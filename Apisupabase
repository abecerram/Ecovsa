function api_lobby(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok:false, error:'PIN no válido' };
  tareaDiaria313_();   // api 3.13: beneficios de promoción (una vez al día)

  const pend = lobby_pendientes_();

  /* Los 'oculto' no salen del lobby: se llega a ellos desde otra pantalla. */
  const lista = MODULOS.filter(m => m.zona !== 'oculto').map(m => ({
    id: m.id, titulo: m.titulo, detalle: m.detalle, icono: m.icono,
    zona: m.zona,
    /* api 3.4: quién entra lo decide Configuración › Módulos por rol */
    permitido: puedeVer_(u, m.id),
    soloVer: permiso_(u, m.id) === 've',
    estado: m.estado || '',
    pendientes: m.pend ? (pend[m.pend] || 0) : 0
  }));
  /* api 3.14: módulos en mantenimiento. «cerrado» = esta persona no entra mientras tanto */
  const MANT = mant_todos_();
  lista.forEach(m => {
    const M = MANT[m.id]; if (!M || m.estado === 'construccion') return;
    const info = mant_info_(m.id, M);
    m.estado = 'mantenimiento'; m.cerrado = !mant_entra_(u, m.id, M);
    m.aviso = info.aviso; m.regreso = info.regreso;
