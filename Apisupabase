/* ══════════ Cobros3131.gs (api 3.13) ══════════ */
/* ═══════════════════════════════════════════════════════════════
   api 3.13.1 · COBROS › CARGAR LOTE · NOTAS DE CRÉDITO
   Una nota de crédito rebaja la factura que corrige: el total nuevo es el
   original menos las notas. Se guarda el original (totalOriginal,
   montoOriginal, itbmsOriginal) y la lista de notas (notasCredito, JSON:
   [{nota, fecha, monto, lote, por}]) para poder anular el lote.
   ═══════════════════════════════════════════════════════════════ */
function cobA_nc313_(f) {
  const s = String((f && f.notasCredito) || '').replace(/^'/, '').trim();
  if (!s) return [];
  try { const l = JSON.parse(s); return Array.isArray(l) ? l : []; } catch (e) { return []; }
}
/* Recalcula total, monto e ITBMS de la factura con sus notas. */
function cobA_ncTotales313_(f, lista) {
  const tO = cobA_r2_(f.totalOriginal) || cobA_r2_(f.total) || cobA_r2_(Number(f.monto) + Number(f.itbms));
  const mO = f.totalOriginal !== '' && f.totalOriginal != null ? cobA_r2_(f.montoOriginal) : cobA_r2_(f.monto);
  const iO = f.totalOriginal !== '' && f.totalOriginal != null ? cobA_r2_(f.itbmsOriginal) : cobA_r2_(f.itbms);
  const nc = cobA_r2_(lista.reduce((s, x) => s + (Number(x.monto) || 0), 0));
  const nuevo = cobA_r2_(tO - nc), k = tO > 0 ? nuevo / tO : 0;
  return { tO: tO, mO: mO, iO: iO, nc: nc, total: nuevo, monto: cobA_r2_(mO * k), itbms: cobA_r2_(iO * k) };
}
function cobA_ncAplicar313_(hF, fac, n) {
  const f = leerHoja_(HOJA_FAC).filter(x => String(x.factura || '').trim() === fac)[0];
  if (!f) return { ok: false, error: 'no encontré la factura ' + fac };
  const lista = cobA_nc313_(f);
  if (lista.some(x => String(x.nota) === n.nota)) return { ok: false, error: 'ya estaba aplicada a la ' + fac };
  lista.push({ nota: n.nota, fecha: n.fecha, monto: n.monto, lote: n.lote, por: n.por });
  const T = cobA_ncTotales313_(f, lista);
  if (T.total < -0.009) return { ok: false, error: 'es mayor que lo que queda de la ' + fac };
  const notas = String(f.notas || '') + (String(f.notas || '').trim() ? ' · ' : '') + 'Nota de crédito ' + n.nota + ' −B/. ' + n.monto.toFixed(2) + ' (lote ' + n.lote + ')';
  cobA_cambiar_(hF, 'factura', fac, { totalOriginal: T.tO, montoOriginal: T.mO, itbmsOriginal: T.iO,
    notasCredito: "'" + JSON.stringify(lista), total: T.total, monto: T.monto, itbms: T.itbms, notas: notas.slice(0, 480) });
  return { ok: true, total: T.total };
}
function cobA_ncQuitarLote313_(hF, f, loteId) {
  const lista = cobA_nc313_(f).filter(x => x.lote !== loteId);
  const T = cobA_ncTotales313_(f, lista);
  const c = { notasCredito: lista.length ? "'" + JSON.stringify(lista) : '', total: T.total, monto: T.monto, itbms: T.itbms };
  if (!lista.length) Object.assign(c, { total: T.tO, monto: T.mO, itbms: T.iO, totalOriginal: '', montoOriginal: '', itbmsOriginal: '' });
  cobA_cambiar_(hF, 'factura', String(f.factura).trim(), c);
}

/* ═══════════════════════════════════════════════════════════════
   api 3.13.1 · COBROS › CONCILIAR · FACTURAS SIN CLIENTE REGISTRADO
   Sage a veces trae un RUC o un nombre que no coincide con la ficha.
   Cobros elige a mano el cliente: se guarda en CobrosAlias el RUC
   («#RUC …») y los nombres con que vienen esas facturas, todos con el
   mismo código de asignación para poder deshacerlo.
   ═══════════════════════════════════════════════════════════════ */
function cobA_redir313_(alias, k) {
  if (!k || !alias) return k;
  if (k.charAt(0) === 'R' && alias['RUC:' + k.slice(1)]) return alias['RUC:' + k.slice(1)];
  if (k.charAt(0) === 'N' && alias[k.slice(1)]) return alias[k.slice(1)];
  return k;
}

function api_cobAsignarCuenta(pin, claveOrigen, clienteId) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  const L = cobA_libro_();
  const c = L.cuentas[String(claveOrigen || '')];
  if (!c) return { ok: false, error: 'Esa cuenta ya no existe. Actualiza la pantalla.' };
  if (c.esPagador || !c.sinFicha) return { ok: false, error: 'Esa cuenta ya tiene cliente registrado.' };
  const fi = L.F.lista.filter(x => String(x.id) === String(clienteId))[0];
  if (!fi) return { ok: false, error: 'No encontré ese cliente.' };
  const rf = rucClave_(fi.ruc);
  const destino = rf ? 'R' + rf : 'N' + cobA_nom_(fi.nombre);
  if (!cobA_nom_(fi.nombre) && !rf) return { ok: false, error: 'Ese cliente no tiene nombre ni RUC.' };
  if (destino === c.clave) return { ok: false, error: 'Ya está en ese cliente.' };
  const facs = L.facturas.filter(f => f.clave === c.clave);
  const pags = L.pagos.filter(p => p.clave === c.clave && !p.facturaExiste);
  const rucs = {}, noms = {};
  facs.forEach(f => { const r = rucClave_(f.ruc); if (r && 'R' + r !== destino) rucs[r] = String(f.ruc).trim(); });
  facs.concat(pags).forEach(f => [f.cliente, f.razon].forEach(n => { const k = cobA_nom_(n); if (k && !L.F.porNom[k]) noms[k] = String(n).trim(); }));
  if (c.clave.charAt(0) === 'R' && !rucs[c.clave.slice(1)] && 'R' + c.clave.slice(1) !== destino) rucs[c.clave.slice(1)] = c.clave.slice(1);
  if (!Object.keys(rucs).length && !Object.keys(noms).length) return { ok: false, error: 'No encontré con qué RUC o nombre vienen esas facturas.' };
  const g = 'A' + Utilities.formatDate(new Date(), 'America/Panama', 'yyMMddHHmmss');
  const h = cobA_hoja_(HOJA_ALIAS, COLS_ALIAS);
  const vals = h.getDataRange().getValues(), cab = vals[0].map(String);
  const cN = cab.indexOf('nombre'), cC = cab.indexOf('clave'), cG = cab.indexOf('asignacion');
  /* lo que ya apuntaba a otra cuenta con ese RUC o nombre queda sin efecto (se deja la fila, sin clave) */
  for (let i = vals.length - 1; i >= 1; i--) {
    const n = String(vals[i][cN] || '');
    const pega = /^#RUC /.test(n) ? !!rucs[rucClave_(n.slice(5))] : !!noms[cobA_nom_(n)];
    if (pega && String(vals[i][cC] || '')) h.getRange(i + 1, cC + 1).setValue('');
  }
  const fila = (nombre) => cobA_agregar_(h, { nombre: nombre, clave: destino, cuenta: fi.nombre, aprendidoPor: a.u.nombre, aprendidoEn: L.hoy, asignacion: g });
  Object.keys(rucs).forEach(r => fila('#RUC ' + rucs[r]));
  Object.keys(noms).forEach(k => fila(noms[k]));
  tab_try_(() => historialCobros3131_(a.u, 'Asignó a ' + fi.nombre + ' las facturas de «' + c.cliente + '»' + (c.ruc ? ' (RUC ' + c.ruc + ')' : ''), g), null);
  marcar_('cobros');
  return { ok: true, asignacion: g, cliente: fi.nombre, facturas: facs.length, clave: destino };
}

function api_cobDeshacerAsignacion(pin, asignacion) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  const g = String(asignacion || '').trim();
  if (!g) return { ok: false, error: 'Falta cuál asignación.' };
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_ALIAS);
  if (!h) return { ok: false, error: 'No encontré esa asignación.' };
  const vals = h.getDataRange().getValues(), cab = vals[0].map(String);
  const cC = cab.indexOf('clave'), cG = cab.indexOf('asignacion');
  if (cG < 0) return { ok: false, error: 'No encontré esa asignación.' };
  let n = 0;
  for (let i = 1; i < vals.length; i++) if (String(vals[i][cG]).trim() === g && String(vals[i][cC] || '')) { h.getRange(i + 1, cC + 1).setValue(''); n++; }
  if (!n) return { ok: false, error: 'Esa asignación ya se había deshecho.' };
  tab_try_(() => historialCobros3131_(a.u, 'Deshizo la asignación ' + g, g), null);
  marcar_('cobros');
  return { ok: true, filas: n };
}

/* deja constancia en el registro de cambios de Cobros */
