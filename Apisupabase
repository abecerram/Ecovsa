/* ═══════════════════════════════════════════════════════════════
   api 3.16 · ENCUESTA DE SATISFACCIÓN (F-VEN-07 · ISO 9001 9.1.2)
   - Katherine la envía desde Mercadeo (WhatsApp o correo, con el
     mensaje de siempre); cada envío lleva un enlace único.
   - El cliente la llena solo, puede dejarla a medias y seguir; al
     enviarla el enlace muere.
   - Le toca a los N días del primer servicio y luego cada N meses
     (Plantillas y ajustes › Encuesta de satisfacción).
   - Las respuestas bajas «piden atención» (Mi día comercial y la
     bandeja); el análisis va en Calidad y el resumen en Dirección.
   Hoja Encuestas: una fila por encuesta. Nada se borra.
   ═══════════════════════════════════════════════════════════════ */
const HOJA_ENC = 'Encuestas';
const COLS_ENC = ['encuestaId', 'clienteId', 'cliente', 'clave', 'motivo', 'estado', 'creada', 'creadaPor',
  'enviada', 'canal', 'enviadaPor', 'recordatorios', 'ultimoRecordatorio', 'abierta', 'progreso', 'respuestas',
  'respondida', 'promedio', 'nps', 'atencion', 'motivoAtencion', 'comentario', 'atendidaPor', 'atendidaEn', 'notaAtencion', 'saltadaPor'];
const ENC_PROP = 'ENCUESTA_CFG';
const ENC_CFG_BASE = {
  primera: 30, cada: 6, recordar: 7, maxRecordar: 1, unica: true, suspendidos: false,
  avisoBajo: 3, alertaExtra: true, anticipo: 7,
  mensaje: '{saludo}, {contacto}. En ECOVSA queremos saber cómo vamos con su servicio. Son 2 minutos y nos ayuda mucho:\n{enlace}\n\nGracias por confiar en nosotros.\n{firma}'
};
/* Preguntas que cuentan para el promedio (1 a 5) y su valor */
const ENC_PUNTOS = {
  general: 'n', puntual: 'n', trato: 'n', contacto: 'n', seguro: 'n',
  docs: { 'Sí, siempre': 5, 'A veces se demoran': 3, 'Me cuesta conseguirlos': 1 },
  limpio: { 'Sí, siempre': 5, 'Casi siempre': 4, 'A veces no': 2, 'No': 1 },
  quejas: { 'Rápido y bien': 5, 'Se resolvió, pero tardó': 3, 'No se resolvió': 1 },
  compara: { 'Mejor': 5, 'Igual': 3, 'Peor': 1 }
};
/* Para el análisis de Calidad: en el orden de la encuesta */
const ENC_PREGUNTAS = [
  ['general', 'En general, ¿cómo se siente con el servicio?'], ['puntual', '¿Llegamos cuando quedamos?'],
  ['trato', '¿Cómo lo trata nuestro equipo?'], ['docs', '¿Le llegan claros los recibos y certificados?'],
  ['contacto', '¿Qué tan fácil es ubicarnos?'], ['limpio', '¿Su área queda limpia y ordenada?'],
  ['quejas', 'Si tuvo un problema, ¿cómo lo resolvimos?'], ['seguro', '¿Qué tan tranquilo está con el tratamiento legal?'],
  ['compara', 'Comparado con otros proveedores, ¿cómo nos ve?']
];
const ENC_TEXTOS = ['sueno', 'otros', 'algo'];
const ENC_TOTAL_PREG = 22;

function enc_cfg_() {
  let g = {};
  try { g = JSON.parse(PropertiesService.getScriptProperties().getProperty(ENC_PROP) || '{}') || {}; } catch (e) { g = {}; }
  return Object.assign({}, ENC_CFG_BASE, g);
}
function enc_filas_() { return crm_filas_(HOJA_ENC).filter(r => crm_txt_(r.encuestaId)); }
function enc_json_(v) { try { const o = JSON.parse(String(v || '').replace(/^'/, '')); return o && typeof o === 'object' ? o : {}; } catch (e) { return {}; } }
function enc_fh_(v) { return v instanceof Date ? Utilities.formatDate(v, 'America/Panama', 'yyyy-MM-dd HH:mm') : crm_txt_(v).replace(/^'/, ''); }
function enc_dia_(v) { return enc_fh_(v).slice(0, 10); }
function enc_masMeses_(iso, n) {
  const d = new Date(iso + 'T12:00:00Z'), dia = d.getUTCDate();
  d.setUTCDate(1); d.setUTCMonth(d.getUTCMonth() + n);
  const ult = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0)).getUTCDate();
  d.setUTCDate(Math.min(dia, ult));
  return d.toISOString().slice(0, 10);
}
function enc_clave_() {
  const a = new Uint8Array(12); crypto.getRandomValues(a);
  return Array.from(a, b => 'abcdefghijkmnpqrstuvwxyz23456789'.charAt(b % 32)).join('');
}
function enc_nom_(s) { return String(s || '').trim().toUpperCase().replace(/\s+/g, ' '); }
function enc_enlace_(e) { return URL_PANTALLAS + 'Encuesta.html?e=' + encodeURIComponent(crm_txt_(e.encuestaId)) + '&k=' + encodeURIComponent(crm_txt_(e.clave)); }
function enc_unica_(c) {
  const f = enc_nom_(c.frecuencia);
  return /ESPECIAL|UNICA|ÚNICA/.test(f) || ['COMPLETADO', 'TRATAMIENTO'].indexOf(enc_nom_(c.estado)) >= 0;
}
function enc_activo_(c, cfg) {
  const e = enc_nom_(c.estado), s = enc_nom_(c.situacion);
  if (prb_esPrueba_(c.prueba)) return false;
  if (!crm_txt_(c.nombre)) return false;
  if (/BAJA|CIERRE|RETIRO|CANCEL/.test(e + ' ' + s) || crm_txt_(c['fecha baja'])) return false;
  if (e === 'POR INICIAR') return false;
  if (!cfg.suspendidos && (e === 'SUSPENDIDO' || /MORA|PAUSA|SUSPEN/.test(s))) return false;
  if (!cfg.unica && enc_unica_(c)) return false;
  return true;
}
function enc_puntaje_(R) {
  let s = 0, n = 0;
  Object.keys(ENC_PUNTOS).forEach(k => {
    const m = ENC_PUNTOS[k], v = R[k];
    if (v === undefined || v === null || v === '') return;
    const x = m === 'n' ? Number(v) : m[String(v)];
    if (x >= 1 && x <= 5) { s += x; n++; }
  });
  return n ? Math.round(s / n * 10) / 10 : null;
}
function enc_atencion_(R, prom, cfg) {
  const m = [];
  if (prom !== null && prom < Number(cfg.avisoBajo || 3)) m.push('promedio ' + String(prom).replace('.', ','));
  if (cfg.alertaExtra) {
    if (R.quejas === 'No se resolvió') m.push('su queja no se resolvió');
    if (R.nps !== undefined && R.nps !== null && R.nps !== '' && Number(R.nps) <= 6) m.push('recomendaría ' + Number(R.nps) + ' de 10');
  }
  return m;
}
function enc_comentario_(R) { return ENC_TEXTOS.map(k => String(R[k] || '').trim()).filter(Boolean).join(' · ').slice(0, 500); }

/* La foto de las encuestas: por cliente, lo último; y la lista de a quién le toca */
function enc_estado_() {
  const cfg = enc_cfg_(), hoy = hoyPanama_();
  const F = enc_filas_();
  const porCli = {};
  F.forEach(r => { const id = crm_txt_(r.clienteId); (porCli[id] = porCli[id] || []).push(r); });
  const primero = {};
  leerHoja_(HOJA_REC).forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']); if (!f) return;
    const k = enc_nom_(r.Cliente); if (!primero[k] || f < primero[k]) primero[k] = f;
  });
  const clientes = leerHoja_(HOJA_CLI);
  const porEnviar = [];
  const fichaDe = {};
  clientes.forEach(c => {
    const id = crm_txt_(c.id); if (!id) return;
    fichaDe[id] = c;
    if (!enc_activo_(c, cfg)) return;
    const L = (porCli[id] || []).slice().sort((a, b) => enc_fh_(a.creada).localeCompare(enc_fh_(b.creada)));
    const abierta = L.filter(r => crm_txt_(r.estado) === 'enviada')[0];
    if (abierta) return;                                    // ya tiene una enviada sin responder
    const hechas = L.filter(r => ['enviada', 'respondida', 'saltada'].indexOf(crm_txt_(r.estado)) >= 0);
    const ult = hechas[hechas.length - 1];
    let toca, motivo, desde;
    if (!ult) {
      const p = primero[enc_nom_(c.nombre)] || primero[enc_nom_(c['nombre 2'])] || fechaISO_(c['inicio recoleccion']);
      if (!p) return;
      toca = crm_masDias_(p, Number(cfg.primera) || 30); motivo = 'primera';
      desde = 'primer servicio el ' + p;
    } else {
      if (enc_unica_(c)) return;                            // visita única: una sola
      const base = enc_dia_(ult.respondida) || enc_dia_(ult.enviada) || enc_dia_(ult.creada);
      toca = enc_masMeses_(base, Number(cfg.cada) || 6); motivo = 'periodica';
      desde = (crm_txt_(ult.estado) === 'respondida' ? 'respondió el ' : crm_txt_(ult.estado) === 'saltada' ? 'se saltó el ' : 'última enviada el ') + base;
    }
    if (toca > crm_masDias_(hoy, Number(cfg.anticipo) || 7)) return;
    const prep = L.filter(r => crm_txt_(r.estado) === 'preparada').slice(-1)[0];
    porEnviar.push({ clienteId: id, cliente: crm_txt_(c.nombre), motivo: motivo, toca: toca, atrasada: toca < hoy, desde: desde,
      nunca: motivo === 'primera' && crm_dias_(toca, hoy) > 30,   // cliente de antes: nunca la ha recibido
      contacto: crm_txt_(c.contacto), telefono: crm_txt_(c.whatsapp) || crm_txt_(c.telefono), correo: crm_txt_(c.correo),
      unica: enc_unica_(c), preparada: prep ? crm_txt_(prep.encuestaId) : '' });
  });
  porEnviar.sort((a, b) => a.toca.localeCompare(b.toca) || a.cliente.localeCompare(b.cliente));
  return { cfg: cfg, hoy: hoy, filas: F, porEnviar: porEnviar, fichaDe: fichaDe };
}
function enc_vista_(r, ficha) {
  const R = enc_json_(r.respuestas), est = crm_txt_(r.estado);
  return { encuestaId: crm_txt_(r.encuestaId), clienteId: crm_txt_(r.clienteId), cliente: crm_txt_(r.cliente), motivo: crm_txt_(r.motivo),
    estado: est, enviada: enc_fh_(r.enviada), canal: crm_txt_(r.canal), enviadaPor: crm_txt_(r.enviadaPor),
    recordatorios: crm_n_(r.recordatorios), ultimoRecordatorio: enc_fh_(r.ultimoRecordatorio), abierta: enc_fh_(r.abierta),
    progreso: crm_n_(r.progreso), total: ENC_TOTAL_PREG, respondida: enc_fh_(r.respondida),
    promedio: r.promedio === '' || r.promedio === undefined ? null : crm_n_(r.promedio), nps: r.nps === '' || r.nps === undefined ? null : crm_n_(r.nps),
    atencion: crm_txt_(r.atencion) === 'SI', motivoAtencion: crm_txt_(r.motivoAtencion), comentario: crm_txt_(r.comentario),
    atendidaPor: crm_txt_(r.atendidaPor), atendidaEn: enc_fh_(r.atendidaEn), notaAtencion: crm_txt_(r.notaAtencion),
    contacto: ficha ? crm_txt_(ficha.contacto) : '', telefono: ficha ? (crm_txt_(ficha.whatsapp) || crm_txt_(ficha.telefono)) : '',
    correo: ficha ? crm_txt_(ficha.correo) : '', respuestas: est === 'respondida' ? R : undefined };
}
function enc_trimestre_(hoy) {
  const m = Number(hoy.slice(5, 7)), q = Math.floor((m - 1) / 3);
  return hoy.slice(0, 4) + '-' + ('0' + (q * 3 + 1)).slice(-2) + '-01';
}

/* ── Mercadeo › Encuestas ── */
function api_encBandeja(pin) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const S = enc_estado_(), hoy = S.hoy, cfg = S.cfg;
  const enviadas = S.filas.filter(r => crm_txt_(r.estado) === 'enviada').map(r => {
    const v = enc_vista_(r, S.fichaDe[crm_txt_(r.clienteId)]);
    const base = enc_dia_(r.ultimoRecordatorio) || enc_dia_(r.enviada);
    v.recordar = v.recordatorios < (Number(cfg.maxRecordar) || 1) && !!base && crm_dias_(base, hoy) >= (Number(cfg.recordar) || 7);
    v.enlace = enc_enlace_(r);
    return v;
  }).sort((a, b) => b.enviada.localeCompare(a.enviada));
  const desde = crm_masDias_(hoy, -92);
  const respondidas = S.filas.filter(r => crm_txt_(r.estado) === 'respondida' && enc_dia_(r.respondida) >= desde)
    .map(r => enc_vista_(r, S.fichaDe[crm_txt_(r.clienteId)])).sort((a, b) => b.respondida.localeCompare(a.respondida));
  const pend = S.filas.filter(r => crm_txt_(r.estado) === 'respondida' && crm_txt_(r.atencion) === 'SI' && !crm_txt_(r.atendidaPor))
    .map(r => enc_vista_(r, S.fichaDe[crm_txt_(r.clienteId)]));
  const proms = respondidas.filter(v => v.promedio !== null);
  return { ok: true, hoy: hoy, cfg: cfg, puedeEnviar: CRM_ROLES_EDITAR.indexOf(x.u.rol) >= 0,
    porEnviar: S.porEnviar, enviadas: enviadas, respondidas: respondidas, atencion: pend,
    kpis: { porEnviar: S.porEnviar.length, atrasadas: S.porEnviar.filter(p => p.atrasada).length,
      enviadas: enviadas.length, paraRecordar: enviadas.filter(v => v.recordar).length,
      respondidas: respondidas.length, promedio: proms.length ? Math.round(proms.reduce((s, v) => s + v.promedio, 0) / proms.length * 10) / 10 : null,
      atencion: pend.length } };
}

/* Antes de abrir WhatsApp: el enlace del cliente (se reutiliza si ya había uno preparado) */
function api_encPreparar(pin, clienteId) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const id = crm_txt_(clienteId);
  const c = leerHoja_(HOJA_CLI).filter(r => crm_txt_(r.id) === id)[0];
  if (!c) return { ok: false, error: 'No encontré ese cliente.' };
  const F = enc_filas_().filter(r => crm_txt_(r.clienteId) === id);
  if (F.some(r => crm_txt_(r.estado) === 'enviada')) return { ok: false, error: 'Ese cliente ya tiene una encuesta enviada sin responder. Usa «Recordar» en Enviadas.' };
  let r = F.filter(f => crm_txt_(f.estado) === 'preparada').slice(-1)[0];
  if (!r) {
    const hechas = F.filter(f => ['enviada', 'respondida', 'saltada'].indexOf(crm_txt_(f.estado)) >= 0);
    r = { encuestaId: crm_id_('ENC'), clienteId: id, cliente: crm_txt_(c.nombre), clave: enc_clave_(),
          motivo: hechas.length ? 'periodica' : 'primera', estado: 'preparada', creada: seg_ahoraTxt_(), creadaPor: x.u.nombre,
          recordatorios: 0, progreso: 0 };
    crm_agregar_(HOJA_ENC, COLS_ENC, r);
  }
  const cfg = enc_cfg_();
  const texto = String(cfg.mensaje || ENC_CFG_BASE.mensaje).replace(/\{enlace\}/g, enc_enlace_(r));
  return { ok: true, encuestaId: crm_txt_(r.encuestaId), enlace: enc_enlace_(r), texto: texto, cliente: crm_txt_(c.nombre),
           contacto: crm_txt_(c.contacto), telefono: crm_txt_(c.whatsapp) || crm_txt_(c.telefono), correo: crm_txt_(c.correo) };
}

/* Al abrir WhatsApp o el correo: queda enviada (o un recordatorio más) */
function api_encMarcarEnviada(pin, encuestaId, canal, esRecordatorio) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const r = enc_filas_().filter(f => crm_txt_(f.encuestaId) === crm_txt_(encuestaId))[0];
  if (!r) return { ok: false, error: 'No encontré esa encuesta.' };
  const est = crm_txt_(r.estado), ahora = seg_ahoraTxt_();
  if (esRecordatorio) {
    if (est !== 'enviada') return { ok: false, error: 'Esa encuesta ya no está esperando respuesta.' };
    crm_cambiar_(HOJA_ENC, COLS_ENC, 'encuestaId', r.encuestaId, { recordatorios: crm_n_(r.recordatorios) + 1, ultimoRecordatorio: ahora });
    return { ok: true };
  }
  if (est !== 'preparada') return { ok: false, error: 'Esa encuesta ya se había enviado.' };
  crm_cambiar_(HOJA_ENC, COLS_ENC, 'encuestaId', r.encuestaId, { estado: 'enviada', enviada: ahora, canal: canal === 'correo' ? 'correo' : 'whatsapp', enviadaPor: x.u.nombre });
  return { ok: true };
}

/* «Saltar»: esta vez no; le vuelve a tocar en N meses */
function api_encSaltar(pin, clienteId) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const id = crm_txt_(clienteId);
  const c = leerHoja_(HOJA_CLI).filter(r => crm_txt_(r.id) === id)[0];
  if (!c) return { ok: false, error: 'No encontré ese cliente.' };
  const prep = enc_filas_().filter(f => crm_txt_(f.clienteId) === id && crm_txt_(f.estado) === 'preparada').slice(-1)[0];
  if (prep) crm_cambiar_(HOJA_ENC, COLS_ENC, 'encuestaId', prep.encuestaId, { estado: 'saltada', enviada: seg_ahoraTxt_(), saltadaPor: x.u.nombre });
  else crm_agregar_(HOJA_ENC, COLS_ENC, { encuestaId: crm_id_('ENC'), clienteId: id, cliente: crm_txt_(c.nombre), clave: '', motivo: 'saltada',
    estado: 'saltada', creada: seg_ahoraTxt_(), creadaPor: x.u.nombre, enviada: seg_ahoraTxt_(), saltadaPor: x.u.nombre });
  return { ok: true };
}

/* Respuesta que pedía atención: ya se atendió */
function api_encAtender(pin, encuestaId, nota) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const r = enc_filas_().filter(f => crm_txt_(f.encuestaId) === crm_txt_(encuestaId))[0];
  if (!r || crm_txt_(r.estado) !== 'respondida') return { ok: false, error: 'No encontré esa respuesta.' };
  crm_cambiar_(HOJA_ENC, COLS_ENC, 'encuestaId', r.encuestaId, { atendidaPor: x.u.nombre, atendidaEn: seg_ahoraTxt_(), notaAtencion: String(nota || '').trim().slice(0, 300) });
  return { ok: true };
}

/* Las respuestas completas (para «Ver respuestas») */
function api_encRespuestas(pin, encuestaId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (CRM_ROLES_VER.indexOf(u.rol) < 0 && !puedeVer_(u, 'calidad')) return { ok: false, error: 'Sin permiso.' };
  const r = enc_filas_().filter(f => crm_txt_(f.encuestaId) === crm_txt_(encuestaId))[0];
  if (!r) return { ok: false, error: 'No encontré esa encuesta.' };
  const v = enc_vista_(r, null); v.respuestas = enc_json_(r.respuestas);
  return { ok: true, encuesta: v };
}

/* Ficha del cliente */
function api_encCliente(pin, clienteId) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const id = crm_txt_(clienteId);
  const S = enc_estado_();
  const L = S.filas.filter(r => crm_txt_(r.clienteId) === id);
  const resp = L.filter(r => crm_txt_(r.estado) === 'respondida').sort((a, b) => enc_fh_(a.respondida).localeCompare(enc_fh_(b.respondida)));
  const ult = resp.length ? enc_vista_(resp[resp.length - 1], null) : null;
  const env = L.filter(r => crm_txt_(r.estado) === 'enviada')[0];
  const toca = S.porEnviar.filter(p => p.clienteId === id)[0] || null;
  let proxima = null;
  if (!toca && !env) {
    const c = S.fichaDe[id];
    if (c && enc_activo_(c, S.cfg) && !(enc_unica_(c) && L.some(r => crm_txt_(r.estado) !== 'preparada'))) {
      const hechas = L.filter(r => ['enviada', 'respondida', 'saltada'].indexOf(crm_txt_(r.estado)) >= 0);
      const u = hechas.sort((a, b) => enc_fh_(a.creada).localeCompare(enc_fh_(b.creada))).slice(-1)[0];
      if (u) proxima = enc_masMeses_(enc_dia_(u.respondida) || enc_dia_(u.enviada) || enc_dia_(u.creada), Number(S.cfg.cada) || 6);
    }
  }
  return { ok: true, hoy: S.hoy, ultima: ult, enviada: env ? enc_vista_(env, null) : null, toca: toca, proxima: proxima,
           respondidas: resp.length, puedeEnviar: CRM_ROLES_EDITAR.indexOf(x.u.rol) >= 0 };
}

/* ── Plantillas y ajustes › Encuesta de satisfacción ── */
function api_encAjustes(pin) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  return { ok: true, cfg: enc_cfg_(), base: ENC_CFG_BASE, puede: CRM_ROLES_EDITAR.indexOf(x.u.rol) >= 0 };
}
function api_encGuardarAjustes(pin, d) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  d = d || {};
  const ent = (v, min, max, def) => { const n = Math.round(Number(v)); return isFinite(n) && n >= min && n <= max ? n : def; };
  const a = enc_cfg_();
  const n = { primera: ent(d.primera, 1, 365, a.primera), cada: ent(d.cada, 1, 24, a.cada), recordar: ent(d.recordar, 1, 60, a.recordar),
    maxRecordar: ent(d.maxRecordar, 0, 3, a.maxRecordar), anticipo: ent(d.anticipo, 0, 30, a.anticipo),
    unica: !!d.unica, suspendidos: !!d.suspendidos, avisoBajo: Math.min(5, Math.max(1, Number(d.avisoBajo) || a.avisoBajo)),
    alertaExtra: !!d.alertaExtra, mensaje: String(d.mensaje || '').trim().slice(0, 1200) || ENC_CFG_BASE.mensaje };
  if (n.mensaje.indexOf('{enlace}') < 0) return { ok: false, error: 'El mensaje debe llevar {enlace}: es donde va el enlace de la encuesta.' };
  const cambios = Object.keys(n).filter(k => JSON.stringify(n[k]) !== JSON.stringify(a[k]));
  if (!cambios.length) return { ok: true, sinCambios: true };
  PropertiesService.getScriptProperties().setProperty(ENC_PROP, JSON.stringify(n));
  try { cfgHistorial_(x.u, 'Encuesta', 'Cambió: ' + cambios.join(', '), cambios.map(k => k + ' ' + JSON.stringify(a[k]).slice(0, 40) + ' → ' + JSON.stringify(n[k]).slice(0, 40)).join(' · ')); } catch (e) {}
  return { ok: true, cambios: cambios.length };
}

/* ── La página del cliente (sin PIN: clave del enlace) ── */
function enc_publica_(e, k) {
  const id = String(e || '').trim(), cl = String(k || '').trim();
  if (!/^ENC-[A-Z0-9]{6,20}$/.test(id) || !/^[a-z0-9]{8,30}$/.test(cl)) return null;
  const r = enc_filas_().filter(f => crm_txt_(f.encuestaId) === id)[0];
  if (!r || crm_txt_(r.clave) !== cl) return null;
  return r;
}
function api_encAbrir(e, k) {
  const r = enc_publica_(e, k);
  if (!r) return { ok: false, error: 'Este enlace no es válido. Pídale a ECOVSA uno nuevo.', invalido: true };
  const est = crm_txt_(r.estado);
  const asesor = String(crm_txt_(r.enviadaPor) || crm_txt_(r.creadaPor) || 'Katherine').split(/\s+/)[0];
