function api_merInformeMinsa(pin, anio, trimestre) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!puedeVer_(u, 'alta')) return { ok: false, error: 'Sin acceso.' };
  const hoy = hoyPanama_();
  const y = Number(anio) || Number(hoy.slice(0, 4));
  const q = Math.min(4, Math.max(1, Number(trimestre) || Math.ceil(Number(hoy.slice(5, 7)) / 3)));
  const meses = [0, 1, 2].map(i => y + '-' + ('0' + ((q - 1) * 3 + i + 1)).slice(-2));
  const d1 = meses[0] + '-01', d2 = cobA_mas_(cobA_masMeses_(meses[0] + '-01', 3), -1);
  const cli = {};
  leerHoja_(HOJA_CLI).forEach(c => { const n = String(c.nombre || '').trim(); if (n) cli[n.toUpperCase()] = c; });
  const filas = {};
  leerHoja_(HOJA_REC).forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']);
    if (!f || f < d1 || f > d2) return;
    const n = String(r.Cliente || '').trim(); if (!n) return;
    const kg = Number(r['total Kg']) || ((Number(r['Kg Recolectados']) || 0) + (Number(r['kg anatomopatologico']) || 0) + (Number(r['kg punzo cortantes']) || 0));
    const o = filas[n.toUpperCase()] = filas[n.toUpperCase()] || { establecimiento: n, kg: [0, 0, 0], visitas: 0, ultima: '' };
    o.kg[meses.indexOf(f.slice(0, 7))] += kg; o.visitas++; if (f > o.ultima) o.ultima = f;
  });
  /* los que estaban en servicio y quedaron fuera en el trimestre también salen, con su fecha */
  Object.keys(cli).forEach(k => {
    const c = cli[k], sit = String(c.situacion || '').trim().toLowerCase(), fb = fechaISO_(c['fecha baja']);
    if (situacionFuera_(sit) && fb && fb >= d1 && fb <= d2 && !filas[k]) filas[k] = { establecimiento: String(c.nombre), kg: [0, 0, 0], visitas: 0, ultima: '' };
  });
  const lista = Object.keys(filas).map(k => {
    const o = filas[k], c = cli[k] || {};
    const sit = String(c.situacion || '').trim().toLowerCase(), fb = fechaISO_(c['fecha baja']);
    const fuera = situacionFuera_(sit), desde = fb ? ' desde ' + fechaPanama_(fb) : '';
    const est = !fuera ? 'Atendido' : sit === 'mora' ? 'Suspendido por falta de pago' + desde : sit === 'pausa' ? 'En pausa' + desde : 'De baja' + desde;
    return { establecimiento: o.establecimiento, razon: String(c['razon social'] || ''), ruc: String(c.ruc || ''),
      direccion: String(c.direccion || c['dirección'] || ''), frecuencia: String(c.frecuencia || ''),
      kg: o.kg.map(v => Math.round(v * 100) / 100), total: Math.round(o.kg.reduce((a, b) => a + b, 0) * 100) / 100,
      visitas: o.visitas, ultima: o.ultima, estado: est, fuera: fuera };
  }).sort((a, b) => b.total - a.total);
  return { ok: true, formulario: codigoFormulario_('informeMinsa'), anio: y, trimestre: q, meses: meses, desde: d1, hasta: d2, filas: lista,
    totales: { establecimientos: lista.length, kg: Math.round(lista.reduce((a, x) => a + x.total, 0) * 100) / 100, visitas: lista.reduce((a, x) => a + x.visitas, 0) },
    empresa: { razonSocial: EMPRESA.razonSocial, ruc: EMPRESA.ruc, dv: EMPRESA.dv, resolucion: EMPRESA.resolucion || '' } };
}

