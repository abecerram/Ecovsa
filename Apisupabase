    else { id = id313_('PR'); agregar313_(t, Object.assign(d, { id: id, estado: 'activa', creadoPor: e.u.nombre, creadoEn: ah, version: 1 })); }
    return { ok: true, id: id, promos: promosRespuesta313_() };
