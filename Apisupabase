  if (!/^data:[\w/+.-]+;base64,/.test(datos)) return { ok:false, error:'El archivo no llegó bien. Vuelve a elegirlo.' };
  if (datos.length > CRM_ARCHIVO_MAX) return { ok:false, error:'El archivo pesa más de 3 MB. Redúcelo o guarda el enlace de donde está.' };
  /* api 3.5.1: el archivo va al espacio de archivos, no a la base */
  const id = crm_id_('ARC'), tipo = crm_txt_(a.tipo) || datos.slice(5, datos.indexOf(';'));
  const ruta = 'crm/' + arc_slug_(id) + '.' + arc_ext_(tipo, a.nombre);
  const nuevo = { id: id, nombre: crm_txt_(a.nombre) || 'archivo', tipo: tipo,
                  tamano: Math.round(datos.length * 0.75), datos: '', ruta: ruta, subidoPor: x.u.nombre, subidoEn: crm_ahora_() };
