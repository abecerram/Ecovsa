function api_crmBuscar(pin, texto) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const q = crm_normal_(texto);
  if (q.length < 2) return { ok:true, resultados: [] };
  const qRuc = String(texto || '').replace(/[^0-9A-Za-z]/g, '').toUpperCase();
  const res = [];
  const pega = (nom, ruc) => {
    const n = crm_normal_(nom);
    if (n && (n.indexOf(q) >= 0 || (q.length >= 4 && q.indexOf(n) >= 0))) return true;
    const r = String(ruc || '').replace(/[^0-9A-Za-z]/g, '').toUpperCase();
    return !!(qRuc.length >= 4 && r && r.indexOf(qRuc) >= 0);
  };
  const cuentas = crm_cuentas_();
  leerHoja_(HOJA_CLI).forEach(c => {
    if (!pega(c.nombre, c.ruc) && !pega(c['razon social'], '')) return;
    res.push({ tipo:'cliente', id: crm_txt_(c.id), nombre: crm_txt_(c.nombre), detalle: [crm_txt_(c.ruc), crm_txt_(c.estado), crm_txt_(c.region)].filter(Boolean).join(' · '),
               ruc: crm_txt_(c.ruc), cuenta: cuentas.de[crm_txt_(c.id)] || '' });
  });
  crm_filas_(HOJA_PRO).forEach(p => {
    if (!pega(p.empresa, p.ruc) && !pega(p['razon social'], '')) return;
    res.push({ tipo:'oportunidad', id: crm_txt_(p.codigoPropuesta), nombre: crm_txt_(p.empresa),
               detalle: [crm_txt_(p.estado) || 'Registrado', crm_txt_(p.ruc)].filter(Boolean).join(' · '), ruc: crm_txt_(p.ruc) });
  });
  crm_filas_(HOJA_CRM_CON).forEach(c => {
    if (!pega(c.nombre, '') && !(q.length >= 4 && String(c.correo || '').toUpperCase().indexOf(String(texto).trim().toUpperCase()) >= 0)) return;
    res.push({ tipo:'contacto', id: crm_txt_(c.ref), refTipo: crm_txt_(c.refTipo), nombre: crm_txt_(c.nombre),
               detalle: [crm_txt_(c.cargo), crm_txt_(c.cuenta)].filter(Boolean).join(' · ') });
  });
  const orden = { cliente:0, oportunidad:1, contacto:2 };
  res.sort((a, b) => orden[a.tipo] - orden[b.tipo] || a.nombre.localeCompare(b.nombre));
  return { ok:true, resultados: res.slice(0, 30) };
}

