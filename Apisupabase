function fechaDe313_(iso) { return new Date(String(iso).slice(0, 10) + 'T12:00:00'); }
function isoDe313_(d) {
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
}
function sumarDias313_(iso, n) { const d = fechaDe313_(iso); d.setDate(d.getDate() + Number(n || 0)); return isoDe313_(d); }
/* Suma meses sin desbordar: 31 ene + 1 mes = 28/29 feb, no 3 mar. */
function sumarMeses313_(iso, n) {
  const d = fechaDe313_(iso), dia = d.getDate();
  d.setDate(1); d.setMonth(d.getMonth() + Number(n || 0));
  const ult = new Date(d.getFullYear(), d.getMonth() + 1, 0, 12).getDate();
  d.setDate(Math.min(dia, ult));
  return isoDe313_(d);
}
function diasEntre313_(a, b) { return Math.round((fechaDe313_(b) - fechaDe313_(a)) / 86400000); }
/* Sábado → viernes; domingo → viernes. (Los feriados no se miran.) */
function habilAntes313_(iso) {
  const d = fechaDe313_(iso), w = d.getDay();
  if (w === 6) d.setDate(d.getDate() - 1);
  if (w === 0) d.setDate(d.getDate() - 2);
  return isoDe313_(d);
}
const MESES_313 = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const MESES_CORTOS_313 = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fechaLarga313_(iso) {
