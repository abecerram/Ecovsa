const SST_MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

function sst_tab_() { return tabla313_(SST_H, SST_COLS); }
/* api 3.33 · el número del formulario lleno sale de su registro: cada entrega de EPP es un F-SST-01 y cada capacitación un F-SST-02 */
const SST_FORM_DE = { epp: 'F-SST-01', caprec: 'F-SST-02' };
function sst_num_(tipo, id) {
  const m = /^[A-Z]+-(\d{2})-(\d+)$/.exec(String(id || '')), c = SST_FORM_DE[tipo];
