function arc_espacio_() {
  let b = 0; const rutas = {};
  arc_filas_().forEach(a => { if (a.ruta) rutas[a.ruta] = 1; if (ARC_VIVOS.indexOf(a.estado) >= 0 && a.ruta) b += a.tamano; });
  let viejos = 0, viejosB = 0;
  crm_filas_(HOJA_CRM_ARC).forEach(a => {
    const r = String(a.ruta || '');
    if (r) { if (!rutas[r]) b += Number(a.tamano) || 0; }
    else if (String(a.datos || '').length > 30) { viejos++; viejosB += Number(a.tamano) || 0; }
  });
  const clientes = leerHoja_(HOJA_CLI).filter(c => String(c.nombre || '').trim() && !situacionFuera_(c.situacion)).length;
  const mb = Math.round(b / 1048576 * 10) / 10, pct = Math.round(b / (ARC_LIMITE_MB * 1048576) * 1000) / 10;
  return { usadoMB: mb, limiteMB: ARC_LIMITE_MB, pct: pct, clientes: clientes, clientesAviso: ARC_AVISO_CLIENTES,
           aviso: pct >= 70 || clientes >= ARC_AVISO_CLIENTES, adjuntosViejos: viejos, adjuntosViejosMB: Math.round(viejosB / 1048576 * 10) / 10,
           listo: Almacen.listo() };
}

