/* ══════════ Portal.gs (api 3.17) ══════════ */
/**
 * PORTAL DE CLIENTES (clientes.ecovsaapp.com · mientras tanto, ecovsaapp.com/Portal.html)
 *
 * Niveles: micro (una sede), sede (de un macro, sin facturas) y corp (el
 * encargado de toda la cuenta: todas las sedes con la misma razón social).
 * Accesos por persona, con PIN propio de 6 números (tabla aparte del equipo).
 * Todos los accesos los maneja el administrador (Configuración › Portal de clientes):
 *  · invitación de un solo uso que vence a las 48 h, enviada al WhatsApp de la ficha;
 *  · pedidos que llegan desde el QR («Activar mi acceso», «Olvidé mi PIN») y del
 *    corporativo (accesos nuevos y bajas);
 *  · entrega del distintivo con firma de recibido y constancia con el QR «Active su portal».
 * Lo que cambia según la cuenta (semáforo de Cobros + estado del servicio):
 *  · al día: todo abierto;  · con atraso: aviso, certificados de lo no pagado cerrados;
 *  · suspendida: el corporativo ve Resumen y Facturas, el micro solo Facturas.
 * Lo que el cliente manda: comprobantes de pago → bandeja de Cobros; pedidos de
 * servicios → bandeja de Mercadeo y actividad del cliente; recolección extra →
 * Logística (el mismo flujo del QR).
 */
const HOJA_PTL_ACC = 'PortalAccesos', HOJA_PTL_PED = 'PortalPedidos', HOJA_PTL_HIS = 'PortalHistorial', HOJA_PTL_ENT = 'PortalEntregas';
const COLS_PTL_ACC = ['accesoId', 'nivel', 'clienteId', 'razonSocial', 'nombre', 'cargo', 'telefono', 'pinHash', 'estado', 'invToken', 'invVence', 'creadoPor', 'creadoEn',
  'activadoEn', 'ultimoIngreso', 'sesion', 'sesionVence', 'entrega', 'notas'];
const COLS_PTL_PED = ['pedidoId', 'tipo', 'clienteId', 'razonSocial', 'accesoId', 'nombre', 'cargo', 'telefono', 'nota', 'estado', 'creadoEn', 'creadoPor', 'atendidoPor', 'atendidoEn', 'respuesta'];
const COLS_PTL_HIS = ['en', 'quien', 'accion', 'detalle'];
const COLS_PTL_ENT = ['folio', 'clienteIds', 'razonSocial', 'kit', 'recibe', 'cargo', 'telefono', 'firma', 'fecha', 'hora', 'por', 'accesoId', 'nota'];
const PTL_INV_HORAS = 48, PTL_SES_DIAS = 60, PTL_MAX_FALLOS = 6, PTL_MAX_FALLOS_TODOS = 60;
const PTL_KIT = ['Distintivo (uno por sede)', 'Carta de bienvenida con su QR', 'Hoja «Servicios y productos de ECOVSA»', 'Certificado de servicio'];

function ptl_t_(v, n) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().slice(0, n || 120); }
function ptl_ahora_() { return Utilities.formatDate(new Date(), 'America/Panama', 'yyyy-MM-dd HH:mm'); }
function ptl_hex_(s) { return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(s) + '|' + arc_secreto_()).map(x => ('0' + ((x + 256) % 256).toString(16)).slice(-2)).join(''); }
function ptl_hashPin_(pin) { return ptl_hex_('PTL-PIN|' + String(pin)); }
function ptl_hashSes_(t) { return ptl_hex_('PTL-SES|' + String(t)); }
function ptl_token_() { return Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '').slice(0, 8); }
function ptl_url_() {
  let u = ''; try { u = String(PropertiesService.getScriptProperties().getProperty('PTL_URL') || ''); } catch (e) {}
  return u || 'https://ecovsaapp.com/Portal.html';
}
function ptl_tab_(h, c) { return tabla313_(h, c); }
function ptl_acc_(x) {
  return { accesoId: ptl_t_(x.accesoId), nivel: ptl_t_(x.nivel) || 'micro', clienteId: ptl_t_(x.clienteId), razonSocial: ptl_t_(x.razonSocial, 160), nombre: ptl_t_(x.nombre), cargo: ptl_t_(x.cargo),
    telefono: ptl_t_(x.telefono), estado: ptl_t_(x.estado) || 'invitado', invVence: ptl_t_(x.invVence), creadoPor: ptl_t_(x.creadoPor), creadoEn: ptl_t_(x.creadoEn),
    activadoEn: ptl_t_(x.activadoEn), ultimoIngreso: ptl_t_(x.ultimoIngreso), entrega: ptl_t_(x.entrega), tienePin: !!ptl_t_(x.pinHash),
    vencida: (ptl_t_(x.estado) || 'invitado') === 'invitado' && !ptl_t_(x.pinHash) && (!ptl_t_(x.invVence) || ptl_t_(x.invVence) < ptl_ahora_()) };   // api 3.23
}
function ptl_his_(quien, accion, detalle) { try { agregar313_(ptl_tab_(HOJA_PTL_HIS, COLS_PTL_HIS), { en: "'" + ptl_ahora_(), quien: String(quien || ''), accion: String(accion || ''), detalle: String(detalle || '').slice(0, 300) }); } catch (e) {} }
function ptl_sigId_(filas, col, pref, ancho) {
  let max = 0; filas.forEach(x => { const v = ptl_t_(x[col]); if (v.indexOf(pref) === 0) max = Math.max(max, Number(v.slice(pref.length)) || 0); });
  return pref + ('00000' + (max + 1)).slice(-(ancho || 4));
}
function ptl_cliente_(id) { return leerHoja_(HOJA_CLI).find(c => String(c.id).trim() === String(id).trim()) || null; }
function ptl_activo_(c) { return !!c && !clienteFuera_(c); }
/* el WhatsApp de la ficha (a veces viene como enlace wa.me): solo los números */
function ptl_telDe_(c) {
  const v = [c && c.whatsapp, c && c.telefono, c && c.celular].map(x => String(x || '')).find(x => x.replace(/\D/g, '').length >= 7) || '';
  const m = /wa\.me\/(\d+)/.exec(v); const d = m ? m[1] : v.replace(/\D/g, '');
  return d.length === 11 && d.indexOf('507') === 0 ? d.slice(3) : d.slice(0, 15);
}
function ptl_waLink_(tel, texto) {
  let d = String(tel || '').replace(/\D/g, ''); if (d.length === 8) d = '507' + d;
  return d ? 'https://wa.me/' + d + '?text=' + encodeURIComponent(texto) : '';
}
/* Las sedes que cubre un acceso */
function ptl_sedes_(a) {
  const C = leerHoja_(HOJA_CLI);
  if (a.nivel === 'corp') { const r = a.razonSocial.toUpperCase(); return C.filter(c => ptl_activo_(c) && String(c['razon social'] || '').trim().toUpperCase() === r); }
  const c = C.find(x => String(x.id).trim() === a.clienteId); return c ? [c] : [];
}

/* ═══ Entrar ═══ */
function ptl_fallos_() {
  const k = 'PTL_FALLOS_' + String(_REQ_IP || _REQ_EQ || 'x').replace(/[^\w.:-]/g, '').slice(0, 50);
  let v = {}; try { v = JSON.parse(PropertiesService.getScriptProperties().getProperty(k) || '{}'); } catch (e) { v = {}; }
  const ahora = Date.now(); if (!v.t || ahora - v.t > 15 * 60000) v = { n: 0, t: ahora };
  return { k: k, v: v };
}
function ptl_fallosTodos_() {
  let v = {}; try { v = JSON.parse(PropertiesService.getScriptProperties().getProperty('PTL_FALLOS_TODOS') || '{}'); } catch (e) { v = {}; }
  const ahora = Date.now(); if (!v.t || ahora - v.t > 15 * 60000) v = { n: 0, t: ahora };
  return v;
}
function ptl_sumarFallo_(f) {
  try { const g = ptl_fallosTodos_(); g.n = (g.n || 0) + 1; PropertiesService.getScriptProperties().setProperty('PTL_FALLOS_TODOS', JSON.stringify(g)); } catch (e) {} f.v.n = (f.v.n || 0) + 1; f.v.t = f.v.t || Date.now(); try { PropertiesService.getScriptProperties().setProperty(f.k, JSON.stringify(f.v)); } catch (e) {} }
function ptl_sesionNueva_(t, fila) {
  const tok = ptl_token_(), vence = Utilities.formatDate(new Date(Date.now() + PTL_SES_DIAS * 864e5), 'America/Panama', 'yyyy-MM-dd');
  actualizar313_(t, fila._fila, { sesion: ptl_hashSes_(tok), sesionVence: "'" + vence, ultimoIngreso: "'" + ptl_ahora_() });
  return tok;
}
function api_ptlEntrar(pin) {
  const p = String(pin || '').replace(/\D/g, '');
  const f = ptl_fallos_();
  if (f.v.n >= PTL_MAX_FALLOS) return { ok: false, error: 'Demasiados intentos. Espere 15 minutos o escríbanos al WhatsApp 6264-1647.' };
  /* solidez: muchos PIN equivocados en 15 minutos (de donde sea) cierran la entrada un rato */
  if ((ptl_fallosTodos_().n || 0) >= PTL_MAX_FALLOS_TODOS) return { ok: false, error: 'El portal está recibiendo demasiados intentos. Pruebe en 15 minutos o escríbanos al WhatsApp 6264-1647.' };
  if (p.length !== 6) return { ok: false, error: 'El PIN tiene 6 números.' };
  const t = ptl_tab_(HOJA_PTL_ACC, COLS_PTL_ACC), h = ptl_hashPin_(p);
  const x = t.filas.find(z => ptl_t_(z.pinHash) === h && ptl_t_(z.estado) === 'activo');
  if (!x) { ptl_sumarFallo_(f); return { ok: false, error: 'Ese PIN no es válido.' }; }
  const tok = ptl_sesionNueva_(t, x);
  ptl_his_(ptl_t_(x.nombre), 'entró', ptl_t_(x.nivel) + ' · ' + (ptl_t_(x.razonSocial) || ptl_t_(x.clienteId)));
  return { ok: true, sesion: tok, nombre: ptl_t_(x.nombre) };
}
function ptl_sesion_(tok) {
  const s = String(tok || '');
  if (s.length < 20) return { e: { ok: false, salir: true, error: 'Entre con su PIN.' } };
  const t = ptl_tab_(HOJA_PTL_ACC, COLS_PTL_ACC), h = ptl_hashSes_(s);
  const x = t.filas.find(z => ptl_t_(z.sesion) === h);
  if (!x || ptl_t_(x.estado) !== 'activo') return { e: { ok: false, salir: true, error: 'Su sesión terminó. Entre con su PIN.' } };
  if (fechaISO_(x.sesionVence) < hoyPanama_()) return { e: { ok: false, salir: true, error: 'Su sesión venció. Entre con su PIN.' } };
  return { t: t, fila: x, a: ptl_acc_(x) };
}
function api_ptlSalir(tok) { const s = ptl_sesion_(tok); if (s.e) return { ok: true }; actualizar313_(s.t, s.fila._fila, { sesion: '', sesionVence: '' }); return { ok: true }; }

/* La invitación: la abre el cliente, crea su PIN y queda adentro */
function ptl_invitacion_(tok) {
  const s = String(tok || '').trim(); if (s.length < 20) return null;
  const t = ptl_tab_(HOJA_PTL_ACC, COLS_PTL_ACC), x = t.filas.find(z => ptl_t_(z.invToken) === ptl_hashSes_('INV|' + s));
  return x ? { t: t, fila: x } : null;
}
function api_ptlInvitacion(tok) {
  const v = ptl_invitacion_(tok);
  if (!v) return { ok: false, error: 'Esta invitación no es válida o ya se usó. Pida otra a ECOVSA por WhatsApp 6264-1647.' };
  if (ptl_t_(v.fila.invVence) < ptl_ahora_()) return { ok: false, error: 'Esta invitación venció. Pida otra a ECOVSA por WhatsApp 6264-1647.' };
  const a = ptl_acc_(v.fila), sedes = ptl_sedes_(a);
  return { ok: true, nombre: a.nombre, nivel: a.nivel, de: a.nivel === 'corp' ? a.razonSocial : (sedes[0] ? String(sedes[0].nombre || '') : ''), sedes: sedes.length };
}
function api_ptlCrearPin(tok, pin, pin2) {
  const v = ptl_invitacion_(tok);
  if (!v) return { ok: false, error: 'Esta invitación no es válida o ya se usó.' };
  if (ptl_t_(v.fila.invVence) < ptl_ahora_()) return { ok: false, error: 'Esta invitación venció. Pida otra a ECOVSA.' };
  const p = String(pin || '').replace(/\D/g, '');
  if (p.length !== 6) return { ok: false, error: 'El PIN tiene 6 números.' };
  if (String(pin2 || '').replace(/\D/g, '') !== p) return { ok: false, error: 'Los dos PIN no son iguales.' };
  if (/^(\d)\1{5}$/.test(p) || '0123456789'.indexOf(p) >= 0 || '9876543210'.indexOf(p) >= 0) return { ok: false, error: 'Ese PIN es muy fácil de adivinar. Elija otro.' };
  const h = ptl_hashPin_(p);
  if (v.t.filas.some(z => z !== v.fila && ptl_t_(z.pinHash) === h && ptl_t_(z.estado) === 'activo')) {
    /* solidez: que este aviso no sirva para descubrir el PIN de otra persona */
    const n = (Number(String(v.fila.notas || '').replace(/\D/g, '')) || 0) + 1;
    if (n >= 3) { actualizar313_(v.t, v.fila._fila, { invToken: '', invVence: '', notas: '' }); ptl_his_(ptl_t_(v.fila.nombre), 'invitación anulada', 'tres PIN repetidos'); ptl_sumarFallo_(ptl_fallos_());
      return { ok: false, error: 'Por seguridad esta invitación se anuló. Pida otra a ECOVSA por WhatsApp 6264-1647.' }; }
    actualizar313_(v.t, v.fila._fila, { notas: 'choques ' + n });
    return { ok: false, error: 'Elija otro PIN.' };
  }
  actualizar313_(v.t, v.fila._fila, { pinHash: h, estado: 'activo', invToken: '', invVence: '', activadoEn: "'" + ptl_ahora_() });
  const tok2 = ptl_sesionNueva_(v.t, v.fila);
  ptl_his_(ptl_t_(v.fila.nombre), 'creó su PIN', ptl_t_(v.fila.nivel));
  return { ok: true, sesion: tok2, nombre: ptl_t_(v.fila.nombre) };
}

/* Desde el QR: «Primera vez: activar mi acceso» y «Olvidé mi PIN» llegan al administrador */
function api_ptlPedirAcceso(clienteId, codigo, d) {
  const q = qr_cliente_(clienteId, codigo);
  if (q.error) return { ok: false, error: q.error };
  if (q.est === 'baja') return { ok: false, error: 'Este establecimiento ya no tiene servicio con ECOVSA.' };
  d = d || {};
  const tipo = d.tipo === 'olvide' ? 'olvide' : 'activar', nombre = ptl_t_(d.nombre, 80), cargo = ptl_t_(d.cargo, 60);
  if (!nombre) return { ok: false, error: 'Escriba su nombre.' };
  const t = ptl_tab_(HOJA_PTL_PED, COLS_PTL_PED);
  if (t.filas.some(p => ptl_t_(p.clienteId) === q.id && ptl_t_(p.tipo) === tipo && ptl_t_(p.estado) === 'pendiente'))
    return { ok: true, repetido: true, mensaje: 'Ya tenemos su pedido. ECOVSA le escribe al WhatsApp registrado del establecimiento.' };
  const id = ptl_sigId_(t.filas, 'pedidoId', 'PPA-' + hoyPanama_().slice(2, 4) + '-', 3);
  agregar313_(t, { pedidoId: id, tipo: tipo, clienteId: q.id, razonSocial: String(q.c['razon social'] || ''), nombre: nombre, cargo: cargo, telefono: '', nota: ptl_t_(d.nota, 200),
    estado: 'pendiente', creadoEn: "'" + ptl_ahora_(), creadoPor: 'Página del QR' });
  ptl_his_(nombre, tipo === 'olvide' ? 'pidió un PIN nuevo' : 'pidió activar su acceso', String(q.c.nombre || ''));
  return { ok: true, folio: id, mensaje: 'Recibimos su pedido. Por seguridad, ECOVSA le manda la invitación al WhatsApp registrado del establecimiento.' };
}

/* ═══ Lo que ve el cliente ═══ */
function ptl_facturas_(sedes) {
  let L; try { L = cobA_libro_(); } catch (e) { return []; }
  const nom = {}, rucs = {}, pag = {};
  sedes.forEach(c => {
    [c.nombre, c['razon social']].forEach(n => { const k = String(n || '').trim().toUpperCase(); if (k) nom[k] = 1; });
    const r = String(c.ruc || '').replace(/\D/g, ''); if (r.length > 5) rucs[r] = 1;
    try { const pg = pag_deCliente_(String(c.nombre || '').trim()); if (pg) pag['P' + pg.pagadorId] = 1; } catch (e) {}
  });
