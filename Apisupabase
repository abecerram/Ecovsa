  const u = usuarioPorPin_(pin);
  if (!u) return { e: { ok: false, error: 'PIN no válido', requiereLogin: true } };
  if (!esSupervisor_(u)) return { e: { ok: false, error: 'El asistente de rutas es de Logística.' } };
  return { u: u };
}
function asis_entrada_(r) {
