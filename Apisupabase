/* Guardar y salir = borrador, sin validar. Guardar = activo, validado. */
function api_guardarPlanTarifa(pin, plan, borrador) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  plan = plan || {};
  const tipo = plan.tipo === 'especial' ? 'especial' : 'regular';
  const frec = String(plan.frecuencia || '').toUpperCase().trim();
  const d = { nombre: String(plan.nombre || '').trim(), tipo: tipo, sector: tipo === 'especial' ? String(plan.sector || '').trim() : '',
    descripcion: String(plan.descripcion || '').trim(), frecuencia: frec, visitas: visitasDe313_(frec, plan.visitas),
    kgIncluidos: Number(plan.kgIncluidos) || 0, precio: r2_313_(plan.precio),
    kgAdicional: (plan.kgAdicional === '' || plan.kgAdicional == null) ? '' : r2_313_(plan.kgAdicional),
    servicios: JSON.stringify(limpiarServicios313_(plan.servicios, visitasDe313_(frec, plan.visitas))),
    referencia: limpiarReferencia313_(plan.referencia) };
  /* estado pedido: 'apagado' se respeta; 'borrador' equivale a Guardar y salir */
  const pedido = String(plan.estado || '');
  if (pedido === 'borrador') borrador = true;
  if (!borrador) {
    const falta = faltaPlan313_(d);
    if (falta.length) return { ok: false, error: 'Falta ' + falta.join(', ') + '.', falta: falta };
  }
  if (!d.nombre) d.nombre = 'Plan sin nombre';
  return candado313_(() => {
    const t = tabla313_(HOJA_PLANES_313, COLS_PLANES_313);
    const f = plan.id ? t.filas.filter(x => String(x.id) === String(plan.id))[0] : null;
    if (plan.id && !f) return { ok: false, error: 'Ese plan ya no existe.' };
    const repetido = t.filas.some(x => String(x.id) !== String(plan.id || '') && String(x.nombre).trim().toLowerCase() === d.nombre.toLowerCase());
    if (repetido && !borrador) return { ok: false, error: 'Ya hay un plan con ese nombre.' };
    const ah = ahora313_();
    d.estado = borrador ? (f && String(f.estado) !== 'borrador' ? String(f.estado) : 'borrador') : (pedido === 'apagado' ? 'apagado' : 'activo');
    /* un plan activo que se guarda como borrador con datos incompletos pasa a borrador */
    if (borrador && d.estado === 'activo' && faltaPlan313_(d).length) d.estado = 'borrador';
    let id, version;
    if (f) {
      id = String(f.id); version = (Number(f.version) || 1) + 1;
      actualizar313_(t, f._fila, Object.assign(d, { cambiadoPor: e.u.nombre, cambiadoEn: ah, version: version }));
    } else {
      id = id313_('PL'); version = 1;
      agregar313_(t, Object.assign(d, { id: id, creadoPor: e.u.nombre, creadoEn: ah, cambiadoPor: e.u.nombre, cambiadoEn: ah, version: 1 }));
    }
    return { ok: true, id: id, version: version, estado: d.estado, planes: planesRespuesta313_() };
  });
}

