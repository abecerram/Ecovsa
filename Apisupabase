      if (escalon === 'antes') texto = 'Aviso antes de vencer (vence en ' + c.paraVencerMin + ' días)';
      else if (escalon === 'incobrable') texto = c.moraMax + ' días: llamada final o proponer incobrable';
      else if (ug && ug.fecha && fecha <= hoy && cobA_dias_(ug.fecha, hoy) >= cad && ug.tipo !== 'noContesta') texto = 'Sin respuesta desde el ' + fechaPanama_(ug.fecha) + ': ' + (canalBase === 'llamada' ? 'llamar' : 'insistir por ' + (canalBase === 'whatsapp' ? 'WhatsApp' : 'correo'));
      else texto = esc ? esc.n + (c.grande && canalBase === 'llamada' ? ' · cuenta grande: llamar' : '') : 'Seguimiento';
      if (escalon === 'antes' && ug && ug.fecha >= cobA_mas_(hoy, -10)) paso = null;
      else paso = { tipo: 'escalon', texto: texto, canal: canalBase, fecha: fecha, tono: escalon === 'ultimo' || escalon === 'incobrable' ? 'bad' : escalon === 'arreglo' ? 'warn' : '' };
    }
    c.paso = paso;
    if (paso && paso.fecha <= cobA_mas_(hoy, 7)) {
      const peso = c.vencido + c.saldo * 0.2 + (paso.tono === 'bad' ? 5000 : 0) + (paso.fecha < hoy ? 2000 : 0);
      agenda.push({ clave: k, cliente: c.cliente, fecha: paso.fecha, cuando: paso.fecha < hoy ? 'atrasado' : paso.fecha === hoy ? 'hoy' : 'pronto',
                    tipo: paso.tipo, texto: paso.texto, canal: paso.canal, tono: paso.tono, saldo: c.saldo, vencido: c.vencido,
                    escalon: c.escalon, peso: peso });
    }
  });
  agenda.sort((a, b) => {
    const ca = a.cuando === 'pronto' ? 1 : 0, cb = b.cuando === 'pronto' ? 1 : 0;
    if (ca !== cb) return ca - cb;
    if (ca === 1) return a.fecha < b.fecha ? -1 : a.fecha > b.fecha ? 1 : b.peso - a.peso;
    return b.peso - a.peso;
  });
  return agenda;
}

function cobA_conciliar_(L) {
  const out = [];
  const facturasDe = {};
  L.facturas.forEach(f => { (facturasDe[f.clave] = facturasDe[f.clave] || []).push(f); });
  const sinCeros = s => String(s || '').replace(/^0+/, '');
  /* duplicados: dos pagos a la misma factura, mismo monto, y la factura quedó pagada de más */
  const vistos = {};
  L.pagos.forEach(p => {
    if (p.anulado || !p.factura || !p.facturaExiste) return;
    const f = L.facPorNum[p.factura];
    const k = p.factura + '|' + p.monto.toFixed(2);
    if (vistos[k] && f && f.cobrado > f.neto + 0.01) {
      const o = vistos[k];
      out.push({ pagoId: p.pagoId, tipo: 'duplicado', pago: p, texto: 'Probable duplicado: la ' + p.factura + ' ya tenía un pago de B/. ' + p.monto.toFixed(2) + ' del ' + fechaPanama_(o.fecha) + ' y quedó pagada de más.', igualA: o.pagoId });
    } else vistos[k] = p;
  });
  L.pagos.forEach(p => {
    if (p.anulado || p.monto <= 0) return;
    if (p.factura && p.facturaExiste) return;
    if (p.aFavor) { out.push({ pagoId: p.pagoId, tipo: 'aFavor', pago: p, texto: 'Saldo a favor de ' + (p.cliente || 'la cuenta') + ': se aplica a la próxima factura.' }); return; }
    /* 1 · la cuenta: por RUC, razón social, nombre comercial o nombre aprendido */
    let clave = p.clave, por = '';
    if (clave && L.cuentas[clave]) {
      const c = L.cuentas[clave];
      por = cobA_nom_(c.razon) === cobA_nom_(p.cliente) ? 'razón social' : cobA_nom_(c.cliente) === cobA_nom_(p.cliente) ? 'nombre comercial' : 'nombre aprendido';
    } else clave = '';
    /* 2 · la factura: abierta con el mismo monto en esa cuenta */
    const abiertas = (clave ? (facturasDe[clave] || []) : []).filter(f => f.saldo > 0.009).sort((a, b) => a.fecha < b.fecha ? -1 : 1);
    let propuesta = null, texto = '';
    const mismoNum = p.factura ? L.facturas.filter(f => sinCeros(f.factura) === sinCeros(p.factura)) : [];
    const exacta = abiertas.filter(f => Math.abs(f.saldo - p.monto) < 0.01);
    if (p.factura && !p.facturaExiste) {
        const ya = mismoNum.filter(f => f.saldo <= 0.009 && f.estado !== 'INCOBRABLE');
      texto = 'La factura «' + p.factura + '» no existe tal cual' +
        (ya.length ? ' (' + ya.slice(0, 3).map(f => 'la ' + f.factura + ' ya está pagada' + (f.ultimoPago ? ' desde el ' + fechaPanama_(f.ultimoPago) : '')).join('; ') + ')' : '') + '.';
      /* ¿el mismo monto ya entró a una factura con ese número en otra serie? → duplicado */
      const gemelo = L.pagos.filter(q => q !== p && !q.anulado && q.facturaExiste && sinCeros(q.factura) === sinCeros(p.factura) && Math.abs(q.monto - p.monto) < 0.01)[0];
      if (gemelo && !exacta.length) {
        out.push({ pagoId: p.pagoId, tipo: 'duplicado', pago: p, igualA: gemelo.pagoId, clave: gemelo.clave, cuenta: (L.cuentas[gemelo.clave] || {}).cliente || '',
          texto: texto + ' Probable duplicado del pago del ' + fechaPanama_(gemelo.fecha) + ' a la ' + gemelo.factura + ' (mismo monto, B/. ' + p.monto.toFixed(2) + ').' });
        return;
      }
    } else texto = 'El pago no dice a qué factura va.';
    if (exacta.length) { propuesta = [{ factura: exacta[0].factura, monto: p.monto }]; texto += ' Propuesta: ' + exacta[0].factura + ' (abierta, mismo monto' + (por ? ', misma ' + por : '') + ').'; }
    else if (abiertas.length) {
      let resto = p.monto; propuesta = [];
      abiertas.forEach(f => { if (resto <= 0.009) return; const m = cobA_r2_(Math.min(resto, f.saldo)); propuesta.push({ factura: f.factura, monto: m }); resto = cobA_r2_(resto - m); });
      texto += ' Propuesta: a las más viejas de la cuenta' + (resto > 0.009 ? '; quedan B/. ' + resto.toFixed(2) + ' a favor.' : '.');
    } else if (!clave) texto += ' No encontré la cuenta por RUC, razón social ni nombre: elige la cuenta.';
    else texto += ' La cuenta no tiene facturas abiertas: queda a favor.';
    out.push({ pagoId: p.pagoId, tipo: 'sinAmarrar', pago: p, clave: clave, cuenta: clave && L.cuentas[clave] ? L.cuentas[clave].cliente : '', por: por, propuesta: propuesta, texto: texto });
  });
  return out;
}

function cobA_incobrables_(L) {
  const C = L.C, hoy = L.hoy;
  const cand = L.facturas.filter(f => f.estado !== 'INCOBRABLE' && f.saldo > 0.009 && f.mora >= (C.incobrableDias || 365))
    .map(f => {
      const c = L.cuentas[f.clave] || {};
      const sinPago = c.ultimoPago ? cobA_dias_(c.ultimoPago, hoy) : 9999;
      return { factura: f.factura, clave: f.clave, cliente: c.cliente || f.cliente, fecha: f.fecha, mora: f.mora, saldo: f.saldo,
               ultimoPago: c.ultimoPago || '', diasSinPago: sinPago, sugerida: sinPago >= (C.incobrableSinPago || 180) };
    }).sort((a, b) => b.mora - a.mora);
  const decl = L.facturas.filter(f => f.estado === 'INCOBRABLE').map(f => ({
    factura: f.factura, clave: f.clave, cliente: (L.cuentas[f.clave] || {}).cliente || f.cliente, fecha: f.fecha, saldo: f.saldoReal,
    motivo: f.incobrable.motivo, por: f.incobrable.por, en: f.incobrable.en, autorizo: f.incobrable.autorizo || '', recuperado: f.cobrado
  }));
  return { candidatas: cand, declaradas: decl };
}

function cobA_metricas_(L, agenda) {
  const hoy = L.hoy, mes = hoy.slice(0, 7), C = L.C;
  const hace90 = cobA_mas_(hoy, -90), hace7 = cobA_mas_(hoy, -7);
  let mesMonto = 0, mesN = 0, mas90 = 0, mas90N = 0, porPlanes = 0;
  const planActivo = {};
  L.planes.forEach(p => { if (['ACTIVO', 'ATRASADO', 'ROTO', 'CUMPLIDO'].indexOf(p.estado) >= 0) planActivo[p.clave] = p.aceptadoEn || p.creadoEn; });
  L.pagos.forEach(p => {
    if (p.anulado || p.monto <= 0 || p.fecha.slice(0, 7) !== mes) return;
    mesMonto += p.monto; mesN++;
    const f = L.facPorNum[p.factura];
    if (f && f.vencimiento && cobA_dias_(f.vencimiento, p.fecha) > 90) { mas90 += p.monto; mas90N++; }
    if (planActivo[p.clave] && p.fecha >= planActivo[p.clave]) porPlanes += p.monto;
  });
  /* efectividad por canal: gestiones de los últimos 90 días que tuvieron un pago en los 15 días siguientes */
  const pagosDe = {};
  L.pagos.forEach(p => { if (!p.anulado && p.monto > 0 && p.clave) (pagosDe[p.clave] = pagosDe[p.clave] || []).push(p.fecha); });
  const canal = {};
  let semana = 0, promN = 0, promOk = 0;
  L.gestiones.forEach(g => {
    if (g.fecha >= hace7) semana++;
    if (g.fecha < hace90) return;
    const cn = g.canal || 'otro';
    if (['plan', 'sistema'].indexOf(cn) >= 0) return;      // no son contactos con el cliente
    const x = canal[cn] = canal[cn] || { canal: cn, gestiones: 0, conPago: 0 };
    x.gestiones++;
    const fin = cobA_mas_(g.fecha, 15);
    if ((pagosDe[g.clave] || []).some(f => f >= g.fecha && f <= fin)) x.conPago++;
    if (g.seCompromete && g.fechaPrometida && g.fechaPrometida < hoy) {
      promN++;
      const pagado = (L.pagos.filter(p => p.clave === g.clave && !p.anulado && p.fecha >= g.fecha && p.fecha <= cobA_mas_(g.fechaPrometida, 2)).reduce((s, p) => s + p.monto, 0));
      if (g.montoPrometido ? pagado >= g.montoPrometido - 0.01 : pagado > 0) promOk++;
    }
  });
  const cuentas = Object.keys(L.cuentas).map(k => L.cuentas[k]).filter(c => c.saldo > 0.009);
  const conGestion = cuentas.filter(c => c.gestiones > 0).length;
  const enPlan = cuentas.filter(c => c.plan && ['ACTIVO', 'ATRASADO'].indexOf(c.plan.estado) >= 0);
  return {
    cobradoMes: cobA_r2_(mesMonto), pagosMes: mesN, mas90: cobA_r2_(mas90), mas90N: mas90N, porPlanes: cobA_r2_(porPlanes),
    gestionesSemana: semana, cuentasConGestion: conGestion, cuentasSinGestion: cuentas.length - conGestion,
    promesasVencidas: promN, promesasCumplidas: promOk,
    canales: Object.keys(canal).map(k => canal[k]).sort((a, b) => b.gestiones - a.gestiones),
    enPlanCuentas: enPlan.length, enPlanSaldo: cobA_r2_(enPlan.reduce((s, c) => s + c.saldo, 0)),
    agendaHoy: agenda.filter(a => a.cuando !== 'pronto').length
  };
}

function api_cobBase(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!veCobros_(u)) return { ok: false, error: 'Tu usuario no entra a Cobros. Avísale al administrador.' };
  tareaDiaria313_();   // api 3.13: el cambio al plan normal no depende de que alguien abra Mercadeo
  const L = cobA_libro_();
  const agenda = cobA_seguimiento_(L);
  const cuentas = Object.keys(L.cuentas).map(k => L.cuentas[k]).sort((a, b) => b.saldo - a.saldo || b.facturado - a.facturado);
  /* api 3.9: desde qué banco paga (lo anota Mercadeo al revisar los datos bancarios: banco y últimos 4) */
  tab_try_(() => {
    const porId = {}, porRuc = {};
    leerHoja_(HOJA_PRO).forEach(p => {
