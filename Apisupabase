function api_calLogistica(pin, desde, hasta) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!inc_puedeGestionar_(u)) return { ok: false, error: 'Solo logística.' };
  const D = /^\d{4}-\d{2}-\d{2}$/.test(String(desde)) ? String(desde) : hoyPanama_().slice(0, 8) + '01';
  const H = /^\d{4}-\d{2}-\d{2}$/.test(String(hasta)) ? String(hasta) : ini_dia_(D, 41);
  const hoy = hoyPanama_();
  const ag = api_agenda(pin, null, D, H);
  const dias = (ag && ag.ok ? ag.dias : []).map(d => ({
    fecha: d.fecha, rutaId: d.rutaId || '', conductor: d.conductor || '', vehiculo: d.vehiculo || '', total: Number(d.total) || 0,
    completadas: Number(d.completadas) || 0, totalKg: Math.round((Number(d.totalKg) || 0) * 10) / 10, estadoRuta: String(d.estadoRuta || ''),
    motivoCierre: String(d.motivoCierre || ''), borrador: !!d.borrador, primera: d.primera || '', ultima: d.ultima || '',
    sinHacer: (d.paradas || []).filter(p => !p.hecha).map(p => ({ clienteId: p.clienteId, nombre: p.nombre }))
  }));
  const ev = [];
  /* mantenimiento y documentos */
  const mto = tab_try_(() => api_mantenimientoFlota(pin), null);
  if (mto && mto.ok) (mto.camiones || []).forEach(c => (c.servicios || []).concat(c.documentos || []).forEach(t => {
    const f = fechaISO_(t.vence); if (!f || f < D || f > H) return;
    ev.push({ fecha: f, tipo: mto_esDoc_(t) ? 'doc' : 'mto', titulo: (mto_esDoc_(t) ? 'Vence ' : '') + String(t.tarea || '').toLowerCase() + ' · ' + c.placa, placa: c.placa });
  }));
  /* inspecciones con visita programada */
  tab_try_(() => leerHoja_(HOJA_INSP), []).forEach(r => {
    const f = fechaISO_(r.fechaVisita);
    if (!f || f < D || f > H || String(r.estado || '').toUpperCase() !== 'PEDIDA') return;
    ev.push({ fecha: f, tipo: 'ins', titulo: 'Inspección · ' + String(r.empresa || r.nombre || ''), por: String(r.inspectorAsignado || '') });
  });
  /* tus recordatorios */
  tab_try_(() => rcd_de_(u), []).forEach(r => { if (r.fecha >= D && r.fecha <= H) ev.push({ fecha: r.fecha, tipo: 'rec', titulo: r.texto + (r.cliente ? ' · ' + r.cliente : (r.refTxt ? ' · ' + r.refTxt : '')) }); });
  /* incidencias abiertas y no recolectadas, en su día */
  tab_try_(() => inc_filas_(), []).forEach(x => { if (x.fecha >= D && x.fecha <= H && x.estado !== 'ANULADA')
    ev.push({ fecha: x.fecha, tipo: x.tipo === 'norecolectada' ? 'nr' : 'inc', titulo: inc_titulo_(x), incId: x.incId, abierta: inc_abierta_(x) }); });
  /* feriados */
  Object.keys(INC_FERIADOS).forEach(f => { if (f >= D && f <= H) ev.push({ fecha: f, tipo: 'fer', titulo: INC_FERIADOS[f] }); });
  /* clientes que vencen en los días que vienen y no tienen ruta ese día */
  const toca = {};
  tab_try_(() => {
    const P = cli_plan_(leerHoja_(HOJA_CLI), leerHoja_(HOJA_REC), hoy);
    const conRuta = {}; dias.forEach(d => (conRuta[d.fecha] = conRuta[d.fecha] || true));
    Object.keys(P.plan || {}).forEach(id => {
      const pl = P.plan[id]; if (!pl || !pl.activo || !pl.proxima) return;
      const f = pl.proxima < hoy ? hoy : pl.proxima;
      if (f < hoy || f < D || f > H || conRuta[f]) return;
      toca[f] = (toca[f] || 0) + 1;
    });
    return true;
  }, null);
  return { ok: true, hoy: hoy, desde: D, hasta: H, dias: dias, eventos: ev, toca: toca };
}


/* ══════════ Inicio.gs (copiado tal cual) ══════════ */
function ini_dia_(iso, n) {
  const d = new Date(String(iso).slice(0, 10) + 'T12:00:00Z');
  if (isNaN(d.getTime())) return '';
  d.setUTCDate(d.getUTCDate() + (Number(n) || 0));
  return d.toISOString().slice(0, 10);
}

function ini_dow_(iso) { return new Date(String(iso) + 'T12:00:00Z').getUTCDay(); }

function ini_min_(h) { const m = String(h || '').match(/^(\d{1,2}):(\d{2})/); return m ? Number(m[1]) * 60 + Number(m[2]) : null; }

function ini_hhmm_(m) { m = Math.max(0, Math.round(m)); return ('0' + Math.floor(m / 60) % 24).slice(-2) + ':' + ('0' + m % 60).slice(-2); }

function ini_r_(v, d) { const k = Math.pow(10, d || 0); return Math.round((Number(v) || 0) * k) / k; }

function ini_nom_(s) { return String(s || '').trim().toUpperCase(); }

function ini_fechaTxt_(iso) {
  const D = ['dom','lun','mar','mié','jue','vie','sáb'], M = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
  return iso ? D[ini_dow_(iso)] + ' ' + Number(iso.slice(8, 10)) + ' ' + M[Number(iso.slice(5, 7)) - 1] +
    (iso.slice(0, 4) !== hoyPanama_().slice(0, 4) ? ' ' + iso.slice(0, 4) : '') : '';
}

function ini_diasEntre_(a, b) { return Math.round((new Date(b + 'T12:00:00Z') - new Date(a + 'T12:00:00Z')) / 86400000); }

function litrosCarga_(c) {
  const m = String((c && c.notas) || '').match(/registrado como\s+([\d.,]+)\s*litros/i);
  if (m) { const v = Number(m[1].replace(',', '.')); if (isFinite(v) && v > 0) return v; }
  return Number(c && c.galones) || 0;
}

function ini_periodos_(periodo, hoy) {
  const y = Number(hoy.slice(0, 4)), mm = Number(hoy.slice(5, 7)), dd = Number(hoy.slice(8, 10));
  const p2 = n => ('0' + n).slice(-2);
  if (periodo === 'mes') {
    const py = mm === 1 ? y - 1 : y, pm = mm === 1 ? 12 : mm - 1;
    const finPrev = new Date(Date.UTC(py, pm, 0)).getUTCDate();
    return { nombre: 'mes', desde: y + '-' + p2(mm) + '-01', hasta: hoy,
             pDesde: py + '-' + p2(pm) + '-01', pHasta: py + '-' + p2(pm) + '-' + p2(Math.min(dd, finPrev)),
             etiqueta: 'mes anterior' };
  }
  if (periodo === 'anio') {
    return { nombre: 'anio', desde: y + '-01-01', hasta: hoy,
             pDesde: (y - 1) + '-01-01', pHasta: (y - 1) + '-' + p2(mm) + '-' + p2(Math.min(dd, 28 + (mm === 2 ? 0 : 3))),
             etiqueta: 'año anterior' };
  }
  const lunes = ini_dia_(hoy, -((ini_dow_(hoy) + 6) % 7));
  return { nombre: 'semana', desde: lunes, hasta: hoy, pDesde: ini_dia_(lunes, -7), pHasta: ini_dia_(hoy, -7),
           etiqueta: 'semana anterior' };
}

function api_inicioLogistica(pin, periodo) {
  const u = usuarioPorPin_(pin);
  tab_try_(() => { const u331 = usuarioPorPin_(pin); if (u331 && esSupervisor_(u331)) asis_tick_(); }, null);   // api 3.31
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'El inicio de logística es de supervisión.' };

  const hoy = hoyPanama_();
  const ahora = Utilities.formatDate(new Date(), 'America/Panama', 'HH:mm');
  const minAhora = ini_min_(ahora);
  const per = ini_periodos_(String(periodo || 'semana'), hoy);
  const n = v => { const x = Number(v); return isFinite(x) ? x : 0; };

  /* ── una lectura por hoja ───────────────────────────────────────── */
  const CLI = leerHoja_(HOJA_CLI);
  const RUT = leerHoja_(HOJA_RUT);
  const REC = leerHoja_(HOJA_REC);
  const JOR = leerHoja_(HOJA_JOR);
  const COM = leerHoja_(HOJA_COM);
  let REV = [], TODAS_FAL = [];
  try { REV = leerHoja_(HOJA_REV); } catch (e) {}
  try { TODAS_FAL = leerHoja_(HOJA_FAL).map(falla_).filter(f => f.fallaId); } catch (e) {}
  const FAL = TODAS_FAL.filter(f => ['resuelta','anulada'].indexOf(f.estado) < 0);
  const USR = leerHoja_(HOJA_USR);

  const cliPorId = {};
  CLI.forEach(c => { const id = Number(c.id); if (id) cliPorId[id] = c; });
  const nombreCli = id => cliPorId[id] ? String(cliPorId[id].nombre || '') : ('Cliente ' + id);
  const idPorNombre = {};
  CLI.forEach(c => { idPorNombre[ini_nom_(c.nombre)] = Number(c.id); });

  const telDe = nombre => {
    const f = USR.find(x => ini_nom_(x.nombre) === ini_nom_(nombre));
    return f ? String(f.telefono || f.celular || '').trim() : '';
  };

  /* recolecciones por fecha|cliente, y la última de cada cliente */
  const rec = {}, ultimaRec = {};
  REC.forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']); if (!f) return;
    const k = ini_nom_(r.Cliente);
    const kg = n(r['total Kg']) || (n(r['Kg Recolectados']) + n(r['kg anatomopatologico']) + n(r['kg punzo cortantes']));
    rec[f + '|' + k] = { kg: kg, hi: horaTxt_(r['hora inicio']), hf: horaTxt_(r['hora final']),
                         recibo: String(r['recibo numero'] || ''), resp: String(r.Responsable || '') };
    if (!ultimaRec[k] || f > ultimaRec[k]) ultimaRec[k] = f;
  });

  /* rutas agrupadas por rutaId */
  const rutas = {};
  RUT.forEach(r => {
    const f = fechaISO_(r.fecha); const id = String(r.rutaId || ''); if (!f || !id) return;
    if (!rutas[id]) rutas[id] = { rutaId: id, fecha: f, conductor: String(r.conductor || ''), vehiculo: String(r.vehiculo || ''),
                                  estadoRuta: String(r.estadoRuta || '').toUpperCase(), motivoCierre: String(r.motivoCierre || ''),
                                  cerradaEn: r.cerradaEn ? horaTxt_(r.cerradaEn) : '', borrador: esBorrador_(r), paradas: [] };
    const cid = Number(r.clienteId);
    if (rutas[id].paradas.some(p => p.clienteId === cid)) return;
    rutas[id].paradas.push({ orden: n(r.orden), clienteId: cid });
  });
  const listaRutas = Object.keys(rutas).map(k => rutas[k]);
  listaRutas.forEach(ru => {
    ru.paradas.sort((a, b) => a.orden - b.orden);
    ru.paradas.forEach(p => {
      p.cliente = nombreCli(p.clienteId);
      const h = rec[ru.fecha + '|' + ini_nom_(p.cliente)];
      p.hecha = !!h; p.kg = h ? ini_r_(h.kg, 1) : 0; p.hi = h ? h.hi : ''; p.hf = h ? h.hf : '';
      p.recibo = h ? h.recibo : '';
      const c = cliPorId[p.clienteId] || {};
      p.horario = String(c.horarioTipo || '').toLowerCase();
      p.desde = horaTxt_(c.horarioDesde); p.hasta = horaTxt_(c.horarioHasta);
    });
    ru.total = ru.paradas.length;
    ru.hechas = ru.paradas.filter(p => p.hecha).length;
    ru.kg = ini_r_(ru.paradas.reduce((s, p) => s + p.kg, 0), 1);
  });

  const jorDe = (fecha, conductor) => JOR.filter(j => fechaISO_(j.fecha) === fecha && ini_nom_(j.conductor) === ini_nom_(conductor))
    .sort((a, b) => String(horaTxt_(b.horaInicio)).localeCompare(String(horaTxt_(a.horaInicio))))[0] || null;

  /* historial para estimar: hora de salida y minutos por parada (últimos 45 días) */
  const hace45 = ini_dia_(hoy, -45);
  const salidas = JOR.filter(j => { const f = fechaISO_(j.fecha); return f >= hace45 && f < hoy; })
    .map(j => ini_min_(horaTxt_(j.horaInicio))).filter(m => m !== null && m > 300 && m < 720);
  const minSalida = salidas.length ? salidas.reduce((a, b) => a + b, 0) / salidas.length : ini_min_(SALIDA_BASE);
  const porDiaResp = {};
  REC.forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']); if (!f || f < hace45 || f >= hoy) return;
    const m = ini_min_(horaTxt_(r['hora inicio'])); if (m === null) return;
    const k = f + '|' + ini_nom_(r.Responsable);
    (porDiaResp[k] = porDiaResp[k] || []).push(m);
  });
  const saltos = [];
  Object.keys(porDiaResp).forEach(k => {
    const l = porDiaResp[k].sort((a, b) => a - b);
    for (let i = 1; i < l.length; i++) { const d = l[i] - l[i - 1]; if (d >= 5 && d <= 120) saltos.push(d); }
  });
  const minParada = saltos.length >= 5 ? Math.round(saltos.reduce((a, b) => a + b, 0) / saltos.length) : MIN_PARADA_BASE;

  /* camiones y su tope */
  let vehiculos = [];
  try { vehiculos = vehiculosFlota_(); } catch (e) { vehiculos = VEHICULOS_BASE.map(p => ({ placa: p })); }
  const CFGL = cfgLog_(); let ACTS = []; try { ACTS = leerHoja_(HOJA_ACT); } catch (e) {}
  const tope = v => topeCamion_(v, CFGL, ACTS);

  /* ═══ 1 · HOY ═════════════════════════════════════════════════════ */
  const hoyRutas = listaRutas.filter(r => r.fecha === hoy && !r.borrador).sort((a, b) => a.conductor.localeCompare(b.conductor));
  const cargasHoy = COM.filter(c => fechaISO_(c.fecha) === hoy);
  const vivo = hoyRutas.map(ru => {
    const j = jorDe(hoy, ru.conductor);
    const bloqueos = FAL.filter(f => f.bloquea && normVeh_(f.vehiculo) === normVeh_(ru.vehiculo));
    let estado;
    if (ru.estadoRuta === 'TERMINADA ANTES') estado = 'terminada';
    else if (ru.total && ru.hechas >= ru.total) estado = 'completa';
    else if (j && String(j.horaFinal || '').trim()) estado = 'cerrada';
    else if (j) estado = 'en ruta';
    else if (bloqueos.length) estado = 'bloqueado';
    else estado = 'sin salir';

    const hechas = ru.paradas.filter(p => p.hecha).sort((a, b) => String(a.hf || a.hi).localeCompare(String(b.hf || b.hi)));
    const ult = hechas.length ? hechas[hechas.length - 1] : null;
    const sig = ru.paradas.find(p => !p.hecha) || null;

    let revision = null;
    const idRev = j ? String(j.revisionSalida || '') : '';
    const rv = REV.filter(r => (idRev && String(r.revisionId) === idRev) ||
      (fechaISO_(r.fecha) === hoy && String(r.momento) === 'salida' && normVeh_(r.vehiculo) === normVeh_((j && j.vehiculo) || ru.vehiculo)))[0];
    if (rv) revision = { hora: horaTxt_(rv.hora), puntos: n(rv.puntos), bien: n(rv.bien), fallas: n(rv.fallas) };

    const km = j ? (n(j.kmRecorridos) || (n(j.kmFinal) && n(j.kmInicio) ? n(j.kmFinal) - n(j.kmInicio) : 0)) : 0;
    return {
      rutaId: ru.rutaId, conductor: ru.conductor, vehiculo: (j && j.vehiculo) ? String(j.vehiculo) : ru.vehiculo,
      estado: estado, total: ru.total, hechas: ru.hechas, pct: ru.total ? Math.round(ru.hechas / ru.total * 100) : 0,
      kg: ru.kg, km: km, motivoCierre: ru.motivoCierre, cerradaEn: ru.cerradaEn,
      salida: j ? horaTxt_(j.horaInicio) : '', llegada: j ? horaTxt_(j.horaFinal) : '',
      ultima: ult ? { cliente: ult.cliente, hora: ult.hf || ult.hi } : null,
      siguiente: sig ? sig.cliente : '',
      revision: revision,
      revisionCierre: j && String(j.revisionCierre || '').trim() ? true : false,
      cargas: cargasHoy.filter(c => normVeh_(c.vehiculo) === normVeh_(ru.vehiculo)).length,
      recibos: ru.paradas.filter(p => p.recibo).length,
      bloqueo: bloqueos.length ? { fallaId: bloqueos[0].fallaId, punto: bloqueos[0].punto, hora: bloqueos[0].hora,
                                   que: bloqueos[0].que, nota: bloqueos[0].nota, conductor: bloqueos[0].conductor } : null,
      telefono: telDe(ru.conductor),
      paradas: ru.paradas.map(p => ({ clienteId: p.clienteId, cliente: p.cliente, hecha: p.hecha, kg: p.kg,
                                       hi: p.hi, hf: p.hf, recibo: !!p.recibo, horario: p.horario, desde: p.desde, hasta: p.hasta }))
    };
  });
  const abiertas = vivo.filter(r => ['sin salir','bloqueado','en ruta'].indexOf(r.estado) >= 0).length;
  const fase = vivo.length && !abiertas ? 'cierre' : 'vivo';
  const tot = { rutas: vivo.length, total: 0, hechas: 0, kg: 0, km: 0, combustible: 0, litros: 0 };
  vivo.forEach(r => { tot.total += r.total; tot.hechas += r.hechas; tot.kg += r.kg; tot.km += r.km; });
  cargasHoy.forEach(c => { tot.combustible += n(c.monto); tot.litros += litrosCarga_(c); });
  tot.kg = ini_r_(tot.kg, 1); tot.combustible = ini_r_(tot.combustible, 2); tot.litros = ini_r_(tot.litros, 1);
  tot.pct = tot.total ? Math.round(tot.hechas / tot.total * 100) : 0;
  const terminoA = vivo.map(r => r.llegada || r.cerradaEn).filter(Boolean).sort().pop() || '';

  /* ═══ 2 · LO QUE VIENE ═══════════════════════════════════════════ */
  const PLAN = cli_plan_(CLI, REC, hoy).plan;
  const situacionOk = c => !!(PLAN[Number(c.id)] && PLAN[Number(c.id)].activo);
  const proxDe = c => (PLAN[Number(c.id)] && PLAN[Number(c.id)].proxima) || '';
  const enRutaDesde = {};           // clienteId → primera fecha programada desde hoy
  listaRutas.forEach(r => {
    if (r.fecha < hoy) return;
    r.paradas.forEach(p => { if (!p.hecha && (!enRutaDesde[p.clienteId] || r.fecha < enRutaDesde[p.clienteId])) enRutaDesde[p.clienteId] = r.fecha; });
  });
  const lesToca = f => {
    const dia = String(ini_dow_(f) === 0 ? 7 : ini_dow_(f));
    const l = [];
    CLI.forEach(c => {
      const id = Number(c.id); if (!id || !situacionOk(c)) return;
      const fijos = String(c['dias semana'] || '').split(/[^0-9]+/).filter(String);
      const pl = PLAN[id];
      const rec = cli_tocaRec_(pl, f);
      if (fijos.indexOf(dia) >= 0 || rec || proxDe(c) === f)
        l.push({ id: id, nombre: String(c.nombre || ''), motivo: fijos.indexOf(dia) >= 0 ? 'día fijo' : (rec ? 'recurrente' : 'le toca ese día') });
    });
    return l;
  };
  const semana = [];
  let dia = hoy, guard = 0;
  while (semana.length < 5 && guard++ < 14) {
    dia = ini_dia_(dia, 1);
    const dw = ini_dow_(dia);
    const rs = listaRutas.filter(r => r.fecha === dia);
    if ((dw === 0 || dw === 6) && !rs.length) continue;
    const toca = lesToca(dia);
    semana.push({
      fecha: dia,
      rutas: rs.map(r => ({ rutaId: r.rutaId, conductor: r.conductor, vehiculo: r.vehiculo, paradas: r.total, borrador: r.borrador,
                            tope: tope(r.vehiculo), caben: Math.max(0, tope(r.vehiculo) - r.total) })),
      lesToca: toca.length,
      sinProgramar: toca.filter(c => !enRutaDesde[c.id]).length
    });
  }

  /* ═══ 3 · REQUIERE TU ATENCIÓN ═══════════════════════════════════ */
  const aten = [];
  const libres = vehiculos.map(v => v.placa).filter(p =>
    !hoyRutas.some(r => normVeh_(r.vehiculo) === normVeh_(p)) && !FAL.some(f => f.bloquea && normVeh_(f.vehiculo) === normVeh_(p)));

  // camión bloqueado
  const vistasBloq = {};
  vivo.filter(r => r.bloqueo && ['sin salir','bloqueado'].indexOf(r.estado) >= 0).forEach(r => {
    vistasBloq[r.bloqueo.fallaId] = 1;
    const mes = hoy.slice(0, 7);
    const previas = TODAS_FAL.filter(f => f.estado !== 'anulada' && f.punto === r.bloqueo.punto &&
                     normVeh_(f.vehiculo) === normVeh_(r.vehiculo) && f.fecha.slice(0, 7) === mes).length;
    aten.push({ tipo: 'bloqueo', nivel: 'r', grupo: 'Hoy', titulo: r.vehiculo + ' no puede salir',
      texto: r.bloqueo.punto + ' · ' + (r.bloqueo.conductor || r.conductor) + ' espera tu decisión desde las ' + (r.bloqueo.hora || '—'),
      accion: 'Decidir', principal: true,
      datos: { rutaId: r.rutaId, vehiculo: r.vehiculo, conductor: r.conductor, falla: r.bloqueo, paradas: r.total,
               estrictos: r.paradas.filter(p => p.horario === 'estricto').length, libres: libres, vecesMes: previas } });
  });
  FAL.filter(f => f.bloquea && !vistasBloq[f.fallaId]).forEach(f => {
    aten.push({ tipo: 'bloqueo', nivel: 'r', grupo: 'Flota', titulo: f.vehiculo + ' está bloqueado',
      texto: f.punto + ' · reportado el ' + f.fecha + ' por ' + f.conductor, accion: 'Decidir', principal: true,
      datos: { rutaId: '', vehiculo: f.vehiculo, conductor: f.conductor, falla: { fallaId: f.fallaId, punto: f.punto, hora: f.hora, que: f.que, nota: f.nota, conductor: f.conductor },
               paradas: 0, estrictos: 0, libres: libres, vecesMes: 0 } });
  });

  // rutas terminadas antes con paradas sin hacer (últimos 7 días) que nadie volvió a programar
  const hace7 = ini_dia_(hoy, -7);
  listaRutas.filter(r => r.fecha >= hace7 && r.fecha <= hoy && (r.estadoRuta === 'TERMINADA ANTES' ||
      (r.fecha < hoy && r.total && r.hechas < r.total && r.hechas > 0))).forEach(r => {
    const pend = r.paradas.filter(p => !p.hecha && !enRutaDesde[p.clienteId] &&
      !((PLAN[p.clienteId] || {}).ultimaReal > r.fecha));
    if (!pend.length) return;
    const hoyEs = r.fecha === hoy;
    aten.push({ tipo: 'terminada', nivel: 'r', grupo: 'Hoy',
      titulo: pend.length + (pend.length === 1 ? ' parada quedó sin hacer' : ' paradas quedaron sin hacer'),
      texto: r.conductor + (r.estadoRuta === 'TERMINADA ANTES' ? ' terminó antes' : ' no completó la ruta') +
             (hoyEs ? '' : ' el ' + ini_fechaTxt_(r.fecha)) + (r.motivoCierre ? ': ' + r.motivoCierre : ''),
      accion: 'Reprogramar', principal: true,
      datos: { rutaId: r.rutaId, fecha: r.fecha, conductor: r.conductor, vehiculo: r.vehiculo, motivo: r.motivoCierre,
               paradas: pend.map(p => ({ clienteId: p.clienteId, cliente: p.cliente })) } });
  });

  // horario estricto en riesgo, hoy y el próximo día hábil
  const riesgoDe = (ru, base, esHoy) => {
    const pend = ru.paradas.filter(p => !p.hecha);
    const out = [];
    pend.forEach((p, i) => {
      if (p.horario !== 'estricto' || !p.hasta) return;
      const llega = base + (i + (esHoy ? 1 : 0)) * minParada;
      const hasta = ini_min_(p.hasta);
      if (hasta !== null && llega > hasta)
        out.push({ clienteId: p.clienteId, cliente: p.cliente, desde: p.desde, hasta: p.hasta,
                   puesto: ru.paradas.indexOf(p) + 1, llegaria: ini_hhmm_(llega) });
    });
    return out;
  };
  vivo.filter(r => ['sin salir','bloqueado','en ruta'].indexOf(r.estado) >= 0).forEach(r => {
    const ru = rutas[r.rutaId];
    const ultMin = r.ultima ? ini_min_(r.ultima.hora) : null;
    const base = Math.max(minAhora, ultMin !== null ? ultMin : (r.salida ? ini_min_(r.salida) : minSalida));
    const rs = riesgoDe(ru, base, true);
    if (!rs.length) return;
    aten.push({ tipo: 'horario', nivel: 'a', grupo: 'Hoy',
      titulo: rs.length === 1 ? rs[0].cliente + ' llegaría fuera de horario' : rs.length + ' clientes llegarían fuera de horario hoy',
      texto: rs.length === 1 ? 'Solo recibe hasta ' + rs[0].hasta + ' y va de ' + rs[0].puesto + '.ª · llegaría cerca de las ' + rs[0].llegaria
                             : r.conductor + ' · ' + rs.map(x => x.cliente + ' (hasta ' + x.hasta + ')').join(', '),
      accion: 'Ajustar', datos: { rutaId: r.rutaId, fecha: hoy, conductor: r.conductor, vehiculo: r.vehiculo, riesgo: rs } });
  });
  const proxHabil = semana.length ? semana[0].fecha : '';
  listaRutas.filter(r => r.fecha === proxHabil).forEach(ru => {
    const rs = riesgoDe(ru, minSalida, false);
    if (!rs.length) return;
    aten.push({ tipo: 'horario', nivel: 'a', grupo: 'Planificación',
      titulo: rs.length === 1 ? rs[0].cliente + ' llegaría fuera de horario' : rs.length + ' horarios en riesgo el ' + ini_fechaTxt_(proxHabil),
      texto: rs.length === 1 ? 'El ' + ini_fechaTxt_(proxHabil) + ' · solo recibe hasta ' + rs[0].hasta + ' y va de ' + rs[0].puesto + '.ª'
                             : ru.conductor + ' · ' + rs.map(x => x.cliente).join(', '),
      accion: 'Ajustar', datos: { rutaId: ru.rutaId, fecha: proxHabil, conductor: ru.conductor, vehiculo: ru.vehiculo, riesgo: rs } });
  });

  // vencidos sin ruta en los próximos 7 días
  const hasta7 = ini_dia_(hoy, 7);
  const vencidos = [];
  CLI.forEach(c => {
    const id = Number(c.id); if (!id || !situacionOk(c)) return;
    const pv = proxDe(c); if (!pv || pv >= hoy) return;
    if (enRutaDesde[id] && enRutaDesde[id] <= hasta7) return;
    vencidos.push({ clienteId: id, cliente: String(c.nombre || ''), region: String(c.region || ''),
                    dias: ini_diasEntre_(pv, hoy), frecuencia: String(c.frecuencia || '') });
  });
  vencidos.sort((a, b) => b.dias - a.dias);
  if (vencidos.length) aten.push({ tipo: 'vencidos', nivel: 'b', grupo: 'Planificación',
    titulo: vencidos.length + (vencidos.length === 1 ? ' cliente vencido sin ruta' : ' clientes vencidos sin ruta'),
    texto: 'Nadie los tiene programados en los próximos 7 días · ' + vencidos.slice(0, 3).map(v => v.cliente).join(', ') +
           (vencidos.length > 3 ? ' y ' + (vencidos.length - 3) + ' más' : ''),
    accion: 'Planificar', datos: { clientes: vencidos, fecha: proxHabil } });

  // días hábiles sin ruta, con clientes que les toca
  semana.filter(d => !d.rutas.length && d.sinProgramar).slice(0, 2).forEach(d => {
    aten.push({ tipo: 'diaSinRuta', nivel: 'b', grupo: 'Planificación', titulo: ini_fechaTxt_(d.fecha) + ' sin ruta',
      texto: d.sinProgramar + (d.sinProgramar === 1 ? ' cliente le toca ese día' : ' clientes les toca ese día'),
      accion: 'Crear ruta', datos: { fecha: d.fecha } });
  });

  // clientes nuevos por revisar e inspecciones
  let porRevisar = { total: 0, masViejo: 0 }, inspecciones = { total: 0, masVieja: 0 };
  try {
    const pend = solicitudesPendientes_();
    const dd = pend.map(s => s.fechaSolicitud ? ini_diasEntre_(s.fechaSolicitud, hoy) : 0);
    porRevisar = { total: pend.length, masViejo: dd.length ? Math.max.apply(null, dd) : 0 };
  } catch (e) {}
  try {
    const ins = leerHoja_(HOJA_INSP).filter(r => INSP_ABIERTAS.indexOf(String(r.estado || '').trim().toUpperCase()) >= 0);
    const dd = ins.map(r => fechaISO_(r.pedidaEn) ? ini_diasEntre_(fechaISO_(r.pedidaEn), hoy) : 0);
    inspecciones = { total: ins.length, masVieja: dd.length ? Math.max.apply(null, dd) : 0 };
  } catch (e) {}
  /* api 3.5.2 · las tres cosas que esperan a Logística van en un solo aviso
     que abre «Solicitudes»: clientes nuevos, inspecciones y las
     recolecciones extra que el cliente pidió desde su QR */
  let extras = [];
  try { extras = sol_extrasAbiertas_().filter(x => !x.programada); } catch (e) {}
  let inspSinDia = inspecciones.total;
  try { inspSinDia = leerHoja_(HOJA_INSP).filter(r => String(r.estado || '').trim().toUpperCase() === 'EN PROCESO' ||
          (String(r.estado || '').trim().toUpperCase() === 'PEDIDA' && !fechaISO_(r.fechaVisita))).length; } catch (e) {}
  const nSol = porRevisar.total + inspSinDia + extras.length;
  if (nSol) {
    const partes = [];
    if (extras.length) partes.push(extras.length + (extras.length === 1 ? ' recolección extra' : ' recolecciones extra'));
    if (porRevisar.total) partes.push(porRevisar.total + (porRevisar.total === 1 ? ' cliente nuevo' : ' clientes nuevos'));
    if (inspSinDia) partes.push(inspSinDia + (inspSinDia === 1 ? ' inspección' : ' inspecciones'));
    const urge = extras.some(x => x.prioridad === 'alta');
    const viejo = Math.max(porRevisar.masViejo || 0, inspecciones.masVieja || 0,
                           extras.reduce((m, x) => Math.max(m, x.pedida ? ini_diasEntre_(x.pedida, hoy) : 0), 0));
    aten.push({ tipo: 'solicitudes', nivel: urge ? 'r' : 'a', grupo: 'Por revisar',
      titulo: nSol + (nSol === 1 ? ' solicitud esperando' : ' solicitudes esperando'),
      texto: partes.join(' · ') + (urge ? ' · un cliente la pidió para lo antes posible' : (viejo > 1 ? ' · la más vieja lleva ' + viejo + ' días' : '')),
      accion: 'Revisar' });
  }

  // fallas de la flota que no bloquean
  const fallasNo = FAL.filter(f => !f.bloquea);
  if (fallasNo.length) {
    const porConf = fallasNo.filter(f => f.estado === 'por confirmar').length;
    const taller = fallasNo.filter(f => f.estado === 'en taller').length;
    aten.push({ tipo: 'fallas', nivel: 'a', grupo: 'Flota',
      titulo: fallasNo.length === 1 ? fallasNo[0].punto + ' · ' + fallasNo[0].vehiculo : fallasNo.length + ' fallas abiertas en la flota',
      texto: fallasNo.length === 1 ? (fallasNo[0].fecha === hoy ? 'Reportada hoy' : 'Abierta hace ' + ini_diasEntre_(fallasNo[0].fecha, hoy) + ' días') + ' · ' + (fallasNo[0].estado === 'en taller' ? 'en taller' : 'puede salir')
             : [porConf ? porConf + ' por confirmar' : '', taller ? taller + ' en taller' : '', (fallasNo.length - porConf - taller) ? (fallasNo.length - porConf - taller) + ' abiertas' : ''].filter(Boolean).join(' · '),
      accion: 'Ver', datos: { fallas: fallasNo.map(f => ({ fallaId: f.fallaId, vehiculo: f.vehiculo, punto: f.punto, estado: f.estado,
                                                            fecha: f.fecha, conductor: f.conductor, que: f.que, nota: f.nota, critico: f.critico })) } });
  }

  // kg sin acta
  const sinActa = {};
  REC.forEach(r => {
    if (String(r.acta || '').trim()) return;
    const k = String(r.Responsable || '').trim(); if (!k) return;
    const kg = n(r['Kg Recolectados']) + n(r['kg anatomopatologico']) + n(r['kg punzo cortantes']);
    const f = fechaISO_(r['Fecha de Recoleccion']);
    if (!sinActa[k]) sinActa[k] = { operador: k, kg: 0, recibos: 0, desde: f };
    sinActa[k].kg += kg; sinActa[k].recibos++;
    if (f && f < sinActa[k].desde) sinActa[k].desde = f;
  });
  const sa = Object.keys(sinActa).map(k => sinActa[k]).filter(s => s.kg > 0.05)
    .map(s => ({ operador: s.operador, kg: ini_r_(s.kg, 1), recibos: s.recibos, desde: s.desde, dias: s.desde ? ini_diasEntre_(s.desde, hoy) : 0 }))
    .sort((a, b) => b.kg - a.kg);
  const kgSinActa = ini_r_(sa.reduce((s, x) => s + x.kg, 0), 1);
  if (kgSinActa) aten.push({ tipo: 'planta', nivel: 'a', grupo: 'Planta',
    titulo: kgSinActa.toLocaleString('en-US') + ' kg por entregar en planta',
    texto: sa.length === 1 ? 'En el camión de ' + sa[0].operador + ' · sin acta desde el ' + ini_fechaTxt_(sa[0].desde)
                           : sa.length + ' conductores · sin acta todavía',
    accion: 'Ver', datos: { operadores: sa } });

  /* ═══ 4 · INDICADORES ════════════════════════════════════════════ */
  /* rendimiento por tanque lleno: km desde la carga anterior del mismo camión ÷ litros de esta carga */
  const rendCarga = {};
  const porVehCargas = {};
  COM.forEach(c => { const v = normVeh_(c.vehiculo); if (!v || !n(c.kilometraje)) return; (porVehCargas[v] = porVehCargas[v] || []).push(c); });
  Object.keys(porVehCargas).forEach(v => {
    const l = porVehCargas[v].sort((a, b) => n(a.kilometraje) - n(b.kilometraje));
    for (let i = 1; i < l.length; i++) {
      const km = n(l[i].kilometraje) - n(l[i - 1].kilometraje), lt = litrosCarga_(l[i]);
      if (km > 0 && km < 3000 && lt > 0) rendCarga[String(l[i].cargaId || (v + i))] = { km: km, litros: lt };
    }
  });
  const medir = (desde, hasta, detalle) => {
    const m = { kg: 0, kgBio: 0, kgAnatomo: 0, kgPunzo: 0, programadas: 0, hechas: 0, km: 0, jornadas: 0, litros: 0, monto: 0, cargas: 0 };
    const porDia = {}, porCond = {}, porVeh = {}, noHechas = [], cargas = [];
    REC.forEach(r => {
      const f = fechaISO_(r['Fecha de Recoleccion']); if (!f || f < desde || f > hasta) return;
      const kb = n(r['Kg Recolectados']), ka = n(r['kg anatomopatologico']), kp = n(r['kg punzo cortantes']);
      const t = n(r['total Kg']) || (kb + ka + kp);
      m.kg += t; m.kgBio += kb; m.kgAnatomo += ka; m.kgPunzo += kp;
      porDia[f] = (porDia[f] || 0) + t;
    });
    listaRutas.forEach(r => {
      if (r.fecha < desde || r.fecha > hasta) return;
      if (r.fecha === hoy) { const v = vivo.find(x => x.rutaId === r.rutaId); if (!v || ['completa','terminada','cerrada'].indexOf(v.estado) < 0) return; }
      m.programadas += r.total; m.hechas += r.hechas;
      const c = porCond[r.conductor] = porCond[r.conductor] || { conductor: r.conductor, programadas: 0, hechas: 0, km: 0, jornadas: 0 };
      c.programadas += r.total; c.hechas += r.hechas;
      if (detalle) r.paradas.filter(p => !p.hecha).forEach(p => {
        const luego = (PLAN[p.clienteId] || {}).ultimaReal > r.fecha;
        noHechas.push({ fecha: r.fecha, clienteId: p.clienteId, cliente: p.cliente, conductor: r.conductor,
                        motivo: r.motivoCierre || (r.estadoRuta === 'TERMINADA ANTES' ? 'terminó antes' : 'no se hizo'),
                        atendidoDespues: !!luego, programada: !!enRutaDesde[p.clienteId] });
      });
    });
    JOR.forEach(j => {
      const f = fechaISO_(j.fecha); if (!f || f < desde || f > hasta) return;
      const km = n(j.kmRecorridos) || ((n(j.kmFinal) > n(j.kmInicio) && n(j.kmInicio)) ? n(j.kmFinal) - n(j.kmInicio) : 0);
      m.km += km; m.jornadas++;
      const c = porCond[String(j.conductor || '')] = porCond[String(j.conductor || '')] || { conductor: String(j.conductor || ''), programadas: 0, hechas: 0, km: 0, jornadas: 0 };
      c.km += km; c.jornadas++;
      const v = String(j.vehiculo || '—');
      const pv = porVeh[v] = porVeh[v] || { vehiculo: v, km: 0, litros: 0, monto: 0 };
      pv.km += km;
    });
    COM.forEach(c => {
      const f = fechaISO_(c.fecha); if (!f || f < desde || f > hasta) return;
      const l = litrosCarga_(c);
      m.litros += l; m.monto += n(c.monto); m.cargas++;
      const v = String(c.vehiculo || '—');
      const pv = porVeh[v] = porVeh[v] || { vehiculo: v, km: 0, litros: 0, monto: 0, rKm: 0, rL: 0 };
      pv.litros += l; pv.monto += n(c.monto);
      const rc = rendCarga[String(c.cargaId || '')];
      if (rc) { m.rKm = (m.rKm || 0) + rc.km; m.rL = (m.rL || 0) + rc.litros; pv.rKm = (pv.rKm || 0) + rc.km; pv.rL = (pv.rL || 0) + rc.litros; }
      if (detalle) cargas.push({ fecha: f, hora: horaTxt_(c.hora), vehiculo: v, conductor: String(c.conductor || ''),
                                 litros: ini_r_(l, 1), monto: ini_r_(n(c.monto), 2), estacion: String(c.estacion || '') });
    });
    const out = {
      kg: ini_r_(m.kg, 1), programadas: m.programadas, hechas: m.hechas,
      pct: m.programadas ? Math.round(m.hechas / m.programadas * 100) : null,
      km: ini_r_(m.km, 0), jornadas: m.jornadas, litros: ini_r_(m.litros, 1), monto: ini_r_(m.monto, 2), cargas: m.cargas,
      kmL: m.rL ? ini_r_(m.rKm / m.rL, 1) : null,
      costoParada: m.hechas ? ini_r_(m.monto / m.hechas, 2) : null
    };
    if (detalle) {
      out.kgTipo = { bio: ini_r_(m.kgBio, 1), anatomo: ini_r_(m.kgAnatomo, 1), punzo: ini_r_(m.kgPunzo, 1) };
      out.kgDia = Object.keys(porDia).sort().map(f => ({ fecha: f, kg: ini_r_(porDia[f], 1) }));
      out.porConductor = Object.keys(porCond).map(k => porCond[k]).filter(c => c.conductor)
        .map(c => ({ conductor: c.conductor, programadas: c.programadas, hechas: c.hechas,
                     pct: c.programadas ? Math.round(c.hechas / c.programadas * 100) : null, km: ini_r_(c.km, 0), jornadas: c.jornadas }));
      out.porVehiculo = Object.keys(porVeh).map(k => porVeh[k])
        .map(v => ({ vehiculo: v.vehiculo, km: ini_r_(v.km, 0), litros: ini_r_(v.litros, 1), monto: ini_r_(v.monto, 2),
                     kmL: v.rL ? ini_r_(v.rKm / v.rL, 1) : null }));
      out.noHechas = noHechas.sort((a, b) => b.fecha.localeCompare(a.fecha));
      out.cargasLista = cargas.sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
    }
    return out;
  };
  const actual = medir(per.desde, per.hasta, true);
  const anterior = medir(per.pDesde, per.pHasta, false);

  /* api 3.8 · lo que espera en la Bandeja: incidencias, no recolectadas, ubicaciones */
  const band = tab_try_(() => inc_paraAtencion_(), { items: [], n: 0, graves: 0 });
  band.items.forEach(x => aten.push(x));

  /* ═══ 5 · CONTADORES DEL MENÚ ════════════════════════════════════ */
  const orden = { r: 0, a: 1, m: 2, b: 3 };
  const prio = { bloqueo: 0, terminada: 1, horario: 2, vencidos: 3, diaSinRuta: 4, solicitudes: 5, porrevisar: 5, inspecciones: 6, fallas: 7, planta: 8,
                 incidencia: 1.2, norec: 1.6, ubicacion: 6.5 };
  /* una recolección extra «lo antes posible» sube: el cliente está esperando hoy */
  const pr = x => x.tipo === 'solicitudes' && x.nivel === 'r' ? 1.5 : (x.tipo === 'incidencia' && x.nivel === 'r' ? -0.5 : prio[x.tipo]);
  aten.sort((a, b) => (pr(a) - pr(b)) || (orden[a.nivel] - orden[b.nivel]));

  return {
    ok: true, usuario: { nombre: u.nombre, rol: u.rol }, hoy: hoy, hora: ahora,
    fase: fase, terminoA: terminoA, vivo: vivo, totales: tot,
    minParada: minParada, salidaHabitual: ini_hhmm_(minSalida),
    atencion: aten, semana: semana,
    periodo: per, indicadores: { actual: actual, anterior: anterior },
    menu: { porRevisar: porRevisar.total, inspecciones: inspecciones.total, solicitudes: nSol, req: req_preguntas_('logistica'),
            flota: FAL.length, flotaBloqueo: FAL.filter(f => f.bloquea).length,
            clientes: vencidos.length, atencion: aten.length,
            bandeja: nSol + band.n + FAL.filter(f => f.bloquea).length + aten.filter(a => a.tipo === 'terminada').length, incGraves: band.graves },
    libres: libres
  };
}

function api_cambiarCamionRuta(pin, rutaId, vehiculo, nota) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística cambia el camión de una ruta.' };
  const id = String(rutaId || '').trim(), veh = String(vehiculo || '').trim().toUpperCase();
  if (!id || !veh) return { ok: false, error: 'Falta la ruta o el camión.' };
  if (bloqueoVehiculo_(veh).length) return { ok: false, error: veh + ' también está bloqueado.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
    const vals = h.getDataRange().getValues();
    const cab = vals[0].map(String);
    const cId = cab.indexOf('rutaId'), cV = cab.indexOf('vehiculo'), cF = cab.indexOf('fecha');
    let antes = '', fecha = '', k = 0;
    for (let i = 1; i < vals.length; i++) {
      if (String(vals[i][cId]).trim() !== id) continue;
      antes = String(vals[i][cV] || ''); fecha = fechaISO_(vals[i][cF]);
      h.getRange(i + 1, cV + 1).setValue(veh); k++;
    }
    if (!k) return { ok: false, error: 'No encontré esa ruta.' };
    const otra = leerHoja_(HOJA_RUT).find(r => fechaISO_(r.fecha) === fecha && String(r.rutaId) !== id &&
                                              normVeh_(r.vehiculo) === normVeh_(veh));
    marcar_('logistica');
    return { ok: true, rutaId: id, antes: antes, vehiculo: veh,
             aviso: otra ? veh + ' ya tiene otra ruta ese día (' + String(otra.conductor || '') + ').' : '' };
  } finally { lock.releaseLock(); }
}


/* ══════════ Jurisdiccion.gs (copiado tal cual) ══════════ */
function jur_dueno_(u, m) { return !!u && (u.rol === 'admin' || (JUR_DUENOS[m] || []).indexOf(u.rol) >= 0); }

function jur_guard_(u, m, que) {
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (jur_dueno_(u, m)) return null;
  return { ok: false, error: 'No puedes borrar ni anular esto: es de ' + JUR_NOM[m] + '. Solo ' + JUR_NOM[m] + ' o el administrador pueden hacerlo.', jurisdiccion: m };
}

function jur_fila_(vals, i) { const o = {}; vals[0].forEach((c, j) => { const v = vals[i][j]; o[String(c)] = v instanceof Date ? Utilities.formatDate(v, 'America/Panama', 'yyyy-MM-dd HH:mm') : v; }); return o; }

function jur_log_(u, m, accion, ref, detalle, motivo, hoja, datos) {
  try {
    const t = Utilities.formatDate(new Date(), 'America/Panama', 'yyyy-MM-dd HH:mm');
    let d = ''; if (datos !== undefined && datos !== null) { try { d = JSON.stringify(datos); } catch (e) { d = ''; } if (d.length > 45000) d = d.slice(0, 45000) + '…'; }
    crm_agregar_(HOJA_REGB, COLS_REGB, { regId: 'RB-' + new Date().getTime().toString(36).toUpperCase() + Math.floor(Math.random() * 90 + 10),
      fecha: t.slice(0, 10), hora: t.slice(11), quien: u ? u.nombre : '', rol: u ? u.rol : '', modulo: JUR_NOM[m] || m || '', accion: String(accion || ''),
      ref: String(ref || '').slice(0, 80), detalle: String(detalle || '').slice(0, 400), motivo: String(motivo || '').slice(0, 300), hoja: String(hoja || ''), datos: d });
  } catch (e) { /* la constancia no deshace la acción */ }
}

function jur_borrarFilas_(hoja, pred, copia) {
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(hoja);
  if (!h || h.getLastRow() < 2) return 0;
  const vals = h.getDataRange().getValues();
  let n = 0;
  for (let i = vals.length - 1; i >= 1; i--) {
    const o = jur_fila_(vals, i);
    if (pred(o)) { if (copia) copia.push({ hoja: hoja, fila: o }); h.deleteRow(i + 1); n++; }
  }
  return n;
}

