}
const _gooSeg = s => Number(String(s || '0s').replace(/s$/, '')) || 0;
const _gooLL = p => ({ latitude: Number(p.lat), longitude: Number(p.lng) });
/* hora de Panamá (UTC−5 todo el año) */
const _gooT = (f, hm) => f + 'T' + (String(hm).length === 4 ? '0' + hm : hm) + ':00-05:00';
const _gooHM = iso => { if (!iso) return ''; const d = new Date(new Date(iso).getTime() - 5 * 3600000); return String(d.getUTCHours()).padStart(2, '0') + ':' + String(d.getUTCMinutes()).padStart(2, '0'); };
