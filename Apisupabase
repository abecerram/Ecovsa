/* ══════════ Correcciones329.gs (api 3.29) ══════════
 * Corregir un recibo de visita sin perder la historia.
 *
 * Decidido por Álvaro (12 oct 2026, opción D):
 *  · El conductor no edita: «Avisar un error» en su recibo, con el dato correcto.
 *  · Al administrador le llega como pendiente; lo aplica (o lo ajusta) con un
 *    motivo. Solo el administrador corrige, también si el recibo ya está en un
 *    acta o si el cliente ya firmó.
 *  · El motivo se le muestra al cliente en su recibo («Corregido el …»).
 *  · Si el mes ya se facturó, la factura no se toca: Para facturar del mes
 *    original queda como se facturó y la diferencia sale como «Ajuste por
 *    corrección de recibo» (cargo o crédito) en el mes en que se corrigió.
 *  · Queda todo: antes, después, quién, cuándo y por qué (hoja CorreccionesRecibo).
 */
const HOJA_CORR = 'CorreccionesRecibo';
const COLS_CORR = ['corrId', 'recibo', 'registroId', 'cliente', 'fechaRecibo', 'estado',
  'avisoPor', 'avisoEn', 'avisoNota', 'propuesto', 'antes', 'despues', 'motivo',
  'corrigioPor', 'corrigioEn', 'acta', 'firmado', 'facturado', 'enviadoAntes',
  'descartadoPor', 'descartadoEn', 'descartadoNota'];
/* lo que se puede corregir: kilos y bolsas de cada tipo (nada más) */
const CORR_CAMPOS = [
  ['kgBio', 'Kg Recolectados', 'kg'], ['cantBio', 'cantidad bolsas', 'n'],
  ['kgPunzo', 'kg punzo cortantes', 'kg'], ['cantPunzo', 'cantidad punzo cort', 'n'],
  ['kgAnatomo', 'kg anatomopatologico', 'kg'], ['cantAnatomo', 'cantidad anatomo', 'n']
];
const CORR_NOMBRES = { kgBio: 'kg bioinfeccioso', cantBio: 'bolsas', kgPunzo: 'kg punzocortante', cantPunzo: 'envases punzocortantes', kgAnatomo: 'kg anatomopatológico', cantAnatomo: 'bolsas anatomopatológico' };

function corr_t_(v, n) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().slice(0, n || 300); }
function corr_ahora_() { return Utilities.formatDate(new Date(), 'America/Panama', 'yyyy-MM-dd HH:mm'); }
function corr_r2_(v) { return Math.round((Number(v) || 0) * 100) / 100; }
function corr_valores_(fila) {
  const o = {}; CORR_CAMPOS.forEach(c => { o[c[0]] = c[2] === 'kg' ? corr_r2_(fila[c[1]]) : Math.round(Number(fila[c[1]]) || 0); }); return o;
}
function corr_total_(v) { return corr_r2_((Number(v.kgBio) || 0) + (Number(v.kgPunzo) || 0) + (Number(v.kgAnatomo) || 0)); }
function corr_iguales_(a, b) { return CORR_CAMPOS.every(c => Number(a[c[0]]) === Number(b[c[0]])); }
/* limpia lo que manda la pantalla: números, sin negativos, kilos con 2 decimales y bolsas enteras */
function corr_limpiar_(d) {
  d = d || {}; const o = {};
  for (const c of CORR_CAMPOS) {
    const raw = d[c[0]];
    const v = Number(String(raw == null || raw === '' ? 0 : raw).replace(',', '.'));
    if (!isFinite(v) || v < 0) return { error: 'Revise ' + CORR_NOMBRES[c[0]] + ': debe ser un número de 0 en adelante.' };
    if (c[2] === 'kg' && v > 5000) return { error: 'Revise ' + CORR_NOMBRES[c[0]] + ': ' + v + ' kg es demasiado para una visita.' };
    if (c[2] === 'n' && (v > 999 || Math.round(v) !== v)) return { error: 'Revise ' + CORR_NOMBRES[c[0]] + ': debe ser un número entero.' };
    o[c[0]] = c[2] === 'kg' ? corr_r2_(v) : v;
  }
  return { v: o };
}
function corr_json_(s) { if (s && typeof s === 'object') return s; try { return JSON.parse(String(s || '')) || null; } catch (e) { return null; } }
/* la lista de correcciones (vacía si la hoja todavía no existe) */
function corr_lista_() {
  return leerHoja_(HOJA_CORR).map(x => ({
    corrId: corr_t_(x.corrId), recibo: corr_t_(x.recibo), registroId: corr_t_(x.registroId), cliente: corr_t_(x.cliente, 160),
    fechaRecibo: fechaISO_(x.fechaRecibo) || corr_t_(x.fechaRecibo).slice(0, 10), estado: corr_t_(x.estado),
    avisoPor: corr_t_(x.avisoPor), avisoEn: corr_fh_(x.avisoEn), avisoNota: corr_t_(x.avisoNota, 500),
    propuesto: corr_json_(x.propuesto), antes: corr_json_(x.antes), despues: corr_json_(x.despues), motivo: corr_t_(x.motivo, 500),
    corrigioPor: corr_t_(x.corrigioPor), corrigioEn: corr_fh_(x.corrigioEn), acta: corr_t_(x.acta),
    firmado: si313_(x.firmado), facturado: si313_(x.facturado), descartadoPor: corr_t_(x.descartadoPor),
    descartadoEn: corr_fh_(x.descartadoEn), descartadoNota: corr_t_(x.descartadoNota, 500)
  })).filter(x => x.corrId && x.recibo);
}
/* fecha y hora como texto «yyyy-MM-dd HH:mm» (la hoja puede devolverla como fecha) */
function corr_fh_(v) {
  if (v instanceof Date) return Utilities.formatDate(v, 'America/Panama', 'yyyy-MM-dd HH:mm');
  return corr_t_(v).slice(0, 16);
}
function corr_reciboFila_(t, folio) {
  const f = corr_t_(folio);
  return t.filas.filter(r => corr_t_(r['recibo numero']) === f)[0] || null;
}
function corr_esResponsable_(u, fila) {
  return !!u && corr_t_(fila.Responsable).toLowerCase() === corr_t_(u.nombre).toLowerCase();
}
function corr_mesPasado_(fechaIso) { return !!fechaIso && fechaIso.slice(0, 7) < hoyPanama_().slice(0, 7); }
function corr_cambios_(a, b) {
  if (!a || !b) return '';
  return CORR_CAMPOS.filter(c => Number(a[c[0]]) !== Number(b[c[0]]))
    .map(c => CORR_NOMBRES[c[0]] + ' ' + a[c[0]] + ' → ' + b[c[0]]).join(' · ');
}

/* ── El conductor avisa un error en su recibo ── */
function api_enviarAvisoRecibo(pin, folio, datos) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido' };
  const tr = tabla313_(HOJA_REC);
  const fila = corr_reciboFila_(tr, folio);
  if (!fila) return { ok: false, error: 'No encontré el recibo ' + corr_t_(folio) + '.' };
  if (!corr_esResponsable_(u, fila) && !esSupervisor_(u))
    return { ok: false, error: 'Solo quien hizo la visita puede avisar un error en este recibo.' };
  const L = corr_limpiar_(datos && datos.valores);
  if (L.error) return { ok: false, error: L.error };
  const nota = corr_t_(datos && datos.nota, 500);
  const antes = corr_valores_(fila);
  if (corr_iguales_(antes, L.v) && !nota)
    return { ok: false, error: 'Escriba el dato correcto o cuente qué pasó: así como está es igual al recibo.' };

  const t = tabla313_(HOJA_CORR, COLS_CORR);
  const abierto = t.filas.filter(x => corr_t_(x.recibo) === corr_t_(folio) && corr_t_(x.estado) === 'aviso')[0];
  const campos = { avisoPor: u.nombre, avisoEn: "'" + corr_ahora_(), avisoNota: nota, propuesto: L.v, antes: antes };
  if (abierto) actualizar313_(t, abierto._fila, campos);
  else agregar313_(t, Object.assign({
    corrId: 'COR-' + Utilities.formatDate(new Date(), 'America/Panama', 'yyMMddHHmmss') + '-' + Math.floor(Math.random() * 900 + 100),
    recibo: corr_t_(folio), registroId: corr_t_(fila.registroId), cliente: corr_t_(fila.Cliente, 160),
    fechaRecibo: "'" + (fechaISO_(fila['Fecha de Recoleccion']) || ''), estado: 'aviso'
  }, campos));
  marcar_('logistica');
  return { ok: true, actualizado: !!abierto,
    mensaje: 'Listo. El administrador recibe su aviso y corrige el recibo. Usted no tiene que hacer nada más.' };
}

/* ── El administrador corrige (con o sin aviso del conductor) ── */
function api_corregirRecibo(pin, folio, datos) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido' };
  if (!esAdmin_(u)) return { ok: false, error: 'Solo el administrador corrige un recibo.' };
  datos = datos || {};
  const motivo = corr_t_(datos.motivo, 500);
  if (motivo.length < 10) return { ok: false, error: 'Escriba el motivo (lo verá el cliente en su recibo).' };
  const L = corr_limpiar_(datos.valores);
  if (L.error) return { ok: false, error: L.error };

  const tr = tabla313_(HOJA_REC);
  const fila = corr_reciboFila_(tr, folio);
  if (!fila) return { ok: false, error: 'No encontré el recibo ' + corr_t_(folio) + '.' };
  const antes = corr_valores_(fila);
  if (corr_iguales_(antes, L.v))
