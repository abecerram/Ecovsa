    const sid = id.slice(2), ya = t.filas.find(f => sst_t_(f.tipo, 20) === 'persona' && sst_t_(f.estado, 12) !== 'quitado' && sst_json_(f.datos, {}).solidosId === sid);
    if (ya) return { t: t, fila: ya, datos: sst_json_(ya.datos, {}), id: sst_t_(ya.regId, 40) };
    const e = dso_equipo_().find(z => z.personaId === sid);
