function api_guardarTarifario(pin, t) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  t = t || {};
  const n = {}, err = [];
  const tramos = (Array.isArray(t.kg) ? t.kg : []).map(k => ({ hasta: k.hasta === '' || k.hasta == null ? null : cta_n_(k.hasta), precio: cta_r2_(cta_n_(k.precio)) }))
    .sort((a, b) => (a.hasta == null ? 1e12 : a.hasta) - (b.hasta == null ? 1e12 : b.hasta));
  if (!tramos.length || tramos[tramos.length - 1].hasta != null) err.push('El último tramo del kilo debe ser «en adelante» (sin tope).');
  if (tramos.some(k => !(k.precio > 0))) err.push('Cada tramo del kilo necesita su precio.');
  if (tramos.filter(k => k.hasta == null).length > 1) err.push('Solo un tramo puede ir sin tope.');
  n.kg = tramos;
  n.zonas = {};
  TAR_ZONAS.forEach(z => { const v = t.zonas && t.zonas[z]; n.zonas[z] = cta_r2_(cta_n_(v)); if (!(n.zonas[z] >= 0)) err.push('Viaje de ' + z + ' no válido.'); });
  ['kgAdicional', 'recargoKm', 'recargoDesdeKm', 'minimoRuta', 'minimoSolicitud', 'minimoUnica', 'granDesdeKg'].forEach(k => {
    n[k] = cta_r2_(cta_n_(t[k] == null ? tar_()[k] : t[k])); if (n[k] < 0) err.push(k + ' no puede ser negativo.');
  });
  const planes = (Array.isArray(t.planes) ? t.planes : []).map(p => ({ hasta: p.hasta === '' || p.hasta == null ? null : cta_n_(p.hasta), frecuencia: cta_txt_(p.frecuencia, 30).toUpperCase(), visitas: cta_n_(p.visitas) || FREC_VISITAS[cta_txt_(p.frecuencia, 30).toUpperCase()] || 1 }))
    .filter(p => p.frecuencia).sort((a, b) => (a.hasta == null ? 1e12 : a.hasta) - (b.hasta == null ? 1e12 : b.hasta));
  if (!planes.length || planes[planes.length - 1].hasta != null) err.push('La última regla del plan debe ser «en adelante».');
  n.planes = planes;
  n.anatomoSemanal = t.anatomoSemanal !== false;
  n.itbms = 0.07;
  if (err.length) return { ok: false, error: err.join(' ') };
  const antes = tar_();
  const que = [];
  if (JSON.stringify(antes.kg) !== JSON.stringify(n.kg)) que.push('precio del kilo');
  if (JSON.stringify(antes.zonas) !== JSON.stringify(n.zonas)) que.push('viaje por zona');
  ['recargoKm', 'recargoDesdeKm'].forEach(k => { if (antes[k] !== n[k]) que.push('recargo por km'); });
  ['minimoRuta', 'minimoSolicitud', 'minimoUnica'].forEach(k => { if (antes[k] !== n[k]) que.push('mínimos'); });
  if (antes.kgAdicional !== n.kgAdicional) que.push('kilo adicional');
  if (JSON.stringify(antes.planes) !== JSON.stringify(n.planes) || antes.anatomoSemanal !== n.anatomoSemanal) que.push('reglas del plan');
  if (antes.granDesdeKg !== n.granDesdeKg) que.push('cuándo sugerir gran generador');
  if (!que.length && !antes.ejemplo) return { ok: true, sinCambios: true, tarifario: antes };
  tar_poner_('tarifario', n, x.u);
  const h = tar_historial_(); h.push({ cuando: crm_ahora_(), quien: x.u.nombre, que: que.length ? [...new Set(que)].join(', ') : 'guardó los números de ECOVSA' });
  tar_poner_('tarifario historial', h.slice(-80), x.u);
  avisoAdmin313_(x.u, 'Mercadeo cambió las reglas de base', x.u.nombre + ' guardó el tarifario (Planes y tarifas › Reglas de base): ' + (que.length ? [...new Set(que)].join(', ') : 'números de ECOVSA') + '.');   // api 3.13
  return { ok: true, tarifario: tar_() };
}

