function pag_deFactura_(IDX, f) {
  if (!IDX.lista.length) return null;
  const id = String(f.clienteId || '').trim();
  if (id && IDX.porCliente[id]) return IDX.porCliente[id];
  for (const n of [f.cliente, f['razon social']]) {
    const k = cobA_nom_(n); if (!k) continue;
    if (IDX.porNombre[k]) return IDX.porNombre[k];
    const cid = IDX.idPorNom[k]; if (cid && IDX.porCliente[cid]) return IDX.porCliente[cid];
  }
  const r = rucClave_(f.ruc); if (r && IDX.porRuc[r]) return IDX.porRuc[r];
  return null;
}

function pag_mapClave_(IDX, k) {
  if (!IDX.lista.length || !k) return k;
  if (k.charAt(0) === 'R' && IDX.porRuc[k.slice(1)]) return 'P' + IDX.porRuc[k.slice(1)].pagadorId;
  if (k.charAt(0) === 'N' && IDX.porNombre[k.slice(1)]) return 'P' + IDX.porNombre[k.slice(1)].pagadorId;
  return k;
}

function pag_deCliente_(nombre) {
