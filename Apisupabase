}

function api_docsRevisar(pin, archivoId, decision, motivo, datos) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  datos = datos || {};
  const a = arc_filas_().find(z => z.archivoId === String(archivoId) && z.ambito === 'cliente');
  if (!a || a.estado !== 'POR_REVISAR') return { ok: false, error: 'Ese documento ya fue revisado.' };
  const p = arc_prospecto_(a.ref); if (!p) return { ok: false, error: 'No encontré la oportunidad.' };
  const d = ARC_DOCS_CLIENTE.find(z => z[0] === a.doc) || [a.doc, a.doc];
  if (String(decision) === 'rechazar') {
    const m = String(motivo || '').trim();
    if (!m) return { ok: false, error: 'Escribe por qué se rechaza: el cliente lo lee en su enlace.' };
    arc_cambiar_(a.archivoId, { estado: 'RECHAZADO', motivo: m.slice(0, 300), revisadoPor: x.u.nombre, revisadoEn: arc_ahora_(), tamano: 0 });
    Almacen.borrar(a.ruta);
    crm_registrarActividad_(x.u, { tipo: 'nota', ref: a.ref, refTipo: 'op', cuenta: String(p.empresa || ''), texto: 'Rechazó ' + d[1] + ' que subió el cliente: ' + m });
    marcar_('mercadeo');
    return { ok: true, estado: 'RECHAZADO' };
  }
  /* api 3.9: los datos bancarios: solo el banco y los últimos 4 dígitos, nunca el número completo */
  const cambiosPro = {};
  if (a.doc === 'doc datos bancarios') {
    const banco = String(datos.banco || '').trim().slice(0, 60), u4 = String(datos.ult4 || '').replace(/\D/g, '');
    if (!banco || u4.length !== 4) return { ok: false, error: 'Escribe el banco y los últimos 4 dígitos de la cuenta.' };
    cambiosPro['banco pago'] = banco; cambiosPro['cuenta ult4'] = "'" + u4;
  }
  /* lo que Katherine corrigió al compararlo con el documento */
  ARC_DATOS_VERIFICAR.forEach(c => { if (datos[c[0]] !== undefined && String(datos[c[0]]).trim() !== String(p[c[0]] || '').trim()) cambiosPro[c[0]] = String(datos[c[0]]).trim().slice(0, 200); });
  /* aceptar: queda como documento de la oportunidad y marca su casilla */
  arc_cambiar_(a.archivoId, { estado: 'ACEPTADO', revisadoPor: x.u.nombre, revisadoEn: arc_ahora_() });
  const arcId = crm_id_('ARC');
  crm_agregar_(HOJA_CRM_ARC, COLS_CRM_ARC, { id: arcId, nombre: a.nombre, tipo: a.mime, tamano: a.tamano, datos: '', ruta: a.ruta,
                                             subidoPor: 'cliente · aceptó ' + x.u.nombre, subidoEn: crm_ahora_() });
  /* con el mismo nombre de la casilla, para que la pestaña Documentos lo encuentre */
  const nom = (DOCS_PRO.find(z => z[0] === a.doc) || d)[1];
  const previo = crm_filas_(HOJA_CRM_DOC).map(crm_documento_).find(z => z.ref === a.ref && crm_clave_(z.nombre) === crm_clave_(nom));
  api_crmGuardarDocumento(pin, previo
    ? { id: previo.id, archivoId: arcId, nuevaVersion: true, estado: 'aceptada', evento: 'Lo subió el cliente desde su enlace' }
    : { tipo: 'documento', ref: a.ref, refTipo: 'op', cuenta: String(p.empresa || ''), nombre: nom, estado: 'aceptada', archivoId: arcId, evento: 'Lo subió el cliente desde su enlace' });
  /* un documento nuevo no está en el expediente que ya se imprimió: hay que volver a armarlo */
  if (String(p['expediente docs'] || '').trim()) cambiosPro['expediente docs'] = '';
  crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', a.ref, Object.assign({ [a.doc]: 'SI' }, cambiosPro));
  const corr = Object.keys(cambiosPro).filter(k => k !== 'banco pago' && k !== 'cuenta ult4');
  crm_registrarActividad_(x.u, { tipo: 'nota', ref: a.ref, refTipo: 'op', cuenta: String(p.empresa || ''),
    texto: 'Revisó ' + d[1] + ' que subió el cliente: ' + (corr.length ? 'corrigió ' + corr.join(', ') + ' en la ficha' : 'coincide con la ficha') +
           (cambiosPro['banco pago'] ? ' · paga desde ' + cambiosPro['banco pago'] + ' ····' + String(cambiosPro['cuenta ult4']).replace(/^'/, '') : '') + '.' });
  marcar_('mercadeo');
  const p2 = arc_prospecto_(a.ref);
  return { ok: true, estado: 'ACEPTADO', completo: arc_docsCliente_(p2).completo };
}

