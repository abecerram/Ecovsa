function cfgAdmin_(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { error: { ok: false, error: 'PIN no válido', requiereLogin: true } };
  if (u.rol !== 'admin') return { error: { ok: false, error: 'Configuración es solo para el administrador.' } };
  return { u: u };
}

function cfgNombre_(s) {
  return String(s || '').replace(/\s+/g, ' ').trim().toLowerCase()
    .replace(/(^|[\s\-'])([a-záéíóúñü])/g, (m, a, b) => a + b.toUpperCase());
}

function cfgEsPrueba_(n) { return /^prueba\b/i.test(String(n || '').trim()); }

function cfgPinDebil_(p) {
  if (/^(\d)\1+$/.test(p)) return true;                             // 1111
  const d = p.split('').map(Number);
  let sube = true, baja = true;
  for (let i = 1; i < d.length; i++) { if (d[i] !== (d[i - 1] + 1) % 10) sube = false; if (d[i] !== (d[i - 1] + 9) % 10) baja = false; }
  if (sube || baja) return true;                                    // 1234 · 4321
  if (new Set(d).size <= 2) return true;                            // 1212 · 1122
  if (/^(19|20)\d\d$/.test(p)) return true;                         // un año
  return false;
}

function cfgNuevoPin_(largo, filasUsr) {
  const usadas = new Set(filasUsr.map(f => String(f.pin || '').trim()));
  for (let i = 0; i < 500; i++) {
    let p = '';
    for (let j = 0; j < largo; j++) p += String(Math.floor(Math.random() * 10));
    if (cfgPinDebil_(p)) continue;
    const huella = cfgHuella_(p);
    if (usadas.has(huella) || usadas.has(p)) continue;
    return { pin: p, huella: huella };
  }
  throw new Error('No se pudo generar un PIN libre. Intenta otra vez.');
}

function cfgHuella_(p) {
  try { return huellaPin_(p); } catch (e) { return p; }
}

function cfgHojaUsr_() {
