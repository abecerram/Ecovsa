  const v = "'" + JSON.stringify(valor);
  const r = crm_cambiar_(HOJA_CRM_AJU, COLS_CRM_AJU, 'clave', clave, { valor: v, cambiadoPor: u.nombre, cambiadoEn: crm_ahora_() });
  if (!r) crm_agregar_(HOJA_CRM_AJU, COLS_CRM_AJU, { clave: clave, valor: v, cambiadoPor: u.nombre, cambiadoEn: crm_ahora_() });
}

function tar_precioKg_(T, kgMes) {
  const L = (T.kg || []).slice().sort((a, b) => (a.hasta == null ? 1e12 : a.hasta) - (b.hasta == null ? 1e12 : b.hasta));
  let desde = 0;
  for (const x of L) {
    if (x.hasta == null || kgMes <= Number(x.hasta)) return { precio: cta_n_(x.precio), desde: desde, hasta: x.hasta };
    desde = Number(x.hasta);
  }
  const u = L[L.length - 1] || { precio: 0 };
  return { precio: cta_n_(u.precio), desde: desde, hasta: null };
}

function tar_viaje_(T, zona, km) {
  const z = String(zona || '').toUpperCase().trim();
  const base = cta_n_(T.zonas[z] != null ? T.zonas[z] : T.zonas.OTRA);
  const extra = km > cta_n_(T.recargoDesdeKm) ? (km - cta_n_(T.recargoDesdeKm)) * cta_n_(T.recargoKm) : 0;
  return { base: cta_r2_(base), extra: cta_r2_(extra), total: cta_r2_(base + extra) };
}

function tar_plan_(T, kgMes, anatomo) {
  const L = (T.planes || []).slice().sort((a, b) => (a.hasta == null ? 1e12 : a.hasta) - (b.hasta == null ? 1e12 : b.hasta));
  let p = L[L.length - 1] || { frecuencia: 'MENSUAL', visitas: 1 };
  for (const x of L) { if (x.hasta == null || kgMes <= Number(x.hasta)) { p = x; break; } }
  let porque = kgMes ? 'genera ' + cta_r2_(kgMes) + ' kg al mes' : 'sin kilos todavía';
  if (anatomo && T.anatomoSemanal && cta_n_(p.visitas) < 4) { p = { frecuencia: 'SEMANAL', visitas: 4 }; porque += ' · anatomopatológico: semanal'; }
  return { frecuencia: p.frecuencia, visitas: cta_n_(p.visitas), porque: porque };
}

