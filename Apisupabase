function pag_indice_(F) {
  if (_PAGIDX) return _PAGIDX;
  const L = pag_lista_();
  const idx = { lista: L, porId: {}, porCliente: {}, porNombre: {}, porRuc: {} };
  const idPorNom = {};
  (F ? F.lista : leerHoja_(HOJA_CLI).map(c => ({ id: Number(c.id), nombre: String(c.nombre || '') }))).forEach(c => { idPorNom[cobA_nom_(c.nombre)] = String(c.id); });
  L.forEach(p => {
    idx.porId[p.pagadorId] = p;
    p.clienteIds.concat(p.clientesNombres.map(n => idPorNom[cobA_nom_(n)]).filter(Boolean)).forEach(id => { idx.porCliente[String(id)] = p; });
    p.nombresFactura.forEach(n => { const k = cobA_nom_(n); if (k) idx.porNombre[k] = p; });
    if (p.modo === 'consolidada') { const r = rucClave_(p.ruc); if (r) idx.porRuc[r] = p; }
    p.clientes = Object.keys(idx.porCliente).filter(k => idx.porCliente[k] === p);
  });
