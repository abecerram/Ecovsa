    agregar313_(te, { folio: folio, clienteIds: sedes.map(c => String(c.id).trim()).join(','), razonSocial: raz, kit: JSON.stringify((d.kit || PTL_KIT).map(k => ptl_t_(k, 80)).slice(0, 10)), recibe: recibe, cargo: cargo, telefono: "'" + tel,
