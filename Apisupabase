function api_crmGuardarActividad(pin, a) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  a = a || {};
  if (!crm_txt_(a.texto) && !crm_txt_(a.resultado)) return { ok:false, error:'Escribe qué pasó.' };
  if (CRM_TIPOS_ACT.indexOf(crm_txt_(a.tipo)) < 0) return { ok:false, error:'Tipo de actividad no válido.' };
  const act = crm_registrarActividad_(x.u, a);
  let hecha = null, siguiente = null;
  if (crm_txt_(a.tareaId)) {
    hecha = crm_cambiar_(HOJA_CRM_TAR, COLS_CRM_TAR, 'id', crm_txt_(a.tareaId),
      { estado:'hecha', resultado: crm_txt_(a.resultado) || crm_txt_(a.texto), hechaEn: crm_ahora_() });
  }
  if (a.siguiente && crm_txt_(a.siguiente.titulo)) {
    siguiente = crm_crearTarea_(x.u, Object.assign({ ref: act.ref, refTipo: act.refTipo, cuenta: act.cuenta }, a.siguiente));
  }
  if (a.etapa && act.refTipo === 'op') {
    const m = api_crmMoverEtapa(pin, [act.ref], a.etapa, { motivo: a.motivo, silencio: true });
    if (!m.ok) return m;
  }
  crm_sincronizarSeguimiento_(act.ref);
  return { ok:true, actividad: act, tareaHecha: hecha ? crm_tarea_(hecha) : null, siguiente: siguiente };
}

