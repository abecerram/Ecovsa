}
/* Lo que Google contesta, dicho para logística */
function _gooErrorTxt(m) {
  m = String(m || '');
  if (/^GOO_CUENTA:/.test(m)) return 'Google no aceptó la cuenta de servicio (' + m.slice(11) + '). Revisa el secreto GOOGLE_RO_CUENTA en Supabase.';
  if (/^GOO_RED:/.test(m)) return 'No se pudo hablar con Google. Intenta de nuevo en un momento.';
  if (/^GOO_(RESOURCE_EXHAUSTED|429)/.test(m)) return 'Se llegó al tope diario de Google. Mañana vuelve a funcionar; mientras, se calcula en línea recta.';
  if (/^GOO_(PERMISSION_DENIED|403)/.test(m)) {
    if (/not been used|disabled|SERVICE_DISABLED/i.test(m)) return 'Esa API de Google no está activada en el proyecto ECOVSA Rutas. Actívala en APIs y servicios › Biblioteca.';
    if (/API key/i.test(m)) return 'Google no aceptó la clave: revisa que la clave permita Routes API.';
    return 'Google no da permiso: revisa que la cuenta de servicio tenga el rol Route Optimization Editor.';
  }
  if (/^GOO_(UNAUTHENTICATED|401)/.test(m)) return 'Google no reconoció la credencial. Revisa los secretos de Google en Supabase.';
  if (/^GOO_(INVALID_ARGUMENT|400)/.test(m)) return 'Google no pudo calcular con esos datos: ' + m.replace(/^GOO_[A-Z_0-9]+:/, '').slice(0, 160);
  if (/^GOO_(DEADLINE_EXCEEDED|504)/.test(m)) return 'Google tardó demasiado en contestar. Intenta de nuevo.';
