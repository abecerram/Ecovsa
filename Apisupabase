  if (cid) { const c = leerHoja_(HOJA_CLI).find(z => String(z.id) === cid); if (!c) return { ok: false, error: 'No encontré el cliente.' }; nom = crm_clave_(c.nombre); }
  const L = rep_filas_().filter(r => !r.revisado && (rid ? r.repId === rid : (r.clienteId ? r.clienteId === cid : crm_clave_(r.clienteNombre) === nom)));
  if (!L.length) return { ok: true, n: 0 };
  const cuando = crm_ahora_();
  L.forEach(r => crm_cambiar_(HOJA_REP, COLS_REP, 'repId', r.repId, { porRevisar: '', revisadoPor: u.nombre, revisadoEn: cuando }));
