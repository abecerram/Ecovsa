async function cargarHojas(lista, db = sql) {
  const filas = await db`
    select h.nombre, h.columnas,
           case when h.nombre = any(${lista}::text[]) then
             (select coalesce(json_agg(json_build_array(f.id, f.orden, f.datos) order by f.orden, f.id), '[]'::json)
                from public.filas f where f.hoja = h.nombre)
           end as filas
      from public.hojas h`;
  const [p] = await db`
    select (select valor from public.propiedades where clave = 'PIN_PEPPER')   as pepper,
           (select valor from public.propiedades where clave = 'CLAVE_TAREAS') as tareas,
           (select valor from public.meta        where clave = 'version')      as version,
           (select coalesce(json_object_agg(clave, valor), '{}'::json) from public.propiedades
             where clave <> all(${PROPS_INTERNAS}::text[]))                     as props`;
  /* No se toca nada global aquí: otro pedido puede estar trabajando.
     Quien llama instala lo leído con usarLeido_, sin esperas de por medio. */
  return { filas, pepper: p.pepper, tareas: p.tareas, version: p.version, props: p.props || {} };
}
function usarLeido_(l) {
  _LIBRO = new Map(); _EXISTEN = new Map();
  for (const r of l.filas) {
    _EXISTEN.set(r.nombre, r.columnas);
    if (r.filas) _LIBRO.set(r.nombre, new Hoja(r.nombre, r.columnas, r.filas, false));
  }
  _PEPPER = l.pepper; _CLAVE_TAREAS = l.tareas; _VERSION = l.version;
  _CACHE = new Map();
  _PROPS = new Map(Object.entries(l.props).map(([k, v]) => [k, v == null ? null : String(v)]));
  _PROPS_ORIG = JSON.stringify(Object.fromEntries(_PROPS));
}

/* leerHoja_ entrega lo mismo que en Apps Script: una lista de objetos
   { columna: valor }, con '' en las celdas vacías y fechas como Date.
   Lee del libro en memoria, así ve también lo que la misma función ya
   escribió. */
function leerHoja_(nombre) {
  const h = LIBRO_APP.getSheetByName(nombre);
  if (!h || h.getLastRow() < 2) return [];
  const datos = h.getDataRange().getValues();
  const cab = datos.shift().map(String);
  return datos.filter(f => f.some(v => v !== '')).map(f => {
    const o = {}; cab.forEach((c, i) => o[c] = f[i]); return o;
  });
}

/* ── Qué cambió: se compara el libro con lo que se trajo ── */
function cambiosDelLibro_() {
  const c = { hojasNuevas: [], cabeceras: [], borrar: [], actualizar: [], insertar: [], props: [], tocadas: new Set() };
  const antes = JSON.parse(_PROPS_ORIG);
  for (const [k, v] of _PROPS) if (antes[k] !== v) c.props.push({ clave: k, valor: v });
  for (const k of Object.keys(antes)) if (!_PROPS.has(k)) c.props.push({ clave: k, valor: null });
  if (c.props.length) c.tocadas.add('(propiedades)');
  for (const h of _LIBRO.values()) {
    const cab = JSON.stringify(h.cab);
    if (h.nueva) { c.hojasNuevas.push({ nombre: h.nombre, columnas: h.cab }); c.tocadas.add(h.nombre); }
    else if (cab !== h.cabOriginal) { c.cabeceras.push({ nombre: h.nombre, columnas: h.cab }); c.tocadas.add(h.nombre); }
    if (h.borradas.length) { c.borrar.push(...h.borradas); c.tocadas.add(h.nombre); }
    let ultimo = 0;
    for (const f of h.filas) if (f.orden !== null && f.orden > ultimo) ultimo = f.orden;
    for (const f of h.filas) {
      const datos = h._datos(f.v);
      if (f.id) {
        if (datos !== f.orig) { c.actualizar.push({ id: f.id, datos: JSON.parse(datos) }); c.tocadas.add(h.nombre); }
      } else if (datos !== '{}') {
        ultimo += 1;
        c.insertar.push({ hoja: h.nombre, orden: ultimo, datos: JSON.parse(datos) });
        c.tocadas.add(h.nombre);
      }
    }
  }
  return c;
}

/* Aplica los cambios dentro de una transacción ya abierta. */
async function aplicarCambios_(tx, cambios, clave, txt) {
  if (cambios.tocadas.size) {
    let orden = 1000;
    for (const n of cambios.hojasNuevas)
      await tx`insert into public.hojas (nombre, columnas, orden) values (${n.nombre}, ${tx.json(n.columnas)}, ${orden++})`;
    for (const n of cambios.cabeceras)
      await tx`update public.hojas set columnas = ${tx.json(n.columnas)} where nombre = ${n.nombre}`;
    if (cambios.borrar.length)
      await tx`delete from public.filas where id = any(${cambios.borrar}::bigint[])`;
    if (cambios.actualizar.length)
      await tx`update public.filas f set datos = x.datos
                 from jsonb_to_recordset(${tx.json(cambios.actualizar)}) as x(id bigint, datos jsonb)
                where f.id = x.id`;
    if (cambios.insertar.length)
      await tx`insert into public.filas (hoja, orden, datos)
               select x.hoja, x.orden, x.datos
                 from jsonb_to_recordset(${tx.json(cambios.insertar)}) as x(hoja text, orden float8, datos jsonb)`;
    for (const p of cambios.props) {
      if (p.valor === null) await tx`delete from public.propiedades where clave = ${p.clave}`;
      else await tx`insert into public.propiedades (clave, valor) values (${p.clave}, ${p.valor})
                    on conflict (clave) do update set valor = excluded.valor`;
    }
    await tx`update public.meta set valor = (valor::bigint + 1)::text where clave = 'version'`;
    if (cambios.hojasNuevas.length || cambios.cabeceras.length) await tx`select public.refrescar_vistas()`;
  }
  if (clave && txt.startsWith('{"ok":true'))
    await tx`insert into public.idempotencia (id, respuesta) values (${clave}, ${txt}) on conflict (id) do nothing`;
}

/* Primer intento, sin esperar a nadie: si mientras se calculaba otro
   guardó algo, se avisa con Conflicto y se repite en fila (ver atender). */
async function guardarLibro_(cambios, clave, txt, versionLeida) {
  if (!cambios.tocadas.size && !clave) return;
  await sql.begin(async tx => {
    await tx`select pg_advisory_xact_lock(770707)`;
    if (clave) {
      const prev = await tx`select 1 from public.idempotencia where id = ${clave}`;
      if (prev.length) throw new Conflicto();
    }
    if (cambios.tocadas.size) {
      const [v] = await tx`select valor from public.meta where clave = 'version'`;
      if (String(v && v.valor) !== String(versionLeida)) throw new Conflicto();
    }
    await aplicarCambios_(tx, cambios, clave, txt);
  });
}

/* ── PIN cifrado ── */
function huellaPin_(p) {
  if (!_PEPPER) throw new Error('Falta la sal de los PIN en la base (PIN_PEPPER).');
  return createHash('sha256').update(_PEPPER + p, 'utf8').digest('hex');
}

