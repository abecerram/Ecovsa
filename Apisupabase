    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_MTO);
    asegurarColumnas_(h, ['solicitudId']);
    cobA_cambiar_(h, 'mtoId', r.mtoId, { solicitudId: sp });
  }
  marcar_('planta');
  return { ok: true, mtoId: r.mtoId, tareas: r.tareas || 0 };
}

function api_plaCrearEquipo(pin, nombre, conPlan) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['admin', 'supervisor', 'gerente'].indexOf(u.rol) < 0) return { ok: false, error: 'El plan de un equipo lo arma supervisión o administración.' };
  const nom = String(nombre || '').trim();
  if (!nom) return { ok: false, error: 'Falta el nombre del equipo.' };
  const ya = pla_leer_(HOJA_ACT).filter(a => String(a.nombre || '').trim().toUpperCase() === nom.toUpperCase())[0];
  let activoId = ya ? String(ya.activoId) : '';
  if (!activoId) {
    const r = api_guardarActivo(pin, { clase: 'equipo', nombre: nom, responsable: 'Planta', estado: 'Activo', notas: 'Equipo de planta' });
    if (!r || !r.ok) return r;
    activoId = r.activoId;
  }
  let tareas = 0;
  if (conPlan) {
    const previas = pla_leer_(HOJA_PLN).filter(p => String(p.activoId || '').trim() === activoId).map(p => String(p.tarea || '').trim().toUpperCase());
    PLA_PLAN_AUTOCLAVE.forEach(t => {
      if (previas.indexOf(t.tarea.toUpperCase()) >= 0) return;
      const r = api_guardarPlanTarea(pin, { activoId: activoId, tarea: t.tarea, cadaDias: t.cadaDias, notas: t.notas });
      if (r && r.ok) tareas++;
    });
  }
  return { ok: true, activoId: activoId, tareas: tareas };
}


/* ══════════ PlantaB.gs (copiado tal cual) ══════════ */
function api_plaGuardarEquipo(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['admin', 'supervisor', 'gerente'].indexOf(u.rol) < 0) return { ok: false, error: 'El plan de un equipo lo arma supervisión o administración.' };
  d = d || {};
  const nom = String(d.nombre || '').trim();
  if (!nom) return { ok: false, error: 'Falta el nombre del equipo.' };
  let activoId = String(d.activoId || '').trim();
  if (!activoId) {
    const ya = pla_leer_(HOJA_ACT).filter(a => String(a.nombre || '').trim().toUpperCase() === nom.toUpperCase())[0];
    if (ya) activoId = String(ya.activoId);
  }
  const r = api_guardarActivo(pin, { activoId: activoId, clase: 'equipo', nombre: nom, marca: String(d.marca || '').trim().slice(0, 60),
    anio: String(d.anio || '').trim().slice(0, 4), responsable: String(d.responsable || 'Planta').trim().slice(0, 60), estado: 'Activo' });
  if (!r || !r.ok) return r;
  activoId = r.activoId;
  const ha = hojaPlanta_(HOJA_ACT, COLS_ACT);
  cobA_cambiar_(ha, 'activoId', activoId, { modelo: String(d.modelo || '').trim().slice(0, 60), serie: String(d.serie || '').trim().slice(0, 60),
    empresaServicio: String(d.empresaServicio || '').trim().slice(0, 80) });

  const errores = []; let guardadas = 0, quitadas = 0;
  const conCiclos = cuentaCiclos_({ nombre: nom }), ctr = conCiclos ? contadorCiclos_() : 0;
  (d.tareas || []).forEach(t => {
    const pid = String(t.planId || '').trim();
    if (t.quitar) {
      if (!pid) return;
      const hp = hojaPlanta_(HOJA_PLN, COLS_PLN);
      const vals = hp.getDataRange().getValues(), c = vals[0].map(String).indexOf('planId');
      for (let i = vals.length - 1; i >= 1; i--) if (String(vals[i][c]).trim() === pid) { hp.deleteRow(i + 1); quitadas++; break; }
      return;
    }
    if (!String(t.tarea || '').trim()) return;
    /* una tarea nueva por ciclos sin punto de partida arranca del contador de hoy */
    const ult = Number(t.ultimoCiclo) || (conCiclos && Number(t.cadaCiclos) > 0 && !pid ? ctr : '');
    const x = api_guardarPlanTarea(pin, { planId: pid, activoId: activoId, tarea: String(t.tarea).trim(),
      cadaDias: Number(t.cadaDias) || '', cadaCiclos: conCiclos ? (Number(t.cadaCiclos) || '') : '', ultimoCiclo: conCiclos ? ult : '',
      ultimaFecha: t.ultimaFecha || '', notas: String(t.notas || '') });
    if (x && x.ok) guardadas++; else errores.push(String(t.tarea) + ': ' + ((x && x.error) || 'no se pudo'));
  });
  marcar_('planta');
  if (errores.length && !guardadas && !quitadas) return { ok: false, error: errores.join(' · ') };
  return { ok: true, activoId: activoId, guardadas: guardadas, quitadas: quitadas, errores: errores };
}


/* ══════════ Qr.gs (copiado tal cual) ══════════ */
function qr_cliente_(clienteId, codigo) {
  const id = String(clienteId || '').trim();
  const cod = String(codigo || '').trim().toUpperCase();
  if (!id || !cod) return { error: 'Enlace incompleto.' };
  if (codigoCliente_(id) !== cod) return { error: 'Este enlace no es válido.' };
  const c = leerHoja_(HOJA_CLI).find(x => String(x.id).trim() === id);
  if (!c) return { error: 'No encontramos este establecimiento.' };
  return { c: c, id: id, est: estadoServicioQR_(c).estado };
}

function estadoServicioQR_(c) {
  const sit = String(c.situacion || '').trim().toLowerCase();
  const est = String(c.estado || '').trim().toUpperCase();
  if (sit === 'cierre' || sit.indexOf('retiro') >= 0 || est === 'RETIRADO') {
    const f = fechaISO_(c['fecha baja']);
    return { estado: 'baja', desde: f ? mesEnPalabras_(f) : '' };
  }
  if (sit === 'mora' || sit === 'pausa' || est === 'SUSPENDIDO') return { estado: 'apagado', desde: '' };
  return { estado: 'activo', desde: '' };
}

function qr_digitos_(s) { return String(s || '').replace(/\D/g, ''); }

function qr_rucCoincide_(c, escrito) {
  const r = qr_digitos_(c.ruc), e = qr_digitos_(escrito);
  if (r.length < 4 || !e) return false;
  if (e === r) return true;
  const dv = qr_digitos_(c.dv);
  if (dv && e === r + dv) return true;
  /* el DV pegado al final (1 o 2 números) cuando la hoja no lo tiene aparte */
  return e.length > r.length && e.length - r.length <= 2 && e.indexOf(r) === 0;
}

function qr_firma_(id, ruc, vence) {
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,
    'QR-' + String(id) + '|' + qr_digitos_(ruc) + '|' + vence + '|' + claveDistintivo_(),
    Utilities.Charset.UTF_8);
  let s = '';
  for (let i = 0; i < 16; i++) s += ALFA_COD[(bytes[i] + 256) % ALFA_COD.length];
  return s;
}

function qr_llave_(c) {
  const vence = sumarDias_(hoyPanama_(), QR_DIAS_SESION);
  return vence + '.' + qr_firma_(String(c.id).trim(), c.ruc, vence);
}

function qr_llaveValida_(c, llave) {
  const p = String(llave || '').split('.');
  if (p.length !== 2 || !/^\d{4}-\d{2}-\d{2}$/.test(p[0])) return false;
  if (p[0] < hoyPanama_()) return false;
  return p[1] === qr_firma_(String(c.id).trim(), c.ruc, p[0]);
}

function qr_fallos_(id) {
  const v = String(PropertiesService.getScriptProperties().getProperty('QR_FALLOS_' + id) || '');
  const p = v.split('|');
  return p[0] === hoyPanama_() ? (Number(p[1]) || 0) : 0;
}

function qr_sumarFallo_(id) {
  PropertiesService.getScriptProperties()
    .setProperty('QR_FALLOS_' + id, hoyPanama_() + '|' + (qr_fallos_(id) + 1));
}

function api_miServicioEntrar(clienteId, codigo, ruc) {
  const q = qr_cliente_(clienteId, codigo);
  if (q.error) return { ok: false, error: q.error };
  const c = q.c;
  if (qr_digitos_(c.ruc).length < 4)
    return { ok: false, sinRuc: true,
             error: 'Todavía no tenemos registrado el RUC de su empresa. Escríbanos al WhatsApp 6264-1647 y lo activamos.' };
  if (qr_fallos_(q.id) >= QR_MAX_FALLOS_DIA)
    return { ok: false, error: 'Demasiados intentos por hoy. Pruebe de nuevo mañana o escríbanos al WhatsApp 6264-1647.' };
  if (!qr_rucCoincide_(c, ruc)) {
    qr_sumarFallo_(q.id);
    return { ok: false, error: 'Ese RUC no coincide con el de este establecimiento. Escríbalo como aparece en su factura.' };
  }
  return { ok: true, llave: qr_llave_(c), dias: QR_DIAS_SESION };
}

function qr_norm_(s) {
  return String(s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase()
    .replace(/[^A-Z0-9]+/g, ' ').trim();
}

function qr_esDe_(c) {
  const nom = qr_norm_(c.nombre), raz = qr_norm_(c['razon social']);
  const id = String(c.id || '').trim();
  const razUnica = !!raz && leerHoja_(HOJA_CLI).filter(x => qr_norm_(x['razon social']) === raz &&
                     String(x.id || '').trim() !== id).length === 0;
  return function (quien) {
    const q = qr_norm_(quien);
    if (!q) return false;
    if (nom && q === nom) return true;
    if (razUnica && q === raz) return true;
    const m = /^(.*?)\s*\(([^)]*)\)\s*$/.exec(String(quien || ''));
    if (m && nom && qr_norm_(m[2]) === nom) return true;
    if (m && nom && qr_norm_(m[1] + ' ' + m[2]) === nom) return true;
    return false;
  };
}

function qr_recibos_(c) {
  const esDe = qr_esDe_(c);
  const n = v => Number(v) || 0;
  const r2 = v => Math.round(v * 100) / 100;
  const lista = [];
  leerHoja_(HOJA_REC).forEach(r => {
    if (!esDe(r.Cliente)) return;
    const f = fechaISO_(r['Fecha de Recoleccion']);
    if (!f) return;
    const bio = n(r['Kg Recolectados']), punzo = n(r['kg punzo cortantes']), anat = n(r['kg anatomopatologico']);
    lista.push({
      fecha: f, recibo: String(r['recibo numero'] || '').trim(), clave: String(r.clave || '').trim(),
      kg: r2(n(r['total Kg']) || (bio + punzo + anat)),
      kgBio: r2(bio), kgPunzo: r2(punzo), kgAnatomo: r2(anat),
      bolsas: n(r['cantidad bolsas']),
      vehiculo: String(r.vehiculo || ''), conductor: String(r.Responsable || ''),
      acta: String(r.acta || ''), firmante: String(r.firmante || '')
    });
  });
  lista.sort((a, b) => b.fecha.localeCompare(a.fecha) || b.recibo.localeCompare(a.recibo));
  return lista;
}

function qr_certificados_(c) {
  const esDe = qr_esDe_(c);
  return leerHoja_(HOJA_CERT).filter(x => esDe(x.cliente)).map(x => ({
    folio: String(x.folio || '').trim(), emitido: fechaISO_(x.fechaEmision),
    desde: fechaISO_(x.desde), hasta: fechaISO_(x.hasta),
    kg: Math.round((Number(x.totalKg) || 0) * 100) / 100, visitas: Number(x.visitas) || 0
  })).filter(x => x.folio).sort((a, b) => String(b.hasta).localeCompare(String(a.hasta)));
}

function qr_periodos_(recibos, certs) {
  const hoy = hoyPanama_();
  const Y = Number(hoy.slice(0, 4)), M = Number(hoy.slice(5, 7));
  const MES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  const cap = s => s.charAt(0).toUpperCase() + s.slice(1);
  const fin = (y, m) => { const d = new Date(y, m, 0); return y + '-' + ('0' + m).slice(-2) + '-' + ('0' + d.getDate()).slice(-2); };
  const lista = [];
  let y = Y, t = Math.floor((M - 1) / 3);
  for (let i = 0; i < 4; i++) {
    const m1 = t * 3 + 1, m3 = m1 + 2;
    lista.push({ desde: y + '-' + ('0' + m1).slice(-2) + '-01', hasta: fin(y, m3),
                 texto: cap(MES[m1 - 1]) + ' – ' + MES[m3 - 1] + ' ' + y + (i === 0 ? ' (hasta hoy)' : '') });
    t--; if (t < 0) { t = 3; y--; }
  }
  lista.push({ desde: (Y - 1) + '-01-01', hasta: (Y - 1) + '-12-31', texto: 'Año ' + (Y - 1) + ' completo' });
  return lista.map(p => {
    const vis = recibos.filter(r => r.fecha >= p.desde && r.fecha <= p.hasta);
    const cub = vis.length ? certs.find(ct => ct.desde && ct.hasta && ct.desde <= vis[vis.length - 1].fecha && ct.hasta >= vis[0].fecha) : null;
    return { desde: p.desde, hasta: p.hasta, texto: p.texto, visitas: vis.length,
             kg: Math.round(vis.reduce((s, r) => s + r.kg, 0) * 100) / 100,
             folio: cub ? cub.folio : '' };
  });
}

function qr_solicitudes_(id) {
  const EST = { nuevo: 'Recibida', abierto: 'En proceso', enviado: 'En proceso', pospuesto: 'En proceso',
                resuelto: 'Atendida', descartado: 'Cerrada' };
  return leerHoja_(HOJA_PEND).filter(p => {
    const t = String(p.tipo || '');
    if (t !== QR_TIPO_REC && t !== QR_TIPO_CERT) return false;
    try { return String(JSON.parse(String(p.contenido || '{}')).clienteId || '') === id; } catch (e) { return false; }
  }).map(p => {
    let d = {}; try { d = JSON.parse(String(p.contenido || '{}')); } catch (e) { d = {}; }
    const est = String(p.estado || 'nuevo');
    return { folio: String(p.referencia || ''), tipo: String(p.tipo) === QR_TIPO_REC ? 'recoleccion' : 'certificado',
             resumen: String(d.resumen || ''), fecha: fechaISO_(p.fecha),
             estado: EST[est] || 'Recibida', cerrada: ESTADOS_CERRADOS.indexOf(est) >= 0,
             nota: String(p.notaCierre || ''), periodo: String(d.periodoDesde || '') + '|' + String(d.periodoHasta || ''),
             quien: String(d.contacto || '').split(' · ')[0].trim().slice(0, 60) };   // api 3.22
  }).sort((a, b) => String(b.fecha).localeCompare(String(a.fecha)) || b.folio.localeCompare(a.folio)).slice(0, 12);
}

function api_miServicio(clienteId, codigo, llave) {
  const q = qr_cliente_(clienteId, codigo);
  if (q.error) return { ok: false, error: q.error };
  const c = q.c;
  if (!qr_llaveValida_(c, llave)) return { ok: false, salir: true, error: 'Su acceso venció. Escriba de nuevo el RUC.' };

  const recibos = qr_recibos_(c);
  const certs = qr_certificados_(c);
  const acum = { visitas: recibos.length, kg: Math.round(recibos.reduce((s, r) => s + r.kg, 0) * 100) / 100 };
  const sem = semaforoCobro_(String(c.nombre || '').trim(), c['razon social']);
  return { ok: true, hoy: hoyPanama_(),
    establecimiento: String(c.nombre || '').trim(),
    correo: String(c.correo || ''),
    contacto: [String(c.contacto || '').trim(), String(c.telefono || c.whatsapp || '').trim()].filter(Boolean).join(' · '),
    /* solo aquí, dentro de su acceso privado: nunca en la pestaña pública */
    temaAdministrativo: (sem === 'rojo' || sem === 'ambar') && !ptl_prorrogaDe_(c),   // api 3.22: no durante la prórroga
    acumulado: acum,
    recibos: recibos,
    certificados: certs,
    periodos: qr_periodos_(recibos, certs),
    solicitudes: qr_solicitudes_(q.id),
    pideCertificado: !!funciones_().certQR,
    estadoServicio: q.est };
}

function qr_folio_(pref) {
  const base = pref + '-' + hoyPanama_().slice(2, 4) + '-';
  let max = 0;
  leerHoja_(HOJA_PEND).forEach(p => {
    const r = String(p.referencia || '');
    if (r.indexOf(base) === 0) max = Math.max(max, Number(r.slice(base.length)) || 0);
  });
  return base + ('00' + (max + 1)).slice(-3);
}

function qr_txt_(v, n) { return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().slice(0, n || 120); }

function api_pedirDesdeQR(clienteId, codigo, llave, d) {
  const q = qr_cliente_(clienteId, codigo);
  if (q.error) return { ok: false, error: q.error };
  const c = q.c;
  if (!qr_llaveValida_(c, llave)) return { ok: false, salir: true, error: 'Su acceso venció. Escriba de nuevo el RUC.' };
  d = d || {};
  const nombre = String(c.nombre || '').trim();
  const abiertas = qr_solicitudes_(q.id).filter(s => !s.cerrada);
  if (q.est === 'baja') return { ok: false, error: 'Este establecimiento ya no tiene servicio con ECOVSA. Escríbanos al WhatsApp 6264-1647.' };
  if (q.est === 'apagado' && d.tipo === 'recoleccion')
    return { ok: false, error: 'Para coordinar una recolección escríbanos al WhatsApp 6264-1647.' };

  if (d.tipo === 'recoleccion') {
    if (abiertas.some(s => s.tipo === 'recoleccion'))
      return { ok: false, error: 'Ya tiene una recolección extra en camino. Logística le confirma por WhatsApp; si es urgente, escríbanos al 6264-1647.' };
    const motivo = qr_txt_(d.motivo, 60) || 'Sin motivo', cuando = qr_txt_(d.cuando, 60) || 'Lo antes posible';
    const cantidad = qr_txt_(d.cantidad, 40) || 'No sabe', contacto = qr_txt_(d.contacto, 90);
    if (!contacto) return { ok: false, error: 'Escriba a quién llamamos para coordinar.' };
    const folio = qr_folio_('SR');
    const r = anotarPendiente_({
      asistente: 'Página del QR', modulo: 'logistica', prioridad: /antes/i.test(cuando) ? 'alta' : 'media',
      tipo: QR_TIPO_REC, referencia: folio, clave: 'qr:' + folio,
      titulo: 'Recolección extra · ' + nombre,
      descripcion: 'Pedido desde el QR · ' + [cuando, cantidad, motivo, 'Llamar a ' + contacto, folio].join(' · '),
      contenido: JSON.stringify({ clienteId: q.id, resumen: (d.plan ? 'Depósito lleno · ' : 'Recolección extra · ') + cuando, motivo: motivo, cuando: cuando, cantidad: cantidad, contacto: contacto,
        plan: d.plan === 'dentro' || d.plan === 'extra' ? d.plan : '' }),
      enlace: '?cli=' + encodeURIComponent(q.id)
    });
    if (!r.ok) return { ok: false, error: 'No se pudo registrar. Intente de nuevo.' };
    return { ok: true, folio: folio };
  }

  if (d.tipo === 'certificado') {
    /* api 3.10: el administrador puede apagar el pedido de certificados desde el QR */
    if (!funciones_().certQR) return { ok: false, error: 'Para pedir un certificado escríbanos al WhatsApp 6264-1647.' };
    const correo = qr_txt_(d.correo, 90);
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(correo)) return { ok: false, error: 'Escriba un correo válido para enviarle el certificado.' };
    const desde = /^\d{4}-\d{2}-\d{2}$/.test(String(d.desde || '')) ? String(d.desde) : '';
    const hasta = /^\d{4}-\d{2}-\d{2}$/.test(String(d.hasta || '')) ? String(d.hasta) : '';
    const texto = qr_txt_(d.texto, 80) || (desde && hasta ? desde + ' a ' + hasta : '');
    if (!texto) return { ok: false, error: 'Elija el periodo del certificado.' };
    if (abiertas.filter(s => s.tipo === 'certificado').length >= 3)
      return { ok: false, error: 'Ya tiene 3 certificados en trámite. Cuando los atendamos podrá pedir otro.' };
    if (abiertas.some(s => s.tipo === 'certificado' &&
          ((desde && s.periodo === desde + '|' + hasta) ||
           s.resumen.toLowerCase() === ('Certificado · ' + texto).toLowerCase())))
      return { ok: false, error: 'Ese periodo ya está pedido. Mercadeo lo está preparando.' };
    const folio = qr_folio_('SC');
    const r = anotarPendiente_({
      asistente: 'Página del QR', modulo: 'mercadeo', prioridad: 'media',
      tipo: QR_TIPO_CERT, referencia: folio, clave: 'qr:' + folio,
      titulo: 'Certificado pedido · ' + nombre,
      descripcion: 'Pedido desde el QR · Periodo ' + texto + ' · Enviar a ' + correo + ' · ' + folio,
      contenido: JSON.stringify({ clienteId: q.id, resumen: 'Certificado · ' + texto, periodoDesde: desde, periodoHasta: hasta, correo: correo }),
      enlace: '?cli=' + encodeURIComponent(q.id)
    });
    if (!r.ok) return { ok: false, error: 'No se pudo registrar. Intente de nuevo.' };
    return { ok: true, folio: folio };
  }
  return { ok: false, error: 'No se entendió la solicitud.' };
}

function api_miCertificado(clienteId, codigo, llave, folio) {
  const q = qr_cliente_(clienteId, codigo);
  if (q.error) return { ok: false, error: q.error };
  if (!qr_llaveValida_(q.c, llave)) return { ok: false, error: 'Su acceso venció. Vuelva a la página del QR y escriba el RUC.' };
  const fo = String(folio || '').trim().toUpperCase();
  const cert313 = qr_certificados_(q.c).find(x => x.folio.toUpperCase() === fo);
  if (!cert313) return { ok: false, error: 'Ese certificado no corresponde a este establecimiento.' };
  /* api 3.17 · regla de Álvaro: no se entrega el certificado de un periodo que no está pagado */
  if (estadoServicioQR_(q.c).estado === 'apagado' || ptl_certCerrado_(cert313, ptl_facturas_([q.c]), q.c))
    return { ok: false, error: 'Este certificado se libera cuando se confirme el pago del periodo. Escríbanos al WhatsApp 6264-1647.' };
  const c = leerHoja_(HOJA_CERT).find(x => String(x.folio || '').trim().toUpperCase() === fo);
  const n = v => Number(v) || 0;
  const ruc = String(c.ruc || '').trim(), dv = String(c.dv || '').trim();
  const lista = s => String(s || '').split(/\s*[|,]\s*/).filter(Boolean);
  return {
    ok: true, folio: String(c.folio), forzado: false,
    empresa: {
      nombre: String(c.cliente || ''), razonSocial: String(c.razonSocial || c.cliente || ''),
      ruc: ruc || 'SIN RUC', dv: dv,
