/* ══════════ Crm.gs (copiado tal cual) ══════════ */
function crm_n_(v) { const x = Number(String(v === undefined || v === null ? '' : v).replace(/,/g, '')); return isFinite(x) ? x : 0; }

function crm_r_(v, d) { const k = Math.pow(10, d || 0); return Math.round(crm_n_(v) * k) / k; }

function crm_txt_(v) { return v === undefined || v === null ? '' : (v instanceof Date ? fechaISO_(v) : String(v).trim()); }

function crm_dias_(a, b) { return Math.round((new Date(b + 'T12:00:00Z') - new Date(a + 'T12:00:00Z')) / 86400000); }

function crm_masDias_(iso, n) { const d = new Date(iso + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }

function crm_ahora_() { return hoyPanama_() + ' ' + Utilities.formatDate(new Date(), 'America/Panama', 'HH:mm'); }

function crm_id_(pref) { return pref + '-' + Utilities.getUuid().replace(/-/g, '').slice(0, 10).toUpperCase(); }

function crm_clave_(s) { return String(s || '').trim().toUpperCase().replace(/\s+/g, ' '); }

function crm_normal_(s) {
  return String(s || '').toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/\b(S\.?\s?A\.?|INC|CORP|CORPORACION)\b/g, '').replace(/[^A-Z0-9]+/g, ' ').trim();
}

function crm_usuario_(pin, editar) {
  const u = usuarioPorPin_(pin);
  if (!u) return { error: { ok:false, error:'PIN no válido', requiereLogin:true } };
  const roles = editar ? CRM_ROLES_EDITAR : CRM_ROLES_VER;
  if (roles.indexOf(u.rol) < 0) return { error: { ok:false, error: editar && CRM_ROLES_VER.indexOf(u.rol) >= 0
    ? 'Tu usuario consulta mercadeo pero no lo modifica.' : 'Esta pantalla es de mercadeo.' } };
  return { u: u };
}

function crm_hoja_(nombre, cols) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let h = ss.getSheetByName(nombre);
  if (!h) h = crearHoja_(ss, nombre, cols);
  else asegurarColumnas_(h, cols);
  return h;
}

function crm_filas_(nombre) {
  try { return leerHoja_(nombre); } catch (e) { if (e && e.hoja) throw e; return []; }
}

function crm_celda_(v) {
  if (v === undefined || v === null) return '';
  if (typeof v === 'string' && (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}$/.test(v) || /^\d{1,2}:\d{2}$/.test(v))) return "'" + v;
  return v;
}

function crm_agregar_(nombre, cols, obj) {
  const h = crm_hoja_(nombre, cols);
  const cab = h.getRange(1, 1, 1, Math.max(h.getLastColumn(), 1)).getValues()[0].map(String);
  h.appendRow(cab.map(c => crm_celda_(obj[c])));
  return obj;
}

function crm_cambiar_(nombre, cols, clave, valor, cambios) {
  const h = crm_hoja_(nombre, cols);
  const vals = h.getDataRange().getValues();
  const cab = vals[0].map(String);
  const ci = cab.indexOf(clave);
  for (let i = 1; i < vals.length; i++) {
    if (String(vals[i][ci]).trim() !== String(valor).trim()) continue;
    Object.keys(cambios).forEach(k => {
      let c = cab.indexOf(k);
      if (c < 0) { c = cab.length; h.getRange(1, c + 1).setValue(k); cab.push(k); }
      const rg = h.getRange(i + 1, c + 1);
      rg.setValue(crm_celda_(cambios[k]));
      vals[i][c] = rg.getValue();
    });
    const o = {}; cab.forEach((c, j) => o[c] = vals[i][j]); return o;
  }
  return null;
}

function crm_borrarFila_(nombre, cols, clave, valor) {
  const h = crm_hoja_(nombre, cols);
  const vals = h.getDataRange().getValues();
  const ci = vals[0].map(String).indexOf(clave);
  for (let i = vals.length - 1; i >= 1; i--)
    if (String(vals[i][ci]).trim() === String(valor).trim()) { h.deleteRow(i + 1); return true; }
  return false;
}

function crm_ajustes_() {
  const a = JSON.parse(JSON.stringify(CRM_AJUSTES_BASE));
  crm_filas_(HOJA_CRM_AJU).forEach(r => {
    const k = crm_txt_(r.clave); if (!k) return;
    let v = r.valor;
    try { v = JSON.parse(String(r.valor)); } catch (e) { v = r.valor; }
    if (k.indexOf('.') > 0) {           // probabilidades.Firmado
      const [g, s] = [k.slice(0, k.indexOf('.')), k.slice(k.indexOf('.') + 1)];
      if (a[g] && typeof a[g] === 'object' && !Array.isArray(a[g])) a[g][s] = v;
      return;
    }
    a[k] = v;
  });
  return a;
}

function crm_asesores_() {
  return leerHoja_(HOJA_USR)
    .filter(u => String(u.activo || 'SI').toUpperCase() !== 'NO')
    .filter(u => ['mercadeo','supervisor','gerente','admin'].indexOf(String(u.rol || '').toLowerCase().trim()) >= 0)
    .map(u => ({ nombre: String(u.nombre || ''), rol: String(u.rol || '').toLowerCase().trim() }))
    .filter(u => u.nombre);
}

function crm_valor_(p) {
  /* api 3.11: una cuenta de gran generador vale lo que suma su propuesta al mes */
  if (crm_txt_(p.generador).toUpperCase() === 'GRAN') {
    const m = crm_n_(p['valor cotizado']);
    return { valor: crm_r_(m, 2), mensual: crm_r_(m, 2), unico: false, gran: true };
  }
  /* api 3.12: lo cobrado de sus servicios y productos también suma */
  const srv = String(p['servicios json'] || '').trim() ? tab_try_(() => srv_paraOp_(p).total, 0) : 0;
  const costo = crm_n_(p['costo visita']);
  if (esVisitaUnica_(p)) {
    const cant = crm_n_(p.cantidadEstimada) || 1;
    return { valor: crm_r_(costo * cant + srv, 2), mensual: 0, unico: true, servicios: srv };
  }
  const dias = diasDeFrecuencia_(p.frecuencia || p['frecuencia estimada']);
  const porMes = dias ? 30 / dias : 1;
  const m = crm_r_(costo * porMes + srv, 2);
  return { valor: m, mensual: m, unico: false, servicios: srv };
}

function crm_oportunidad_(r, aj, hoy, extra) {
  const o = {};
  COLS_PRO.forEach(k => {
    let v = r[k];
    if (k.indexOf('fecha') === 0 || k === 'inicio recoleccion' || k === 'vencimiento' ||
        k === 'proximo seguimiento' || k === 'cierre esperado' || k === 'retomar') v = fechaISO_(v);
    o[k] = (v === null || v === undefined) ? '' : (v instanceof Date ? fechaISO_(v) : String(v).trim());
  });
  o.tipoServicio = tipoServicioDe_(o);
  o.visitaUnica = esVisitaUnica_(o);
  o.estado = o.estado || 'Registrado';
  /* api 3.12: sus servicios y productos (suman al valor) */
  o['servicios json'] = crm_txt_(r['servicios json']) ? String(r['servicios json']).replace(/^'/, '') : '';
  /* api 3.13: plan y promoción elegidos (la foto completa la trae api_planesParaOportunidad) */
  o.planId = crm_txt_(r.planId); o.promoId = crm_txt_(r.promoId); o.venceOferta = fechaISO_(r.venceOferta) || '';
  /* api 3.11: gran generador (cuenta con varias sedes) */
  o.generador = crm_txt_(r.generador).toUpperCase();
  o.gran = o.generador === 'GRAN';
  if (o.gran) {
    o.cuentaResumen = tab_try_(() => {
      const c = cta_leer_(r); if (!c) return null;
      const sedes = (c.grupos || []).reduce((n, g) => n + (g.sedes || []).length, 0);
      return { sedes: sedes, grupos: (c.grupos || []).length, facturacion: c.facturacion || 'consolidada', paso: c.paso || 0,
               aceptadas: c.aceptadas ? c.aceptadas.length : null, pagadores: (c.pagadores || []).map(x => x.nombre).filter(Boolean) };
    }, null);
  }
  /* api 3.5.1: la llave del enlace del formulario (para subir documentos) */
  try { o.formClave = o.codigoPropuesta ? claveFormulario_(o.codigoPropuesta) : ''; } catch (e) { o.formClave = ''; }
  const vv = crm_valor_(o);
  o.valor = vv.valor; o.valorMensual = vv.mensual;
  o.probabilidad = crm_n_(aj.probabilidades[o.estado]);
  o.ponderado = crm_r_(o.valor * o.probabilidad / 100, 2);
  const inicioEtapa = o['fecha etapa'] || o['fecha propuesta'] || o['fecha contacto'] ||
                      fechaISO_(r.registradoEn) || hoy;
  o.diasEtapa = Math.max(0, crm_dias_(inicioEtapa, hoy));
  o.limiteDias = crm_n_(aj.limitesDias[o.estado]) || 0;
  o.excedido = !!(o.limiteDias && o.diasEtapa > o.limiteDias);
  o.abierta = CRM_GANADAS.concat(CRM_PERDIDAS).indexOf(o.estado) < 0;
  o.ganada = CRM_GANADAS.indexOf(o.estado) >= 0;
  o.perdida = CRM_PERDIDAS.indexOf(o.estado) >= 0;
  o.cierreEsperado = o['cierre esperado'] || '';
  o.fuente = o.fuente || '';
  const docs = docsDe_(o);
  let listos = 0;
  docs.forEach(d => { if (String(o[d[0]]).toUpperCase() === 'SI') listos++; });
  o.docsListos = listos; o.docsTotal = docs.length;
  o.atrasado = !!(o['proximo seguimiento'] && o['proximo seguimiento'] < hoy && o.abierta);
  /* lo que le falta a una captura rápida para dejar de estar «por completar» */
  const faltan = [];
  if (!o.ruc) faltan.push('RUC');
  if (!o.sector) faltan.push('sector');
  if (!o.correo) faltan.push('correo');
  if (!o.contacto) faltan.push('contacto');
  if (!(o.celular || o.telefono)) faltan.push('teléfono');
  if (!o['costo visita'] && !(o.gran && o.valor > 0)) faltan.push('tarifa');
  if (!o.visitaUnica && !o.frecuencia && !o.gran) faltan.push('frecuencia');
  o.faltan = faltan;
  o.porCompletar = o.abierta && faltan.length >= 3;
  if (extra) {
    const t = extra.tareas[o.codigoPropuesta] || [];
    o.proximaTarea = t.length ? t[0] : null;
    o.tareasAbiertas = t.length;
    o.ultimaActividad = extra.ultimas[o.codigoPropuesta] || null;
  }
  return o;
}

function crm_indices_() {
  const tareas = {}, ultimas = {};
  crm_filas_(HOJA_CRM_TAR).forEach(t => {
    if (crm_txt_(t.estado || 'pendiente') !== 'pendiente') return;
    const ref = crm_txt_(t.ref); if (!ref) return;
    (tareas[ref] = tareas[ref] || []).push(crm_tarea_(t));
  });
  Object.keys(tareas).forEach(k => tareas[k].sort((a, b) => (a.fecha || '9999') .localeCompare(b.fecha || '9999') || (a.hora || '').localeCompare(b.hora || '')));
  crm_filas_(HOJA_CRM_ACT).forEach(a => {
    const ref = crm_txt_(a.ref); if (!ref) return;
    const x = crm_actividad_(a);
    const k = x.fecha + ' ' + x.hora;
    if (!ultimas[ref] || k > ultimas[ref]._k) { x._k = k; ultimas[ref] = x; }
  });
  Object.keys(ultimas).forEach(k => delete ultimas[k]._k);
  return { tareas: tareas, ultimas: ultimas };
}

