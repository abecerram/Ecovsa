function sst_t_(v, n) { return String(v == null ? '' : v).replace(/^'/, '').trim().slice(0, n || 400); }
function sst_ahora_() { return cal_ahora_(); }
/* Historial de Seguridad (el mismo de Calidad, marcado SST) */
function sst_his_(u, que, detalle) {
  agregar313_(cal_tab_('his'), { en: "'" + cal_ahora_(), por: u ? u.nombre : 'Sistema', que: cal_t_(que, 120), detalle: cal_t_(detalle, 600), sistema: 'SST' });
