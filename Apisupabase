function cfgPrefs_(f, rol) {
  rol = String(rol || (f && f.rol) || '').toLowerCase().trim();
  const u = { rol: rol };
  const puede = id => permiso_(u, id) !== 'no';
  const ids = CFG_PRINCIPALES.map(m => m.id);
  let pr = String(f && f.moduloPrincipal || '').trim();
  const elegido = ids.indexOf(pr) >= 0 && puede(pr);
  if (!elegido) pr = CFG_PRINCIPAL_ROL[rol] || 'campo';
  if (!puede(pr)) pr = ids.filter(puede)[0] || pr;
  const raw = String(f && f.sigue || '').trim();
  let sigue;
  if (raw === '-') sigue = [];
  else if (raw) sigue = raw.split(/[,\s]+/).filter(x => ids.indexOf(x) >= 0);
  else sigue = (rol === 'admin' || rol === 'gerente') ? ids.slice() : [];
  sigue = sigue.filter((x, i, a) => x !== pr && puede(x) && a.indexOf(x) === i);
  return { principal: pr, elegido: elegido, sigue: sigue, sigueRaw: raw };
}

