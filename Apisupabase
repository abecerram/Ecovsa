/* Anota un hecho del expediente.
   d = { personaId, clave, ... }:
     apt     { res: 'apto'|'restr'|'noapto', fecha, vence, tramite, cita, archivoId }     (permiso de salud)
     hepb    { dosis, de, completa, fecha }                                                (permiso de salud)
     tet     { fecha }                                                                     (permiso de salud)
     cverde / cblanco { vence, tramite, cita, archivoId }
     ind     { fecha, firmada }  */
function api_segHecho(pin, d) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  d = d && typeof d === 'object' ? d : {};
  const clave = String(d.clave || '');
  if (!SST_REQ.some(q => q[0] === clave) || ['cap', 'epp'].indexOf(clave) >= 0) return { ok: false, error: 'Ese dato no se anota así.' };
  const salud = ['apt', 'hepb', 'tet'].indexOf(clave) >= 0;
  if (salud ? !x.p.certificado : !x.puedeEditar) return { ok: false, error: salud ? 'El certificado de buena salud y las vacunas son datos de salud: solo el responsable de SST y el administrador los anotan (Ley 81).' : 'Tu usuario no puede cambiar los expedientes.' };
  const res = sst_personaFila_(d.personaId, x); if (res.e) return res.e;
  const datos = res.datos;
  const hoy = hoyPanama_(), F = k => sst_iso_(d[k]);
  let detalle = '';
  if (clave === 'apt') {
    if (['apto', 'restr', 'noapto'].indexOf(d.res) < 0 && !d.tramite) return { ok: false, error: 'Elija el resultado.' };
    datos.salud = datos.salud || {};
    datos.salud.apt = d.tramite && !d.res ? { tramite: true, cita: F('cita') } : { res: d.res, fecha: F('fecha') || hoy, vence: F('vence'), evaluacion: sst_t_(d.evaluacion, 40), archivoId: sst_t_(d.archivoId, 40) };
    if (datos.salud.apt.res && !datos.salud.apt.vence) return { ok: false, error: 'Escriba cuándo vence.' };
    detalle = 'certificado de buena salud';
  } else if (clave === 'hepb') {
    datos.salud = datos.salud || {};
    const de = Math.max(1, Math.min(6, Number(d.de) || 3)), dosis = Math.max(0, Math.min(de, Number(d.dosis) || 0));
    datos.salud.hepb = { dosis: dosis, de: de, completa: !!d.completa || dosis >= de, fecha: F('fecha') };
    detalle = 'hepatitis B';
  } else if (clave === 'tet') {
    if (!F('fecha')) return { ok: false, error: 'Escriba la fecha de la vacuna.' };
    datos.salud = datos.salud || {};
    datos.salud.tet = { fecha: F('fecha') };
    detalle = 'tétanos';
  } else if (clave === 'cverde' || clave === 'cblanco') {
    datos.carnes = datos.carnes || {};
    if (!F('vence') && !d.tramite) return { ok: false, error: 'Escriba cuándo vence el carné.' };
    datos.carnes[clave] = d.tramite && !F('vence') ? { tramite: true, cita: F('cita') } : { vence: F('vence'), archivoId: sst_t_(d.archivoId, 40) };
    detalle = clave === 'cverde' ? 'carné de salud verde' : 'carné de salud blanco';
  } else if (clave === 'ind') {
    datos.ind = { fecha: F('fecha') || hoy, firmada: d.firmada !== false, origen: 'inducción' };
    detalle = 'inducción';
  }
  sst_personaPoner_(res, datos, x);
  sst_his_(x.u, 'Anotó en el expediente de ' + datos.n, detalle);
  return { ok: true, id: res.id };
}
/* Busca la ficha (creando la enlazada de sólidos si hace falta) */
function sst_personaFila_(id, x) {
