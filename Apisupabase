/* Carga cada tipo solo si todavía no hay ninguno (aunque estén quitados): lo que alguien quitó no vuelve. */
function sst_cargaDatos_(u) {
  const t = sst_tab_(), ahora = "'" + sst_ahora_(), nombres = { iper: 'peligros', legal: 'normas', capplan: 'planes de capacitación', equipo: 'equipos' };
  let n = 0; const partes = [];
  Object.keys(SST_DATOS_BASE).forEach(tipo => {
    if (t.filas.some(f => sst_t_(f.tipo, 20) === tipo)) return;
    const T = SST_TIPOS[tipo];
    SST_DATOS_BASE[tipo].forEach(r => {
      const rid = sst_nuevoId_(tipo, T);
      agregar313_(sst_tab_(), { regId: rid, tipo: tipo, ref: '', datos: JSON.stringify(r), estado: 'activo', creadoPor: u.nombre + ' · carga inicial', creadoEn: ahora, cambiadoPor: u.nombre, cambiadoEn: ahora });
      n++;
    });
    partes.push(SST_DATOS_BASE[tipo].length + ' ' + nombres[tipo]);
  });
  return { n: n, detalle: partes.join(', ') };
}


