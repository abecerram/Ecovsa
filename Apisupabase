const _gooHHMM = m => { m = Math.max(0, Math.round(m)); return String(Math.floor(m / 60) % 24).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0'); };

/* ── trazo por carretera: base → paradas → base, con su polilínea por tramo ── */
async function _gooTrazo(d) {
  const P = d.puntos || [];
  const ll = p => ({ location: { latLng: _gooLL(p) } });
  const j = await _gooPost(GOO_URL_ROUTES + '/directions/v2:computeRoutes',
    { 'X-Goog-Api-Key': GOO_KEY, 'X-Goog-FieldMask': 'routes.distanceMeters,routes.duration,routes.legs.distanceMeters,routes.legs.duration,routes.legs.polyline.encodedPolyline' },
    { origin: ll(P[0]), destination: ll(P[P.length - 1]), intermediates: P.slice(1, -1).map(ll),
      travelMode: 'DRIVE', routingPreference: 'TRAFFIC_UNAWARE', languageCode: 'es-419', units: 'METRIC' });
  const r = (j.routes || [])[0];
  if (!r) throw new Error('GOO_INVALID_ARGUMENT:Google no encontró un camino entre esos puntos');
  const legs = r.legs || [];
  return { fuente: 'google', legs: legs.map(l => (l.polyline && l.polyline.encodedPolyline) || ''),
    /* Google da tiempos de auto: el camión va un 25 % más lento (lo mismo que se le dice al optimizador) */
    tramos: legs.map(l => ({ km: Math.round((l.distanceMeters || 0) / 100) / 10, min: Math.round(_gooSeg(l.duration) * 1.25 / 60) })),
    km: Math.round((r.distanceMeters || 0) / 100) / 10, min: Math.round(_gooSeg(r.duration) * 1.25 / 60) };
}

/* ── optimizar con horarios: un camión, salida fija de la base y regreso a la base ──
   d = { fecha, salida:'HH:MM', base:{lat,lng}, conductor, paradas:[{id,lat,lng,min,hTipo,hDesde,hHasta}],
         planta:{lat,lng,min,desde,hasta,nombre}|null }
   Estricto = ventana dura (puede llegar antes y esperar). Preferencia = ventana suave con costo.
   Cada parada tiene costo por no hacerla: si no cabe, Google la deja fuera y dice por qué. */
function _gooModelo(d, adelanto) {
  const F = d.fecha, sal = _gooMin(d.salida) || 470;
  const visita = (p, min, tipo, desde, hasta) => {
    const vr = { arrivalLocation: _gooLL(p), duration: Math.max(1, Math.round(min || 15)) * 60 + 's' };
    if (desde && hasta && _gooMin(desde) !== null && _gooMin(hasta) !== null) {
      vr.timeWindows = [tipo === 'estricto'
        ? { startTime: _gooT(F, desde), endTime: _gooT(F, hasta) }
        : { softStartTime: _gooT(F, desde), softEndTime: _gooT(F, hasta), costPerHourBeforeSoftStartTime: 60, costPerHourAfterSoftEndTime: 120 }];
    }
    return vr;
  };
  const shipments = (d.paradas || []).map(p => ({ label: String(p.id), pickups: [visita(p, p.min, p.hTipo, p.hDesde, p.hHasta)], penaltyCost: 100000 }));
  if (d.planta) shipments.push({ label: 'PLANTA', pickups: [visita(d.planta, d.planta.min || 30, 'estricto', d.planta.desde, d.planta.hasta)], penaltyCost: 10000000 });
  const ini = adelanto ? sal - adelanto : sal;
  return { timeout: '20s', populateTransitionPolylines: true, considerRoadTraffic: false, label: 'ecovsa ' + F,
    model: { globalStartTime: _gooT(F, '00:00'), globalEndTime: _gooT(F, '23:59'), shipments: shipments,
      vehicles: [{ label: String(d.conductor || 'camion'), startLocation: _gooLL(d.base), endLocation: _gooLL(d.base),
        startTimeWindows: [{ startTime: _gooT(F, _gooHHMM(ini)), endTime: _gooT(F, _gooHHMM(sal)) }],
        travelDurationMultiple: 1.25, costPerKilometer: 1, costPerHour: 30 }] } };
}
function _gooLeerRuta(res, cuerpo) {
  const S = cuerpo.model.shipments, R = (res.routes || [])[0] || {};
  const visits = R.visits || [], tr = R.transitions || [];
  const lab = v => v.shipmentLabel || S[v.shipmentIndex || 0].label;
  const llegadas = {}, esperas = {};
  visits.forEach((v, i) => { const l = lab(v); llegadas[l] = _gooHM(v.startTime); const w = Math.round(_gooSeg(tr[i] && tr[i].waitDuration) / 60); if (w > 0) esperas[l] = w; });
  const metros = (R.metrics && R.metrics.travelDistanceMeters) || tr.reduce((s, t) => s + (Number(t.travelDistanceMeters) || 0), 0);
  const MOT = { CANNOT_BE_PERFORMED_WITHIN_VEHICLE_TIME_WINDOWS: 'no alcanza su horario saliendo a esa hora',
