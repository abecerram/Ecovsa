    const d = { nombre: nombre, beneficios: JSON.stringify(ben.lista), duracionMeses: dur, desde: desde, hasta: hasta,
      planes: planes === 'todos' ? 'todos' : JSON.stringify(planes), cambiadoPor: e.u.nombre, cambiadoEn: ah };
