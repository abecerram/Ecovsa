  };
  dias.filter(editable).forEach(D => {
    let x = pasa(D);
    if (!x.hora && !x.paradas) return;
    const antes = x.c.regreso, antesN = R[D].ids.length;
    const hacia = cfg.permisos.mover === 'solo' ? destinoMover(D) : '';
    const movidos = [];
    for (let k = 0; k < 12 && (x.hora || x.paradas) && hacia; k++) {
      const movibles = R[D].ids.filter(id => !R[D].fijo[id] && !(cfg.nunca.estricto && (X.cli[id] || {}).hTipo === 'estricto'));
