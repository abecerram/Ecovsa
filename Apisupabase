function pla_r2_(v) { return Math.round((Number(v) || 0) * 100) / 100; }

function pla_leer_(n) { try { return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n) ? leerHoja_(n) : []; } catch (e) { return []; } }

function api_plaBase(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!puedeVer_(u, 'planta')) return { ok: false, error: 'Tu usuario no entra a Planta. Avísale al administrador.' };
  const hoy = hoyPanama_();
  const anio = hoy.slice(0, 4);

  const tra = api_tratamiento(pin, '', '');
  const sal = api_salidas(pin, '', '');
  const act = api_plantaActas(pin, '', '');
  const con = api_consumibles(pin, anio + '-01-01', hoy);
  const mto = api_mantenimiento(pin);
  let activos = { activos: [] };
  try { activos = api_activos(pin); } catch (e) { activos = { activos: [] }; }
  if (!activos || !activos.ok) activos = { activos: [] };

  /* ── lo que Logística recogió y no ha llegado con acta ── */
  let sinActa = 0, kgSinActa = 0, masVieja = '';
  const n = v => Number(v) || 0;
  pla_leer_(HOJA_REC).forEach(r => {
    if (String(r.acta || '').trim()) return;
    const f = fechaISO_(r['Fecha de Recoleccion']); if (!f) return;
    const kg = n(r['Kg Recolectados']) + n(r['kg anatomopatologico']) + n(r['kg punzo cortantes']);
    if (!(kg > 0)) return;
    sinActa++; kgSinActa += kg;
    if (!masVieja || f < masVieja) masVieja = f;
  });

  /* ── balance mes a mes (año en curso y el anterior) ── */
  const meses = {};
  const mes = m => (meses[m] = meses[m] || { mes: m, recibido: 0, tratado: 0, despachado: 0, actas: 0, ciclos: 0, despachos: 0 });
  (act.actas || []).forEach(a => { const x = mes(a.fecha.slice(0, 7)); x.recibido += n(a.kgTotal); x.actas++; });
  (tra.ciclos || []).forEach(c => { if (c.anulado || c.esPrueba) return; const x = mes(c.fecha.slice(0, 7)); x.ciclos++; if (!c.sinPeso) x.tratado += n(c.kgEntrada); });
  (sal.salidas || []).forEach(s => { const x = mes(s.fecha.slice(0, 7)); x.despachado += n(s.kgPlanta); x.despachos++; });
  const balance = Object.keys(meses).sort().map(k => { const x = meses[k]; x.recibido = pla_r2_(x.recibido); x.tratado = pla_r2_(x.tratado); x.despachado = pla_r2_(x.despachado); return x; });

  /* ── verificación biológica ── */
  const bio = pla_leer_(HOJA_BIO).map(b => ({
    bioId: String(b.bioId || ''), mes: String(b.mes || '').slice(0, 7), cicloId: String(b.cicloId || ''), fecha: fechaISO_(b.fecha),
    lote: String(b.lote || ''), inicioIncubacion: String(b.inicioIncubacion instanceof Date ? Utilities.formatDate(b.inicioIncubacion, tzHoja_(), 'yyyy-MM-dd HH:mm') : (b.inicioIncubacion || '')),
    lectura: String(b.lectura instanceof Date ? Utilities.formatDate(b.lectura, tzHoja_(), 'yyyy-MM-dd HH:mm') : (b.lectura || '')),
    resultado: String(b.resultado || ''), control: String(b.control || ''), observaciones: String(b.observaciones || ''), registradoPor: String(b.registradoPor || '')
  })).filter(b => b.bioId);

  /* ── solicitudes de pago que parecen servicios de equipos y no están anotadas ── */
  const anotadas = {};
  pla_leer_(HOJA_MTO).forEach(m => { const s = String(m.solicitudId || '').trim(); if (s) anotadas[s] = String(m.mtoId || ''); });
  const spEquipos = pla_leer_('SolicitudesPago').filter(s => {
    const est = String(s.estado || '').toUpperCase();
    if (est === 'ANULADA' || est === 'RECHAZADA') return false;
    const t = (String(s.concepto || '') + ' ' + String(s.observaciones || '')).toLowerCase();
    return /autoclave|caldera|calibra|hermetic|triturador|planta el[eé]ctrica|b[aá]scula|hidrolavadora/.test(t);
  }).map(s => ({
    solicitudId: String(s.solicitudId || ''), numero: String(s.numero || s.solicitudId || ''), fecha: fechaISO_(s.fecha || s.fechaSolicitud),
    proveedor: String(s.proveedor || ''), total: pla_r2_(s.total), concepto: String(s.concepto || '').slice(0, 200), estado: String(s.estado || ''),
    servicio: anotadas[String(s.solicitudId || '')] || anotadas[String(s.numero || '')] || ''
  })).sort((a, b) => a.fecha < b.fecha ? 1 : -1);

  const equipos = (activos.activos || []).filter(a => a.clase !== 'vehiculo');
  /* api 3.5.3: los servicios de los camiones (Logística › Mantenimiento) caen en la misma hoja; aquí solo los de planta */
  const esCamion = {};
  (activos.activos || []).filter(a => a.clase === 'vehiculo').forEach(a => { [a.placa, a.nombre].forEach(x => { if (x) esCamion[String(x).trim().toUpperCase()] = 1; }); });
  try { vehiculosFlota_().forEach(v => { esCamion[String(v.placa).trim().toUpperCase()] = 1; }); } catch (e) {}
  if (mto.ok) mto.mantenimientos = (mto.mantenimientos || []).filter(s => !esCamion[String(s.equipo || '').trim().toUpperCase()] && !/^[A-Z]{2}-?\d{3,5}$/.test(String(s.equipo || '').trim().toUpperCase()));

  return {
    ok: true, usuario: u, hoy: hoy, permiso: puedeTrabajar_(u, 'planta') ? 'trabaja' : 've',
    puedeActivos: ['admin', 'supervisor', 'gerente'].indexOf(u.rol) >= 0,
    /* api 3.5.3: el contador de ciclos del autoclave (del último ciclo registrado) y las requisiciones con pregunta */
    contadorCiclos: contadorCiclos_(), reqPreguntas: req_preguntas_('planta'),
    receta: RECETA_AUTOCLAVE, margen: MARGEN_CARGA, siguienteNumero: tra.siguienteNumero || 1,
    tratamiento: tra.ok ? { totales: tra.totales, ciclos: tra.ciclos, pendientes: tra.pendientes, kgPorDespachar: tra.kgPorDespachar,
                            sinQuimico: tra.sinQuimico, bioDelMes: tra.bioDelMes, tocaBiologica: tra.tocaBiologica } : null,
    salidas: sal.ok ? { salidas: sal.salidas, totales: sal.totales, siguienteId: sal.siguienteId, destinos: sal.destinos, vehiculos: sal.vehiculos } : null,
    actas: act.ok ? { actas: act.actas, generadores: act.generadores } : null,
    consumibles: con.ok ? { consumos: con.consumos, articulos: con.articulos } : null,
    mantenimiento: mto.ok ? { servicios: mto.mantenimientos, alertas: mto.alertas, equiposBase: mto.equipos, tipos: mto.tipos } : null,
    equipos: equipos, planSugerido: PLA_PLAN_AUTOCLAVE, spEquipos: spEquipos,
    sinActa: { recolecciones: sinActa, kg: pla_r2_(kgSinActa), masVieja: masVieja, dias: masVieja ? Math.round((new Date(hoy + 'T12:00:00') - new Date(masVieja + 'T12:00:00')) / 86400000) : 0 },
    balance: balance, bio: bio, bioDesde: PLA_BIO_DESDE
  };
}

function api_plaGuardarBio(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!puedeTrabajar_(u, 'planta')) return { ok: false, error: 'Sin permiso.' };
  d = d || {};
  const cicloId = String(d.cicloId || '').trim();
  const ciclo = pla_leer_(HOJA_CIC).filter(c => String(c.cicloId || '').trim() === cicloId)[0];
  if (!ciclo) return { ok: false, error: 'Elige el ciclo en que se puso el vial.' };
  if (String(ciclo.anulado || '').toUpperCase() === 'SI') return { ok: false, error: 'Ese ciclo está anulado.' };
  const lote = String(d.lote || '').trim();
  if (!lote) return { ok: false, error: 'Escribe el lote del vial (viene en el empaque).' };
  const res = String(d.resultado || 'PENDIENTE').toUpperCase();
  if (['PENDIENTE', 'CONFORME', 'NO CONFORME'].indexOf(res) < 0) return { ok: false, error: 'Resultado no válido.' };
  if (res !== 'PENDIENTE' && !d.controlValido) return { ok: false, error: 'Sin el vial de control creciendo, la prueba no es válida: repítela.' };
  const fechaCiclo = fechaISO_(ciclo.fecha);
  const h = cobA_hoja_(HOJA_BIO, COLS_BIO);
  const previa = pla_leer_(HOJA_BIO).filter(b => String(b.cicloId || '').trim() === cicloId)[0];
  const obj = {
    mes: fechaCiclo.slice(0, 7), cicloId: cicloId, fecha: fechaCiclo, lote: lote, inicioIncubacion: String(d.inicioIncubacion || ''),
    lectura: res === 'PENDIENTE' ? '' : Utilities.formatDate(new Date(), tzHoja_(), 'yyyy-MM-dd HH:mm'), resultado: res,
    control: d.controlValido ? 'VÁLIDO' : '', observaciones: String(d.observaciones || '').slice(0, 500), registradoPor: u.nombre, registradoEn: new Date()
  };
  let bioId;
  if (previa) { bioId = String(previa.bioId); cobA_cambiar_(h, 'bioId', bioId, obj); }
  else { bioId = 'BIO-' + fechaCiclo.slice(0, 7); obj.bioId = bioId; cobA_agregar_(h, obj); }
  /* en el ciclo: lo que lee el manifiesto */
  const hc = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_CIC);
  cobA_cambiar_(hc, 'cicloId', cicloId, { verifBiologica: 'SI', resultadoBiologico: res === 'PENDIENTE' ? 'En incubación' : (res === 'CONFORME' ? 'Sin crecimiento · conforme' : 'Con crecimiento · NO CONFORME') });
  marcar_('planta');
  return { ok: true, bioId: bioId, noConforme: res === 'NO CONFORME' };
}

function api_plaServicio(pin, d) {
