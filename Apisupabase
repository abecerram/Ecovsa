function map_llOk_(la, ln) { la = Number(la); ln = Number(ln); return isFinite(la) && isFinite(ln) && la > 7 && la < 10 && ln > -83.5 && ln < -77; }

function map_r6_(n) { return Math.round(Number(n) * 1e6) / 1e6; }

function map_ahora_() { return Utilities.formatDate(new Date(), 'America/Panama', 'yyyy-MM-dd HH:mm'); }

function map_cfgPoner_(k, v, u) {
  const h = hojaPlanta_(HOJA_CFGL, COLS_CFGL);
  const vals = h.getDataRange().getValues(), cab = vals[0].map(String);
  const cK = cab.indexOf('clave'), cV = cab.indexOf('valor'), cP = cab.indexOf('por'), cE = cab.indexOf('en');
  for (let i = 1; i < vals.length; i++) if (String(vals[i][cK]) === k) {
    h.getRange(i + 1, cV + 1).setValue(v); h.getRange(i + 1, cP + 1).setValue(u ? u.nombre : ''); h.getRange(i + 1, cE + 1).setValue(new Date()); return;
  }
  h.appendRow(filaPorNombre_(h, { clave: k, valor: v, por: u ? u.nombre : '', en: new Date() }));
}

function map_uso_(cfg) {
  cfg = cfg || cfgLog_();
  let u = {}; try { u = JSON.parse(String(cfg['google:' + hoyPanama_()] || '{}')) || {}; } catch (e) { u = {}; }
  return { trazo: Number(u.t) || 0, optimizar: Number(u.o) || 0 };
}

function map_contar_(tipo, u) {
  const x = map_uso_();
  const o = { t: x.trazo + (tipo === 't' ? 1 : 0), o: x.optimizar + (tipo === 'o' ? 1 : 0) };
  map_cfgPoner_('google:' + hoyPanama_(), JSON.stringify(o), u);
  return o;
}

function map_google_(cfg) {
  const uso = map_uso_(cfg);
  return { rutas: Google.rutasListo(), optimizar: Google.optimizarListo(), cuentaIlegible: Google.cuentaIlegible(),
           topeTrazo: MAPA_TOPE_TRAZO, topeOptimizar: MAPA_TOPE_OPT, usoTrazo: uso.trazo, usoOptimizar: uso.optimizar };
}

function destinos_(cfg) {
  cfg = cfg || cfgLog_();
  let l = []; try { l = JSON.parse(String(cfg.destinos || '[]')) || []; } catch (e) { l = []; }
  return l.filter(d => d && d.id && d.nombre);
}

function destino_(id, cfg) { return destinos_(cfg).find(d => String(d.id) === String(id)) || null; }

function api_guardarDestinos(pin, lista) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Los destinos los maneja logística.' };
  const out = [], vistos = {};
  let n = 0; destinos_().forEach(d => { const k = Number(String(d.id).replace(/\D/g, '')) || 0; if (k > n) n = k; });
  for (const d of (lista || [])) {
    const nombre = String(d.nombre || '').trim().slice(0, 80);
    if (!nombre) continue;
    if (!map_llOk_(d.lat, d.lng)) return { ok: false, error: 'La ubicación de «' + nombre + '» no está en Panamá. Pega el enlace del mapa o «lat, lng».' };
    if (!horaValida_(d.desde) || !horaValida_(d.hasta)) return { ok: false, error: 'Revisa el horario de recepción de «' + nombre + '».' };
    if (d.desde >= d.hasta) return { ok: false, error: 'En «' + nombre + '» la hora de cierre tiene que ser después de la de apertura.' };
    const min = Number(d.minutos);
    if (!(min >= 5 && min <= 240)) return { ok: false, error: 'Los minutos de entrega de «' + nombre + '» van de 5 a 240.' };
    let id = String(d.id || '').trim(); if (!id || vistos[id]) id = 'D' + (++n);
    vistos[id] = 1;
    out.push({ id: id, nombre: nombre, tipo: d.tipo === 'socio' ? 'socio' : 'propia', lat: map_r6_(d.lat), lng: map_r6_(d.lng),
               desde: String(d.desde), hasta: String(d.hasta), minutos: min, direccion: String(d.direccion || '').trim().slice(0, 160) });
  }
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try { map_cfgPoner_('destinos', JSON.stringify(out), u); } finally { lock.releaseLock(); }
  marcar_('logistica');
  return { ok: true, destinos: out };
}

function rinf_leer_() {
  const m = {};
  cobA_leer_(HOJA_RINF).forEach(r => { const id = String(r.rutaId || '').trim(); if (id) m[id] = r; });
  return m;
}

function rinf_obj_(r, cfg) {
  if (!r) return { tipo: 'recoleccion', destinoId: '', destino: null, plantaPos: null, trazo: null };
  let tz = null; try { tz = r.trazo ? JSON.parse(String(r.trazo)) : null; } catch (e) { tz = null; }
  const tipo = String(r.tipo || '') === 'planta' ? 'planta' : 'recoleccion';
  const pp = String(r.plantaPos === undefined ? '' : r.plantaPos).trim();
  return { tipo: tipo, destinoId: String(r.destinoId || ''), destino: tipo === 'planta' ? destino_(r.destinoId, cfg) : null,
           plantaPos: tipo === 'planta' && pp !== '' ? Number(pp) : null,
           trazo: tz && tz.legs ? { legs: tz.legs, tramos: tz.tramos || [], km: Number(r.trazoKm) || null, min: Number(r.trazoMin) || null,
                                   firma: String(r.trazoFirma || ''), fuente: String(r.trazoFuente || '') } : null };
}

/* api 3.34: el recorrido real (el orden en que de verdad se hicieron las paradas), guardado una sola vez */
function rinf_recorrido_(r) {
  if (!r) return null;
  let rr = null; try { rr = r.recorrido ? JSON.parse(String(r.recorrido)) : null; } catch (e) { rr = null; }
  return rr && rr.legs && rr.legs.length ? { legs: rr.legs, km: Number(r.recorridoKm) || null, min: Number(r.recorridoMin) || null,
                                             firma: String(r.recorridoFirma || '') } : null;
}

function rinf_guardar_(rutaId, datos) {
  const h = cobA_hoja_(HOJA_RINF, COLS_RINF);
  if (!cobA_cambiar_(h, 'rutaId', rutaId, datos)) cobA_agregar_(h, Object.assign({ rutaId: rutaId }, datos));
}

function rinf_borrar_(rutaId) {
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RINF); if (!h) return;
  const vals = h.getDataRange().getValues(), c = vals[0].map(String).indexOf('rutaId');
  for (let i = vals.length - 1; i >= 1; i--) if (String(vals[i][c]) === String(rutaId)) h.deleteRow(i + 1);
}

function map_conInfo_(rutas, F, cfg) {
  cfg = cfg || cfgLog_();
  const I = rinf_leer_();
  const out = rutas.map(r => Object.assign(r, rinf_obj_(I[r.rutaId], cfg)));
  Object.keys(I).forEach(id => {
    const x = I[id];
    if (fechaISO_(x.fecha) !== F || out.some(r => r.rutaId === id) || String(x.tipo) !== 'planta') return;
    out.push(Object.assign({ rutaId: id, fecha: F, conductor: String(x.conductor || ''), vehiculo: String(x.vehiculo || ''),
      estadoPlan: String(x.estadoPlan || '') === 'borrador' ? 'borrador' : 'publicada', estadoRuta: '', motivoCierre: '',
      horaSalida: horaTxt_(x.horaSalida), regresoMin: Number(x.regresoMin) || null, creadaPor: String(x.por || ''), creadaEn: '', publicadaPor: String(x.por || ''), publicadaEn: '', paradas: [] },
      rinf_obj_(x, cfg)));
  });
  return out;
}

function map_acopio_() {
  try {
    const hoy = hoyPanama_();
    const lim = (function () { const d = new Date(hoy + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() - DL_DIAS_VIEJO); return d.toISOString().slice(0, 10); })();
    const l = dl_rec_().filter(r => !String(r.acta || '').trim() && r._f <= hoy && r._f >= lim);
    const dias = l.map(r => r._f).sort();
    return { kg: dl_r_(l.reduce((s, r) => s + dl_kg_(r), 0)), recibos: l.length, desde: dias[0] || '' };
  } catch (e) { return { kg: 0, recibos: 0, desde: '' }; }
}

function api_mapaTrazo(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  d = d || {};
  const P = (d.puntos || []).map(p => ({ lat: Number(p.lat), lng: Number(p.lng) }));
  if (P.length < 2) return { ok: false, error: 'Hacen falta al menos dos puntos.' };
  if (P.length > 27) return { ok: false, error: 'Google traza hasta 25 paradas por ruta. Divide la ruta.' };
  if (P.some(p => !map_llOk_(p.lat, p.lng))) return { ok: false, error: 'Hay un punto fuera de Panamá: revisa las ubicaciones.' };
  const cfg = cfgLog_(), g = map_google_(cfg);
  if (!g.rutas) return { ok: true, conectado: false, google: g };
  if (g.usoTrazo >= MAPA_TOPE_TRAZO) return { ok: true, conectado: true, tope: true, google: g,
    aviso: 'Hoy ya se pidieron ' + g.usoTrazo + ' trazos a Google (el tope es ' + MAPA_TOPE_TRAZO + '). Mañana vuelve; mientras, en línea recta.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try { map_contar_('t', u); } finally { lock.releaseLock(); }
  g.usoTrazo++;
  return { ok: true, conectado: true, google: g, trazo: Google.trazo({ puntos: P }) };
}

function api_mapaOptimizar(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  d = d || {};
  const cfg = cfgLog_(), g = map_google_(cfg);
  const F = /^\d{4}-\d{2}-\d{2}$/.test(String(d.fecha || '')) ? String(d.fecha) : hoyPanama_();
  if (!map_llOk_(cfg.baseLat, cfg.baseLng)) return { ok: false, error: 'Falta fijar la base en ⚙ del planificador: de ahí sale y ahí vuelve el camión.' };
  if (!horaValida_(d.salida)) return { ok: false, error: 'Falta la hora de salida.' };
  const par = (d.paradas || []).filter(p => map_llOk_(p.lat, p.lng)).slice(0, 60).map(p => ({
    id: String(p.id), lat: Number(p.lat), lng: Number(p.lng), min: Math.max(3, Math.min(240, Number(p.min) || MIN_SITIO_BASE)),
    hTipo: String(p.hTipo || '') === 'estricto' ? 'estricto' : (p.hTipo ? 'preferencia' : ''),
    hDesde: horaValida_(p.hDesde) ? String(p.hDesde) : '', hHasta: horaValida_(p.hHasta) ? String(p.hHasta) : '' }));
  const dst = d.destinoId ? destino_(d.destinoId, cfg) : null;
  if (d.destinoId && !dst) return { ok: false, error: 'Ese destino ya no está en la lista.' };
  if (par.length + (dst ? 1 : 0) < 2) return { ok: false, error: 'Hacen falta al menos dos paradas con ubicación.' };
  if (!g.optimizar) return { ok: true, conectado: false, google: g };
  if (g.usoOptimizar >= MAPA_TOPE_OPT) return { ok: true, conectado: true, tope: true, google: g,
    aviso: 'Hoy ya se optimizó ' + g.usoOptimizar + ' veces con Google (el tope es ' + MAPA_TOPE_OPT + '). Mañana vuelve; mientras, se optimiza aquí en línea recta.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try { map_contar_('o', u); } finally { lock.releaseLock(); }
  g.usoOptimizar++;
  return { ok: true, conectado: true, google: g, res: Google.optimizar({
    fecha: F, salida: String(d.salida), conductor: String(d.conductor || ''), base: { lat: Number(cfg.baseLat), lng: Number(cfg.baseLng) },
    paradas: par, sinAdelanto: !!d.sinAdelanto,
    planta: dst ? { lat: dst.lat, lng: dst.lng, min: dst.minutos, desde: dst.desde, hasta: dst.hasta, nombre: dst.nombre } : null }) };
}

function map_estadoCli_(pl, hoy) {
  if (!pl || !pl.activo || pl.pausada) return 'fuera';
  if (!pl.visitas && !pl.ultima) return 'nuevo';
  if (!pl.proxima) return 'aldia';
  if (pl.proxima < hoy) return 'atrasado';
  return ini_diasEntre_(hoy, pl.proxima) <= 7 ? 'semana' : 'aldia';
}

function api_mapaDia(pin, fecha) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'Solo logística.' };
  const hoy = hoyPanama_();
  const F = /^\d{4}-\d{2}-\d{2}$/.test(String(fecha || '')) ? String(fecha) : hoy;
  const cfg = cfgLog_();
  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC);
  const P = cli_plan_(CLI, REC, hoy);
  const porId = {}; CLI.forEach(c => porId[Number(c.id)] = c);
  const kgDe = r => Number(r['total Kg']) || (Number(r['Kg Recolectados']) || 0) + (Number(r['kg anatomopatologico']) || 0) + (Number(r['kg punzo cortantes']) || 0);
  const rutas = map_conInfo_(plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.fecha === F && r.estadoPlan === 'publicada'), F, cfg)
    .filter(r => r.estadoPlan === 'publicada')
    .map((r, k) => {
      const par = r.paradas.map(p => {
        const c = porId[p.clienteId] || {}, v = (P.idx.visitas[p.clienteId] || []).filter(x => fechaISO_(x['Fecha de Recoleccion']) === F)[0];
        return { clienteId: p.clienteId, nombre: String(c.nombre || ('Cliente ' + p.clienteId)), zona: String(c.region || ''),
                 lat: numeroSeguro_(c.lat), lng: numeroSeguro_(c.lng), horaPlan: p.horaPlan || '',
                 hTipo: String(c.horarioTipo || '').toLowerCase(), hDesde: horaTxt_(c.horarioDesde), hHasta: horaTxt_(c.horarioHasta),
                 hecha: !!v, horaHecha: v ? horaTxt_(v['hora final'] || v['hora inicio']) : '', kg: v ? ini_r_(kgDe(v), 1) : 0,
                 recibo: v ? String(v['recibo numero'] || '') : '' };
      });
      return Object.assign({}, r, { color: MAPA_COLORES[k % MAPA_COLORES.length], paradas: par,
        hechas: par.filter(p => p.hecha).length, kg: ini_r_(par.reduce((s, p) => s + p.kg, 0), 1) });
    });
  const clientes = [], sinUbicacion = [];
  CLI.forEach(c => {
    const id = Number(c.id); if (!id) return;
    const pl = P.plan[id]; if (!pl) return;
    const est = map_estadoCli_(pl, hoy);
    if (est === 'fuera' && !pl.activo) return;
    const la = numeroSeguro_(c.lat), ln = numeroSeguro_(c.lng);
    const o = { id: id, nombre: String(c.nombre || ''), zona: String(c.region || ''), estado: est, proxima: pl.proxima || '', ultima: pl.ultima || '',
                frec: String(c.frecuencia || ''), direccion: String(c.direccion || ''), lat: la, lng: ln };
    if (map_llOk_(la, ln)) clientes.push(o);
    else sinUbicacion.push(Object.assign(o, { mal: !!(la || ln) }));
  });
  const nom = {}; CLI.forEach(c => nom[Number(c.id)] = c);
  const propuestas = cobA_leer_(HOJA_UBP).filter(x => String(x.estado || '') === 'PENDIENTE').map(x => {
    const c = nom[Number(x.clienteId)] || {};
    return { ubId: String(x.ubId), fecha: fechaISO_(x.fecha) + ' ' + horaTxt_(x.fecha), clienteId: Number(x.clienteId), cliente: String(c.nombre || x.cliente || ''),
             lat: Number(x.lat), lng: Number(x.lng), precision: Number(x.precision) || null, distancia: Number(x.distancia) || null,
             nota: String(x.nota || ''), por: String(x.por || ''), antes: map_llOk_(c.lat, c.lng) ? { lat: Number(c.lat), lng: Number(c.lng) } : null };
  });
  return { ok: true, hoy: hoy, fecha: F, rutas: rutas, clientes: clientes, sinUbicacion: sinUbicacion, propuestas: propuestas,
           base: map_llOk_(cfg.baseLat, cfg.baseLng) ? { lat: Number(cfg.baseLat), lng: Number(cfg.baseLng), nombre: String(cfg.baseNombre || 'Base') } : null,
           destinos: destinos_(cfg), google: map_google_(cfg) };
}

function api_reportarUbicacion(pin, clienteId, lat, lng, precision, nota) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const id = Number(clienteId);
  if (!id) return { ok: false, error: 'Falta el cliente.' };
  if (!map_llOk_(lat, lng)) return { ok: false, error: 'La ubicación del teléfono no parece estar en Panamá. Activa el GPS y vuelve a intentar.' };
  const c = leerHoja_(HOJA_CLI).find(x => Number(x.id) === id);
  if (!c) return { ok: false, error: 'No encontré ese cliente.' };
  let dist = '';
  if (map_llOk_(c.lat, c.lng)) {
    const R = 6371000, a = Number(c.lat) * Math.PI / 180, b = Number(lat) * Math.PI / 180;
    const dl = b - a, dn = (Number(lng) - Number(c.lng)) * Math.PI / 180;
    const x = Math.sin(dl / 2) ** 2 + Math.cos(a) * Math.cos(b) * Math.sin(dn / 2) ** 2;
    dist = Math.round(2 * R * Math.atan2(Math.sqrt(x), Math.sqrt(1 - x)));
  }
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = cobA_hoja_(HOJA_UBP, COLS_UBP);
    const n = cobA_leer_(HOJA_UBP).length + 1;
    const ubId = 'UB-' + hoyPanama_().slice(0, 4) + '-' + ('000' + n).slice(-4);
    cobA_agregar_(h, { ubId: ubId, fecha: map_ahora_(), clienteId: id, cliente: String(c.nombre || ''), lat: map_r6_(lat), lng: map_r6_(lng),
                       precision: Math.round(Number(precision) || 0) || '', distancia: dist, nota: String(nota || '').trim().slice(0, 300),
                       por: u.nombre, estado: 'PENDIENTE' });
    marcar_('logistica');
    return { ok: true, ubId: ubId, distancia: dist };
  } finally { lock.releaseLock(); }
}

function api_revisarUbicacion(pin, ubId, aprobar) {
