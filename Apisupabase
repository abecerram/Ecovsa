  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!inc_puedeGestionar_(u)) return { ok: false, error: 'Solo logística.' };
  d = d || {};
  const causa = String(d.causa || '').trim().slice(0, 300), accion = String(d.accion || '').trim().slice(0, 500);
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const x = inc_buscar_(u, incId);
    if (!x) return { ok: false, error: 'No encontré la incidencia.' };
    if (!inc_abierta_(x)) return { ok: true, yaEstaba: true };
    if (x.tipo !== 'norecolectada' && (!causa || !accion)) return { ok: false, error: 'Para cerrarla escribe la causa y lo que se hizo.' };
    if (x.tipo === 'norecolectada' && !accion) return { ok: false, error: 'Escribe qué se hizo con la parada.' };
    const tenia = (x.fotos || []).length && !x.fotosBorradas;
    inc_borrarFotos_(x, 'Incidencia cerrada');
    inc_cambiar_(x.incId, { estado: 'CERRADA', causa: causa, accion: accion, prevencion: String(d.prevencion || '').trim().slice(0, 500),
                            verificar: String(d.verificar || '').trim().slice(0, 200), cerradaPor: u.nombre, cerradaEn: inc_ahora_(),
                            reporteEn: d.reporte ? inc_ahora_() : '', fotosBorradas: tenia ? inc_ahora_() : (x.fotosBorradas || ''),
                            vistaPor: x.vistaPor || u.nombre, vistaEn: x.vistaEn || inc_ahora_() });
    marcar_('logistica');
    return { ok: true };
  } finally { lock.releaseLock(); }
}

function inc_mantener_(F) {
  const hoy = hoyPanama_();
  const abiertasNR = F.filter(x => x.tipo === 'norecolectada' && inc_abierta_(x));
  let REC = null;
  if (abiertasNR.length) REC = leerHoja_(HOJA_REC);
  abiertasNR.forEach(x => {
    const nom = String(x.cliente || '').trim().toUpperCase(); if (!nom) return;
    const r = REC.filter(z => String(z.Cliente || '').trim().toUpperCase() === nom && fechaISO_(z['Fecha de Recoleccion']) >= x.fecha)
      .sort((a, b) => fechaISO_(a['Fecha de Recoleccion']).localeCompare(fechaISO_(b['Fecha de Recoleccion'])))[0];
    if (!r) return;
    const f = fechaISO_(r['Fecha de Recoleccion']);
    inc_borrarFotos_(x, 'Se recolectó');
    inc_cambiar_(x.incId, { estado: 'CERRADA', accion: 'Se recolectó el ' + mto_f_(f) + (r['recibo numero'] ? ' (recibo ' + r['recibo numero'] + ')' : '') + '.',
                            cerradaPor: 'Sistema', cerradaEn: inc_ahora_(), fotosBorradas: x.fotos.length ? inc_ahora_() : '' });
    x.estado = 'CERRADA';
  });
  F.filter(x => inc_abierta_(x) && x.fotos.length && !x.fotosBorradas && inc_dias_(x.fecha) >= INC_DIAS_FOTOS).forEach(x => {
    inc_borrarFotos_(x, 'Pasaron ' + INC_DIAS_FOTOS + ' días sin cerrar la incidencia');
    inc_cambiar_(x.incId, { fotosBorradas: inc_ahora_() });
    x.fotosBorradas = hoy;
  });
}

