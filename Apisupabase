}

function api_reqVerAdjunto(pin, reqId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const r = req_filas_().find(x => x.reqId === String(reqId));
  if (!r || !r.archivoId) return { ok: false, error: 'Esa requisición no tiene archivo.' };
  if (!req_compras_(u) && !req_pide_(u, r.modulo)) return { ok: false, error: 'Sin permiso.' };
