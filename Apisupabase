/* Llena un texto: renglón por renglón, con las reglas del encabezado. */
/* marcar = true (contrato): cada valor de variable va entre [[…]] para que la
   pantalla lo resalte, como hacía el 3.12 con los datos del cliente. */
function llenarTexto313_(texto, val, marcar) {
  const salida = [];
  String(texto || '').split('\n').forEach(linea => {
    const alts = linea.split(' || ');
    for (let i = 0; i < alts.length; i++) {
      let completa = true;
      const hecho = alts[i].replace(/\{(\?)?([^{}]*)\}/g, (m, cond, k) => {
        k = k.trim();
        if (!(k in val)) return m;                       // variable desconocida: se deja como está
        const v = String(val[k] == null ? '' : val[k]);
        if (!v) completa = false;
        return cond ? '' : (marcar && v ? '[[' + v + ']]' : v);
      });
      if (completa) { if (hecho.trim()) salida.push(hecho.trim()); return; }
    }
  });
  return salida;
}

/* Los textos de un documento para un prospecto, ya resueltos (texto plano).
   propuesta → {saludo, operativa, incluye:[…], notas:[…], pasos, variante}
   contrato  → {consideraciones:[…], clausulas:[{id, titulo, texto}]}
   Si hay foto guardada (enviada / generado), manda la foto. */
function resolverTextos_(p, doc, sinFoto) {
  if (!sinFoto) {
    const snap = json313_(doc === 'contrato' ? p.contratoSnap : p.textosSnap, null);
    if (snap && typeof snap === 'object') { snap.foto = true; return snap; }
  }
  const val = valoresDoc313_(p);
  /* 3.13 · documento legal: en el contrato «el cliente» es su razón social (reporte de Katherine, 30 sep). */
  if (doc === 'contrato') val.empresa = val.razonSocial;
  const ed = textosEditados313_();
  if (doc === 'contrato') {
    const cons = llenarTexto313_(textoVigente313_('contrato', 'consideraciones', '', ed), val, true).map(x => x.replace(/^-\s+/, ''));
    const clausulas = TEXTOS_FABRICA.contrato.filter(b => !b.auto && b.id !== 'consideraciones' && b.id !== 'partes').map(b => ({
      id: b.id, titulo: b.titulo, texto: llenarTexto313_(textoVigente313_('contrato', b.id, '', ed), val, true).join('\n') }));
    /* api 3.13.1 · «Las partes» se edita; un dato vacío sale como raya (el párrafo no se pierde) */
    const valP = {}; Object.keys(val).forEach(k => { valP[k] = String(val[k] == null ? '' : val[k]).trim() || '____________'; });
    const partes = llenarTexto313_(textoVigente313_('contrato', 'partes', '', ed), valP, true).join('\n');
    return { partes: partes, consideraciones: cons, clausulas: clausulas, foto: false };
  }
  const variante = esUnica313_(p) ? 'unica' : 'recurrente';
  return {
    variante: variante,
    saludo: llenarTexto313_(textoVigente313_('propuesta', 'saludo', '', ed), val).join('\n'),
    operativa: llenarTexto313_(textoVigente313_('propuesta', 'operativa', variante, ed), val).join('\n'),
    incluye: llenarTexto313_(textoVigente313_('propuesta', 'incluye', variante, ed), val).map(x => x.replace(/^-\s+/, '')),
    notas: llenarTexto313_(textoVigente313_('propuesta', 'notas', variante, ed), val).map(x => x.replace(/^-\s+/, '')),
    pasos: llenarTexto313_(textoVigente313_('propuesta', 'pasos', variante, ed), val).join('\n'),
    foto: false
  };
}

/* Foto de los textos al ENVIAR la propuesta. `forzar` = versión nueva
   (cambió el precio o las notas): se toma de nuevo. */
function fotoTextosPropuesta313_(cod, forzar) {
  const p = prospecto313_(cod); if (!p) return false;
  if (String(p.textosSnap || '').trim() && !forzar) return false;
  const t = resolverTextos_(p, 'propuesta', true);
  t.notasLista = notasPropuesta313_(p);      // las notas finales tal como salieron
  t.tomadaEn = ahora313_();
  actualizarProspecto313_(cod, { textosSnap: JSON.stringify(t) });
  return true;
}
/* Foto del contrato al GENERARLO (una sola vez; si se borra el número y se
   genera de nuevo, se toma otra). */
function fotoTextosContrato313_(cod) {
  const p = prospecto313_(cod); if (!p) return null;
  const ya = json313_(p.contratoSnap, null); if (ya) { ya.foto = true; return ya; }
  const t = resolverTextos_(p, 'contrato', true);
  t.tomadaEn = ahora313_();
  actualizarProspecto313_(cod, { contratoSnap: JSON.stringify(t) });
  t.foto = true;
  return t;
}

/* api 3.25 · «Actualizar al texto vigente» del contrato.
   La foto del contrato se toma una sola vez (fotoTextosContrato313_). Si
   Mercadeo cambió las cláusulas en Plantillas y ajustes, o cambió algún dato
   de la ficha, un contrato que ya se generó seguía saliendo con lo de antes.
   Esto vuelve a tomar la foto con el texto vigente:
   · solo si el contrato NO está firmado (estado Firmado / Pasado a cartera,
     o la casilla «Contrato firmado» marcada);
   · conserva el mismo número CT-…;
   · la foto anterior queda en DocTextosHistorial (textoAnterior), con quién y cuándo.
   confirmar !== true → solo dice qué cambiaría, sin guardar nada. */
function api_actualizarTextoContrato(pin, cod, confirmar, motivo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  const c = String(cod || '').trim();
  if (!c) return { ok: false, error: 'Falta la oportunidad.' };
  return candado313_(() => {
    const p = prospecto313_(c); if (!p) return { ok: false, error: 'No encontré esa oportunidad.' };
    /* api 3.25.1: un contrato firmado (o en cartera) solo lo rehace el administrador, con motivo */
    const firmado = prospectoBloqueado313_(p) || si313_(p['doc contrato firmado']);
    const mot = String(motivo || '').replace(/\s+/g, ' ').trim().slice(0, 300);
    if (firmado && !esAdmin_(e.u))
      return { ok: false, firmado: true, error: 'El contrato ya está firmado: solo el administrador puede rehacerlo, escribiendo el motivo.' };
    const n = String(p['n contrato'] || '').trim();
    const antes = json313_(p.contratoSnap, null);
    if (!antes || typeof antes !== 'object')
      return { ok: true, sinFoto: true, cambios: [], nContrato: n };      // nunca se generó: al abrirlo sale con el texto vigente
    const nuevo = resolverTextos_(p, 'contrato', true);
    const cambios = cambiosContrato325_(antes, nuevo);
    const base = { ok: true, nContrato: n, tomadaEn: String(antes.tomadaEn || ''), version: Number(antes.version) || 1, cambios: cambios, firmado: firmado };
    if (!cambios.length) { base.sinCambios = true; return base; }
    if (confirmar !== true) return base;
    if (firmado && mot.length < 5) return { ok: false, firmado: true, error: 'Escribe el motivo para rehacer un contrato firmado.' };
    nuevo.tomadaEn = ahora313_();
    nuevo.version = base.version + 1;
    nuevo.actualizadoPor = e.u.nombre;
    if (firmado) nuevo.motivo = mot;
    actualizarProspecto313_(c, { contratoSnap: JSON.stringify(nuevo) });
    const empresa = String(p.empresa || '').trim();
    historialDoc313_(e.u, { doc: 'contrato', bloque: 'foto', accion: 'actualizar contrato',
      titulo: 'Contrato ' + (n || c) + (empresa ? ' · ' + empresa : '') + (firmado ? ' · FIRMADO, rehecho' : ''),
      resumen: resumen313_((firmado ? 'Motivo: ' + mot + ' · ' : '') + cambios.join(' · ')),
      textoAnterior: contratoLegible325_(antes), textoNuevo: contratoLegible325_(nuevo),
      avisoTitulo: firmado ? 'Se rehízo un contrato firmado' : 'Se actualizó el texto de un contrato',
      avisoDetalle: e.u.nombre + ' actualizó el contrato ' + (n || c) + (empresa ? ' de ' + empresa : '') + ' al texto vigente (versión ' + nuevo.version + ')' + (firmado ? '. Estaba firmado. Motivo: ' + mot : '') + '.' });
    base.actualizado = true; base.version = nuevo.version; base.tomadaEn = nuevo.tomadaEn;
    return base;
  });
}
/* La foto del contrato como texto corrido, para el historial de Plantillas y ajustes. */
function contratoLegible325_(f) {
  if (!f || typeof f !== 'object') return '';
  const l = [];
  if (f.tomadaEn) l.push('Tomada el ' + f.tomadaEn + (f.actualizadoPor ? ' · por ' + f.actualizadoPor : '') + (f.version ? ' · versión ' + f.version : '') + (f.motivo ? ' · motivo: ' + f.motivo : ''));
  if (String(f.partes || '').trim()) l.push('LAS PARTES\n' + String(f.partes).trim());
  const cons = Array.isArray(f.consideraciones) ? f.consideraciones : String(f.consideraciones || '').split('\n');
  if (cons.filter(x => String(x).trim()).length) l.push('CONSIDERACIONES\n' + cons.filter(x => String(x).trim()).map(x => '- ' + String(x).trim()).join('\n'));
  (Array.isArray(f.clausulas) ? f.clausulas : []).forEach(c => l.push(String(c.titulo || '').toUpperCase() + '\n' + String(c.texto || '').trim()));
  return l.join('\n\n');
}
/* Qué cambia entre dos fotos del contrato, en palabras. */
function cambiosContrato325_(a, b) {
  const t = v => String(v == null ? '' : v).replace(/\s+/g, ' ').trim();
  const lista = v => (Array.isArray(v) ? v : String(v || '').split('\n')).map(t).filter(Boolean).join('\n');
  const out = [];
  if (t(a.partes) !== t(b.partes)) out.push('cambia «Las partes»');
  if (lista(a.consideraciones) !== lista(b.consideraciones)) out.push('cambian las consideraciones');
  const ca = Array.isArray(a.clausulas) ? a.clausulas : [], cb = Array.isArray(b.clausulas) ? b.clausulas : [];
  const clave = (x, i) => String(x.id || x.titulo || i);
  const mapaA = {}; ca.forEach((x, i) => { mapaA[clave(x, i)] = x; });
  const vistas = {};
  cb.forEach((x, i) => {
    const k = clave(x, i), y = mapaA[k]; vistas[k] = true;
    if (!y) out.push('nueva cláusula «' + t(x.titulo) + '»');
    else if (t(y.titulo) !== t(x.titulo) || t(y.texto) !== t(x.texto)) out.push('cambia «' + t(x.titulo) + '»');
  });
  ca.forEach((x, i) => { if (!vistas[clave(x, i)]) out.push('se quita «' + t(x.titulo) + '»'); });
  return out;
}

/* Las notas de la propuesta: las del cliente (si Mercadeo las ajustó) o las
   estándar del bloque «notas», más la nota de la promoción. Reemplaza el
   cuerpo de notasBase_ del 3.12 (ver CAMBIOS_EXISTENTES.md). */
function notasEstandar313_(p) {
  const r = resolverTextos_(p, 'propuesta', true);
  return r.notas.concat(notasPromocion313_(p));
}
function notasPropuesta313_(p) {
  const guardadas = String(p.notasPropuesta || '').trim();
  const promo = notasPromocion313_(p);
  let base = guardadas ? guardadas.split('\n').map(x => x.trim()).filter(Boolean).concat(promo) : notasEstandar313_(p);
  /* Con promoción no se promete que los precios se mantienen: cambian al terminar el beneficio. */
  if (promo.length) base = base.filter(x => !/precios\s+se\s+mantienen/i.test(x));
  const fuera = (typeof esLineaVigencia_ === 'function') ? esLineaVigencia_ : (t => /^\s*propuesta\s+vigente\s+hasta/i.test(String(t || '')));
  const vistas = {};
  return base.filter(x => !fuera(x)).filter(x => { const k = x.toLowerCase(); if (vistas[k]) return false; vistas[k] = 1; return true; });
}


/* ══════════ Numeracion.gs (api 3.13) ══════════ */
/**
 * ═══════════════════════════════════════════════════════════════
 *  api 3.13 · CONSECUTIVOS DE PROPUESTA Y CONTRATO
 *
 *  Propuesta: PRO-AA-NNN-001  (AA = año, NNN = correlativo del año)
 *  Contrato:  CNT-AA-NNN-PPP  (api 3.13.1: el prefijo se cambia en Numeración;
 *             NNN = correlativo del año, vuelve a 001 cada
 *             enero; PPP = el NNN de la propuesta de donde sale)
 *
 *  «En uso» se lee de lo que existe de verdad (Prospectos y el contrato de
 *  cada cliente), no de un contador: así un número nunca sale dos veces.
 *
 *  Hoja Numeracion: lo que el sistema no puede deducir solo.
 *   - estado 'libre': un número que se borró (se vuelve a usar SIEMPRE).
 *   - estado 'fijado': «Cambiar el siguiente número» de Mercadeo.
 *  El siguiente número es, en este orden:
 *   1. el fijado (si no está en uso), porque alguien lo pidió a propósito;
 *   2. el libre más bajo del año;
 *   3. el más alto en uso del año + 1.
 *  Un libre o un fijado que ya se usó se ignora (y se limpia solo).
 * ═══════════════════════════════════════════════════════════════
 */

const HOJA_NUM_313 = 'Numeracion';
const COLS_NUM_313 = ['serie', 'anio', 'numero', 'codigo', 'estado', 'cliente', 'cuando', 'quien'];

function anio2313_() { return hoy313_().slice(2, 4); }

/* api 3.13.1 · prefijo del contrato (Plantillas y ajustes › Numeración).
   El formato real de ECOVSA es CNT. Se reconocen como «en uso» los del
   prefijo actual, CNT y CT (los que se hayan armado antes). */
const PROP_PREFIJO_CT_313 = 'CONTRATO_PREFIJO';
const PREFIJO_CT_OMISION_313 = 'CNT';
function prefijoContrato313_() {
  const v = String(PropertiesService.getScriptProperties().getProperty(PROP_PREFIJO_CT_313) || '').trim().toUpperCase();
  return /^[A-Z]{1,6}$/.test(v) ? v : PREFIJO_CT_OMISION_313;
}
function prefijosContrato313_() {
  const l = [prefijoContrato313_(), 'CNT', 'CT'];
  return l.filter((x, i) => l.indexOf(x) === i);
}
function tres313_(n) { return ('00' + n).slice(-3); }

/* Partes de un código de la serie; null si no es de la serie. */
function partesCodigo313_(serie, codigo) {
  const s = String(codigo || '').trim().toUpperCase();
  let m;
  if (serie === 'pro') m = s.match(/^PRO-(\d{2})-(\d{1,4})-(\d{3})$/);
  else {
    const x = s.match(/^([A-Z]{1,6})-(\d{2})-(\d{1,4})-(\d{1,4})$/);
    m = x && prefijosContrato313_().indexOf(x[1]) >= 0 ? [x[0], x[2], x[3], x[4]] : null;
  }
  if (!m) return null;
  return { anio: m[1], numero: Number(m[2]), ppp: m[3] };
}

/* Todo lo que está en uso de una serie en un año: {numero: {codigo, cliente, fecha}} */
function enUso313_(serie, anio) {
  const uso = {};
  const pon = (codigo, cliente, fecha) => {
    const x = partesCodigo313_(serie, codigo);
    if (!x || x.anio !== anio) return;
    if (!uso[x.numero]) uso[x.numero] = { codigo: String(codigo).trim().toUpperCase(), cliente: String(cliente || ''), fecha: fecha || '' };
  };
  tabla313_(HOJA_PRO).filas.forEach(p => {
    if (serie === 'pro') pon(p.codigoPropuesta, p.empresa, fechaISO_(p['fecha propuesta']) || fechaISO_(p.registradoEn) || '');
    else pon(p['n contrato'], p.empresa, fechaISO_(p['fecha contrato']) || '');
  });
  if (serie === 'ct') tabla313_(HOJA_CLI).filas.forEach(c => pon(c.contrato, c.nombre, ''));
  return uso;
}

function filasNum313_(serie, anio) {
  return tabla313_(HOJA_NUM_313, COLS_NUM_313).filas.filter(f => String(f.serie) === serie && String(f.anio) === String(anio));
}

/* El estado completo de una serie (lo que ve Mercadeo en «Numeración»). */
function estadoSerie313_(serie, anio) {
  anio = anio || anio2313_();
  const uso = enUso313_(serie, anio);
  const nums = Object.keys(uso).map(Number).sort((a, b) => a - b);
  const max = nums.length ? nums[nums.length - 1] : 0;
  const filas = filasNum313_(serie, anio);
  const libres = filas.filter(f => f.estado === 'libre' && !uso[Number(f.numero)])
    .sort((a, b) => Number(a.numero) - Number(b.numero));
  const vistos = {};
  const libresUnicos = libres.filter(f => { if (vistos[f.numero]) return false; vistos[f.numero] = 1; return true; });
  const fij = filas.filter(f => f.estado === 'fijado').sort((a, b) => b._fila - a._fila)[0];
  const fijado = fij && !uso[Number(fij.numero)] ? Number(fij.numero) : null;
  const siguiente = fijado != null ? fijado : libresUnicos.length ? Number(libresUnicos[0].numero) : max + 1;
  return { anio: anio, uso: uso, max: max, siguiente: siguiente, fijado: fijado,
    libres: libresUnicos.map(f => ({ numero: Number(f.numero), codigo: String(f.codigo), borradoEn: String(f.cuando || ''), cliente: String(f.cliente || '') })),
    ultimo: max ? uso[max] : null };
}

/* Nuevo siguienteCodigoPropuesta_ (reemplaza al del 3.12). Se llama DENTRO
   del candado de quien crea el prospecto, igual que antes. */
function siguienteCodigoPropuesta_() {
  const s = estadoSerie313_('pro');
  return 'PRO-' + s.anio + '-' + tres313_(s.siguiente) + '-001';
}

/* Le pone número al contrato si no tiene. Los contratos viejos conservan el
   suyo. Devuelve {codigo, nuevo}. Se llama con el candado tomado. */
function asignarNumeroContrato_(p) {
  const ya = String(p['n contrato'] || '').trim();
  if (ya) return { codigo: ya, nuevo: false };
  const pp = partesCodigo313_('pro', p.codigoPropuesta);
  const ppp = pp ? tres313_(pp.numero) : (String(p.codigoPropuesta || '').split('-')[2] || '000');
  const s = estadoSerie313_('ct');
  const codigo = prefijoContrato313_() + '-' + s.anio + '-' + tres313_(s.siguiente) + '-' + ppp;
  actualizarProspecto313_(p.codigoPropuesta, { 'n contrato': codigo });
  p['n contrato'] = codigo;
  return { codigo: codigo, nuevo: true };
}

/* Al borrar una propuesta o un contrato: su número queda libre para el
   siguiente. Llamar DESPUÉS de borrar la fila (si el número sigue en uso
   en otra parte, no se libera). */
function liberarNumero_(serie, codigo, cliente, u) {
  const x = partesCodigo313_(serie, codigo); if (!x) return false;
  if (enUso313_(serie, x.anio)[x.numero]) return false;
  const t = tabla313_(HOJA_NUM_313, COLS_NUM_313);
  if (t.filas.some(f => f.serie === serie && String(f.anio) === x.anio && Number(f.numero) === x.numero && f.estado === 'libre')) return false;
  agregar313_(t, { serie: serie, anio: x.anio, numero: x.numero, codigo: String(codigo).trim().toUpperCase(), estado: 'libre',
    cliente: cliente || '', cuando: ahora313_(), quien: (u && u.nombre) || '' });
  return true;
}

function formatoSerie313_(serie, n, anio) {
  /* ejemplo del formato con números reales: el contrato lleva al final el número de una propuesta */
  return serie === 'pro' ? 'PRO-' + anio + '-' + tres313_(n) + '-001' : prefijoContrato313_() + '-' + anio + '-' + tres313_(n) + '-' + tres313_(estadoSerie313_('pro').max || 1);
}
function datosSerie313_(serie) {
  const s = estadoSerie313_(serie);
  const pref = serie === 'pro' ? 'PRO-' : prefijoContrato313_() + '-';
  return { formato: formatoSerie313_(serie, s.max || 1, s.anio), anio: Number(s.anio),
    ultimo: s.ultimo ? { codigo: s.ultimo.codigo, cliente: s.ultimo.cliente, fecha: s.ultimo.fecha } : null,
    siguiente: pref + s.anio + '-' + tres313_(s.siguiente), siguienteNumero: s.siguiente,
    libres: s.libres.map(l => ({ codigo: l.codigo, borradoEn: l.borradoEn, cliente: l.cliente })), fijado: s.fijado,
    prefijo: serie === 'pro' ? 'PRO' : prefijoContrato313_() };
}
function numeracionDatos313_() { return { pro: datosSerie313_('pro'), ct: datosSerie313_('ct') }; }

function api_numeracion(pin) {
  const e = entrar313_(pin, 'lee'); if (e.error) return e.error;
  const d = numeracionDatos313_();
  return { ok: true, pro: d.pro, ct: d.ct, puedeEditar: puedeEscribirMer313_(e.u) };
}

/* «Cambiar el siguiente número». No acepta un número en uso. */
function api_numeracionFijar(pin, serie, numero, entiendo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  if (serie !== 'pro' && serie !== 'ct') return { ok: false, error: 'Serie desconocida.' };
  if (entiendo !== true) return { ok: false, error: 'Marca «Entiendo» para cambiar el siguiente número.' };
  const n = Math.floor(Number(numero));
  if (!(n >= 1 && n <= 999)) return { ok: false, error: 'Escribe un número del 1 al 999.' };
  return candado313_(() => {
    const s = estadoSerie313_(serie);
    if (s.uso[n]) return { ok: false, error: 'Ese número ya está en uso (' + s.uso[n].codigo + ').' };
    const antes = s.siguiente;
    const t = tabla313_(HOJA_NUM_313, COLS_NUM_313);
    /* un solo fijado por serie y año: los anteriores se borran */
    t.filas.filter(f => f.serie === serie && String(f.anio) === s.anio && f.estado === 'fijado')
      .sort((a, b) => b._fila - a._fila).forEach(f => t.h.deleteRow(f._fila));
    const t2 = tabla313_(HOJA_NUM_313, COLS_NUM_313);
    agregar313_(t2, { serie: serie, anio: s.anio, numero: n, codigo: (serie === 'pro' ? 'PRO-' : prefijoContrato313_() + '-') + s.anio + '-' + tres313_(n),
      estado: 'fijado', cliente: '', cuando: ahora313_(), quien: e.u.nombre });
    const nombre = serie === 'pro' ? 'propuesta' : 'contrato';
    historialDoc313_(e.u, { doc: 'numeracion', bloque: serie, accion: 'fijar', titulo: 'Siguiente número de ' + nombre,
      resumen: 'De ' + tres313_(antes) + ' a ' + tres313_(n), textoAnterior: String(antes), textoNuevo: String(n),
      avisoTitulo: 'Mercadeo cambió el siguiente número de ' + nombre, avisoDetalle: e.u.nombre + ': de ' + tres313_(antes) + ' a ' + tres313_(n) + '.' });
    const d = numeracionDatos313_();
    return { ok: true, pro: d.pro, ct: d.ct };
  });
}

/* api 3.13.1 · «Cambiar el formato» del contrato: solo el prefijo (CNT…).
   El año, el correlativo y el número de la propuesta (-PPP) los pone el
   sistema. Los contratos ya generados conservan su número. */
function api_numeracionFormato(pin, prefijo, entiendo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  if (entiendo !== true) return { ok: false, error: 'Marca «Entiendo» para cambiar el formato.' };
  const p = String(prefijo || '').trim().toUpperCase();
  if (!/^[A-Z]{1,6}$/.test(p)) return { ok: false, error: 'El prefijo lleva solo letras (de 1 a 6), sin números ni guiones.' };
  return candado313_(() => {
    const antes = prefijoContrato313_();
    if (p === antes) { const d0 = numeracionDatos313_(); return { ok: true, sinCambios: true, pro: d0.pro, ct: d0.ct }; }
    PropertiesService.getScriptProperties().setProperty(PROP_PREFIJO_CT_313, p);
    historialDoc313_(e.u, { doc: 'numeracion', bloque: 'ct', accion: 'formato', titulo: 'Formato del número de contrato',
      resumen: 'De ' + antes + '-AA-NNN-PPP a ' + p + '-AA-NNN-PPP', textoAnterior: antes, textoNuevo: p,
      avisoTitulo: 'Mercadeo cambió el formato del número de contrato', avisoDetalle: e.u.nombre + ': de ' + antes + ' a ' + p + '.' });
    const d = numeracionDatos313_();
    return { ok: true, pro: d.pro, ct: d.ct };
  });
}


