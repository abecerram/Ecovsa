function req_cambiar_(reqId, cambios) {
  const h = req_hoja_();
  return cobA_cambiar_(h, 'reqId', String(reqId).trim(), cambios);
}

function req_una_(reqId) { return req_filas_().find(x => x.reqId === String(reqId || '').trim()) || null; }

function api_reqPreguntar(pin, reqId, texto) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!req_compras_(u)) return { ok: false, error: 'Pregunta Compras.' };
  const r = req_una_(reqId); if (!r) return { ok: false, error: 'No encontré esa requisición.' };
  const t = String(texto || '').trim(); if (!t) return { ok: false, error: 'Escribe la pregunta.' };
  if (['TRAMITADA', 'RECIBIDA', 'NO_PROCEDE'].indexOf(r.estado) >= 0) return { ok: false, error: 'Esa requisición ya está cerrada o tramitada.' };
  req_cambiar_(r.reqId, { estado: 'PREGUNTA', pregunta: t.slice(0, 400), preguntaPor: u.nombre, preguntaEn: req_ahora_(), respuesta: '', respuestaEn: '' });
  marcar_(r.modulo === 'planta' ? 'planta' : 'logistica');
  return { ok: true };
}

function api_reqResponder(pin, reqId, texto) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const r = req_una_(reqId); if (!r) return { ok: false, error: 'No encontré esa requisición.' };
  if (!req_pide_(u, r.modulo)) return { ok: false, error: 'Responde quien la pidió.' };
  const t = String(texto || '').trim(); if (!t) return { ok: false, error: 'Escribe la respuesta.' };
  if (r.estado !== 'PREGUNTA') return { ok: false, error: 'Esa requisición no tiene una pregunta pendiente.' };
  req_cambiar_(r.reqId, { estado: 'RESPONDIDA', respuesta: t.slice(0, 400), respuestaEn: req_ahora_() });
  marcar_('mercadeo');
  return { ok: true };
}

function api_reqNoProcede(pin, reqId, motivo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!req_compras_(u)) return { ok: false, error: 'Lo decide Compras.' };
  const r = req_una_(reqId); if (!r) return { ok: false, error: 'No encontré esa requisición.' };
  const t = String(motivo || '').trim(); if (!t) return { ok: false, error: 'Escribe el motivo: quien la pidió lo va a leer.' };
  if (['TRAMITADA', 'RECIBIDA'].indexOf(r.estado) >= 0) return { ok: false, error: 'Ya se tramitó: anula su solicitud de pago en Compras.' };
  req_cambiar_(r.reqId, { estado: 'NO_PROCEDE', motivo: t.slice(0, 400), cerradaPor: u.nombre, cerradaEn: req_ahora_() });
  marcar_(r.modulo === 'planta' ? 'planta' : 'logistica');
  return { ok: true };
}

function api_reqTramitada(pin, reqId, solicitudId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!req_compras_(u)) return { ok: false, error: 'La tramita Compras.' };
  const r = req_una_(reqId); if (!r) return { ok: false, error: 'No encontré esa requisición.' };
  const sid = String(solicitudId || '').trim();
  const s = leerHoja_(HOJA_SP).find(x => String(x.solicitudId || '').trim() === sid);
  if (!s) return { ok: false, error: 'No encontré la solicitud ' + sid + '.' };
  req_cambiar_(r.reqId, { estado: 'TRAMITADA', solicitudId: sid, tramitadaPor: u.nombre, tramitadaEn: req_ahora_() });
  marcar_(r.modulo === 'planta' ? 'planta' : 'logistica');
  return { ok: true };
}

function api_reqRecibida(pin, reqId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const r = req_una_(reqId); if (!r) return { ok: false, error: 'No encontré esa requisición.' };
  if (!req_pide_(u, r.modulo)) return { ok: false, error: 'La cierra quien la pidió.' };
  if (r.estado !== 'TRAMITADA') return { ok: false, error: 'Todavía no se ha tramitado.' };
  req_cambiar_(r.reqId, { estado: 'RECIBIDA', cerradaPor: u.nombre, cerradaEn: req_ahora_() });
  marcar_('mercadeo');
  return { ok: true };
}


/* ══════════ Seguridad.gs (copiado tal cual) ══════════ */
function seg_ctx_() { if (!_SEG) _SEG = { contado: false, cache: null, permiteTemp: false }; return _SEG; }

function seg_eq_() { try { return String(_REQ_EQ || '').replace(/[^A-Za-z0-9]/g, '').slice(0, 40); } catch (e) { return ''; } }

function seg_eqTxt_() { try { return String(_REQ_EQD || '').slice(0, 80); } catch (e) { return ''; } }

function seg_ip_() { try { return String(_REQ_IP || '').replace(/[^0-9a-fA-F:.]/g, '').slice(0, 45); } catch (e) { return ''; } }

function seg_ahoraMs_() { return new Date().getTime(); }

function seg_ahoraTxt_() { return Utilities.formatDate(new Date(), 'America/Panama', 'yyyy-MM-dd HH:mm'); }

function seg_fh_(v) { return v instanceof Date ? Utilities.formatDate(v, 'America/Panama', 'yyyy-MM-dd HH:mm') : String(v || '').replace(/^'/, '').trim(); }

function seg_mas_(horas) { return Utilities.formatDate(new Date(seg_ahoraMs_() + horas * 3600000), 'America/Panama', 'yyyy-MM-dd HH:mm'); }

function seg_leer_(k) {
  if (!k) return null;
  const v = PropertiesService.getScriptProperties().getProperty(k);
  if (!v) return null;
  try { return JSON.parse(v); } catch (e) { return null; }
}

function seg_poner_(k, o) { if (k) PropertiesService.getScriptProperties().setProperty(k, JSON.stringify(o)); }

function seg_kEq_() { const e = seg_eq_(); return e ? 'seg.eq.' + e : ''; }

function seg_kIp_() { const i = seg_ip_(); return i ? 'seg.ip.' + i : ''; }

function seg_limpiar_() {
  const P = PropertiesService.getScriptProperties(), lim = seg_ahoraMs_() - 30 * 86400000;
  P.getKeys().filter(k => /^seg\.(eq|ip)\./.test(k)).forEach(k => {
    const o = seg_leer_(k); if (!o) { P.deleteProperty(k); return; }
    if (!o.bloq && Math.max(o.t || 0, (o.ult && o.ult.t) || 0) < lim) P.deleteProperty(k);
  });
}

function seg_bloqueo_(huella) {
  const ahora = seg_ahoraMs_();
  const eq = seg_leer_(seg_kEq_()), ip = seg_leer_(seg_kIp_());
  /* el equipo donde esta misma persona ya tenía la sesión abierta sigue trabajando */
  const suya = eq && eq.ult && eq.ult.h === huella && ahora - (eq.ult.t || 0) < SEG_SESION_HORAS * 3600000;
  if (eq && eq.bloq && !suya) return { tipo: 'bloqueado' };
  if (eq && eq.hasta > ahora && !suya) return { tipo: 'espera', min: Math.ceil((eq.hasta - ahora) / 60000), hasta: eq.hasta };
  if (ip && ip.hasta > ahora && !suya) return { tipo: 'espera', min: Math.ceil((ip.hasta - ahora) / 60000), hasta: ip.hasta, red: true };
  return null;
}

function seg_fallo_(forzar) {
  const S = seg_ctx_();
  if (S.contado && !forzar) return;
  S.contado = true;
  const ahora = seg_ahoraMs_();
  const kE = seg_kEq_(), kI = seg_kIp_();
  if (kE) {
    let o = seg_leer_(kE) || { n: 0, e: 0 };
    if (!o.bloq && o.t && ahora - o.t > 24 * 3600000) { o.n = 0; o.e = 0; }          // un día sin fallos: se empieza de cero
    o.n = (o.n || 0) + 1; o.t = ahora;
    if (o.n >= SEG_POR_ESCALON) {
      o.n = 0;
      if ((o.e || 0) < SEG_ESCALA.length) { o.hasta = ahora + SEG_ESCALA[o.e || 0] * 60000; o.e = (o.e || 0) + 1; S.subio = o.e; }
      else if (!o.bloq) {
        o.bloq = true; o.bloqEn = seg_ahoraTxt_(); S.bloqueado = true;
        seg_aviso_('bloqueo', 'Equipo bloqueado por intentos de PIN', (SEG_POR_ESCALON * (SEG_ESCALA.length + 1)) + ' intentos equivocados seguidos. Desbloquéalo si fue alguien del equipo.');
      }
    }
    if (!o.bloq && !(o.hasta > ahora)) S.quedan = SEG_POR_ESCALON - o.n;
    seg_poner_(kE, o);
  }
  if (kI) {
    let o = seg_leer_(kI) || { v: [] };
    o.v = (o.v || []).filter(x => ahora - x < SEG_IP_VENTANA * 60000); o.v.push(ahora); o.t = ahora;
    if (o.v.length >= SEG_IP_FALLOS && !(o.hasta > ahora)) {
      o.hasta = ahora + SEG_IP_MIN * 60000; o.v = [];
      seg_aviso_('conexion', 'Muchos intentos de PIN desde una misma red', SEG_IP_FALLOS + ' intentos equivocados en menos de una hora. La red espera ' + SEG_IP_MIN + ' min.');
    }
    seg_poner_(kI, o);
  }
  if (Math.random() < 0.1) seg_limpiar_();
}

function seg_acierto_(huella) {
  const kE = seg_kEq_(); if (!kE) return;
  const ahora = seg_ahoraMs_(), o = seg_leer_(kE) || {};
  const limpio = !o.n && !o.e && !o.hasta && !o.bloq;
  if (limpio && o.ult && o.ult.h === huella && ahora - (o.ult.t || 0) < 3600000) return;
  const n = { ult: { h: huella, t: ahora }, t: o.t || 0 };
  if (o.bloq) { n.bloq = true; n.bloqEn = o.bloqEn; n.e = o.e; }                   // el bloqueo lo quita el administrador
  seg_poner_(kE, n);
}

function seg_resolverPin_(f, huella, filas) {
  const S = seg_ctx_();
  if (S.cache && S.cache.h === huella) return S.cache.u;
  let u = null;
  const bloq = seg_bloqueo_(huella);
  if (bloq) S.bloq = bloq;
  else if (f) {
    const nombre = String(f.nombre || '').trim();
    if (String(f.pinTemporal || '').toUpperCase() === 'SI') {
      const vence = seg_fh_(f.pinVence);
      if (vence && vence < seg_ahoraTxt_()) S.vencido = nombre;
      else if (S.permiteTemp) u = { nombre: nombre, rol: String(f.rol || 'operador').toLowerCase().trim(), autorizado: true, temporal: true };
      else S.temp = nombre;
    } else {
      u = { nombre: nombre, rol: String(f.rol || 'operador').toLowerCase().trim(), autorizado: true };
      seg_acierto_(huella);
    }
  } else {
    /* ¿un PIN que servía hasta hace poco o de alguien de baja? No es alguien adivinando */
    const hoy = seg_ahoraTxt_();
    const viejo = (filas || []).some(r => String(r.pin || '').trim() === huella ||
      (String(r.pinAnterior || '').trim() === huella && seg_fh_(r.pinAnteriorHasta) >= hoy));
    if (viejo) S.viejo = true; else seg_fallo_();
  }
  S.cache = { h: huella, u: u };
  return u;
}

function seg_respuesta_(r) {
  const S = _SEG;
  if (!S || !r || typeof r !== 'object' || r.ok !== false) return r;
  if (S.bloq) {
    r.error = S.bloq.tipo === 'bloqueado' ? 'Este equipo quedó bloqueado por intentos de PIN equivocados. Ya le avisamos al administrador.'
      : 'Demasiados intentos. Espera ' + S.bloq.min + ' min' + (S.bloq.red ? ' (se hicieron muchos intentos desde esta red).' : '.');
    r.bloqueo = { tipo: S.bloq.tipo, min: S.bloq.min || 0 };
  } else if (S.bloqueado) {
    r.error = 'Este equipo quedó bloqueado por intentos de PIN equivocados. Ya le avisamos al administrador.';
    r.bloqueo = { tipo: 'bloqueado' };
  } else if (S.subio) {
    r.error = 'PIN no válido. Espera ' + SEG_ESCALA[S.subio - 1] + ' min antes de volver a intentar.';
    r.bloqueo = { tipo: 'espera', min: SEG_ESCALA[S.subio - 1] };
  } else if (S.temp) {
    r.error = 'Crea tu PIN para entrar.'; r.crearPin = true; r.nombre = S.temp;
  } else if (S.vencido) {
    r.error = 'Tu PIN temporal venció. Pídele uno nuevo al administrador.'; r.pinVencido = true;
  } else if (S.viejo) {
    r.error = 'Ese PIN ya no sirve. Si te dieron uno nuevo, usa ese.';
  } else if (S.quedan && S.quedan < SEG_POR_ESCALON) {
    r.error = 'PIN no válido. Te ' + (S.quedan === 1 ? 'queda 1 intento' : 'quedan ' + S.quedan + ' intentos') + ' antes de tener que esperar.';
  }
  return r;
}

function seg_aviso_(tipo, titulo, detalle, nombre) {
  try {
    const t = seg_ahoraTxt_();
    crm_agregar_(HOJA_SEGAV, COLS_SEGAV, { avisoId: 'SEG-' + seg_ahoraMs_().toString(36).toUpperCase() + Math.floor(Math.random() * 90 + 10),
      fecha: t.slice(0, 10), hora: t.slice(11), tipo: tipo, titulo: String(titulo || '').slice(0, 160), detalle: String(detalle || '').slice(0, 400),
      nombre: String(nombre || '').slice(0, 90), equipo: seg_eq_(), equipoTxt: seg_eqTxt_(), conexion: seg_ip_(), estado: 'abierto', atendidoPor: '', atendidoEn: '' });
  } catch (e) { /* un aviso que falla no deshace nada */ }
}

function seg_avisos_(todos) {
  let L = [];
  try { L = crm_filas_(HOJA_SEGAV); } catch (e) { L = []; }
  return L.filter(a => String(a.avisoId || '').trim() && (todos || String(a.estado || 'abierto') === 'abierto')).map(a => ({
    id: String(a.avisoId), fecha: fechaISO_(a.fecha), hora: String(a.hora || '').replace(/^'/, ''), tipo: String(a.tipo || ''), titulo: String(a.titulo || ''),
    detalle: String(a.detalle || ''), nombre: String(a.nombre || ''), equipo: String(a.equipo || ''), equipoTxt: String(a.equipoTxt || ''),
