/* api 3.14: función que se está atendiendo (para la puerta de mantenimiento), quién está en qué
   pantalla (lo anota api_mantEstado) y lo leído de la tabla presencia (para Configuración) */
let _REQ_FN = '', _MANT_BLOQ = null, _PRES_REG = null, _PRES_LEIDA = null;
function usuarioPorPin_(pin) {
  const p = String(pin || '').trim();
  if (!p) return null;
  const huella = huellaPin_(p);
  const filas = leerHoja_(HOJA_USR);
  const f = filas.find(u =>
    String(u.pin).trim() === huella && String(u.activo || 'SI').toUpperCase() !== 'NO');
  /* api 3.12: PIN temporal, bloqueo por intentos y PIN viejos (Seguridad.gs) */
  const u = seg_resolverPin_(f || null, huella, filas);
  /* api 3.14: si el módulo de esta función está en mantenimiento y la persona no está en la lista, no pasa */
  if (u) mant_puerta_(u);
  return u;
}

