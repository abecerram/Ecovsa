function dl_n_(v) { const x = Number(v); return isFinite(x) ? x : 0; }

function dl_r_(v, d) { const k = Math.pow(10, d === undefined ? 1 : d); return Math.round((Number(v) || 0) * k) / k; }

function dl_kg_(r) { return dl_n_(r['Kg Recolectados']) + dl_n_(r['kg anatomopatologico']) + dl_n_(r['kg punzo cortantes']); }

function dl_bul_(r) { return dl_n_(r['cantidad bolsas']) + dl_n_(r['cantidad anatomo']) + dl_n_(r['cantidad punzo cort']); }

function dl_clave_(fecha, resp) { return String(fecha || '') + '|' + String(resp || '').trim().toLowerCase(); }

function dl_lunes_(f) {
  const d = new Date(f + 'T12:00:00Z'), w = d.getUTCDay();
  d.setUTCDate(d.getUTCDate() - ((w + 6) % 7));
  return d.toISOString().slice(0, 10);
}

function dl_tipos_() { return { bio: 0, punzo: 0, anato: 0, cantBio: 0, cantPunzo: 0, cantAnato: 0 }; }

function dl_sumTipos_(t, r) {
  t.bio += dl_n_(r['Kg Recolectados']); t.punzo += dl_n_(r['kg punzo cortantes']); t.anato += dl_n_(r['kg anatomopatologico']);
  t.cantBio += dl_n_(r['cantidad bolsas']); t.cantPunzo += dl_n_(r['cantidad punzo cort']); t.cantAnato += dl_n_(r['cantidad anatomo']);
}

function dl_redTipos_(t) { ['bio', 'punzo', 'anato'].forEach(k => t[k] = dl_r_(t[k])); return t; }

function dl_rec_() {
  return leerHoja_(HOJA_REC).map(r => { r._f = fechaISO_(r['Fecha de Recoleccion']); return r; }).filter(r => r._f);
}

function dl_actas_() {
  return leerHoja_(HOJA_DIS).map(r => ({
    actaId: String(r.actaId || '').trim(), fecha: fechaISO_(r.fecha), hora: horaTxt_(r.hora),
    operador: String(r.operador || ''), vehiculo: String(r.vehiculo || ''), destino: String(r.destino || ''),
    recibe: String(r.recibe || ''), desde: fechaISO_(r.desde), hasta: fechaISO_(r.hasta),
    kg: dl_n_(r.kgTotal), bultos: dl_n_(r.bultos), recibos: String(r.recibos || ''),
    llegada: horaTxt_(r.llegada), salida: horaTxt_(r.salida), observaciones: String(r.observaciones || '')
  })).filter(a => a.actaId && a.fecha);
}

function api_disposicionLogistica(pin, desde, hasta) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'Solo logística.' };
  const hoy = hoyPanama_();
  const D = /^\d{4}-\d{2}-\d{2}$/.test(String(desde || '')) ? String(desde) : hoy.slice(0, 8) + '01';
  const H = /^\d{4}-\d{2}-\d{2}$/.test(String(hasta || '')) ? String(hasta) : hoy;
  const REC = dl_rec_(), ACT = dl_actas_();
  const enP = f => f >= D && f <= H;

  // ── recolectado en el periodo ──
  const recP = REC.filter(r => enP(r._f));
  const rutasP = {}; recP.forEach(r => rutasP[dl_clave_(r._f, r.Responsable)] = 1);
  const tiposP = dl_tipos_(); recP.forEach(r => dl_sumTipos_(tiposP, r));
  const recolectado = { kg: dl_r_(recP.reduce((s, r) => s + dl_kg_(r), 0)), recibos: recP.length,
                        bultos: recP.reduce((s, r) => s + dl_bul_(r), 0), rutas: Object.keys(rutasP).length };

  // ── acopio: sin acta, de los últimos 30 días ──
  const sinActa = REC.filter(r => !String(r.acta || '').trim() && r._f <= hoy);
  const limite = (function(){ const d = new Date(hoy + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() - DL_DIAS_VIEJO); return d.toISOString().slice(0, 10); })();
  const acop = sinActa.filter(r => r._f >= limite), viejos = sinActa.filter(r => r._f < limite);
  const porDia = {};
  const tiposA = dl_tipos_();
  acop.forEach(r => {
    const d = porDia[r._f] = porDia[r._f] || { fecha: r._f, kg: 0, recibos: 0, bultos: 0, conductores: [] };
    d.kg += dl_kg_(r); d.recibos++; d.bultos += dl_bul_(r);
    const c = String(r.Responsable || '').trim().split(' ')[0]; if (c && d.conductores.indexOf(c) < 0) d.conductores.push(c);
    dl_sumTipos_(tiposA, r);
  });
  const dias = Object.keys(porDia).sort().map(k => { porDia[k].kg = dl_r_(porDia[k].kg); return porDia[k]; });
  const acopio = { kg: dl_r_(acop.reduce((s, r) => s + dl_kg_(r), 0)), recibos: acop.length,
                   bultos: acop.reduce((s, r) => s + dl_bul_(r), 0), desde: dias.length ? dias[0].fecha : '',
                   diasViejo: dias.length ? ini_diasEntre_(dias[0].fecha, hoy) : 0, porDia: dias, tipos: dl_redTipos_(tiposA),
                   viejos: { recibos: viejos.length, kg: dl_r_(viejos.reduce((s, r) => s + dl_kg_(r), 0)),
                             desde: viejos.length ? viejos.map(r => r._f).sort()[0] : '' } };

  // ── entregas (actas) del periodo, con el cuadre contra sus recibos ──
  const porActa = {};
  REC.forEach(r => { const a = String(r.acta || '').trim(); if (!a) return;
    const x = porActa[a] = porActa[a] || { kg: 0, n: 0, min: '', max: '' };
    x.kg += dl_kg_(r); x.n++; if (!x.min || r._f < x.min) x.min = r._f; if (!x.max || r._f > x.max) x.max = r._f; });
  const entregas = ACT.filter(a => enP(a.fecha)).map(a => {
    const x = porActa[a.actaId] || { kg: 0, n: 0, min: a.desde, max: a.hasta };
    const dif = dl_r_(x.kg - a.kg);
    return { actaId: a.actaId, fecha: a.fecha, hora: a.hora, vehiculo: a.vehiculo, operador: a.operador, recibe: a.recibe,
             destino: a.destino, desde: x.min || a.desde, hasta: x.max || a.hasta, kgActa: dl_r_(a.kg), kgRecibos: dl_r_(x.kg),
             nRecibos: x.n, bultos: a.bultos, diferencia: dif, cuadra: Math.abs(dif) < 0.1,
             diasAcopio: (x.min || a.desde) ? Math.max(0, ini_diasEntre_(x.min || a.desde, a.fecha)) : 0,
             llegada: a.llegada, salida: a.salida };
  }).sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
  const entregado = { kg: dl_r_(entregas.reduce((s, e) => s + e.kgActa, 0)), actas: entregas.length,
                      bultos: entregas.reduce((s, e) => s + e.bultos, 0) };

  // ── tratado en planta (ciclos) ──
  let CIC = []; try { CIC = leerHoja_(HOJA_CIC); } catch (e) { CIC = []; }
  const cicP = CIC.filter(c => { const f = fechaISO_(c.fecha); return f && enP(f); });
  const anio = H.slice(0, 4) + '-01-01';
  const entAnio = ACT.filter(a => a.fecha >= anio && a.fecha <= H).reduce((s, a) => s + a.kg, 0);
  const tratAnio = CIC.filter(c => { const f = fechaISO_(c.fecha); return f && f >= anio && f <= H; }).reduce((s, c) => s + dl_n_(c.kgEntrada), 0);
  const tratado = { kg: dl_r_(cicP.reduce((s, c) => s + dl_n_(c.kgEntrada), 0)), ciclos: cicP.length,
                    porTratar: dl_r_(Math.max(0, entAnio - tratAnio)) };

  // ── semanas y meses ──
  function agrupar(fnClave) {
    const g = {};
    recP.forEach(r => { const k = fnClave(r._f); const x = g[k] = g[k] || { clave: k, recolectado: 0, entregado: 0, pendiente: 0, actas: [] };
      x.recolectado += dl_kg_(r); if (!String(r.acta || '').trim()) x.pendiente += dl_kg_(r); });
    entregas.forEach(e => { const k = fnClave(e.fecha); const x = g[k] = g[k] || { clave: k, recolectado: 0, entregado: 0, pendiente: 0, actas: [] };
      x.entregado += e.kgActa; x.actas.push(e.actaId); });
    return Object.keys(g).sort().reverse().map(k => { const x = g[k]; x.recolectado = dl_r_(x.recolectado); x.entregado = dl_r_(x.entregado); x.pendiente = dl_r_(x.pendiente); return x; });
  }
  const semanas = agrupar(dl_lunes_), meses = agrupar(f => f.slice(0, 7));

  // ── lo que llama la atención ──
  const alertas = [];
  entregas.filter(e => !e.cuadra).slice(0, 3).forEach(e => alertas.push({ tipo: 'r', actaId: e.actaId,
    titulo: e.actaId + ': sus recibos no suman lo mismo que el acta',
    texto: 'El acta dice ' + e.kgActa + ' kg y sus ' + e.nRecibos + ' recibos suman ' + e.kgRecibos + ' kg. Algún recibo se corrigió después de generar el acta.' }));
  const fechasA = entregas.map(e => e.fecha).sort();
  let cada = 0; if (fechasA.length > 1) cada = Math.round(ini_diasEntre_(fechasA[0], fechasA[fechasA.length - 1]) / (fechasA.length - 1));
  if (acopio.kg > 0) alertas.push({ tipo: acopio.diasViejo > Math.max(cada, 7) ? 'r' : 'a',
    titulo: acopio.kg + ' kg llevan ' + acopio.diasViejo + (acopio.diasViejo === 1 ? ' día' : ' días') + ' en acopio',
    texto: cada ? 'En este periodo se entregó en planta cada ' + cada + ' días en promedio.' : 'Todavía no hay entregas en este periodo.' });
  if (acopio.viejos.recibos) alertas.push({ tipo: 'r', titulo: acopio.viejos.recibos + ' recibos de hace más de ' + DL_DIAS_VIEJO + ' días siguen sin acta',
    texto: acopio.viejos.kg + ' kg desde el ' + acopio.viejos.desde + '. No se cuentan en el acopio: revisa si se entregaron sin acta.' });
  if (tratado.porTratar > 0) alertas.push({ tipo: 'b', titulo: tratado.porTratar + ' kg entregados este año siguen sin tratar',
    texto: 'Entregado en ' + H.slice(0, 4) + ' menos lo que pasó por ciclos de planta.' });

  return { ok: true, desde: D, hasta: H, hoy: hoy, recolectado: recolectado, acopio: acopio, entregado: entregado, tratado: tratado,
           entregas: entregas, semanas: semanas, meses: meses, tipos: dl_redTipos_(tiposP), cadaDias: cada, alertas: alertas };
}

function api_entregaDetalle(pin, actaId) {
