}

function api_cobRegistrarPago(pin, d) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  d = d || {};
  const monto = cobA_r2_(d.monto);
  if (monto <= 0) return { ok: false, error: 'El monto debe ser mayor que cero.' };
  const fecha = fechaISO_(d.fecha) || hoyPanama_();
  if (fecha > hoyPanama_()) return { ok: false, error: 'La fecha del pago no puede ser futura.' };
  const L = cobA_libro_();
  const reparto = (d.reparto || []).map(x => ({ factura: String(x.factura || '').trim(), monto: cobA_r2_(x.monto) })).filter(x => x.monto > 0);
  const sumaRep = cobA_r2_(reparto.reduce((s, x) => s + x.monto, 0));
  if (sumaRep > monto + 0.01) return { ok: false, error: 'El reparto pasa del monto del pago.' };
  for (const x of reparto) {
    const f = L.facPorNum[x.factura];
    if (!f) return { ok: false, error: 'No existe la factura ' + x.factura + '.' };
    if (x.monto > f.saldo + 0.01) return { ok: false, error: 'A la ' + x.factura + ' le quedan B/. ' + f.saldo.toFixed(2) + '.' };
  }
  const c = L.cuentas[String(d.clave || '')];
  const cliente = c ? (c.razon || c.cliente) : String(d.cliente || '');
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_PAG) || crearHoja_(SpreadsheetApp.getActiveSpreadsheet(), HOJA_PAG, COLS_PAG);
  const base = 'PG' + new Date().getTime().toString(36).toUpperCase();
  const ids = [];
  const sobra = cobA_r2_(monto - sumaRep);
  const partes = reparto.length + (sobra > 0.009 ? 1 : 0);
  reparto.forEach((x, i) => {
    const id = partes > 1 ? base + '-' + (i + 1) : base; ids.push(id);
    cobA_agregar_(h, { pagoId: id, factura: x.factura, fecha: fecha, monto: x.monto, metodo: d.metodo || '', referencia: d.referencia || '',
      cliente: cliente, notas: (partes > 1 ? 'Parte ' + (i + 1) + ' de ' + partes + ' de un pago de B/. ' + monto.toFixed(2) + '. ' : '') + String(d.notas || ''),
      registradoPor: a.u.nombre, registradoEn: new Date() });
  });
  if (sobra > 0.009) {
    const id = partes > 1 ? base + '-' + partes : base; ids.push(id);
    cobA_agregar_(h, { pagoId: id, factura: '', fecha: fecha, monto: sobra, metodo: d.metodo || '', referencia: d.referencia || '',
      cliente: cliente, notas: 'Saldo a favor' + (partes > 1 ? ' (parte ' + partes + ' de ' + partes + ')' : '') + '. ' + String(d.notas || ''),
      registradoPor: a.u.nombre, registradoEn: new Date() });
  }
  marcar_('cobros');
  return { ok: true, pagos: ids, aFavor: sobra };
}

function api_cobConciliar(pin, pagoId, reparto, claveCuenta) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  const L = cobA_libro_();
  const p = L.pagos.filter(x => x.pagoId === String(pagoId))[0];
  if (!p) return { ok: false, error: 'No encontré el pago.' };
  const rep = (reparto || []).map(x => ({ factura: String(x.factura || '').trim(), monto: cobA_r2_(x.monto) })).filter(x => x.monto > 0);
  if (!rep.length) return { ok: false, error: 'Elige a qué factura va.' };
  const suma = cobA_r2_(rep.reduce((s, x) => s + x.monto, 0));
  if (suma > p.monto + 0.01) return { ok: false, error: 'El reparto pasa del monto del pago (B/. ' + p.monto.toFixed(2) + ').' };
  for (const x of rep) { if (!L.facPorNum[x.factura]) return { ok: false, error: 'No existe la factura ' + x.factura + '.' }; }
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_PAG);
  const nota = '[Conciliado por ' + a.u.nombre + ' el ' + fechaPanama_(L.hoy) + (p.factura ? '; decía «' + p.factura + '»' : '') + ']';
  const sobra = cobA_r2_(p.monto - suma);
  cobA_cambiar_(h, 'pagoId', p.pagoId, { factura: rep[0].factura, monto: rep[0].monto, notas: (p.notas ? p.notas + ' ' : '') + nota + (rep.length > 1 || sobra > 0.009 ? ' Pago original B/. ' + p.monto.toFixed(2) + ', repartido.' : '') });
  rep.slice(1).forEach((x, i) => cobA_agregar_(h, { pagoId: p.pagoId + '-' + (i + 2), factura: x.factura, fecha: p.fecha, monto: x.monto, metodo: p.metodo, referencia: p.referencia,
    cliente: p.cliente, notas: 'Parte del pago ' + p.pagoId + ' ' + nota, registradoPor: a.u.nombre, registradoEn: new Date() }));
  if (sobra > 0.009) cobA_agregar_(h, { pagoId: p.pagoId + '-F', factura: '', fecha: p.fecha, monto: sobra, metodo: p.metodo, referencia: p.referencia,
    cliente: p.cliente, notas: 'Saldo a favor del pago ' + p.pagoId + ' ' + nota, registradoPor: a.u.nombre, registradoEn: new Date() });
  /* aprender el nombre con que vino el pago, para la próxima vez */
  const f0 = L.facPorNum[rep[0].factura];
  const nom = cobA_nom_(p.cliente);
  if (nom && f0 && f0.clave && !L.alias[nom] && !(L.cuentas[f0.clave] && (cobA_nom_(L.cuentas[f0.clave].razon) === nom || cobA_nom_(L.cuentas[f0.clave].cliente) === nom)))
    cobA_agregar_(cobA_hoja_(HOJA_ALIAS, COLS_ALIAS), { nombre: p.cliente, clave: f0.clave, cuenta: (L.cuentas[f0.clave] || {}).cliente || '', aprendidoPor: a.u.nombre, aprendidoEn: L.hoy });
  marcar_('cobros');
  return { ok: true };
}

function api_cobMarcarDuplicado(pin, pagoId, igualA) {
