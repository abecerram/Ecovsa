  if (!/^\d{4}-\d{2}-\d{2}$/.test(desde) || !/^\d{4}-\d{2}-\d{2}$/.test(hasta)) falta.push('las fechas en que se ofrece');
  else if (desde > hasta) return { ok: false, error: 'La fecha «hasta» es antes de «desde».' };
