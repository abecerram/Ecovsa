  if (/CHORRERA/.test(s)) return 'CHORRERA';
  if (/COLON/.test(s)) return 'COLON';
  if (/OESTE|ARRAIJAN|CAPIRA/.test(s)) return 'PANAMÁ OESTE';
  if (/NORTE|SAN MIGUELITO|LAS CUMBRES|CHILIBRE/.test(s)) return 'PANAMÁ NORTE';
  if (/ESTE|TOCUMEN|PACORA|CHEPO|24 DE DICIEMBRE/.test(s)) return 'PANAMÁ ESTE';
  if (/INTERIOR|CHIRIQUI|COCLE|VERAGUAS|HERRERA|LOS SANTOS|BOCAS|DARIEN|DAVID|PENONOME|SANTIAGO|CHITRE/.test(s)) return 'INTERIOR';
