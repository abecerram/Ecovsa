  };
}
function mascara313_(cuenta) {
  const d = String(cuenta || '').replace(/\D/g, '');
  return d ? '••••' + d.slice(-4) : '';
}
function constEmpresa313_() { return (typeof EMPRESA !== 'undefined') ? EMPRESA : {}; }

function api_empresaDatos(pin) {
  const e = entrar313_(pin, 'admin'); if (e.error) return e.error;
  const g = empresaGuardada313_(), E = constEmpresa313_();
  return { ok: true, puedeEditar: true, empresa: {
