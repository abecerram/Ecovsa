  if (!banco) return { ok: false, error: 'Escriba el banco.' };
  if (!titular) return { ok: false, error: 'Escriba a nombre de quién está la cuenta.' };
  if (u4.length !== 4) return { ok: false, error: 'Escriba solo los últimos 4 dígitos de la cuenta.' };
  const cod = enl_txt_(p.codigoPropuesta);
  crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, { 'banco pago': banco, 'cuenta ult4': "'" + u4, 'titular cuenta': titular,
    'bancarios estado': 'POR_REVISAR', 'bancarios motivo': '', 'bancarios en': enl_ahora_() });
  crm_registrarActividad_(enl_u_(p), { tipo: 'nota', ref: cod, refTipo: 'op', cuenta: enl_txt_(p.empresa),
    texto: 'El cliente escribió sus datos bancarios en su enlace: ' + banco + ' ····' + u4 + ' · titular ' + titular + '. Por revisar.' });
  marcar_('mercadeo');
  return Object.assign({ ok: true }, enl_paraFormulario_(arc_prospecto_(cod), k));
}

function api_bancariosRevisar(pin, cod, decision, motivo, datos) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const p = arc_prospecto_(cod); if (!p) return { ok: false, error: 'No encontré la oportunidad.' };
  if (enl_txt_(p['bancarios estado']) !== 'POR_REVISAR') return { ok: false, error: 'Ya fueron revisados.' };
  const emp = enl_txt_(p.empresa);
  if (String(decision) === 'rechazar') {
    const m = enl_txt_(motivo, 300);
    if (!m) return { ok: false, error: 'Escribe qué hay que corregir: el cliente lo lee en su enlace.' };
    crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', enl_txt_(cod), { 'bancarios estado': 'RECHAZADO', 'bancarios motivo': m });
    crm_registrarActividad_(x.u, { tipo: 'nota', ref: enl_txt_(cod), refTipo: 'op', cuenta: emp, texto: 'Pidió corregir los datos bancarios: ' + m });
    marcar_('mercadeo');
    return { ok: true, estado: 'RECHAZADO' };
  }
  datos = datos || {};
  const c = { 'bancarios estado': 'ACEPTADO', 'doc datos bancarios': 'SI' };
  const banco = enl_txt_(datos.banco, 60), u4 = String(datos.ult4 || '').replace(/\D/g, ''), tit = enl_txt_(datos.titular, 120);
  if (banco) c['banco pago'] = banco;
  if (u4) { if (u4.length !== 4) return { ok: false, error: 'Los últimos dígitos son 4.' }; c['cuenta ult4'] = "'" + u4; }
  if (tit) c['titular cuenta'] = tit;
  crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', enl_txt_(cod), c);
  const p2 = arc_prospecto_(cod);
  crm_registrarActividad_(x.u, { tipo: 'nota', ref: enl_txt_(cod), refTipo: 'op', cuenta: emp,
    texto: 'Aceptó los datos bancarios: paga desde ' + enl_txt_(p2['banco pago']) + ' ····' + enl_txt_(p2['cuenta ult4']) + ' · titular ' + enl_txt_(p2['titular cuenta']) + '.' });
  marcar_('mercadeo');
  return { ok: true, estado: 'ACEPTADO', completo: arc_docsCliente_(p2).completo };
}

function api_enlacePedirDocs(pin, cod) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const p = arc_prospecto_(cod); if (!p) return { ok: false, error: 'No encontré la oportunidad.' };
  if (!funciones_().docsEnlace) return { ok: false, error: 'La carga de documentos por el cliente está apagada en Configuración › Funciones.' };
  if (esVisitaUnica_(p)) return { ok: false, error: 'La visita única no lleva documentos.' };
  if (enl_txt_(p.estado) === 'Rechazado') return { ok: false, error: 'La oportunidad está perdida: reábrela primero.' };
  if (!enl_txt_(p['enlace docs'])) {
    crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', enl_txt_(cod), { 'enlace docs': enl_ahora_() });
    crm_registrarActividad_(x.u, { tipo: 'nota', ref: enl_txt_(cod), refTipo: 'op', cuenta: enl_txt_(p.empresa), texto: 'Pidió los documentos: el enlace del cliente ya los pide.' });
    marcar_('mercadeo');
  }
  return { ok: true, clave: claveFormulario_(enl_txt_(cod)) };
}

function enl_paraOportunidad_(p) {
  const e = enl_estado_(p);
  e.clave = claveFormulario_(enl_txt_(p.codigoPropuesta));
  e.bancarios = { estado: enl_txt_(p['bancarios estado']), motivo: enl_txt_(p['bancarios motivo']), en: enl_txt_(p['bancarios en']),
                  banco: enl_txt_(p['banco pago']), ult4: enl_txt_(p['cuenta ult4']), titular: enl_txt_(p['titular cuenta']) };
  return e;
}


