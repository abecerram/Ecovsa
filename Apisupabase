/* ══════════ ATENCIÓN DE PEDIDOS ══════════ */
/* api 3.17 · solidez: el servidor solo contesta a las pantallas de ECOVSA
   (ecovsaapp.com, www, clientes.ecovsaapp.com y la dirección de GitHub Pages).
   Para pruebas en otra dirección: variable ECOVSA_ORIGENES (separadas por coma). */
const ORIGENES_OK = ['https://ecovsaapp.com', 'https://www.ecovsaapp.com', 'https://clientes.ecovsaapp.com', 'https://abecerram.github.io']
  .concat(String(Deno.env.get('ECOVSA_ORIGENES') || '').split(',').map(s => s.trim()).filter(Boolean));
const CORS = {
  'Access-Control-Allow-Origin': ORIGENES_OK[0],
  'Access-Control-Allow-Methods': 'POST, GET, OPTIONS',
  'Access-Control-Allow-Headers': 'content-type, authorization, apikey, x-client-info',
  'Vary': 'Origin'
};
function origenDe_(req) { const o = String(req.headers.get('origin') || ''); return ORIGENES_OK.indexOf(o) >= 0 ? o : ORIGENES_OK[0]; }
/* cada pedido contesta con su propio origen (los pedidos se atienden a la vez) */
function responderCon_(txt, estado, origen) {
  return new Response(txt, { status: estado || 200, headers: { ...CORS, 'Access-Control-Allow-Origin': origen || ORIGENES_OK[0], 'Content-Type': 'application/json; charset=utf-8' } });
}

async function atender(req) {
  const t0 = performance.now();
  const ms = () => Math.round(performance.now() - t0);
  const origen = origenDe_(req), responder = (t, e) => responderCon_(t, e, origen);
  if (req.method === 'OPTIONS') return new Response(null, { headers: { ...CORS, 'Access-Control-Allow-Origin': origen } });
  if (req.method === 'GET') {
    return responder(JSON.stringify({ ok: true, r: { servidor: VERSION_SERVIDOR, funciones: Object.keys(API).length }, ms: ms() }));
  }

  let p;
  try { p = JSON.parse((await req.text()) || '{}'); }
  catch (e) { return responder(JSON.stringify({ ok: false, error: 'Pedido ilegible', ms: ms() })); }

  const fn = String(p.fn || '');
  const esTarea = /^tarea_\w+$/.test(fn) && typeof TAREAS[fn] === 'function';
  if (!esTarea && (!/^api_\w+$/.test(fn) || typeof API[fn] !== 'function'))
    return responder(JSON.stringify({ ok: false, error: 'Función no permitida: ' + fn, ms: ms() }));
  const args = Array.isArray(p.args) ? p.args : [];
  /* api 3.12: equipo (lo manda puente.js) y conexión, para contar los intentos de PIN */
  _REQ_EQ = String(p.eq || '').slice(0, 40); _REQ_EQD = String(p.eqd || '').slice(0, 80);
  _REQ_IP = String(req.headers.get('x-forwarded-for') || req.headers.get('x-real-ip') || '').split(',')[0].trim().slice(0, 45);

  /* Guardados sin duplicar: si ya se atendió esta etiqueta, se devuelve
     la misma respuesta sin volver a guardar. */
  const clave = (p.esc && p.id) ? String(p.id).slice(0, 60) : '';
  const hojas = new Set(esTarea ? (fn === 'tarea_vigia' ? (HOJAS_DE.api_correrVigia || []) : (HOJAS_DE[fn] || ['Clientes', 'Recolecciones'])) : (HOJAS_DE[fn] || []));
  hojas.add('Usuarios');

  /* Un intento completo: leer → calcular → guardar.
     conCandado = false: primer intento, sin esperar a nadie.
     conCandado = true: se corre dentro de una transacción que ya tiene el
     candado; nadie más puede guardar en medio, así que no puede fallar por
     choque. Se usa solo si el primer intento chocó con otro guardado. */
  let opsDelPedido = [], gooDelPedido = [], iaDelPedido = [], presDelPedido = null;
  /* api 3.14: Configuración › Encender y apagar muestra quién está dentro de cada módulo */
  const presLeida = (fn === 'api_cfgModulos') ? await pres_leer_() : null;
  async function intento(db, conCandado) {
    for (let vuelta = 0; ; vuelta++) {
      if (clave) {
        const prev = await db`select respuesta from public.idempotencia where id = ${clave}`;
        if (prev.length) return prev[0].respuesta;
      }
      const leido = await cargarHojas([...hojas], db);
      /* Desde aquí hasta tener la lista de cambios no hay esperas: otro
         pedido no puede meterse a mitad de camino. */
      usarLeido_(leido);
      const versionLeida = _VERSION;
      __reiniciar();
      _ALM_OPS = []; _GOO_OPS = []; _IA_OPS = [];
      if (esTarea && (!_CLAVE_TAREAS || String(p.clave || '') !== _CLAVE_TAREAS))
        return JSON.stringify({ ok: false, error: 'Tarea no autorizada', ms: ms() });
      let r;
      _REQ_FN = esTarea ? '' : fn; _PRES_LEIDA = presLeida;
      try {
        r = esTarea ? TAREAS[fn]() : API[fn].apply(null, args);
        /* api 3.14: módulo en mantenimiento: no se guarda nada y la pantalla recibe el aviso */
        if (_MANT_BLOQ) { const b = _MANT_BLOQ; _MANT_BLOQ = null; return JSON.stringify({ ok: false, error: b.aviso, mantenimiento: b, ms: ms() }); }
        presDelPedido = _PRES_REG; _PRES_REG = null;
        if (!esTarea) r = seg_respuesta_(r);
        opsDelPedido = _ALM_OPS; _ALM_OPS = []; gooDelPedido = _GOO_OPS; _GOO_OPS = []; iaDelPedido = _IA_OPS; _IA_OPS = [];
        // estado del cliente al instante, si se tocaron recolecciones
        if (!esTarea && _LIBRO.has(HOJA_REC) && cambiosDelLibro_().tocadas.has(HOJA_REC)) actualizarEstadosClientes();
      } catch (err) {
        if (err instanceof FaltaHoja && vuelta < 8) {
          console.warn('[api] ' + fn + ' pidió la hoja ' + err.hoja + ' que no estaba en su lista');
          hojas.add(err.hoja);
          continue;
        }
        if (err instanceof FaltaHoja) throw err;
        if (err && err.mantenimiento) { _MANT_BLOQ = null; return JSON.stringify({ ok: false, error: err.message, mantenimiento: err.mantenimiento, ms: ms() }); }
        // la función falló: no se guarda nada de lo que alcanzó a escribir
        return JSON.stringify({ ok: false, error: String((err && err.message) || err), ms: ms() });
      }
      const txt = JSON.stringify({ ok: true, r: r === undefined ? null : r, ms: ms() });
      const cambios = cambiosDelLibro_();
      if (conCandado) await aplicarCambios_(db, cambios, clave, txt);
      else await guardarLibro_(cambios, clave, txt, versionLeida);
      return txt;
    }
  }

  try {
    let txt;
    try {
      txt = await intento(sql, false);
    } catch (err) {
      if (!(err instanceof Conflicto)) throw err;
      txt = await sql.begin(async tx => {
        await tx`select pg_advisory_xact_lock(770707)`;
        return intento(tx, true);
      });
    }
    if (presDelPedido) pres_anotar_(presDelPedido);   // api 3.14: sin esperar
    txt = await resolverAlmacen_(txt, opsDelPedido);
    txt = await resolverGoogle_(txt, gooDelPedido);
    txt = await resolverIA_(txt, iaDelPedido);   // api 3.20
    if (clave && Math.random() < 0.02)
      sql`delete from public.idempotencia where creado < now() - interval '2 days'`.catch(() => {});
    return responder(txt);
  } catch (err) {
    console.error('[api] ' + fn, err);
    return responder(JSON.stringify({ ok: false, error: 'Error del servidor: ' + String((err && err.message) || err), ms: ms() }));
  }
}

