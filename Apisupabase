}
function sst_lista_(tipo) { return sst_filas_(tipo).map(sst_item_); }
function sst_nuevoId_(tipo, T) {
  const filas = sst_tab_().filas.filter(f => sst_t_(f.tipo, 20) === tipo);
  const yy = hoyPanama_().slice(2, 4);
  let mx = 0;
  filas.forEach(f => {
    const m = /(\d+)$/.exec(sst_t_(f.regId, 40)), mm = /^[A-Z]+-(\d{2})-/.exec(sst_t_(f.regId, 40));
