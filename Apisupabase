function api_cfgAltaUsuario(pin, d) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  d = d || {};
  const nombre = cfgNombre_(d.nombre);
  const rol = String(d.rol || '').toLowerCase().trim();
  if (nombre.length < 3) return { ok: false, error: 'Escribe el nombre completo.' };
  if (!CFG_ROLES.some(r => r.id === rol)) return { ok: false, error: 'Elige qué va a hacer (el rol).' };
  const correo = String(d.correo || '').trim();
  if (correo && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) return { ok: false, error: 'El correo no se ve bien escrito.' };
  const filas = leerHoja_(HOJA_USR);
  if (filas.some(f => cfgActivo_(f) && cfgNombre_(f.nombre) === nombre))
    return { ok: false, error: 'Ya hay un usuario activo con ese nombre.' };
  const largo = Number(cfg_().seguridad.largoPin) === 6 ? 6 : 4;
  const np = cfgNuevoPin_(largo, filas);
  const H = cfgHojaUsr_();
  const ahora = Utilities.formatDate(new Date(), tzHoja_(), 'yyyy-MM-dd HH:mm');
  /* api 3.12: el PIN del alta es TEMPORAL: con él la persona crea el suyo al primer ingreso */
  const nuevo = { pin: np.huella, nombre: nombre, rol: rol, activo: 'SI', correo: correo, largoPin: largo,
    rubro: rol === 'operador' ? (d.rubro === 'solidos' ? 'solidos' : 'peligrosos') : '',
    telefono: String(d.telefono || '').trim(), altaPor: a.u.nombre, altaEn: ahora, pinCambiadoEn: ahora,
    pinTemporal: 'SI', pinVence: seg_mas_(SEG_TEMP_HORAS) };
  const fila = H.cab.map(c => nuevo[c] !== undefined ? nuevo[c] : '');
  H.h.appendRow(fila);
  const rn = (CFG_ROLES.find(r => r.id === rol) || {}).n || rol;
  cfgHistorial_(a.u, 'Usuarios', 'Dio de alta a ' + nombre + ' · ' + rn + (rol === 'operador' ? ' de ' + (nuevo.rubro === 'solidos' ? 'sólidos' : 'peligrosos') : ''), correo ? 'correo ' + correo : 'sin correo');
  return { ok: true, pin: np.pin, nombre: nombre, rol: rol, temporal: true, vence: nuevo.pinVence };
}

function cfgUbicar_(d) {
  const filas = leerHoja_(HOJA_USR);
  const i = Number(d && d.i);
  const nombre = String(d && d.nombre || '').trim();
  if (!(i >= 0) || !filas[i] || String(filas[i].nombre || '').trim() !== nombre) {
    const j = filas.findIndex(f => String(f.nombre || '').trim() === nombre);
    if (j < 0) return { error: { ok: false, error: 'No encontré a ese usuario. Recarga la pantalla.' } };
    return { i: j, f: filas[j], filas: filas };
  }
  return { i: i, f: filas[i], filas: filas };
}

function api_cfgEditarUsuario(pin, d) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  const x = cfgUbicar_(d); if (x.error) return x.error;
  const nombre = cfgNombre_(d.nuevoNombre || d.nombre);
  const rol = String(d.rol || x.f.rol).toLowerCase().trim();
  const correo = String(d.correo == null ? x.f.correo : d.correo).trim();
  if (nombre.length < 3) return { ok: false, error: 'Escribe el nombre completo.' };
  if (!CFG_ROLES.some(r => r.id === rol)) return { ok: false, error: 'Rol no válido.' };
  if (correo && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo)) return { ok: false, error: 'El correo no se ve bien escrito.' };
  const eraAdmin = String(x.f.rol).toLowerCase().trim() === 'admin';
  if (eraAdmin && rol !== 'admin' && cfgActivo_(x.f)) {
    const admins = x.filas.filter(f => cfgActivo_(f) && String(f.rol).toLowerCase().trim() === 'admin' && !cfgEsPrueba_(f.nombre));
    if (admins.length < 2) return { ok: false, error: 'Es el único administrador: primero da de alta otro.' };
  }
  const H = cfgHojaUsr_();
  const cambios = [];
  if (String(x.f.nombre || '').trim() !== nombre) cambios.push('nombre «' + String(x.f.nombre).trim() + '» → «' + nombre + '»');
  if (String(x.f.rol).toLowerCase().trim() !== rol) cambios.push('rol ' + x.f.rol + ' → ' + rol);
  if (String(x.f.correo || '').trim() !== correo) cambios.push('correo ' + (correo || '(sin correo)'));
  const tel = d.telefono == null ? String(x.f.telefono || '') : String(d.telefono).trim();
  if (String(x.f.telefono || '').trim() !== tel) cambios.push('teléfono ' + (tel || '(sin teléfono)'));
  /* api 3.7: módulo principal y «también sigue» */
  const pon = { nombre: nombre, rol: rol, correo: correo, telefono: tel };
  /* api 3.17.2 · rubro del conductor */
  if (d.rubro !== undefined && rol === 'operador') {
    const rb = d.rubro === 'solidos' ? 'solidos' : 'peligrosos', antes = /^s[oó]lidos?$/i.test(String(x.f.rubro || '').trim()) ? 'solidos' : 'peligrosos';
    if (rb !== antes) cambios.push('conductor de ' + (rb === 'solidos' ? 'sólidos' : 'peligrosos'));
    pon.rubro = rb;
  }
  const ids = CFG_PRINCIPALES.map(m => m.id), nomM = id => (CFG_PRINCIPALES.find(m => m.id === id) || {}).n || id;
  if (d.principal !== undefined) {
    const pr = String(d.principal || '').trim();
    if (pr && ids.indexOf(pr) < 0) return { ok: false, error: 'Módulo principal no válido.' };
    if (pr && permiso_({ rol: rol }, pr) === 'no') return { ok: false, error: 'Con el rol elegido no puede entrar a ' + nomM(pr) + '. Cambia el rol o elige otro módulo.' };
    if (String(x.f.moduloPrincipal || '').trim() !== pr) cambios.push('módulo principal ' + (pr ? nomM(pr) : 'el de su rol'));
    pon.moduloPrincipal = pr;
  }
  if (d.sigue !== undefined) {
    let sg = Array.isArray(d.sigue) ? d.sigue.map(String).filter(v => ids.indexOf(v) >= 0) : [];
    sg = sg.filter((v, i, a2) => a2.indexOf(v) === i && v !== (pon.moduloPrincipal !== undefined ? pon.moduloPrincipal : String(x.f.moduloPrincipal || '')));
    const txt = sg.length ? sg.join(',') : '-';
    if (String(x.f.sigue || '').trim() !== txt) cambios.push('también sigue: ' + (sg.length ? sg.map(nomM).join(', ') : 'nada'));
    pon.sigue = txt;
  }
  if (!cambios.length) return { ok: true, sinCambios: true };
  cfgPonerUsr_(H, x.i, pon);
  cfgHistorial_(a.u, 'Usuarios', 'Editó a ' + nombre, cambios.join(' · '));
  return { ok: true };
}

