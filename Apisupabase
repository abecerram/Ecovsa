}


/* ══════════ Incidentes y casi accidentes (ISO 45001 10.2) ══════════
   Un solo lugar para lo que pasó (los reportes F-LOG-03 de Logística: derrame, lesión, choque y seguridad) y lo que estuvo a punto
   de pasar (casi accidentes, que reporta cualquiera). La investigación es UNA sola: causa con los porqués, acción, verificación
   y cierre. Cuando el incidente viene de F-LOG-03, la misma causa y acción quedan escritas allá: no se anota dos veces. */
const SST_INC_TIPOS = ['derrame', 'lesion', 'choque', 'seguridad'];
const SST_INC_PASOS = ['Reportado', 'Causa', 'Acción', 'Verificación', 'Cerrado'];
/* Lo que pudo causar y qué tan grave pudo ser, mientras nadie lo haya investigado (se cambia al investigar) */
function sst_incDefecto_(i) {
  const d = i.datos || {};
  if (i.tipo === 'lesion') return { pot: 'Lesión del trabajador', g: 4 };
  if (i.tipo === 'choque') return { pot: 'Choque o vuelco con la carga', g: 4 };
  if (i.tipo === 'derrame') return { pot: 'Contacto con fluidos o derrame de la carga', g: String(d.controlado || '') === 'no' ? 4 : 3 };
  return { pot: 'Riesgo de seguridad', g: 3 };
}
function sst_incPaso_(estadoInc, inv) {
  if (inv && inv.paso !== undefined && inv.paso !== '') return Math.max(0, Math.min(4, Number(inv.paso) || 0));
  return INC_ABIERTOS.indexOf(String(estadoInc || '').toUpperCase()) >= 0 ? 0 : 4;
}
/* Todo junto: incidentes de Logística + casi accidentes, con su investigación y sus acciones */
function sst_incidentes_() {
  const invs = {}; sst_lista_('inv').forEach(v => { invs[v.ref] = v; });
  const acciones = sst_lista_('accion');
  const accDe = ref => acciones.filter(a => Array.isArray(a.o) && a.o[1] === ref).map(a => [a.j || 'A', a.q, a.r || '', a.f || '', a.id, a.e || 'pend']);
  const base = [];
  let F = [];
  try { F = inc_filas_().filter(i => SST_INC_TIPOS.indexOf(i.tipo) >= 0 && i.estado !== 'ANULADA'); } catch (e) { F = []; }
  F.forEach(i => {
    const v = invs[i.incId] || {}, df = sst_incDefecto_(i);
    base.push({ id: i.incId, t: 'inc', fecha: i.fecha, hora: i.hora, a: INC_TIPOS[i.tipo] || i.tipo, d: i.cliente || i.vehiculo || '', q: i.relato || inc_resumen_(i) || inc_titulo_(i),
      pot: v.pot || df.pot, g: Number(v.g) || df.g, por: (i.usuario || '') + ' (F-LOG-03)', paso: sst_incPaso_(i.estado, invs[i.incId]), resp: v.resp || 'Coordinación logística',
      why: v.why || [], ver: v.ver || '', mat: v.mat || '', baja: v.baja || '', dias: Number(v.dias) || 0, tipoLog: i.tipo, gravedadLog: i.gravedad, cerradoEn: v.cerradoEn || i.cerradaEn || '', origen: 'logistica',
      logCausa: i.causa || '', logAccion: i.accion || '', logVerificar: i.verificar || '', logCerrada: INC_ABIERTOS.indexOf(String(i.estado || '').toUpperCase()) < 0 });
  });
  sst_lista_('casi').forEach(c => {
    const v = invs[c.id] || {};
    base.push({ id: c.id, t: 'ca', fecha: c.fecha || String(c._creadoEn || '').slice(0, 10), hora: c.hora || '', a: c.a || '', d: c.d || '', q: c.q, pot: c.pot || '', g: Number(c.g) || 3, por: c.por || c._creadoPor,
      paso: sst_incPaso_('ENVIADA', invs[c.id]), resp: v.resp || c.resp || 'Responsable de SST', why: v.why || [], ver: v.ver || '', mat: v.mat || '', baja: '', dias: 0,
      fotos: c.fotos || [], cerradoEn: v.cerradoEn || '', origen: 'seguridad' });
  });
  base.forEach(b => { b.acc = accDe(b.id); });
  return base.sort((a, b) => (String(b.fecha) + String(b.hora)).localeCompare(String(a.fecha) + String(a.hora)));
}
function api_segIncidentes(pin) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  return { ok: true, items: sst_incidentes_(), pasos: SST_INC_PASOS, hoy: hoyPanama_(), puede: { editar: x.puedeEditar } };
}
/* Avanza la investigación de un incidente o casi accidente al paso siguiente.
   d = { paso: 1..4, why: [textos], pot, g, resp, acc: [{ j, q, r, f }], ver, mat, baja: 'si'|'no', dias }
   0→1 anotar la causa (al menos un porqué) · 1→2 registrar la acción (al menos una) · 2→3 marcar la acción hecha · 3→4 verificar y cerrar (con la verificación) */
function api_segIncAvanzar(pin, ref, d) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  if (!x.puedeEditar) return { ok: false, error: 'Tu usuario no puede investigar incidentes.' };
  d = d && typeof d === 'object' ? d : {};
  ref = sst_t_(ref, 40);
  const inc = sst_incidentes_().find(z => z.id === ref);
  if (!inc) return { ok: false, error: 'No encontré ese reporte.' };
  const t = sst_tab_(), fila = t.filas.find(f => sst_t_(f.tipo, 20) === 'inv' && sst_t_(f.ref, 60) === ref && sst_t_(f.estado, 12) !== 'quitado');
  const v = fila ? sst_json_(fila.datos, {}) : { ref: ref };
  const paso = inc.paso, ahora = "'" + sst_ahora_(), hoy = hoyPanama_();
  const quiere = d.paso === undefined ? paso : Number(d.paso);
  if (quiere < paso || quiere > paso + 1) return { ok: false, error: 'La investigación va paso por paso.' };
  if (paso === 4) return { ok: false, error: 'Ese reporte ya está cerrado.' };
  const porques = (Array.isArray(d.why) ? d.why : v.why || []).map(s => sst_t_(s, 300)).filter(Boolean).slice(0, 8);
  if (d.pot !== undefined) v.pot = sst_t_(d.pot, 120);
  if (d.g !== undefined && Number(d.g) >= 1 && Number(d.g) <= 5) v.g = Number(d.g);
  if (d.resp !== undefined) v.resp = sst_t_(d.resp, 80);
  if (d.baja !== undefined) v.baja = d.baja === 'si' ? 'si' : d.baja === 'no' ? 'no' : '';
  if (d.dias !== undefined) v.dias = Math.max(0, Math.min(365, Number(d.dias) || 0));
  if (d.mat !== undefined) v.mat = sst_t_(d.mat, 300);
  if (porques.length) v.why = porques;
  let nuevoPaso = paso;
  if (quiere === paso + 1) {
    if (quiere === 1 && !porques.length) return { ok: false, error: 'Escriba al menos el primer porqué.' };
    if (quiere === 2) {
      const L = (Array.isArray(d.acc) ? d.acc : []).map(a => ({ j: ['E', 'S', 'I', 'A', 'P'].indexOf(a.j) >= 0 ? a.j : 'A', q: sst_t_(a.q, 300), r: sst_t_(a.r, 80), f: sst_iso_(a.f) })).filter(a => a.q);
      if (!L.length && !inc.acc.length) return { ok: false, error: 'Registre al menos una acción.' };
      if (!porques.length && !(v.why || []).length) return { ok: false, error: 'Falta la causa.' };
      L.forEach(a => {
        const T = SST_TIPOS.accion, rid = sst_nuevoId_('accion', T);
        agregar313_(sst_tab_(), { regId: rid, tipo: 'accion', ref: ref, estado: 'activo', creadoPor: x.u.nombre, creadoEn: ahora, cambiadoPor: x.u.nombre, cambiadoEn: ahora,
          datos: JSON.stringify({ o: ['inc', ref, inc.t === 'ca' ? 'Casi accidente' : 'Incidente'], j: a.j, q: a.q, r: a.r || v.resp || '', f: a.f, e: 'curso' }) });
      });
    }
    if (quiere === 3) {
      const mias = sst_filas_('accion').filter(f => { const o = sst_json_(f.datos, {}).o; return Array.isArray(o) && o[1] === ref; });
      if (!mias.length) return { ok: false, error: 'No hay acciones que marcar.' };
      mias.forEach(f => { const a = sst_json_(f.datos, {}); if (a.e !== 'cerr') { a.e = 'hecha'; actualizar313_(sst_tab_(), f._fila, { datos: JSON.stringify(a), cambiadoPor: x.u.nombre, cambiadoEn: ahora }); } });
    }
    if (quiere === 4) {
      const ver = sst_t_(d.ver, 400);
      if (!ver) return { ok: false, error: 'Escriba cómo se comprobó que funcionó.' };
      v.ver = ver; v.cerradoEn = hoy;
      const mias = sst_filas_('accion').filter(f => { const o = sst_json_(f.datos, {}).o; return Array.isArray(o) && o[1] === ref; });
      mias.forEach(f => { const a = sst_json_(f.datos, {}); a.e = 'cerr'; a.v = a.v || ver; actualizar313_(sst_tab_(), f._fila, { datos: JSON.stringify(a), cambiadoPor: x.u.nombre, cambiadoEn: ahora }); });
      sst_cerrarLog_(inc, v, x.u, mias.map(f => sst_json_(f.datos, {}).q));
    }
    nuevoPaso = quiere;
  }
  v.paso = nuevoPaso;
  if (fila) actualizar313_(t, fila._fila, { datos: JSON.stringify(v), cambiadoPor: x.u.nombre, cambiadoEn: ahora });
  else agregar313_(t, { regId: sst_nuevoId_('inv', SST_TIPOS.inv), tipo: 'inv', ref: ref, estado: 'activo', creadoPor: x.u.nombre, creadoEn: ahora, cambiadoPor: x.u.nombre, cambiadoEn: ahora, datos: JSON.stringify(v) });
  sst_his_(x.u, (nuevoPaso === 4 ? 'Cerró la investigación de ' : 'Investigó ') + ref, SST_INC_PASOS[nuevoPaso]);
  return { ok: true, id: ref, paso: nuevoPaso };
}
/* Si el reporte vino de Logística, su causa y su acción quedan también en el F-LOG-03 (una sola investigación) y se cierra allá */
function sst_cerrarLog_(inc, v, u, acciones) {
  if (inc.origen !== 'logistica') return;
  let x = null;
  try { x = inc_filas_().find(z => z.incId === inc.id); } catch (e) { return; }
  if (!x || !inc_abierta_(x)) return;
  const tenia = (x.fotos || []).length && !x.fotosBorradas;
  try { inc_borrarFotos_(x, 'Incidencia cerrada'); } catch (e) {}
  inc_cambiar_(x.incId, { estado: 'CERRADA', causa: String((v.why || []).slice(-1)[0] || '').slice(0, 300), accion: acciones.join(' · ').slice(0, 500),
    prevencion: String(v.mat || '').slice(0, 500), verificar: String(v.ver || '').slice(0, 200), cerradaPor: u.nombre, cerradaEn: inc_ahora_(),
    fotosBorradas: tenia ? inc_ahora_() : (x.fotosBorradas || ''), vistaPor: x.vistaPor || u.nombre, vistaEn: x.vistaEn || inc_ahora_() });
}

/* ══════════ Acciones de mejora ══════════
   Todo lo que hay que corregir, venga de donde venga (incidente, casi accidente, auditoría, simulacro, consulta, norma). */
