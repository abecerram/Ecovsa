    const f = fechaISO_(r.fecha), id = String(r.rutaId || ''); if (!f || !id) return;
    const ru = m[id] = m[id] || { rutaId: id, fecha: f, conductor: String(r.conductor || ''), vehiculo: String(r.vehiculo || ''),
      estadoPlan: esBorrador_(r) ? 'borrador' : 'publicada', estadoRuta: String(r.estadoRuta || '').toUpperCase(),
      motivoCierre: String(r.motivoCierre || ''), horaSalida: horaTxt_(r.horaSalida), regresoMin: Number(r.regresoMin) || null,   // api 3.15
      creadaPor: String(r.creadaPor || ''), creadaEn: r.creadaEn || '', publicadaPor: String(r.publicadaPor || ''),
      publicadaEn: r.publicadaEn ? fechaISO_(r.publicadaEn) + ' ' + horaTxt_(r.publicadaEn) : '', paradas: [] };
    const cid = Number(r.clienteId);
    if (!cid || ru.paradas.some(p => p.clienteId === cid)) return;
    ru.paradas.push({ clienteId: cid, orden: Number(r.orden) || 0, origen: String(r.origenParada || ''), horaPlan: horaTxt_(r.horaPlan) });
  });
  return Object.keys(m).map(k => { m[k].paradas.sort((a, b) => a.orden - b.orden); return m[k]; });
}

function plan_quitados_() {
  try { return leerHoja_(HOJA_PQ).map(q => ({ fecha: fechaISO_(q.fecha), clienteId: Number(q.clienteId), origen: String(q.origen || ''),
                                              motivo: String(q.motivo || ''), rutaId: String(q.rutaId || '') })).filter(q => q.fecha && q.clienteId); }
  catch (e) { return []; }
}

function plan_anotarQuitado_(fecha, clienteId, rutaId, origen, motivo, u) {
  const h = hojaPlanta_(HOJA_PQ, COLS_PQ);
  h.appendRow(filaPorNombre_(h, { fecha: fecha, clienteId: Number(clienteId), rutaId: rutaId || '', origen: origen || '',
                                  motivo: motivo || 'quitado solo esta vez', por: u.nombre, en: new Date() }));
}

function plan_agregar_(rutaId, fecha, conductor, vehiculo, estadoPlan, items, u) {
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
  asegurarColumnas_(h, COLS_RUT.concat(COLS_PLAN.filter(c => COLS_RUT.indexOf(c) < 0)));
  const ya = {}; let orden = 0;
  leerHoja_(HOJA_RUT).forEach(r => { if (String(r.rutaId) === rutaId) { ya[Number(r.clienteId)] = 1; orden = Math.max(orden, Number(r.orden) || 0); } });
  const ahora = new Date(); let n = 0;
  items.forEach(it => {
    const id = Number(it.clienteId); if (!id || ya[id]) return;
    orden++; ya[id] = 1; n++;
    h.appendRow(filaPorNombre_(h, { rutaId: rutaId, fecha: fecha, conductor: conductor, vehiculo: vehiculo, orden: orden, clienteId: id,
                                   creadaPor: u.nombre, creadaEn: ahora, estadoPlan: estadoPlan === 'borrador' ? 'borrador' : '',
                                   origenParada: it.origen || '' }));
  });
  return n;
}

function plan_arrastre_(rutas, P, quit, hoy, F) {
  const hechoEn = {};
  Object.keys(P.idx.visitas).forEach(id => { hechoEn[id] = {}; P.idx.visitas[id].forEach(r => hechoEn[id][fechaISO_(r['Fecha de Recoleccion'])] = 1); });
  const out = [], visto = {};
  rutas.filter(r => r.fecha < F && r.fecha >= ini_dia_(F, -14) && r.estadoPlan === 'publicada' &&
                    (r.fecha < hoy || r.estadoRuta === 'TERMINADA ANTES')).forEach(r => {
    const destino = plan_habilDespues_(r.fecha > hoy ? r.fecha : (r.fecha === hoy ? hoy : ini_dia_(hoy, -1)));
    if (destino !== F) return;
    r.paradas.forEach(p => {
      const id = p.clienteId, pl = P.plan[id];
      if (!pl || !pl.activo || visto[id]) return;
      if (hechoEn[id] && hechoEn[id][r.fecha]) return;
      if (pl.ultimaReal && pl.ultimaReal > r.fecha) return;
      if (rutas.some(o => o.fecha > r.fecha && o.fecha !== F && o.paradas.some(x => x.clienteId === id))) return;
      if (quit.some(q => q.clienteId === id && q.fecha > r.fecha)) return;
      visto[id] = 1;
      out.push({ clienteId: id, desde: r.fecha, conductor: r.conductor, motivo: r.estadoRuta === 'TERMINADA ANTES' ? ('terminó antes' + (r.motivoCierre ? ': ' + r.motivoCierre : '')) : 'quedó pendiente' });
    });
  });
  return out;
}

function api_planDia(pin, fecha) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística planifica rutas.' };
  tab_try_(() => asis_tick_(), null);   // api 3.31
  const hoy = hoyPanama_();
  const F = /^\d{4}-\d{2}-\d{2}$/.test(String(fecha || '')) ? String(fecha) : plan_habilDespues_(hoy);
  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC);
  const P = cli_plan_(CLI, REC, hoy);
  let quit = plan_quitados_();
  let rutas = plan_rutas_(leerHoja_(HOJA_RUT));
  const cfg = cfgLog_();
  let ACT = []; try { ACT = leerHoja_(HOJA_ACT); } catch (e) {}

  /* ── carga automática ── */
  const recF = CLI.filter(c => { const pl = P.plan[Number(c.id)]; return pl && pl.activo && cli_tocaRec_(pl, F); }).map(c => Number(c.id));
  const arr = plan_arrastre_(rutas, P, quit, hoy, F);
  const deF = () => rutas.filter(r => r.fecha === F);
  const enF = id => deF().some(r => r.paradas.some(p => p.clienteId === id));
  const quitadoF = id => quit.some(q => q.fecha === F && q.clienteId === id);
  let auto = [];
  recF.forEach(id => { if (!enF(id) && !quitadoF(id)) auto.push({ clienteId: id, origen: 'recurrente' }); });
  arr.forEach(a => { if (!enF(a.clienteId) && !quitadoF(a.clienteId) && !auto.some(x => x.clienteId === a.clienteId)) auto.push({ clienteId: a.clienteId, origen: 'arrastre:' + a.desde }); });
  /* api 3.5.2 · las recolecciones extra programadas para este día se cargan solas */
  const EXT = (typeof sol_extrasAbiertas_ === 'function') ? sol_extrasAbiertas_() : [];
  EXT.filter(x => x.programada === F).forEach(x => { if (!enF(x.clienteId) && !quitadoF(x.clienteId) && !auto.some(a => a.clienteId === x.clienteId)) auto.push({ clienteId: x.clienteId, origen: 'extra:' + x.folio }); });
  let porConfirmar = [], cargadosAhora = 0;
  const puedeAuto = F >= hoy && F <= ini_dia_(hoy, 21);
  if (auto.length && puedeAuto) {
    const borr = deF().filter(r => r.estadoPlan === 'borrador');
    const lock = LockService.getScriptLock(); lock.waitLock(20000);
    try {
      if (borr.length) {
        const porRuta = {};
        auto.forEach(a => {
          const pl = P.plan[a.clienteId];
          const r = borr.find(b => pl && pl.conductorPref && b.conductor.toLowerCase() === pl.conductorPref.toLowerCase()) || borr[0];
          (porRuta[r.rutaId] = porRuta[r.rutaId] || { r: r, items: [] }).items.push(a);
        });
        Object.keys(porRuta).forEach(k => { const x = porRuta[k]; cargadosAhora += plan_agregar_(x.r.rutaId, F, x.r.conductor, x.r.vehiculo, 'borrador', x.items, u); });
      } else if (!deF().length) {
        const cuenta = {}, cuentaV = {};
        auto.forEach(a => { const pl = P.plan[a.clienteId]; if (pl && pl.conductorPref) cuenta[pl.conductorPref] = (cuenta[pl.conductorPref] || 0) + 1;
                            if (pl && pl.vehiculoPref) cuentaV[pl.vehiculoPref] = (cuentaV[pl.vehiculoPref] || 0) + 1; });
        const ult = rutas.filter(r => r.fecha < F).sort((a, b) => b.fecha.localeCompare(a.fecha))[0] || {};
        const cond = Object.keys(cuenta).sort((a, b) => cuenta[b] - cuenta[a])[0] || ult.conductor || (operadoresActivos_()[0] || '');
        const veh = Object.keys(cuentaV).sort((a, b) => cuentaV[b] - cuentaV[a])[0] || ult.vehiculo || (vehiculosFlota_()[0] || {}).placa || '';
        if (cond && veh) cargadosAhora += plan_agregar_('R' + new Date().getTime(), F, cond, veh, 'borrador', auto, u);
      } else porConfirmar = auto;
    } finally { lock.releaseLock(); }
    if (cargadosAhora) rutas = plan_rutas_(leerHoja_(HOJA_RUT));
    /* la solicitud se entera de en qué ruta quedó */
    if (cargadosAhora) EXT.filter(x => x.programada === F).forEach(x => {
      const r = rutas.find(r => r.fecha === F && r.paradas.some(p => p.clienteId === x.clienteId && p.origen === 'extra:' + x.folio));
      if (r) sol_extraPuesta_(x.folio, F, r, u); });
  } else if (auto.length) porConfirmar = auto;

  /* ── a quién le toca ── */
  const diaF = String(ini_dow_(F) === 0 ? 7 : ini_dow_(F));
  const enRutaDesde = {};
  rutas.forEach(r => { if (r.fecha < hoy) return; r.paradas.forEach(p => { const e = enRutaDesde[p.clienteId]; if (!e || r.fecha < e.fecha || r.fecha === F) enRutaDesde[p.clienteId] = { fecha: r.fecha, rutaId: r.rutaId, conductor: r.conductor }; }); });
  const grupos = { extra: [], recurrentes: [], arrastre: [], tocan: [], atrasados: [], pendientes: [], nuevos: [] };
  const usado = {};
  const meter = (g, id, motivo, extra) => { if (usado[id]) return; usado[id] = 1; const o = { id: id, motivo: motivo, enRuta: enRutaDesde[id] || null }; if (extra) Object.keys(extra).forEach(k => o[k] = extra[k]); grupos[g].push(o); };
  /* las que pidió el cliente: las de este día y las que nadie ha programado */
  EXT.filter(x => x.programada === F || !x.programada).forEach(x => meter('extra', x.clienteId,
    'recolección extra · ' + (x.programada === F ? 'programada para este día' : String(x.cuando || 'lo antes posible').toLowerCase()) +
    (x.cantidad && !/^no sabe$/i.test(x.cantidad) ? ' · ' + x.cantidad : '') + ' · ' + x.folio,
    { folio: x.folio, urge: x.prioridad === 'alta' }));
  recF.forEach(id => meter('recurrentes', id, P.plan[id].recTxt));
  arr.forEach(a => meter('arrastre', a.clienteId, 'no se atendió el ' + ini_fechaTxt_(a.desde) + ' · ' + a.motivo, { desde: a.desde }));
  CLI.forEach(c => {
    const id = Number(c.id), pl = P.plan[id]; if (!pl || !pl.activo) return;
    const fijos = String(c['dias semana'] || '').split(/[^0-9]+/).filter(String);
    if (fijos.indexOf(diaF) >= 0) meter('tocan', id, 'día fijo');
    else if (pl.proxima === F && !pl.recurrencia) meter('tocan', id, (c.frecuencia ? String(c.frecuencia).toLowerCase() + ' · ' : '') + 'le toca este día');
  });
  quit.filter(q => q.fecha < F && q.fecha >= ini_dia_(hoy, -30)).forEach(q => {
    const pl = P.plan[q.clienteId]; if (!pl || !pl.activo) return;
    if (pl.ultimaReal && pl.ultimaReal >= q.fecha) return;
    if (rutas.some(r => r.fecha >= q.fecha && r.fecha !== q.fecha && r.fecha !== F && r.paradas.some(p => p.clienteId === q.clienteId))) return;
    meter('pendientes', q.clienteId, 'se quitó del ' + ini_fechaTxt_(q.fecha) + (q.origen ? ' · ' + (q.origen === 'recurrente' ? 'era recurrente' : 'venía arrastrado') : ''));
  });
  CLI.forEach(c => {
    const id = Number(c.id), pl = P.plan[id]; if (!pl || !pl.activo || !pl.proxima) return;
    if (pl.proxima < F && !(enRutaDesde[id] && enRutaDesde[id].fecha <= F)) {
      const d = ini_diasEntre_(pl.proxima, F);
      meter('atrasados', id, (d > 7 ? 'atrasado ' : 'vencido ') + d + (d === 1 ? ' día' : ' días'), { dias: d });
    }
  });
  grupos.atrasados.sort((a, b) => b.dias - a.dias);
  CLI.forEach(c => { const id = Number(c.id), pl = P.plan[id]; if (pl && pl.activo && !pl.visitas && !pl.ultima) meter('nuevos', id, 'sin visitas todavía' + (c.lat ? '' : ' · sin ubicación')); });

  /* ── los clientes que la pantalla necesita para calcular horas y kg ── */
  const minHist = {};
  Object.keys(P.idx.visitas).forEach(id => {
    const ms = P.idx.visitas[id].map(r => minutosEntre_(horaTxt_(r['hora inicio']), horaTxt_(r['hora final']))).filter(m => m >= 3 && m <= 120);
    const kgs = P.idx.visitas[id].slice(-8).map(r => Number(r['total Kg']) || (Number(r['Kg Recolectados']) || 0) + (Number(r['kg anatomopatologico']) || 0) + (Number(r['kg punzo cortantes']) || 0));
    minHist[id] = { min: ms.length ? Math.round(ms.slice(-8).reduce((a, b) => a + b, 0) / Math.min(8, ms.length)) : null,
                    kg: kgs.length ? ini_r_(kgs.reduce((a, b) => a + b, 0) / kgs.length, 1) : null };
  });
  const necesito = {};
  EXT.forEach(x => necesito[x.clienteId] = 1);
  rutas.filter(r => r.fecha === F).forEach(r => r.paradas.forEach(p => necesito[p.clienteId] = 1));
  const clientes = CLI.filter(c => Number(c.id) && ((P.plan[Number(c.id)] || {}).activo || necesito[Number(c.id)])).map(c => {
    const id = Number(c.id), pl = P.plan[id], h = minHist[id] || {};
    return { id: id, nombre: String(c.nombre || ''), zona: String(c.region || ''), lat: numeroSeguro_(c.lat), lng: numeroSeguro_(c.lng),
             kg: h.kg !== null && h.kg !== undefined ? h.kg : (Number(c.kg) || null),
             min: Number(c.minutosParada) || h.min || null, minFijo: !!Number(c.minutosParada), minHist: h.min || null,
             hTipo: String(c.horarioTipo || '').toLowerCase(), hDesde: horaTxt_(c.horarioDesde), hHasta: horaTxt_(c.horarioHasta),
             frec: String(c.frecuencia || ''), rec: pl ? pl.recurrencia : '', recTxt: pl ? pl.recTxt : '', pausada: pl ? pl.pausada : false,
             recDatos: pl && pl.recurrencia ? { patron: pl.recurrencia, dias: pl.recDias, semana: pl.recSemana, desde: pl.recDesde, hasta: pl.recHasta,
                                                conductor: pl.conductorPref, vehiculo: pl.vehiculoPref, pausaHasta: pl.pausaHasta, pausaMotivo: pl.pausaMotivo } : null,
             tel: String(c.telefono || ''), fijo: String(c['dias semana'] || ''), activo: pl ? pl.activo : false, proxima: pl ? pl.proxima : '',
             ultima: pl ? pl.ultima || '' : '' };   /* api 3.7: la última recolección, para la lista */
  });

  /* ── camiones: tope, bloqueo y revisión de hoy ── */
  let fal = []; try { fal = fallasAbiertas_(''); } catch (e) {}
  let revHoy = {}; try { leerHoja_(HOJA_REV).forEach(r => { if (fechaISO_(r.fecha) === hoy && String(r.momento) === 'salida') revHoy[normVeh_(r.vehiculo)] = { hora: horaTxt_(r.hora), bien: Number(r.bien) || 0, puntos: Number(r.puntos) || 0 }; }); } catch (e) {}
  let flota = []; try { flota = vehiculosFlota_(); } catch (e) { flota = VEHICULOS_BASE.map(p => ({ placa: p })); }
  const vehiculos = flota.map(v => ({ placa: v.placa, tope: topeCamion_(v.placa, cfg, ACT),
    bloqueo: fal.filter(f => f.bloquea && normVeh_(f.vehiculo) === normVeh_(v.placa)).map(f => f.punto)[0] || '',
    fallas: fal.filter(f => !f.bloquea && normVeh_(f.vehiculo) === normVeh_(v.placa)).length,
    revisionHoy: revHoy[normVeh_(v.placa)] || null }));

  /* hora de salida habitual (45 días) */
  const hace45 = ini_dia_(hoy, -45);
  const sal = leerHoja_(HOJA_JOR).filter(j => { const f = fechaISO_(j.fecha); return f >= hace45 && f < hoy; })
    .map(j => ini_min_(horaTxt_(j.horaInicio))).filter(m => m !== null && m > 300 && m < 720);
  const salida = horaValida_(cfg.salida) ? String(cfg.salida) : (sal.length ? ini_hhmm_(sal.reduce((a, b) => a + b, 0) / sal.length) : SALIDA_BASE);

  const recTotal = CLI.filter(c => (P.plan[Number(c.id)] || {}).recurrencia && (P.plan[Number(c.id)] || {}).activo).length;
  let operadores = []; try { operadores = operadoresActivos_(); } catch (e) {}
  return {
    ok: true, hoy: hoy, fecha: F, anterior: (() => { let d = ini_dia_(F, -1); for (let i = 0; i < 7 && (ini_dow_(d) === 0 || ini_dow_(d) === 6); i++) d = ini_dia_(d, -1); return d; })(),
    siguiente: plan_habilDespues_(F), pasado: F < hoy,
    rutas: map_conInfo_(rutas.filter(r => r.fecha === F), F, cfg), cargadosAhora: cargadosAhora, porConfirmar: porConfirmar,
    /* api 3.6: destinos de entrega, lo que hay en acopio y si Google está conectado */
    destinos: destinos_(cfg), acopio: map_acopio_(), google: map_google_(cfg),
    grupos: grupos, clientes: clientes, vehiculos: vehiculos, operadores: operadores,
    config: { salida: salida, baseLat: Number(cfg.baseLat) || null, baseLng: Number(cfg.baseLng) || null, baseNombre: String(cfg.baseNombre || ''), minSitio: MIN_SITIO_BASE },
    recurrentes: recTotal,
    asisDias: tab_try_(() => asis_marcasDia_(rutas), {}), asisOn: tab_try_(() => asis_cfg_().on, false),   // api 3.31
    semana: (() => { const out = []; let d = F; for (let i = 0; i < 5; i++) { const rs = rutas.filter(r => r.fecha === d); out.push({ fecha: d, paradas: rs.reduce((s, r) => s + r.paradas.length, 0), rutas: rs.length, borrador: rs.some(r => r.estadoPlan === 'borrador') }); d = plan_habilDespues_(d); } return out; })()
  };
}

function api_guardarPlan_330_(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística planifica rutas.' };
  d = d || {};
  const F = String(d.fecha || '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(F)) return { ok: false, error: 'Falta la fecha.' };
  const cond = String(d.conductor || '').trim(), veh = String(d.vehiculo || '').trim();
  if (!cond) return { ok: false, error: 'Elige el conductor.' };
  if (!veh) return { ok: false, error: 'Elige el camión.' };
  const estado = d.estadoPlan === 'publicada' ? 'publicada' : 'borrador';
  const vistos = {};
  const paradas = (d.paradas || []).filter(p => { const k = Number(p.clienteId); if (!k || vistos[k]) return false; vistos[k] = 1; return true; });
  /* api 3.6: un viaje a planta lleva su destino y puede ir sin clientes */
  const tipo = d.tipo === 'planta' ? 'planta' : 'recoleccion';
  const dst = tipo === 'planta' ? destino_(d.destinoId) : null;
  if (tipo === 'planta' && !dst) return { ok: false, error: 'Elige a qué planta va el viaje.' };
  if (!paradas.length && tipo !== 'planta') return { ok: false, error: 'La ruta no tiene paradas.' };
  if (d.horaSalida && !horaValida_(d.horaSalida)) return { ok: false, error: 'Hora de salida no válida.' };

  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
    asegurarColumnas_(h, COLS_RUT.concat(COLS_PLAN.filter(c => COLS_RUT.indexOf(c) < 0)));
    const todas = leerHoja_(HOJA_RUT);
    const rutaId = String(d.rutaId || '') || ('R' + new Date().getTime());
    /* api 3.15: un conductor puede tener dos rutas ese día si los horarios no chocan (30 min de margen) */
    const I315 = rinf_leer_();
    const sN = rut_min_(d.horaSalida) !== null ? rut_min_(d.horaSalida) : rut_salidaBase_();
    let rN = Number(d.regresoMin) || null;
    if (!rN) { const hp = paradas.map(p => rut_min_(p.horaPlan)).filter(x => x !== null); rN = hp.length ? Math.max.apply(null, hp) + 45 : sN + 480; }
    if (rN <= sN) rN = sN + 60;
    const nueva = { s: sN, r: rN };
    const otras = rut_delDia_(todas, I315, F, rutaId);
    const choca = otras.filter(o => o.conductor.trim().toLowerCase() === cond.toLowerCase() && rut_chocan_(nueva, o.v, RUT_MARGEN_MIN));
    if (choca.length) {
      const o = choca[0], sug = Math.max.apply(null, choca.map(x => x.v.r)) + RUT_MARGEN_MIN, sabe = choca.every(x => x.v.sabe);
      return { ok: false, choqueHorario: true, salidaSugerida: sabe && sug < 1440 ? rut_hhmm_(sug) : '',
               error: cond + ' ya tiene otra ruta ese día' + (o.v.sabe ? ' (sale a las ' + rut_hhmm_(o.v.s) + ' y regresa ≈ ' + rut_hhmm_(o.v.r) + ')' : '') +
                      '. Entre una ruta y otra deben quedar al menos ' + RUT_MARGEN_MIN + ' min' + (o.v.sabe ? '.' : ': abre esa ruta y guárdala de nuevo para que tenga su hora de regreso.') };
    }
    /* el camión puede ser el mismo u otro; si ya está ocupado a esa hora, se avisa y logística decide */
    if (!d.camionOcupadoOk) {
      const ocup = otras.filter(o => normVeh_(o.vehiculo) === normVeh_(veh) && rut_chocan_(nueva, o.v, 0));
      if (ocup.length) return { ok: false, camionOcupado: true,
        error: veh + ' ya sale ese día con ' + ocup[0].conductor + (ocup[0].v.sabe ? ' de ' + rut_hhmm_(ocup[0].v.s) + ' a ≈ ' + rut_hhmm_(ocup[0].v.r) : '') + '.' };
    }
    const nombreDe = {}; leerHoja_(HOJA_CLI).forEach(c => nombreDe[Number(c.id)] = String(c.nombre || ''));
    const choque = todas.filter(r => fechaISO_(r.fecha) === F && String(r.rutaId) !== rutaId && vistos[Number(r.clienteId)]);
    if (choque.length) return { ok: false, error: choque.slice(0, 3).map(r => nombreDe[Number(r.clienteId)] || ('Cliente ' + r.clienteId)).join(', ') +
      (choque.length > 3 ? ' y ' + (choque.length - 3) + ' más' : '') + ' ya ' + (choque.length === 1 ? 'está' : 'están') + ' en la ruta de ' + String(choque[0].conductor || '') + ' ese día. Quítalos de una de las dos.' };
    const viejas = todas.filter(r => String(r.rutaId) === rutaId);
    /* api 3.34.1: no se agrega a la ruta un cliente suspendido o de baja (los que ya estaban, se respetan) */
    const fueraN = rut_fueraNuevos_(paradas.map(p => p.clienteId), viejas.map(r => r.clienteId));
    if (fueraN.length) return { ok: false, error: rut_errorFuera_(fueraN) };
    const antes = viejas[0] || {};
    const eraBorrador = viejas.length ? esBorrador_(antes) : true;

    // lo que se cargó solo y ya no está: «quitado solo esta vez»
    viejas.forEach(r => {
      const o = String(r.origenParada || '');
      if (o && o.indexOf('extra:') !== 0 && !vistos[Number(r.clienteId)] && fechaISO_(r.fecha) === F) plan_anotarQuitado_(F, r.clienteId, rutaId, o.split(':')[0], 'quitado solo esta vez', u);
    });

    const vals = h.getDataRange().getValues(), cab = vals[0].map(String), cId = cab.indexOf('rutaId');
    for (let i = vals.length - 1; i >= 1; i--) if (String(vals[i][cId]) === rutaId) h.deleteRow(i + 1);

    const ahora = new Date();
    const origenDe = {}; viejas.forEach(r => origenDe[Number(r.clienteId)] = String(r.origenParada || ''));
    const publicaAhora = estado === 'publicada' && eraBorrador;
    paradas.forEach((p, i) => {
      h.appendRow(filaPorNombre_(h, {
        rutaId: rutaId, fecha: F, conductor: cond, vehiculo: veh, orden: i + 1, clienteId: Number(p.clienteId),
        creadaPor: antes.creadaPor || u.nombre, creadaEn: publicaAhora ? ahora : (antes.creadaEn || ahora),
        estadoPlan: estado === 'borrador' ? 'borrador' : '',
        origenParada: String(p.origen !== undefined ? p.origen : (origenDe[Number(p.clienteId)] || '')).slice(0, 40),
        horaPlan: horaValida_(p.horaPlan) ? p.horaPlan : '', horaSalida: d.horaSalida || '', regresoMin: rN,
        publicadaPor: estado === 'publicada' ? (publicaAhora ? u.nombre : (antes.publicadaPor || u.nombre)) : '',
        publicadaEn: estado === 'publicada' ? (publicaAhora ? ahora : (antes.publicadaEn || ahora)) : '',
        modificadaPor: u.nombre, modificadaEn: ahora,
        estadoRuta: antes.estadoRuta || '', motivoCierre: antes.motivoCierre || '', cerradaPor: antes.cerradaPor || '', cerradaEn: antes.cerradaEn || ''
      }));
    });
    if (typeof sol_alGuardarRuta_ === 'function') sol_alGuardarRuta_(rutaId, F, cond, veh, paradas, viejas, u);
    /* api 3.6: lo de la ruta entera (tipo, destino, puesto de la planta y el trazo por carretera) */
    const tz = d.trazo && Array.isArray(d.trazo.legs) && d.trazo.legs.length ? d.trazo : null;
    const pp = tipo === 'planta' ? Math.max(0, Math.min(paradas.length, Number(d.plantaPos) >= 0 ? Number(d.plantaPos) : paradas.length)) : '';
    rinf_guardar_(rutaId, { fecha: F, conductor: cond, vehiculo: veh, estadoPlan: estado === 'borrador' ? 'borrador' : '', horaSalida: d.horaSalida || '', regresoMin: rN,
      tipo: tipo, destinoId: dst ? dst.id : '', plantaPos: pp,
      trazo: tz ? JSON.stringify({ legs: tz.legs.slice(0, 40).map(x => String(x || '')), tramos: (tz.tramos || []).slice(0, 40) }) : '',
      trazoFirma: tz ? String(tz.firma || '').slice(0, 900) : '', trazoKm: tz ? Number(tz.km) || '' : '', trazoMin: tz ? Number(tz.min) || '' : '',
      trazoFuente: tz ? String(tz.fuente || '').slice(0, 20) : '', por: u.nombre, en: new Date() });
    marcar_('logistica');
    return { ok: true, rutaId: rutaId, estadoPlan: estado, total: paradas.length, publicadaAhora: publicaAhora };
  } finally { lock.releaseLock(); }
}

function api_borrarPlan_330_(pin, rutaId) {
