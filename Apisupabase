import postgres from 'npm:postgres@3.4.5';
import { createHash, randomUUID } from 'node:crypto';

const VERSION_SERVIDOR = 'api 3.34.1';
const URL_PANTALLAS = 'https://ecovsaapp.com/';   // api 3.14: dominio propio (30 sep 2026)

const sql = postgres(Deno.env.get('SUPABASE_DB_URL'), {
  prepare: false, max: 4, idle_timeout: 30, connect_timeout: 10, onnotice: () => {}
