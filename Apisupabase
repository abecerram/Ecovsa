function api_cobDeclararIncobrable(pin, facturas, motivo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (u.rol !== 'admin') return { ok: false, error: 'Declarar incobrable lo hace el administrador.' };
  const m = String(motivo || '').trim();
  if (!m) return { ok: false, error: 'Escribe el motivo.' };
  const nums = (facturas || []).map(String);
  if (!nums.length) return { ok: false, error: 'Elige las facturas.' };
  const L = cobA_libro_();
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_FAC);
  asegurarColumnas_(h, COLS_FAC_NUEVAS);
  let n = 0, monto = 0;
  nums.forEach(num => {
    const f = L.facPorNum[num];
    if (!f || f.estado === 'INCOBRABLE' || f.saldo <= 0.009) return;
    cobA_cambiar_(h, 'factura', num, { estado: 'INCOBRABLE', incobrableMotivo: m, incobrablePor: u.nombre, incobrableEn: L.hoy });
    n++; monto += f.saldo;
  });
  if (!n) return { ok: false, error: 'Ninguna de esas facturas se puede declarar (pagadas o ya declaradas).' };
  marcar_('cobros');
  return { ok: true, facturas: n, monto: cobA_r2_(monto), avisoGerencia: monto >= (L.C.avisoIncobrable || 500) };
}

