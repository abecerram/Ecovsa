}

function arc_paraOportunidad_(p) {
  tab_try_(() => arc_purgarClientes_(), null);
  const cod = String(p.codigoPropuesta || '').trim();
  const F = arc_filas_().filter(a => a.ambito === 'cliente' && a.ref === cod && a.estado !== 'SUBIENDO' && a.estado !== 'BORRADO')
    .sort((a, b) => a.subidoEn < b.subidoEn ? 1 : -1);
