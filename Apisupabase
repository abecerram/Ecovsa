  [['P', R.dir.P.depreciacion, '5.1.07', 'Peligrosos'], ['S', R.dir.S.depreciacion, '5.2.06', 'Sólidos'], ['C', R.ofi.depreciacion, '6.6.01', 'Oficina']].forEach(x => { if (x[1]) filas.push({ fecha: fin_mesFin_(m), tipo: 'Depreciación del mes', documento: 'DEP-' + m, tercero: '', cuenta: '', plan: x[2], sage: sage[x[2]] || '', centro: x[3], monto: x[1], itbms: 0 }); });
  cx.facturas.forEach(f => { if (!f.incobrable || f.anulada || f.porCobrar <= 0.009 || (f.incobrableEn || f.fecha || '').slice(0, 7) !== m) return; filas.push({ fecha: f.incobrableEn || f.fecha, tipo: 'Cuenta incobrable', documento: f.num, tercero: f.cliente, cuenta: '', plan: '6.4.04', sage: sage['6.4.04'] || '', centro: f.linea === 'S' ? 'Sólidos' : 'Peligrosos', monto: fin_r2_(f.total ? f.porCobrar * f.neto / f.total : 0), itbms: 0, nota: 'saldo no cobrado' }); });
  return { ok: true, mes: m, filas: filas.sort((x, y) => x.fecha < y.fecha ? -1 : 1) };
}


/* ══════════════════════════════════════════════════════════════════════
   api 3.31 · ALTAS Y VISITA ÚNICA  +  ASISTENTE DE RUTAS DE LOGÍSTICA
   Diseño aprobado por Álvaro el 13 oct 2026 (maquetas «Altas y visita
   única» y «Asistente de rutas v6», todas las decisiones en la A).
   ══════════════════════════════════════════════════════════════════════ */

/* ─────────────────────────── ALTAS ─────────────────────────── */
/* Columnas nuevas de Solicitudes: el alta de un cliente que ya existe, la fecha que pidió
   el cliente para su visita única, lo que Logística marcó para corregir y en qué ruta quedó. */
const ALT_COLS_SOL = ['clienteId', 'fechaPedida', 'sinFecha', 'cambiosFicha', 'reactivar', 'corregir', 'reenviadaComo', 'rutaFecha', 'rutaId', 'avisadaFecha', 'avisadaPor'];
/* Frecuencias de un servicio recurrente: «Especial» ya no vale (si es de una sola vez, es visita única) */
const ALT_FREC = ['DIARIA', 'SEMANAL', '2X SEMANA', 'QUINCENAL', 'MENSUAL', 'BIMESTRAL', 'TRIMESTRAL', 'SEMESTRAL', 'ANUAL'];
/* Lo que Logística puede marcar para corregir al devolver un alta */
const ALT_CORREGIR = { direccion: 'Dirección o ubicación', contacto: 'Contacto y teléfono', precio: 'Precio o tarifas', fecha: 'Fecha pedida o de inicio', tipo: 'Tipo de servicio (visita única o recurrente)', otro: 'Otro (en la nota)' };

function alt_frecValida_(f) { return ALT_FREC.indexOf(String(f || '').trim().toUpperCase()) >= 0; }
function alt_txt_(v, n) { return String(v == null ? '' : v).trim().slice(0, n || 200); }
function alt_fecha_(v) { const f = fechaISO_(v); return /^\d{4}-\d{2}-\d{2}$/.test(f) ? f : ''; }
function alt_hojaSol_() { const t = tabla313_(HOJA_SOL); ALT_COLS_SOL.forEach(c => { if (t.h && t.cab.indexOf(c) < 0) { t.h.getRange(1, t.cab.length + 1, 1, 1).setValues([[c]]); t.cab.push(c); } }); return t; }
function alt_ponerSol_(solicitudId, campos) {
  const t = alt_hojaSol_(), f = t.filas.find(x => String(x.solicitudId) === String(solicitudId));
  if (f) actualizar313_(t, f._fila, campos);
  return !!f;
}
function alt_solicitud_(solicitudId) { return leerHoja_(HOJA_SOL).find(x => String(x.solicitudId) === String(solicitudId)) || null; }

/* Lo nuevo de cada solicitud, para la bandeja de Logística: cliente que ya existe, fecha pedida y qué cambia en su ficha */
function alt_mapExtra_(s) {
  let c = {}; try { c = JSON.parse(String(s.cambiosFicha || '{}')) || {}; } catch (e) { c = {}; }
  const o = { clienteId: crm_txt_(s.clienteId), fechaPedida: alt_fecha_(s.fechaPedida), sinFecha: String(s.sinFecha || '').toUpperCase() === 'SI',
    unica: esVisitaUnica_({ tipoServicio: s.tipoServicio }), adicional: !!c._adicional, reenviadaComo: crm_txt_(s.reenviadaComo),
    corregir: crm_txt_(s.corregir).split(',').filter(k => ALT_CORREGIR[k]), rutaFecha: alt_fecha_(s.rutaFecha) };
  if (o.fechaPedida) o.fechaPedidaTxt = ini_fechaTxt_(o.fechaPedida);
  if (o.clienteId) {
    const cli = tab_try_(() => leerHoja_(HOJA_CLI), []).find(x => crm_txt_(x.id) === o.clienteId);
    if (cli) {
      const fila = (k, t, f) => ({ dato: t, hoy: f(cli[k]), queda: c[k] !== undefined ? f(c[k]) : null });
      const B = v => v === '' || v == null ? '' : 'B/. ' + Number(v).toFixed(2), T = v => String(v == null ? '' : v);
      o.ficha = [fila('plan costo', 'Precio por recolección', B), fila('plan kg', 'Kilos incluidos', T), fila('tarifa kg adic', 'Kilo adicional', B),
                 fila('tarifa visita adic', 'Visita adicional', B), fila('frecuencia', 'Frecuencia', T), fila('contrato', 'Contrato', T), fila('modalidad', 'Modalidad', v => v === 'servicio' ? 'servicio especial' : T(v))]
        .filter(x => x.queda !== null && x.queda !== x.hoy);
      ['_direccion', '_contacto', '_telefono'].forEach(k => { if (c[k]) o.ficha.push({ dato: k === '_direccion' ? 'Dirección' : k === '_contacto' ? 'Contacto' : 'Teléfono', hoy: T(cli[k.slice(1)]), queda: c[k] }); });
      if (o.unica && o.fechaPedida) o.ficha.push({ dato: 'Fecha pedida', hoy: '—', queda: ini_fechaTxt_(o.fechaPedida) });
      o.clienteNombre = crm_txt_(cli.nombre); o.clienteEstado = crm_txt_(cli.estado);
    }
  }
  return o;
}

/* La propuesta que nace desde la ficha: ¿visita única o recurrente? (paso 2 de la hoja) */
function alt_tipoDeFicha_(datos, d, cli) {
  const esp = /ESPECIAL/i.test(String(cli.frecuencia || '')) || String(cli.modalidad || '').toLowerCase() === 'servicio';
  const t = d.tipoServicio ? tipoServicioDe_({ tipoServicio: d.tipoServicio }) : (esp ? 'VISITA UNICA' : 'RECURRENTE');
  datos.tipoServicio = t;
  if (t === 'VISITA UNICA') {
    datos.frecuencia = '';
    const f = alt_fecha_(d.fechaPedida);
    if (f) datos.fechaTentativa = f;
    datos['sin fecha'] = d.sinFecha && !f ? 'SI' : '';
    if (cta_n_(d.kilos)) datos.cantidadEstimada = cta_n_(d.kilos);
    if (cta_n_(d.precio)) datos['costo visita'] = cta_n_(d.precio);
    if (cta_n_(d.kgAdic)) datos['tarifa kg adic'] = cta_n_(d.kgAdic);
  } else {
    if (alt_frecValida_(d.frecuencia)) datos.frecuencia = String(d.frecuencia).trim().toUpperCase();
    else if (!alt_frecValida_(datos.frecuencia)) datos.frecuencia = '';
    const ini = alt_fecha_(d.inicio); if (ini) datos['inicio recoleccion'] = ini;
  }
}

/* Antes de Firmado: una recurrente lleva frecuencia real y contrato */
function alt_puedeFirmar_(r, e) {
  if (e !== 'Firmado' || esVisitaUnica_(r) || cta_esGran_(r)) return '';
  if (!alt_frecValida_(r.frecuencia)) return 'una recurrente necesita su frecuencia (semanal, quincenal, mensual…). «Especial» ya no vale: si es de una sola vez, cámbiala a Visita única';
  if (!crm_txt_(r['n contrato'])) return 'falta generar el contrato antes de marcarla firmada';
  return '';
}
/* Antes de pasar a cartera */
function alt_validarCartera_(p) {
  if (cta_esGran_(p)) return '';
  if (esVisitaUnica_(p)) {
    if (!alt_fecha_(p.fechaTentativa) && String(p['sin fecha'] || '').toUpperCase() !== 'SI')
      return 'Falta la fecha que pidió el cliente para su visita única. Si todavía no la sabe, marca «el cliente todavía no sabe la fecha» y queda en seguimiento.';
    return '';
  }
  if (!alt_frecValida_(p.frecuencia)) return 'Falta la frecuencia del servicio. «Especial» ya no vale: si es de una sola vez, cámbiala a Visita única.';
  return '';
}

/* Las tareas que se anulan al cerrar la oportunidad: solo las de Mercadeo. Las de Logística siguen vivas. */
function alt_tareaDeMercadeo_(t) {
  const a = crm_txt_(t.asignado).toLowerCase(); if (!a) return true;
  const us = (typeof leerHoja_ === 'function') ? tab_try_(() => leerHoja_('Usuarios'), []) : [];
  const x = us.find(z => String(z.nombre || '').trim().toLowerCase() === a);
  return !x || ['mercadeo', 'gerente'].indexOf(String(x.rol || '').toLowerCase()) >= 0;
}

/* Un cliente que ya existe NO cambia su ficha al pasar a cartera: se crea el alta para Logística
   con lo que va a cambiar, y la ficha cambia cuando Logística la aprueba. */
function alt_pasarExistente_(u, pin, p) {
  const cod = crm_txt_(p.codigoPropuesta), id = crm_txt_(p['cliente origen']);
  const cli = leerHoja_(HOJA_CLI).find(c => crm_txt_(c.id) === id);
  if (!cli) return { ok: false, error: 'No encontré el cliente de esta propuesta (CLI-' + id + ').' };
  const ya = leerHoja_(HOJA_SOL).find(x => crm_txt_(x.codigoPropuesta) === cod && String(x.estado || '').toUpperCase() === 'PENDIENTE');
  if (ya) {
    api_guardarProspecto(pin, cod, { estado: 'Pasado a cartera', __forzar: true });
    return { ok: false, yaEnviada: true, solicitudId: crm_txt_(ya.solicitudId), error: 'Este cliente ya está con Logística esperando revisión. No se envió otra vez.' };
  }
  const unica = esVisitaUnica_(p), fuera = ['mora', 'cierre', 'retiro', 'pausa'].indexOf(String(cli.situacion || '').toLowerCase()) >= 0;
  const cambios = {};
  /* un cliente recurrente activo que pide una visita aparte: es una visita adicional; su plan no cambia */
  const recurrenteActivo = alt_frecValida_(cli.frecuencia) && String(cli.modalidad || '').toLowerCase() !== 'servicio' && !fuera && CLI_FUERA_EST.indexOf(String(cli.estado || '').toUpperCase()) < 0;
  if (unica && recurrenteActivo) {
    cambios._adicional = true;
  } else if (unica) {
    cambios.modalidad = 'servicio';
    if (cta_n_(p['costo visita'])) cambios['plan costo'] = cta_n_(p['costo visita']);
    if (cta_n_(p.cantidadEstimada)) cambios['plan kg'] = cta_n_(p.cantidadEstimada);
    if (cta_n_(p['tarifa kg adic'])) cambios['tarifa kg adic'] = cta_n_(p['tarifa kg adic']);
  } else {
    if (alt_frecValida_(p.frecuencia)) cambios.frecuencia = crm_txt_(p.frecuencia).toUpperCase();
    if (cta_n_(p['costo visita'])) cambios['plan costo'] = cta_n_(p['costo visita']);
    if (cta_n_(p['kg plan'])) cambios['plan kg'] = cta_n_(p['kg plan']);
    if (cta_n_(p['tarifa kg adic'])) cambios['tarifa kg adic'] = cta_n_(p['tarifa kg adic']);
    if (cta_n_(p['tarifa visita adic'])) cambios['tarifa visita adic'] = cta_n_(p['tarifa visita adic']);
    if (crm_txt_(p['n contrato'])) cambios.contrato = crm_txt_(p['n contrato']);
    const ven = fechaISO_(p.vencimiento) || tab_try_(() => vencimientoContrato_(p), ''); if (ven) cambios.vencimiento = ven;
    if (String(cli.modalidad || '').toLowerCase() === 'servicio') cambios.modalidad = '';
  }
  const fechaPedida = unica ? alt_fecha_(p.fechaTentativa) : '';
  const inicio = unica ? fechaPedida : alt_fecha_(p['inicio recoleccion']);
  const r = api_guardarSolicitud(pin, {
    empresa: crm_txt_(cli.nombre), razonSocial: crm_txt_(cli['razon social']), ruc: crm_txt_(cli.ruc), dv: crm_txt_(cli.dv), sector: crm_txt_(cli.sector),
    contacto: crm_txt_(cli.contacto), telefono: crm_txt_(cli.telefono), celular: crm_txt_(cli.whatsapp), correo: crm_txt_(cli.correo),
    direccion: crm_txt_(cli.direccion), zona: crm_txt_(cli.region), frecuencia: unica ? '' : (cambios.frecuencia || crm_txt_(cli.frecuencia)),
    kgMax: unica ? (p.cantidadEstimada || '') : (p['kg plan'] || ''), inicioRecoleccion: inicio,
    codigoPropuesta: cod, tipoServicio: tipoServicioDe_(p),
    planCosto: cambios['plan costo'] || '', planKg: cambios['plan kg'] || '', tarifaKgAdic: cambios['tarifa kg adic'] || '', tarifaVisitaAdic: cambios['tarifa visita adic'] || '',
    contrato: cambios.contrato || '', fechaContrato: fechaISO_(p['fecha contrato']), plazoContrato: crm_txt_(p['plazo contrato']), vencimiento: cambios.vencimiento || '',
    horarioRecoleccion: crm_txt_(p['horario recoleccion']),
    notas: 'Cliente que ya existe (CLI-' + ('000' + id).slice(-3) + ') · desde propuesta ' + cod + (fuera ? ' · vuelve a activo al aprobar' : '')
  });
  if (!r || !r.ok) return r;
  alt_ponerSol_(r.solicitudId, { clienteId: id, fechaPedida: fechaPedida, sinFecha: unica && !fechaPedida && String(p['sin fecha'] || '').toUpperCase() === 'SI' ? 'SI' : '',
    cambiosFicha: JSON.stringify(cambios), reactivar: fuera ? 'SI' : '' });
  const txt = tab_try_(() => srv_aCartera_(u, p, { id: id, nombre: crm_txt_(cli.nombre) }), '');
  api_guardarProspecto(pin, cod, { estado: 'Pasado a cartera', __forzar: true });
  crm_registrarActividad_(u, { tipo: 'nota', ref: cod, refTipo: 'op', cuenta: crm_txt_(cli.nombre),
    texto: 'Enviada a Logística como alta (cliente que ya existe, ' + (unica ? 'visita única' + (fechaPedida ? ' pedida para el ' + ini_fechaTxt_(fechaPedida) : ' sin fecha todavía') : 'recurrente') + '). Su ficha cambia cuando Logística la apruebe.' + (txt ? ' Servicios y productos: ' + txt + '.' : '') });
  crm_registrarActividad_(u, { tipo: 'nota', ref: id, refTipo: 'cli', cuenta: crm_txt_(cli.nombre), texto: 'Propuesta ' + cod + ' aceptada: enviada a Logística como alta.' });
  marcar_('mercadeo'); marcar_('logistica');
  return { ok: true, solicitudId: r.solicitudId, existente: true, faltan: [] };
}

/* La solicitud de un cliente nuevo: la fecha pedida de la visita única viaja con ella */
function alt_completarSol_(solicitudId, p) {
  if (!esVisitaUnica_(p)) return;
  const f = alt_fecha_(p.fechaTentativa);
  alt_ponerSol_(solicitudId, { fechaPedida: f, inicioRecoleccion: f, sinFecha: !f && String(p['sin fecha'] || '').toUpperCase() === 'SI' ? 'SI' : '' });
}

/* Reenviar una devuelta: la nueva lleva lo que la vieja sabía, y la vieja deja de salir en la lista */
function api_guardarSolicitud(pin, d) {
  d = d || {};
  const vieja = d.reenvioDe ? alt_solicitud_(d.reenvioDe) : null;
  if (d.reenvioDe) {
    const u = usuarioPorPin_(pin);
    if (!u) return { ok: false, error: 'PIN no válido' };
    if (!vieja) return { ok: false, error: 'No encontré el alta que se devolvió.' };
    if (String(vieja.estado || '').toUpperCase() !== 'DEVUELTA') return { ok: false, error: 'Solo se reenvía un alta devuelta.' };
    if (crm_txt_(vieja.reenviadaComo)) return { ok: false, error: 'Esa alta ya se reenvió (' + crm_txt_(vieja.reenviadaComo) + ').' };
    if (String(vieja.registradoPor || '').trim().toLowerCase() !== String(u.nombre).trim().toLowerCase() && !esSupervisor_(u)) return { ok: false, error: 'Esa alta la envió otra persona.' };
    if (crm_txt_(vieja.clienteId)) d.empresa = crm_txt_(vieja.empresa);   // un cliente que ya existe no cambia de nombre por aquí
  }
  const r = api_guardarSolicitud_330_(pin, d);
  if (!r || !r.ok) return r;
  if (vieja) {
    const campos = {};
    ['clienteId', 'fechaPedida', 'sinFecha', 'cambiosFicha', 'reactivar'].forEach(k => { if (crm_txt_(vieja[k])) campos[k] = vieja[k]; });
    const fp = alt_fecha_(d.fechaPedida);
    if (fp) { campos.fechaPedida = fp; campos.sinFecha = ''; if (esVisitaUnica_({ tipoServicio: d.tipoServicio || vieja.tipoServicio })) campos.inicioRecoleccion = fp; }
    if (campos.cambiosFicha) {
      let c = {}; try { c = JSON.parse(campos.cambiosFicha) || {}; } catch (e) { c = {}; }
      if (cta_n_(d.planCosto)) c['plan costo'] = cta_n_(d.planCosto);
      if (cta_n_(d.planKg)) c['plan kg'] = cta_n_(d.planKg);
      if (cta_n_(d.tarifaKgAdic)) c['tarifa kg adic'] = cta_n_(d.tarifaKgAdic);
      if (cta_n_(d.tarifaVisitaAdic)) c['tarifa visita adic'] = cta_n_(d.tarifaVisitaAdic);
      if (alt_frecValida_(d.frecuencia)) c.frecuencia = String(d.frecuencia).toUpperCase();
      [['direccion', 'direccion'], ['contacto', 'contacto'], ['telefono', 'telefono'], ['celular', 'whatsapp']].forEach(z => {
        const v = alt_txt_(d[z[0]], 200); if (v && v !== alt_txt_(vieja[z[0]], 200)) c['_' + z[1]] = v; });
      campos.cambiosFicha = JSON.stringify(c);
    }
    ['codigoPropuesta', 'tipoServicio'].forEach(k => { if (!crm_txt_(d[k]) && crm_txt_(vieja[k])) campos[k] = vieja[k]; });
    if (d.tipoServicio) {
      campos.tipoServicio = tipoServicioDe_({ tipoServicio: d.tipoServicio });
      if (campos.tipoServicio !== 'VISITA UNICA') { campos.fechaPedida = ''; campos.sinFecha = ''; }
    }
    if (Object.keys(campos).length) alt_ponerSol_(r.solicitudId, campos);
    alt_ponerSol_(d.reenvioDe, { reenviadaComo: r.solicitudId });
  }
  return r;
}

/* Aprobar: el cliente nuevo nace (como antes); el que ya existe se actualiza con historial.
   La visita única queda en la ruta del día que pidió. A Mercadeo le llega el aviso. */
function api_aprobarSolicitud(pin, solicitudId, ajustes) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido' };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo un supervisor puede aprobar.' };
  const s = alt_solicitud_(solicitudId);
  if (!s) return { ok: false, error: 'No encuentro esa solicitud.' };
  if (String(s.estado || '').toUpperCase() !== 'PENDIENTE') return { ok: false, error: 'Esa solicitud ya fue procesada.' };
  const a = Object.assign({}, ajustes || {});
  const unica = esVisitaUnica_({ tipoServicio: s.tipoServicio });
  const hoy = hoyPanama_();
  const fecha = alt_fecha_(a.fechaRuta) || alt_fecha_(s.fechaPedida);
  if (unica && fecha && fecha < hoy) return { ok: false, error: 'La fecha pedida (' + ini_fechaTxt_(fecha) + ') ya pasó. Elige otro día para ponerla en ruta.' };
  if (unica && fecha) a.inicioRecoleccion = fecha;
  const r = crm_txt_(s.clienteId) ? alt_aprobarExistente_(u, pin, s, a) : api_aprobarSolicitud_330_(pin, solicitudId, a);
  if (!r || !r.ok) return r;
  const cid = Number(r.clienteId || s.clienteId);
  let ruta = null;
  if (unica && fecha && cid && a.ponerEnRuta !== false) ruta = tab_try_(() => alt_ponerEnRuta_(u, cid, fecha, a.rutaId), null);
  alt_ponerSol_(solicitudId, { clienteId: cid || '', rutaFecha: ruta ? fecha : '', rutaId: ruta ? ruta.rutaId : '' });
  const nombre = String(a.nombre || s.empresa || '').trim();
  const sinFecha = !fecha && !alt_fecha_(a.inicioRecoleccion) && !alt_fecha_(s.inicioRecoleccion);
  anotarPendiente_({ modulo: 'mercadeo', asistente: 'Altas', prioridad: sinFecha ? 'media' : 'baja', tipo: 'altaAprobada', referencia: String(solicitudId),
    clave: 'altaAprobada:' + solicitudId, enlace: 'MerClientes.html#altas',
    titulo: 'Logística aprobó ' + nombre,
    descripcion: ruta ? 'Queda en la ruta del ' + ini_fechaTxt_(fecha) + (ruta.conductor ? ' (' + ruta.conductor + ')' : '') + '.'
      : sinFecha ? 'Queda «Por iniciar»: todavía no tiene fecha de primera recolección. Te toca darle seguimiento en Altas enviadas.'
      : 'Primera recolección prevista para el ' + ini_fechaTxt_(fecha || alt_fecha_(a.inicioRecoleccion) || alt_fecha_(s.inicioRecoleccion)) + '.' });
  asis_seguro_(() => asis_alEntrar_());
  return Object.assign({}, r, { ruta: ruta ? { fecha: fecha, rutaId: ruta.rutaId, conductor: ruta.conductor, nueva: ruta.nueva, publicada: ruta.estadoPlan === 'publicada' } : null });
}

function alt_aprobarExistente_(u, pin, s, a) {
  const id = crm_txt_(s.clienteId);
  const cli = leerHoja_(HOJA_CLI).find(c => crm_txt_(c.id) === id);
  if (!cli) return { ok: false, error: 'No encontré la ficha del cliente (CLI-' + id + ').' };
  const cod = crm_txt_(s.codigoPropuesta);
  /* todo o nada: si algo falla se lanza y el pedido no guarda nada */
  const falla = r => { if (r && r.ok === false) throw new Error(r.error || 'No se pudo actualizar la ficha.'); return r; };
  if (String(s.reactivar || '').toUpperCase() === 'SI') falla(api_cambiarEstadoCliente(pin, id, 'activo', 'Reactivado con la propuesta ' + cod));
  let c = {}; try { c = JSON.parse(String(s.cambiosFicha || '{}')) || {}; } catch (e) { c = {}; }
  const datos = {};
  Object.keys(c).forEach(k => { if (k.charAt(0) !== '_') datos[k] = c[k]; });
  const ini = alt_fecha_(a.inicioRecoleccion) || alt_fecha_(s.inicioRecoleccion);
  if (ini && !esVisitaUnica_({ tipoServicio: s.tipoServicio })) datos['inicio recoleccion'] = ini;
  if (Object.keys(datos).length) falla(api_crmGuardarFichaCliente(pin, id, datos));
  /* lo demás de la ficha, con su antes y después en el historial */
  const extra = {};
  if (CLI_FUERA_EST.indexOf(String(cli.estado || '').toUpperCase()) >= 0) extra.estado = 'POR INICIAR';
  ['direccion', 'contacto', 'telefono', 'whatsapp'].forEach(k => { if (c['_' + k]) extra[k] = c['_' + k]; });
  if (a.direccion && alt_txt_(a.direccion, 200) !== alt_txt_(cli.direccion, 200)) extra.direccion = alt_txt_(a.direccion, 200);
  if (a.zona && TAR_ZONAS.indexOf(String(a.zona)) >= 0 && String(a.zona) !== String(cli.region || '')) extra.region = String(a.zona);
  if (ini && !c._adicional) extra.proximaVisita = ini;
  const ahora = crm_ahora_();
  Object.keys(extra).forEach(k => {
    const antes = k === 'proximaVisita' ? fechaISO_(cli[k]) : crm_txt_(cli[k]), despues = crm_txt_(extra[k]);
    if (antes === despues) { delete extra[k]; return; }
    crm_agregar_(HOJA_CRM_HIS, COLS_CRM_HIS, { fecha: ahora, clienteId: id, cliente: crm_txt_(cli.nombre), campo: k === 'region' ? 'zona' : k === 'proximaVisita' ? 'próxima visita' : k, antes: antes, despues: despues, usuario: u.nombre });
  });
  if (Object.keys(extra).length) crm_cambiar_(HOJA_CLI, COLS_CLI, 'id', id, extra);
  const t = alt_hojaSol_(), f = t.filas.find(x => String(x.solicitudId) === String(s.solicitudId));
  if (f) actualizar313_(t, f._fila, { estado: 'APROBADA', procesadaEn: hoyPanama_(), procesadaPor: u.nombre });
  crm_registrarActividad_(u, { tipo: 'nota', ref: id, refTipo: 'cli', cuenta: crm_txt_(cli.nombre),
    texto: 'Logística aprobó el alta ' + s.solicitudId + (cod ? ' (propuesta ' + cod + ')' : '') + (c._adicional ? ': visita adicional; su plan no cambia' : ': ficha actualizada') + (ini ? (c._adicional ? '; la visita es el ' : '; primera recolección ') + ini_fechaTxt_(ini) : '') + '.' });
  marcar_('mercadeo'); marcar_('logistica');
