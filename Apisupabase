function api_docCamionGuardar(pin, placa, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!arc_puedeFlota_(u, true)) return { ok: false, error: 'Los documentos los cambia logística.' };
  d = d || {};
  const vence = fechaISO_(d.vence);
  if (!vence) return { ok: false, error: 'Pon la fecha de vencimiento.' };
  asegurarColumnas_(hojaPlanta_(HOJA_PLN, COLS_PLN), ARC_COLS_PLN_EXTRA);
  let planId = String(d.planId || '').trim();
  let actual = null;
  if (planId) {
    actual = leerHoja_(HOJA_PLN).find(p => String(p.planId || '').trim() === planId);
    if (!actual) return { ok: false, error: 'No encontré ese documento en el plan.' };
  } else {
    const t = String(d.tarea || '').trim();
    if (!t) return { ok: false, error: 'Escribe el nombre del documento.' };
    mto_asegurarActivos_(pin);
    let act = mto_activoDe_(placa);
    if (!act) { const g = api_guardarActivo(pin, { clase: 'vehiculo', nombre: placa, placa: placa, estado: 'Activo' }); if (!g.ok) return g; act = mto_activoDe_(placa); }
    const r = api_guardarPlanTarea(pin, { activoId: String(act.activoId), tarea: MTO_DOC_RE.test(t) ? t : 'Documento · ' + t, cadaDias: Number(d.cadaDias) || 365, vence: vence });
    if (!r || !r.ok) return r;
    planId = r.planId;
  }
  const F = arc_filas_(), vig = F.find(a => a.ambito === 'flota' && a.ref === planId && a.estado === 'VIGENTE');
  const nuevoArc = String(d.archivoId || '').trim() ? F.find(a => a.archivoId === String(d.archivoId).trim() && a.ambito === 'flota') : null;
  if (String(d.archivoId || '').trim() && !nuevoArc) return { ok: false, error: 'El archivo no llegó. Vuelve a elegirlo.' };
  const hist = d.renovar || !!nuevoArc;
  /* lo vigente pasa al historial (con o sin archivo, para no perder la fecha anterior) */
  if (hist && actual) {
    if (vig) arc_cambiar_(vig.archivoId, { estado: 'HISTORIAL' });
    else if (fechaISO_(actual.vence) && fechaISO_(actual.vence) !== vence)
      cobA_agregar_(arc_hoja_(), { archivoId: arc_id_(), ambito: 'flota', ref: planId, doc: String(actual.tarea || ''), nombre: '', estado: 'HISTORIAL',
        numero: String(actual.numero || ''), emisor: String(actual.emisor || ''), emitido: fechaISO_(actual.emitido), vence: fechaISO_(actual.vence),
        subidoPor: u.nombre, subidoEn: arc_ahora_() });
  }
  if (nuevoArc) arc_cambiar_(nuevoArc.archivoId, { ref: planId, doc: String((actual && actual.tarea) || d.tarea || ''), estado: 'VIGENTE',
    numero: String(d.numero || ''), emisor: String(d.emisor || ''), emitido: fechaISO_(d.emitido), vence: vence, revisadoPor: u.nombre, revisadoEn: arc_ahora_() });
  else if (vig && !hist) arc_cambiar_(vig.archivoId, { numero: String(d.numero || ''), emisor: String(d.emisor || ''), emitido: fechaISO_(d.emitido), vence: vence });
  const cambios = { vence: vence, numero: String(d.numero || ''), emisor: String(d.emisor || ''), emitido: fechaISO_(d.emitido), noAplica: '' };
  if (Number(d.cadaDias) > 0) cambios.cadaDias = Number(d.cadaDias);
  if (nuevoArc) cambios.archivoId = nuevoArc.archivoId;
  cobA_cambiar_(hojaPlanta_(HOJA_PLN, COLS_PLN), 'planId', planId, cambios);
  marcar_('admin');
  /* api 3.7.1: devuelve los documentos de este camión ya actualizados: la pantalla no tiene que volver a pedirlos */
  let camion = null;
  try { const dc = api_docsCamion(pin, placa); if (dc && dc.ok) camion = dc.camion; } catch (e) { camion = null; }
  return { ok: true, planId: planId, camion: camion };
}

