/* ── Cuenta con sedes ↔ ficha normal (punto 9 de AJUSTES_UNION) ───────
   Forma de la cuenta vista en MerCuenta.html (columna `cuenta` del prospecto,
   JSON): {grupos:[{id, nombre, aSolicitud, precio (al mes), kgIncluidos,
   servicios, planId, sedes:[{id, nombre, direccion, zona, kgMes, km, visitas,
   anatomo, desde, clienteId, contacto, telefono}]}], contactoCorp, pagadores}.
   Unido con el 3.12: la columna es «cuenta json» y la marca es generador = GRAN (antes se pensó `cuenta` y
   cuenta con sedes del prospecto (`gran`). */
const FREC_DE_VISITAS_313 = [[8, '2X SEMANA'], [4, 'SEMANAL'], [2, 'QUINCENAL'], [1, 'MENSUAL'], [0.5, 'BIMESTRAL'], [0, 'TRIMESTRAL']];
function frecuenciaDeVisitas313_(v) {
  v = Number(v) || 0;
  for (let i = 0; i < FREC_DE_VISITAS_313.length; i++) if (v >= FREC_DE_VISITAS_313[i][0]) return FREC_DE_VISITAS_313[i][1];
  return 'MENSUAL';
}
function sedeEnBlanco313_() {
  return { id: 'S' + Utilities.getUuid().replace(/-/g, '').slice(0, 8), nombre: '', zona: 'CENTRO CIUDAD', kgMes: 0, km: 0, visitas: null };
}
/* La cuenta que nace al tocar «Agregar otra sede» (api_pasarAGranGenerador):
   la sede de la ficha + una sede en blanco. No se pierde lo escrito. */
function cuentaDesdeFicha313_(p) {
  const visitas = visitasDe313_(p.frecuencia) || null;
  const kg = Number(p.kgMesEstimado || p['kg estimado'] || p['kg plan'] || 0) || 0;
  return { grupos: [{ id: 'G1', nombre: 'Grupo 1', aSolicitud: false, precio: null, kgIncluidos: null, planId: String(p.planId || ''),
    servicios: serviciosForma313_(serviciosDeProspecto313_(p), visitas || 1),
    sedes: [{ id: 'S' + Utilities.getUuid().replace(/-/g, '').slice(0, 8), nombre: String(p.empresa || ''), direccion: String(p.direccion || ''),
      zona: String(p.zona || 'CENTRO CIUDAD').toUpperCase(), kgMes: kg, km: 0, visitas: visitas, clienteId: String(p.clienteId || '') },
      sedeEnBlanco313_()] }] };
