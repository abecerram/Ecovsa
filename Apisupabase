           sinFecha: todas.filter(t => t.estado === 'pendiente' && !t.fecha),
           sinHora: todas.filter(t => t.estado === 'pendiente' && t.fecha && !t.hora && t.fecha >= d1 && t.fecha <= d2),
           asesores: crm_asesores_(), ajustes: crm_ajustes_() };
}

function api_crmActividades(pin, filtro) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const f = filtro || {}, hoy = hoyPanama_();
  const d1 = crm_txt_(f.desde) || crm_masDias_(hoy, -30), d2 = crm_txt_(f.hasta) || hoy;
  let l = crm_filas_(HOJA_CRM_ACT).map(crm_actividad_).filter(a => a.fecha >= d1 && a.fecha <= d2);
  if (f.ref) l = l.filter(a => a.ref === crm_txt_(f.ref));
  if (f.tipo) l = l.filter(a => a.tipo === crm_txt_(f.tipo));
  if (f.usuario) l = l.filter(a => a.usuario === crm_txt_(f.usuario));
  l.sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
  const tope = Math.min(crm_n_(f.limite) || 300, 1000);
  return { ok:true, hoy: hoy, desde: d1, hasta: d2, actividades: l.slice(0, tope), total: l.length };
}

function crm_cuentas_() {
  const puesto = {};
  crm_filas_(HOJA_CRM_CTA).forEach(r => { const id = crm_txt_(r.clienteId); if (id) puesto[id] = crm_txt_(r.cuenta); });
  const cli = leerHoja_(HOJA_CLI);
  const porRuc = {}, porPref = {};
  cli.forEach(c => {
    const ruc = String(c.ruc || '').replace(/\s/g, '').toUpperCase();
    if (ruc.length >= 5) (porRuc[ruc] = porRuc[ruc] || []).push(c);
    const pre = crm_clave_(c.nombre).split(/\s*-\s*/)[0];
    if (pre && crm_clave_(c.nombre).indexOf('-') > 0) (porPref[pre] = porPref[pre] || []).push(c);
  });
  const de = {};
  cli.forEach(c => {
    const id = crm_txt_(c.id); if (!id) return;
    if (puesto[id] !== undefined) { if (puesto[id]) de[id] = puesto[id]; return; }
    const pre = crm_clave_(c.nombre).split(/\s*-\s*/)[0];
    if (crm_clave_(c.nombre).indexOf('-') > 0 && (porPref[pre] || []).length >= 2) { de[id] = pre; return; }
    const ruc = String(c.ruc || '').replace(/\s/g, '').toUpperCase();
    if (ruc.length >= 5 && (porRuc[ruc] || []).length >= 2) {
      const nombres = porRuc[ruc].map(y => crm_clave_(y.nombre).split(/\s*-\s*/)[0]).sort((a, b) => a.length - b.length);
      de[id] = nombres[0];
    }
  });
  return { de: de };
}

function crm_saldos_(hoy) {
  const libro = cob_libro_(), porCli = {};
  libro.facturas.forEach(f => {
    const pagado = (f.pagos || []).reduce((s, p) => s + crm_n_(p.monto), 0);
    const saldo = crm_n_(f.neto || f.total) - pagado;
    const k = crm_clave_(f.cliente);
    const o = porCli[k] = porCli[k] || { saldo: 0, vencido: 0, masViejo: '', facturas: 0, ruc: f.ruc };
    o.facturas++;
    if (saldo <= 0.009) return;
    o.saldo += saldo;
    if (f.vencimiento && f.vencimiento < hoy) {
      o.vencido += saldo;
      if (!o.masViejo || f.vencimiento < o.masViejo) o.masViejo = f.vencimiento;
    }
  });
  return porCli;
}

function crm_kilos_(hoy) {
  const desde = crm_masDias_(hoy, -90), porCli = {};
  leerHoja_(HOJA_REC).forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']);
    if (!f || f < desde || f > hoy) return;
    const k = crm_clave_(r.Cliente);
    const kg = crm_n_(r['total Kg']) || (crm_n_(r['Kg Recolectados']) + crm_n_(r['kg anatomopatologico']) + crm_n_(r['kg punzo cortantes']));
    const o = porCli[k] = porCli[k] || { kg: 0, visitas: 0, ultima: '' };
    o.kg += kg; o.visitas++;
    if (f > o.ultima) o.ultima = f;
  });
  return porCli;
}

function crm_planesCuenta_(cuentas, clientes, kilos) {
  const g = {};
  clientes.forEach(c => {
    const cta = cuentas.de[crm_txt_(c.id)]; if (!cta) return;
    (g[cta] = g[cta] || []).push(c);
  });
  const out = {};
  Object.keys(g).forEach(cta => {
    const l = g[cta]; if (l.length < 2) return;
    const planes = l.map(c => crm_n_(c['plan kg'])).filter(v => v > 0);
    if (planes.length < 2 || planes.some(v => v !== planes[0])) return;
    let kg = 0, visitas = 0, ultima = '';
    l.forEach(c => { const k = kilos[crm_clave_(c.nombre)]; if (k) { kg += k.kg; visitas += k.visitas; if (k.ultima > ultima) ultima = k.ultima; } });
    out[cta] = { plan: planes[0], kil: { kg: kg, visitas: visitas, ultima: ultima }, sucursales: l.length };
  });
  return out;
}

function crm_salud_(c, saldo, kil, hoy, aj, planCta) {
  const s = { pago: 'ok', kilos: 'ok', contrato: 'ok', visitas: 'ok', motivos: [], accion: '' };
  if (saldo && saldo.vencido > 0.009) {
    const d = saldo.masViejo ? crm_dias_(saldo.masViejo, hoy) : 0;
    s.pago = d > 60 ? 'mal' : 'ojo';
    s.motivos.push('Debe B/. ' + crm_r_(saldo.vencido, 2).toLocaleString('en-US', { minimumFractionDigits: 2 }) + ' vencido' + (d ? ' (' + d + ' días)' : ''));
  }
  const planKg = planCta ? planCta.plan : crm_n_(c['plan kg']);
  const kk = planCta ? planCta.kil : kil;
  const kgMes = kk ? kk.kg / 3 : 0;
  const deCta = planCta ? ' (la cuenta, ' + planCta.sucursales + ' sucursales)' : '';
  if (planKg > 0 && kk && kk.visitas >= 2) {
    if (kgMes > planKg * 1.2) { s.kilos = 'crecer'; s.motivos.push('Genera ' + Math.round(kgMes) + ' kg/mes y su plan es de ' + planKg + ' kg' + deCta); }
    else if (kgMes < planKg * 0.5) { s.kilos = 'ojo'; s.motivos.push('El plan le queda grande: ' + Math.round(kgMes) + ' de ' + planKg + ' kg/mes' + deCta); }
  }
  const venc = fechaISO_(c.vencimiento);
  if (venc) {
    const d = crm_dias_(hoy, venc);
    if (d < 0) { s.contrato = 'mal'; s.motivos.push('Contrato vencido hace ' + (-d) + ' días'); }
    else if (d <= crm_n_(aj.diasRenovacion || 60)) { s.contrato = 'ojo'; s.motivos.push('Contrato vence en ' + d + ' días'); }
  }
  const atraso = crm_n_(c.diasAtraso);
  if (atraso > 14) { s.visitas = 'mal'; s.motivos.push('Visita atrasada ' + atraso + ' días'); }
  else if (atraso > 3) { s.visitas = 'ojo'; s.motivos.push('Visita atrasada ' + atraso + ' días'); }
  const malos = ['pago','contrato','visitas'].filter(k => s[k] === 'mal').length;
  const ojos = ['pago','contrato','visitas','kilos'].filter(k => s[k] === 'ojo').length;
  s.nivel = malos ? 'riesgo' : (s.kilos === 'crecer' ? 'crecer' : (ojos ? 'atencion' : 'sano'));
  s.puntos = Math.max(0, 100 - malos * 30 - ojos * 12);
  s.accion = s.pago !== 'ok' ? 'Cobrar' : s.contrato !== 'ok' ? 'Renovar' : s.kilos === 'crecer' ? 'Ofrecer plan mayor'
           : s.kilos === 'ojo' ? 'Ajustar plan' : s.visitas !== 'ok' ? 'Revisar con logística' : '';
  return s;
}

function crm_clienteCorto_(c, cuentas, saldos, kilos, hoy, aj, planes) {
  const k = crm_clave_(c.nombre);
  const sal = saldos[k] || null, kil = kilos[k] || null;
  const planCta = planes ? planes[cuentas.de[crm_txt_(c.id)]] || null : null;
  const salud = crm_salud_(c, sal, kil, hoy, aj, planCta);
  const faltan = [];
  if (!crm_txt_(c.ruc)) faltan.push('RUC');
  if (!crm_txt_(c.correo)) faltan.push('correo');
  if (!fechaISO_(c['inicio recoleccion'])) faltan.push('inicio');
  if (!crm_txt_(c.contacto)) faltan.push('contacto');
  return { id: crm_txt_(c.id), nombre: crm_txt_(c.nombre), razon: crm_txt_(c['razon social']),
           ruc: crm_txt_(c.ruc), estado: crm_txt_(c.estado), situacion: crm_txt_(c.situacion),
           region: crm_txt_(c.region), frecuencia: crm_txt_(c.frecuencia),
           planCosto: crm_n_(c['plan costo']), planKg: crm_n_(c['plan kg']),
           kg90: kil ? crm_r_(kil.kg, 1) : 0, kgMes: kil ? crm_r_(kil.kg / 3, 1) : 0, visitas90: kil ? kil.visitas : 0,
           ultimaVisita: fechaISO_(c.ultimaVisita) || (kil ? kil.ultima : ''), proximaVisita: fechaISO_(c.proximaVisita),
           saldo: sal ? crm_r_(sal.saldo, 2) : 0, vencido: sal ? crm_r_(sal.vencido, 2) : 0,
           vencimiento: fechaISO_(c.vencimiento), contrato: crm_txt_(c.contrato),
           diasVence: fechaISO_(c.vencimiento) ? crm_dias_(hoy, fechaISO_(c.vencimiento)) : null,
           contacto: crm_txt_(c.contacto), telefono: crm_txt_(c.telefono), whatsapp: crm_txt_(c.whatsapp), correo: crm_txt_(c.correo),
           cuenta: cuentas.de[crm_txt_(c.id)] || '', salud: salud, faltan: faltan,
           tipoCartera: crm_txt_(c['tipo cartera']) };
}

function api_crmClientes(pin) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const hoy = hoyPanama_(), aj = crm_ajustes_();
  const cuentas = crm_cuentas_(), saldos = crm_saldos_(hoy), kilos = crm_kilos_(hoy);
  const todos = leerHoja_(HOJA_CLI).filter(c => crm_txt_(c.id) && crm_txt_(c.nombre));
  const planes = crm_planesCuenta_(cuentas, todos, kilos);
  const lista = todos.map(c => crm_clienteCorto_(c, cuentas, saldos, kilos, hoy, aj, planes));
  const activos = lista.filter(c => ['ACTIVO','AL DÍA','AL DIA','ATRASADO','VENCIDO',''].indexOf(c.estado.toUpperCase()) >= 0 &&
                                    ['BAJA','CIERRE','RETIRO'].indexOf(c.situacion.toUpperCase()) < 0);
  const renovar = lista.filter(c => c.diasVence !== null && c.diasVence <= 90)
    .sort((a, b) => a.diasVence - b.diasVence);
  const resumen = { total: lista.length, activos: activos.length,
                    sanos: lista.filter(c => c.salud.nivel === 'sano').length,
                    atencion: lista.filter(c => c.salud.nivel === 'atencion').length,
                    riesgo: lista.filter(c => c.salud.nivel === 'riesgo').length,
                    crecer: lista.filter(c => c.salud.nivel === 'crecer').length,
                    porCompletar: lista.filter(c => c.faltan.length).length,
                    renovar: renovar.length };
  return { ok:true, usuario: x.u, hoy: hoy, clientes: lista, renovaciones: renovar, resumen: resumen, ajustes: aj };
}

function api_crmCliente(pin, clienteId) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const hoy = hoyPanama_(), aj = crm_ajustes_(), id = crm_txt_(clienteId);
  const todos = leerHoja_(HOJA_CLI);
  const c = todos.find(y => crm_txt_(y.id) === id);
  if (!c) return { ok:false, error:'No encontré el cliente ' + id + '.' };
  const cuentas = crm_cuentas_(), saldos = crm_saldos_(hoy), kilos = crm_kilos_(hoy);
  const planes = crm_planesCuenta_(cuentas, todos, kilos);
  const corto = crm_clienteCorto_(c, cuentas, saldos, kilos, hoy, aj, planes);
  const datos = {};
  Object.keys(c).forEach(k => { const v = c[k]; datos[k] = v instanceof Date ? (k.indexOf('hora') === 0 ? horaTxt_(v) : fechaISO_(v)) : (v === null || v === undefined ? '' : v); });
  const nom = crm_clave_(c.nombre);

  /* cobros: facturas con su saldo y los últimos pagos */
  const libro = cob_libro_();
  const facturas = libro.facturas.filter(f => crm_clave_(f.cliente) === nom)
    .map(f => { const pag = (f.pagos || []).reduce((s, p) => s + crm_n_(p.monto), 0);
                return { factura: f.factura, fecha: f.fecha, total: crm_r_(f.total, 2), neto: crm_r_(f.neto, 2),
                         pagado: crm_r_(pag, 2), saldo: crm_r_(crm_n_(f.neto || f.total) - pag, 2), vencimiento: f.vencimiento,
                         vencida: !!(f.vencimiento && f.vencimiento < hoy && crm_n_(f.neto || f.total) - pag > 0.009) }; })
    .sort((a, b) => b.fecha.localeCompare(a.fecha));
  const facSet = {}; facturas.forEach(f => facSet[f.factura] = true);
  const pagos = libro.pagos.filter(p => facSet[p.factura]).sort((a, b) => b.fecha.localeCompare(a.fecha)).slice(0, 20);

  /* servicio: visitas y kilos por mes */
  const recs = leerHoja_(HOJA_REC).filter(r => crm_clave_(r.Cliente) === nom).map(r => ({
    recibo: crm_txt_(r['recibo numero']), fecha: fechaISO_(r['Fecha de Recoleccion']),
    kg: crm_r_(crm_n_(r['total Kg']) || (crm_n_(r['Kg Recolectados']) + crm_n_(r['kg anatomopatologico']) + crm_n_(r['kg punzo cortantes'])), 2),
    responsable: crm_txt_(r.Responsable), acta: crm_txt_(r.acta) }))
    .filter(r => r.fecha).sort((a, b) => b.fecha.localeCompare(a.fecha));
  const porMes = {};
  for (let i = 5; i >= 0; i--) { const d = new Date(hoy.slice(0, 8) + '15T12:00:00Z'); d.setUTCMonth(d.getUTCMonth() - i); porMes[d.toISOString().slice(0, 7)] = { mes: d.toISOString().slice(0, 7), kg: 0, visitas: 0 }; }
  recs.forEach(r => { const m = r.fecha.slice(0, 7); if (porMes[m]) { porMes[m].kg += r.kg; porMes[m].visitas++; } });

  const contactos = crm_filas_(HOJA_CRM_CON).map(crm_contacto_).filter(k => k.ref === id);
  if (crm_txt_(c.contacto) && !contactos.some(k => crm_clave_(k.nombre) === crm_clave_(c.contacto)))
    contactos.unshift({ id:'', ref: id, refTipo:'cli', nombre: crm_txt_(c.contacto), cargo:'', telefono: crm_txt_(c.telefono),
                        celular: crm_txt_(c.whatsapp), correo: crm_txt_(c.correo), principal: true, notas:'', deFicha: true });

  /* la oportunidad de la que vino, si existe */
  const pro = crm_filas_(HOJA_PRO).find(p => crm_txt_(p.clienteId) === id ||
                                            (crm_clave_(p.empresa) === nom && crm_txt_(p.estado) === 'Pasado a cartera'));
  const refs = [id]; if (pro) refs.push(crm_txt_(pro.codigoPropuesta));
  const acts = crm_filas_(HOJA_CRM_ACT).map(crm_actividad_).filter(a => refs.indexOf(a.ref) >= 0);
  const sis = [];
  recs.slice(0, 15).forEach(r => sis.push({ id: 's-r' + r.recibo, fecha: r.fecha, hora:'', tipo:'sistema', texto:'Recolección · recibo ' + r.recibo + ' · ' + r.kg + ' kg', usuario: r.responsable }));
  facturas.slice(0, 10).forEach(f => sis.push({ id: 's-f' + f.factura, fecha: f.fecha, hora:'', tipo:'sistema', texto:'Factura ' + f.factura + ' · B/. ' + f.total.toFixed(2), usuario:'' }));
  pagos.slice(0, 10).forEach(p => sis.push({ id: 's-p' + p.factura + p.fecha, fecha: p.fecha, hora:'', tipo:'sistema', texto:'Pago de la factura ' + p.factura + ' · B/. ' + crm_n_(p.monto).toFixed(2), usuario:'' }));
  const linea = acts.concat(sis).sort((a, b) => (b.fecha + (b.hora || '')).localeCompare(a.fecha + (a.hora || '')));

  const tareas = crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => refs.indexOf(t.ref) >= 0)
    .sort((a, b) => (a.estado === 'pendiente' ? 0 : 1) - (b.estado === 'pendiente' ? 0 : 1) || (a.fecha || '9999').localeCompare(b.fecha || '9999'));
  const documentos = crm_filas_(HOJA_CRM_DOC).map(crm_documento_).filter(d => refs.indexOf(d.ref) >= 0);
  const historial = crm_filas_(HOJA_CRM_HIS).filter(h => crm_txt_(h.clienteId) === id)
    .map(h => ({ fecha: crm_txt_(h.fecha), campo: crm_txt_(h.campo), antes: crm_txt_(h.antes), despues: crm_txt_(h.despues), usuario: crm_txt_(h.usuario) }))
    .sort((a, b) => b.fecha.localeCompare(a.fecha));
  const sucursales = corto.cuenta ? leerHoja_(HOJA_CLI).filter(y => cuentas.de[crm_txt_(y.id)] === corto.cuenta && crm_txt_(y.id) !== id)
    .map(y => crm_clienteCorto_(y, cuentas, saldos, kilos, hoy, aj, planes)) : [];
  const distintivo = { entregado: fechaISO_(c.distintivoEntregado), entregadoPor: crm_txt_(c.distintivoPor),
                       inicio: fechaISO_(c['inicio recoleccion']) };
  const certs = crm_filas_(HOJA_CERT).filter(z => crm_clave_(z.cliente) === nom)
    .map(z => ({ folio: crm_txt_(z.folio), fecha: fechaISO_(z.fechaEmision || z.registradoEn), desde: fechaISO_(z.desde),
                 hasta: fechaISO_(z.hasta), totalKg: crm_r_(z.totalKg, 2), visitas: crm_n_(z.visitas) }))
    .sort((a, b) => b.fecha.localeCompare(a.fecha));

  /* api 3.5: puntualidad de su cuenta y la solicitud de suspensión de
     Cobros si está esperando a Mercadeo */
  let fc = { puntualidad: null, suspension: null };
  try { if (typeof cobB_paraFicha_ === 'function') fc = cobB_paraFicha_(id, x.u); } catch (e) { }
  const puntualidad = fc.puntualidad, suspension = fc.suspension, cobrosClave = fc.clave || '';

  return { ok:true, usuario: x.u, hoy: hoy, cliente: corto, datos: datos,
           cobros: { facturas: facturas.slice(0, 40), pagos: pagos, saldo: corto.saldo, vencido: corto.vencido, puntualidad: puntualidad },
           suspension: suspension, cobrosClave: cobrosClave,
           servicio: { visitas: recs.slice(0, 30), porMes: Object.keys(porMes).map(k => ({ mes: k, kg: crm_r_(porMes[k].kg, 1), visitas: porMes[k].visitas })) },
           contactos: contactos, linea: linea, tareas: tareas, documentos: documentos, historial: historial,
           sucursales: sucursales, oportunidad: pro ? crm_txt_(pro.codigoPropuesta) : '',
           distintivo: distintivo, certificados: certs, ajustes: aj };
}

function api_crmDocumentos(pin) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const hoy = hoyPanama_(), aj = crm_ajustes_();
  const docs = crm_filas_(HOJA_CRM_DOC).map(crm_documento_);
  const tiene = {};
  docs.forEach(d => { tiene[d.ref + '|' + d.tipo] = true; });
  const deducidos = [];
  crm_filas_(HOJA_PRO).forEach(r => {
    const p = crm_oportunidad_(r, aj, hoy);
    if (!p.codigoPropuesta) return;
    if (!tiene[p.codigoPropuesta + '|propuesta'] && (p['fecha propuesta'] || ['Propuesta enviada','En negociación','Contrato en proceso','Firmado','Pasado a cartera'].indexOf(p.estado) >= 0)) {
      const val = p['validez propuesta'];
      deducidos.push({ id: 'auto-p-' + p.codigoPropuesta, tipo:'propuesta', ref: p.codigoPropuesta, refTipo:'op', cuenta: p.empresa,
        nombre: 'Propuesta ' + p.codigoPropuesta, version: 1,
        estado: p.ganada ? 'aceptada' : p.perdida ? 'rechazada' : (p.estado === 'Registrado' || p.estado.indexOf('Formulario') === 0 ? 'borrador' : 'enviada'),
        canal:'', enviadoA: p.correo, enviadoEn: p['fecha propuesta'], validoHasta: /^\d+$/.test(String(val)) && p['fecha propuesta'] ? crm_masDias_(p['fecha propuesta'], Number(val)) : '',
        archivoId:'', enlace:'', notas:'', creadoPor: p.asesor, creadoEn: p['fecha propuesta'], historial:[], deducido: true,
        valor: p.valor, etapa: p.estado });
    }
    if (!p.visitaUnica && !tiene[p.codigoPropuesta + '|contrato'] && ['Contrato en proceso','Firmado','Pasado a cartera'].indexOf(p.estado) >= 0) {
      deducidos.push({ id: 'auto-c-' + p.codigoPropuesta, tipo:'contrato', ref: p.codigoPropuesta, refTipo:'op', cuenta: p.empresa,
        nombre: 'Contrato ' + (p['n contrato'] || p.codigoPropuesta), version: 1,
        estado: String(p['doc contrato firmado']).toUpperCase() === 'SI' ? 'firmada' : (p.estado === 'Contrato en proceso' ? 'borrador' : 'enviada'),
        canal:'', enviadoA:'', enviadoEn: p['fecha contrato'], validoHasta: p.vencimiento, archivoId:'', enlace:'', notas:'',
        creadoPor: p.asesor, creadoEn: p['fecha contrato'], historial:[], deducido: true, valor: p.valor, etapa: p.estado });
    }
  });
  /* contratos de la cartera: vigencia y renovación */
  const kilos = crm_kilos_(hoy);
  const contratos = leerHoja_(HOJA_CLI).filter(c => fechaISO_(c.vencimiento)).map(c => {
    const v = fechaISO_(c.vencimiento), k = kilos[crm_clave_(c.nombre)];
    return { clienteId: crm_txt_(c.id), cliente: crm_txt_(c.nombre), contrato: crm_txt_(c.contrato), vencimiento: v,
             dias: crm_dias_(hoy, v), planKg: crm_n_(c['plan kg']), kgMes: k ? crm_r_(k.kg / 3, 1) : 0, planCosto: crm_n_(c['plan costo']) };
  }).sort((a, b) => a.dias - b.dias);
  return { ok:true, usuario: x.u, hoy: hoy, documentos: docs.concat(deducidos)
