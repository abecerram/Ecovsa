      tipo: tipo, titulo: String(titulo || '').slice(0, 200), detalle: String(detalle || '').slice(0, 500),
      quien: u ? u.nombre : '', modulo: modulo || '', ref: ref || '' });
  } catch (e) { /* un aviso que falla no deshace la acción */ }
}

function avisosGerencia_(dias) {
  const desde = cobA_mas_(hoyPanama_(), -(dias || 15));
  return cobA_leer_(HOJA_AVG).map(a => ({ id: String(a.avisoId || ''), fecha: fechaISO_(a.fecha), hora: horaTxt_(a.hora),
    tipo: String(a.tipo || ''), titulo: String(a.titulo || ''), detalle: String(a.detalle || ''), quien: String(a.quien || ''),
    modulo: String(a.modulo || ''), ref: String(a.ref || '') }))
    .filter(a => a.fecha && a.fecha >= desde)
    .sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
}

function cobB_puntualidad_(L) {
  const desde = cobA_mas_(L.hoy, -365), out = {};
  L.facturas.forEach(f => {
    if (f.estado !== 'PAGADA' || !f.ultimoPago || !f.vencimiento || f.fecha < desde) return;
    const o = out[f.clave] = out[f.clave] || { pagadas: 0, tarde: 0, dias: 0 };
    o.pagadas++;
    if (f.ultimoPago > f.vencimiento) { o.tarde++; o.dias += cobA_dias_(f.vencimiento, f.ultimoPago); }
  });
  Object.keys(out).forEach(k => { const o = out[k]; o.pagaTarde = o.pagadas >= 2 && o.tarde / o.pagadas >= 0.5; o.diasTarde = o.tarde ? Math.round(o.dias / o.tarde) : 0; });
  return out;
}

function cobB_suspensiones_(L) {
  const hoy = L.hoy;
  return cobA_leer_(HOJA_SUSP).map(s => {
    const x = { id: String(s.suspId || ''), fecha: fechaISO_(s.fecha), clave: String(s.clave || ''), cliente: String(s.cliente || ''),
      clienteIds: String(s.clienteIds || '').split(',').map(v => v.trim()).filter(String), saldo: cobA_r2_(s.saldo), vencido: cobA_r2_(s.vencido),
      facturas: String(s.facturas || ''), moraMax: Number(s.moraMax) || 0, motivo: String(s.motivo || ''), pidio: String(s.pidio || ''),
      estadoGuardado: String(s.estado || 'PENDIENTE').toUpperCase(), decidio: String(s.decidio || ''), fechaDecision: fechaISO_(s.fechaDecision),
      motivoDecision: String(s.motivoDecision || ''), plazoHasta: fechaISO_(s.plazoHasta), cartaId: String(s.cartaId || '') };
    const c = L.cuentas[x.clave];
    let est = x.estadoGuardado;
    if (est === 'PLAZO' && x.plazoHasta && x.plazoHasta < hoy) { est = 'PENDIENTE'; x.plazoVencido = true; }
    /* si ya no debe nada vencido, la solicitud se cae sola */
    if ((est === 'PENDIENTE' || est === 'PLAZO') && c && c.vencido <= 0.009) est = 'SIN_DEUDA';
    if ((est === 'PENDIENTE' || est === 'PLAZO') && c && c.situacion === 'mora') est = 'SUSPENDIDA';
    x.estado = est;
    x.abierta = est === 'PENDIENTE' || est === 'PLAZO';
    return x;
  }).filter(x => x.id);
}

function cobB_checklist_(L, clave) {
  const c = L.cuentas[clave] || {}, hoy = L.hoy;
  const G = L.gestiones.filter(g => g.clave === clave && g.canal !== 'sistema');
  const cartas = cobA_leer_(HOJA_CARTAS).filter(k => String(k.clave) === clave && String(k.tipo) === 'ultimo' && String(k.enviadaEn || ''))
    .map(k => ({ fecha: fechaISO_(k.enviadaEn) || fechaISO_(k.fecha), limite: fechaISO_(k.fechaLimite) })).sort((a, b) => a.fecha < b.fecha ? 1 : -1);
  const ua = cartas[0] || null;
  const fl = cobA_fichas_().lista;
  const enRuta = (c.clienteIds || []).filter(id => { const f = fl.filter(x => String(x.id) === String(id))[0]; return !f || !/mora|pausa|cierre|retiro/i.test(f.situacion || ''); }).length;
  return [
    { ok: !!ua, t: ua ? 'Carta de último aviso enviada el ' + fechaPanama_(ua.fecha) + (ua.limite ? (ua.limite < hoy ? ' · el plazo venció el ' + fechaPanama_(ua.limite) : ' · el plazo vence el ' + fechaPanama_(ua.limite)) : '') : 'No se ha enviado la carta de último aviso' },
    { ok: !c.plan || ['ACTIVO', 'ATRASADO', 'PROPUESTO'].indexOf(c.plan.estado) < 0, t: c.plan && ['ACTIVO', 'ATRASADO', 'PROPUESTO'].indexOf(c.plan.estado) >= 0 ? 'Tiene un plan de pago ' + c.plan.estado.toLowerCase() : 'Sin plan de pago activo' },
    { ok: !(c.promesa && c.promesa.estado === 'viva'), t: c.promesa && c.promesa.estado === 'viva' ? 'Tiene una promesa de pago para el ' + fechaPanama_(c.promesa.fecha) : 'Sin promesa vigente' },
    { ok: !c.reclamo, t: c.reclamo ? 'Tiene un reclamo abierto desde el ' + fechaPanama_(c.reclamo.fecha) : 'Sin reclamo abierto' },
    { ok: G.length >= 3, t: G.filter(g => g.canal === 'llamada').length + ' llamada(s) y ' + G.filter(g => g.canal !== 'llamada').length + ' mensaje(s) anotados en el seguimiento' },
    { ok: false, aviso: true, t: 'Tiene ' + enRuta + ' punto(s) de atención en ruta: ' + (enRuta === 1 ? 'dejaría' : 'dejarían') + ' de recibir visitas' }
  ];
}

function api_cobPedirSuspension(pin, clave, motivo) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  const L = cobA_libro_(); cobA_seguimiento_(L);
  const c = L.cuentas[String(clave || '')];
  if (!c) return { ok: false, error: 'No encontré la cuenta.' };
  if (c.situacion === 'mora') return { ok: false, error: 'La cuenta ya está suspendida.' };
  if (c.vencido <= 0.009) return { ok: false, error: 'La cuenta no tiene nada vencido.' };
  if (!c.clienteIds.length) return { ok: false, error: 'La cuenta no tiene ficha de cliente: créala en Mercadeo antes de pedir la suspensión.' };
  if (cobB_suspensiones_(L).some(s => s.clave === c.clave && s.abierta)) return { ok: false, error: 'Ya hay una solicitud de suspensión esperando a Mercadeo.' };
  const m = String(motivo || '').trim();
  if (!m) return { ok: false, error: 'Escribe por qué se pide la suspensión.' };
  const abiertas = L.facturas.filter(f => f.clave === c.clave && f.saldo > 0.009 && f.mora > 0).map(f => f.factura);
  const id = cobB_id_('SS');
  cobA_agregar_(cobA_hoja_(HOJA_SUSP, COLS_SUSP), { suspId: id, fecha: L.hoy, clave: c.clave, cliente: c.cliente, clienteIds: c.clienteIds.join(','),
    saldo: c.saldo, vencido: c.vencido, facturas: abiertas.join(', '), moraMax: c.moraMax, motivo: m, pidio: a.u.nombre, estado: 'PENDIENTE' });
  cobA_agregar_(cobA_hojaGes_(), { gestionId: 'GC' + Date.now().toString(36).toUpperCase(), fecha: L.hoy, cliente: c.cliente, 'razon social': c.razon, ruc: c.ruc,
    canal: 'sistema', saldoEnEseMomento: c.saldo, seCompromete: 'NO', resultado: 'SUSPENSIÓN PEDIDA', notas: m, hechoPor: a.u.nombre, registradoEn: new Date(),
    tipo: 'suspension', clave: c.clave, siguientePaso: 'Mercadeo decide la suspensión', fechaSiguiente: cobA_mas_(L.hoy, 3) });
  marcar_('cobros'); marcar_('mercadeo');
  return { ok: true, suspId: id };
}

