  if (tipo === 'epp') { d.originalId = a.archivoId; d.firmada = true; } else d.listaId = a.archivoId;
  actualizar313_(t, f._fila, { datos: JSON.stringify(d), cambiadoPor: x.u.nombre, cambiadoEn: "'" + sst_ahora_() });
  if (tipo === 'epp' && d.persona) {          // la entrega queda firmada también en el expediente
