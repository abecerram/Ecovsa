  })).sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
}

function seg_resumen_() {
  const L = seg_avisos_(false);
  return { abiertos: L.length, bloqueos: L.filter(a => a.tipo === 'bloqueo' || a.tipo === 'conexion').length, pedidos: L.filter(a => a.tipo === 'pidePin').map(a => a.nombre),
           mercadeo: L.filter(a => a.tipo === 'mercadeo').length };   // api 3.13: cambios de Mercadeo por revisar
}

function seg_pinAbsurdo_(p) {
  if (/^(\d)\1+$/.test(p)) return true;
  const d = p.split('').map(Number);
  let sube = true, baja = true;
  for (let i = 1; i < d.length; i++) { if (d[i] !== d[i - 1] + 1) sube = false; if (d[i] !== d[i - 1] - 1) baja = false; }
  return sube || baja;
}

function api_crearMiPin(pinTemporal, nuevo) {
  const S = seg_ctx_(); S.permiteTemp = true;
  const u = usuarioPorPin_(pinTemporal);
  S.permiteTemp = false;
  if (!u) return { ok: false, error: 'Ese PIN temporal no sirve. Pídele uno nuevo al administrador.', requiereLogin: true };
  if (!u.temporal) return { ok: false, error: 'Tu PIN ya está creado. Entra con él.' };
  const p = String(nuevo || '').trim();
  const largo = Number(cfg_().seguridad.largoPin) === 6 ? 6 : 4;
  if (!/^\d+$/.test(p) || p.length !== largo) return { ok: false, error: 'Tu PIN debe tener ' + largo + ' números.' };
  if (seg_pinAbsurdo_(p)) return { ok: false, error: 'Ese PIN es muy fácil de adivinar (todos iguales o seguidos). Elige otro.', facil: true };
  if (p === String(pinTemporal).trim()) return { ok: false, error: 'Elige un PIN distinto al temporal.' };
  const filas = leerHoja_(HOJA_USR), h = huellaPin_(p);
  if (filas.some(r => String(r.pin || '').trim() === h || String(r.pinAnterior || '').trim() === h)) {
    seg_fallo_(true);                       // cuenta como intento: nadie puede andar probando PIN por aquí
    return { ok: false, error: 'Ese PIN no se puede usar. Elige otro.', otro: true };
  }
  const i = filas.findIndex(r => String(r.pin || '').trim() === huellaPin_(String(pinTemporal).trim()));
  if (i < 0) return { ok: false, error: 'No encontré tu usuario. Pídele un PIN nuevo al administrador.' };
  const H = cfgHojaUsr_(), t = seg_ahoraTxt_();
  cfgPonerUsr_(H, i, { pin: h, pinTemporal: '', pinVence: '', pinCreadoEn: t, pinCambiadoEn: t, largoPin: largo,
    pinAnterior: huellaPin_(String(pinTemporal).trim()), pinAnteriorHasta: seg_mas_(48) });   // si vuelve a escribir el temporal: «ya no sirve», sin contar
  cfgHistorial_({ nombre: u.nombre }, 'Usuarios', u.nombre + ' creó su PIN', 'con el PIN temporal; nadie más lo conoce');
  /* si había pedido un PIN nuevo, el aviso queda atendido */
  try {
    seg_avisos_(false).filter(a => a.tipo === 'pidePin' && cfgNombre_(a.nombre) === cfgNombre_(u.nombre))
      .forEach(a => crm_cambiar_(HOJA_SEGAV, COLS_SEGAV, 'avisoId', a.id, { estado: 'atendido', atendidoPor: u.nombre, atendidoEn: t }));
  } catch (e) {}
  seg_acierto_(h);
  return { ok: true, nombre: u.nombre };
}

function api_pedirPinNuevo(nombre) {
  const n = String(nombre || '').replace(/\s+/g, ' ').trim().slice(0, 80);
  const listo = { ok: true, texto: 'Listo. Le avisamos al administrador: te dará un PIN temporal para que crees el tuyo.' };
  if (n.length < 3) return { ok: false, error: 'Escribe tu nombre como aparece en el sistema.' };
  const kE = seg_kEq_(), hoy = seg_ahoraTxt_().slice(0, 10);
  const o = seg_leer_(kE) || {};
  if (o.pd === hoy && (o.pn || 0) >= 3) return listo;
  if (kE) { o.pn = (o.pd === hoy ? (o.pn || 0) : 0) + 1; o.pd = hoy; seg_poner_(kE, o); }
  const clave = s => String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toUpperCase().replace(/[^A-Z ]/g, '').trim();
  const q = clave(n);
  const u = leerHoja_(HOJA_USR).filter(r => String(r.activo || 'SI').toUpperCase() !== 'NO' && String(r.nombre || '').trim())
    .find(r => clave(r.nombre) === q || (q.length >= 4 && clave(r.nombre).indexOf(q) === 0));
  const ya = seg_avisos_(false).some(a => a.tipo === 'pidePin' && a.nombre === (u ? String(u.nombre).trim() : n));
  if (!ya) seg_aviso_('pidePin', (u ? String(u.nombre).trim() : n) + ' pide un PIN nuevo',
    u ? 'Lo pidió desde la entrada. Genera un PIN temporal en Usuarios.' : 'El nombre no coincide con ningún usuario activo. Revisa quién es antes de darle acceso.', u ? String(u.nombre).trim() : n);
  return listo;
}

function api_cfgSeguridadAvisos(pin) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  const eqs = {};
  PropertiesService.getScriptProperties().getKeys().filter(k => /^seg\.eq\./.test(k)).forEach(k => {
    const o = seg_leer_(k); if (o && (o.bloq || o.hasta > seg_ahoraMs_())) eqs[k.slice(7)] = { bloq: !!o.bloq, hasta: o.hasta || 0 };
  });
  return { ok: true, avisos: seg_avisos_(true).slice(0, 60), equiposBloqueados: eqs };
}

function api_cfgDesbloquear(pin, avisoId) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  const av = seg_avisos_(true).find(x => x.id === String(avisoId || ''));
  if (!av) return { ok: false, error: 'No encontré ese aviso.' };
  if (av.tipo === 'mercadeo') return { ok: false, error: 'Ese aviso no es de un equipo bloqueado.' };   // api 3.13
  const P = PropertiesService.getScriptProperties();
  if (av.equipo) P.deleteProperty('seg.eq.' + av.equipo);
  if (av.tipo === 'conexion' && av.conexion) P.deleteProperty('seg.ip.' + av.conexion);
  crm_cambiar_(HOJA_SEGAV, COLS_SEGAV, 'avisoId', av.id, { estado: 'atendido', atendidoPor: a.u.nombre, atendidoEn: seg_ahoraTxt_() });
  cfgHistorial_(a.u, 'Seguridad', 'Desbloqueó un equipo', (av.equipoTxt || 'equipo') + (av.conexion ? ' · conexión ' + av.conexion : '') + ' · bloqueado el ' + av.fecha + ' ' + av.hora);
  return { ok: true };
}

function api_cfgAtenderAviso(pin, avisoId) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  const r = crm_cambiar_(HOJA_SEGAV, COLS_SEGAV, 'avisoId', String(avisoId || ''), { estado: 'atendido', atendidoPor: a.u.nombre, atendidoEn: seg_ahoraTxt_() });
  if (!r) return { ok: false, error: 'No encontré ese aviso.' };
  return { ok: true };
}


/* ══════════ Solicitudes.gs (copiado tal cual) ══════════ */
function sol_contenido_(p) { try { return JSON.parse(String(p.contenido || '{}')) || {}; } catch (e) { return {}; } }

function sol_abiertaExtra_(p) {
  return String(p.tipo || '') === QR_TIPO_REC && ESTADOS_CERRADOS.indexOf(String(p.estado || 'nuevo')) < 0;
}

function sol_puede_(u) { return u && (esSupervisor_(u) || u.rol === 'gerente'); }

function sol_diaLargo_(f) {
  const d = new Date(String(f) + 'T12:00:00');
  if (isNaN(d.getTime())) return String(f || '');
  const D = ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
  const M = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
  return D[d.getDay()] + ' ' + d.getDate() + ' de ' + M[d.getMonth()];
}

function sol_recibosDe_(idx, id) {
  return (idx.visitas[id] || []).map(r => ({
    fecha: fechaISO_(r['Fecha de Recoleccion']), recibo: String(r['recibo numero'] || ''),
    kg: Number(r['total Kg']) || ((Number(r['Kg Recolectados']) || 0) + (Number(r['kg anatomopatologico']) || 0) + (Number(r['kg punzo cortantes']) || 0))
  })).filter(r => r.fecha).sort((a, b) => a.fecha.localeCompare(b.fecha));
}

function sol_yaRecolectada_(recs, pedida, prog) {
  const desde = prog && prog.fecha ? prog.fecha : '';
  return recs.find(r => desde ? r.fecha >= desde : (pedida && r.fecha > pedida)) || null;
}

function api_solLogistica(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!sol_puede_(u)) return { ok: false, error: 'Las solicitudes son de supervisión.' };
  const hoy = hoyPanama_();

  /* clientes nuevos e inspecciones: lo mismo que ya daban sus pantallas */
  const nuevos = api_clientesPorRevisar(pin);
  const insp = puedeInspeccionar_(u) ? api_inspecciones(pin) : { ok: true, pendientes: [], total: 0 };

  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC);
  const P = cli_plan_(CLI, REC, hoy);
  const cliPorId = {}; CLI.forEach(c => { const id = Number(c.id); if (id) cliPorId[id] = c; });
  const rutas = plan_rutas_(leerHoja_(HOJA_RUT));
  let vehiculos = []; try { vehiculos = vehiculosFlota_(); } catch (e) { vehiculos = VEHICULOS_BASE.map(p => ({ placa: p })); }
  const CFGL = cfgLog_(); let ACTS = []; try { ACTS = leerHoja_(HOJA_ACT); } catch (e) {}
  const tope = v => topeCamion_(v, CFGL, ACTS);

  /* ── los días por delante: hoy (si tiene ruta) y los 5 hábiles siguientes ── */
  const dias = [];
  const diaDe = f => {
    const rs = rutas.filter(r => r.fecha === f);
    return { fecha: f, hoy: f === hoy,
             rutas: rs.map(r => ({ rutaId: r.rutaId, conductor: r.conductor, vehiculo: r.vehiculo, paradas: r.paradas.length,
                                   tope: tope(r.vehiculo), caben: Math.max(0, tope(r.vehiculo) - r.paradas.length),
                                   borrador: r.estadoPlan === 'borrador', clientes: r.paradas.map(p => p.clienteId) })) };
  };
  if (rutas.some(r => r.fecha === hoy)) dias.push(diaDe(hoy));
  let d = hoy;
  for (let i = 0; i < 5; i++) { d = plan_habilDespues_(d); dias.push(diaDe(d)); }

  /* ── recolecciones extra ── */
  const PEND = leerHoja_(HOJA_PEND);
  const extras = [], atendidas = [];
  const hace = ini_dia_(hoy, -SOL_DIAS_ATENDIDAS);
  PEND.filter(p => String(p.tipo || '') === QR_TIPO_REC).forEach(p => {
    const c = sol_contenido_(p);
    const id = Number(c.clienteId);
    const ficha = cliPorId[id] || {};
    const pl = P.plan[id] || {};
    const pedida = fechaISO_(p.fecha);
    const est = String(p.estado || 'nuevo');
    const recs = sol_recibosDe_(P.idx, id);
    const prog = c.programada && c.programada.fecha ? c.programada : null;
    if (ESTADOS_CERRADOS.indexOf(est) < 0) {
      /* se cierra sola cuando ya llegó el recibo */
      const ya = sol_yaRecolectada_(recs, pedida, prog);
      if (ya) {
        actualizarFila_(HOJA_PEND, 'pendienteId', String(p.pendienteId), {
          estado: 'resuelto', atendidoPor: 'Sistema', atendidoEn: hoy,
          notaCierre: 'Recolectada el ' + sol_diaLargo_(ya.fecha) + (ya.recibo ? ' · recibo ' + ya.recibo : '') });
        atendidas.push({ tipo: 'extra', id: String(p.pendienteId), nombre: String(ficha.nombre || p.titulo || ''),
                         fecha: ya.fecha, que: 'Recolectada' + (ya.recibo ? ' · recibo ' + ya.recibo : '') + (ya.kg ? ' · ' + ini_r_(ya.kg, 1) + ' kg' : '') });
        return;
      }
      const enRuta = rutas.filter(r => r.fecha >= hoy && r.paradas.some(x => x.clienteId === id))
                          .sort((a, b) => a.fecha.localeCompare(b.fecha))[0];
      const ult = recs.length ? recs[recs.length - 1] : null;
      extras.push({
        pendienteId: String(p.pendienteId), folio: String(p.referencia || ''), pedida: pedida,
        diasEsperando: pedida ? Math.max(0, ini_diasEntre_(pedida, hoy)) : 0,
        prioridad: String(p.prioridad || 'media'), estado: est,
        cuando: String(c.cuando || ''), cantidad: String(c.cantidad || ''), motivo: String(c.motivo || ''), contacto: String(c.contacto || ''),
        plan: String(c.plan || ''),   /* api 3.18 · «dentro» del plan o «extra», del aviso «Mi depósito está lleno» */
        clienteId: id, nombre: String(ficha.nombre || String(p.titulo || '').replace(/^Recolección extra · /, '')),
        razonSocial: String(ficha['razon social'] || ''),
        direccion: String(ficha.direccion || ''), zona: String(ficha.region || ''), frecuencia: String(ficha.frecuencia || ''),
        diasFijos: String(ficha['dias semana'] || ''), telefonoFicha: String(ficha.telefono || ficha.whatsapp || ''),
        contactoFicha: String(ficha.contacto || ''), horario: ficha.horarioTipo ? String(ficha.horarioTipo).toLowerCase() + ' ' + horaTxt_(ficha.horarioDesde) + '–' + horaTxt_(ficha.horarioHasta) : '',
        conUbicacion: !!(numeroSeguro_(ficha.lat) && numeroSeguro_(ficha.lng)),
        activo: !!pl.activo, situacion: String(ficha.situacion || ficha.estado || ''),
        proxima: pl.proxima || '', ultima: ult ? { fecha: ult.fecha, recibo: ult.recibo, kg: ini_r_(ult.kg, 1) } : null,
        kgPromedio: recs.length ? ini_r_(recs.slice(-8).reduce((s, r) => s + r.kg, 0) / Math.min(8, recs.length), 1) : null,
        enRuta: enRuta ? { fecha: enRuta.fecha, rutaId: enRuta.rutaId, conductor: enRuta.conductor, vehiculo: enRuta.vehiculo,
                           comoExtra: enRuta.paradas.some(x => x.clienteId === id && String(x.origen).indexOf('extra:') === 0) } : null,
        programada: prog,
        anteriores: PEND.filter(x => String(x.tipo || '') === QR_TIPO_REC && String(x.pendienteId) !== String(p.pendienteId) &&
                                    Number(sol_contenido_(x).clienteId) === id).length
      });
    } else if (fechaISO_(p.atendidoEn) >= hace) {
      atendidas.push({ tipo: 'extra', id: String(p.pendienteId), nombre: String(ficha.nombre || p.titulo || ''),
                       fecha: fechaISO_(p.atendidoEn),
                       que: (est === 'descartado' ? 'No procede · ' : '') + String(p.notaCierre || (est === 'resuelto' ? 'Atendida' : 'Cerrada')),
                       por: String(p.atendidoPor || '') });
    }
  });
  /* primero lo que el cliente pidió para ya, luego por antigüedad */
  extras.sort((a, b) => (a.programada ? 1 : 0) - (b.programada ? 1 : 0) ||
                        (a.prioridad === 'alta' ? 0 : 1) - (b.prioridad === 'alta' ? 0 : 1) ||
                        b.diasEsperando - a.diasEsperando);

  /* ── lo atendido de las otras dos, para el filtro «Atendidas» ── */
  tab_try_(() => leerHoja_(HOJA_SOL).forEach(s => {
    const e = String(s.estado || '').toUpperCase(); if (e === 'PENDIENTE') return;
    const f = fechaISO_(s.procesadaEn); if (!f || f < hace) return;
    atendidas.push({ tipo: 'nuevo', id: String(s.solicitudId || ''), nombre: String(s.empresa || ''), fecha: f,
                     que: (e === 'APROBADA' ? 'Aprobado · entró a la agenda' : (e === 'DEVUELTA' ? 'Devuelto a Mercadeo' : e.toLowerCase())) +
                          (s.motivo && e !== 'APROBADA' ? ' · ' + String(s.motivo) : ''),
                     por: String(s.procesadaPor || '') });
  }), null);
  tab_try_(() => leerHoja_(HOJA_INSP).forEach(r => {
    const e = String(r.estado || '').toUpperCase(); if (INSP_ABIERTAS.indexOf(e) >= 0) return;
    const f = fechaISO_(r.cerradaEn); if (!f || f < hace) return;
    atendidas.push({ tipo: 'inspeccion', id: String(r.inspeccionId || ''), nombre: String(r.empresa || ''), fecha: f,
                     que: 'Inspección hecha · se mandó a Mercadeo', por: String(r.cerradaPor || '') });
  }), null);
  atendidas.sort((a, b) => String(b.fecha).localeCompare(String(a.fecha)));

  const porAtender = (nuevos.pendientes || []).length +
    (insp.pendientes || []).filter(i => !i.visitaProgramada).length +
    extras.filter(x => !x.programada).length;
  return { ok: true, hoy: hoy, usuario: { nombre: u.nombre, rol: u.rol },
           nuevos: nuevos.ok ? nuevos : { ok: false, pendientes: [], error: nuevos.error },
           insp: insp.ok ? insp : { ok: false, pendientes: [], error: insp.error },
           extras: extras, atendidas: atendidas.slice(0, 40), dias: dias,
           inspectores: sol_inspectores_(), porAtender: porAtender };
}

function sol_inspectores_() {
  return tab_try_(() => leerHoja_(HOJA_USR).filter(x => ['supervisor','admin','gerente'].indexOf(String(x.rol || '').toLowerCase()) >= 0 &&
      String(x.activo === undefined ? 'si' : x.activo).toLowerCase() !== 'no')
    .map(x => String(x.nombre || '').trim()).filter(String), []);
}

function api_solProgramarExtra(pin, pendienteId, fecha, rutaId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística programa recolecciones.' };
  const F = String(fecha || '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(F)) return { ok: false, error: 'Elige el día.' };
  const hoy = hoyPanama_();
  if (F < hoy) return { ok: false, error: 'Ese día ya pasó.' };
  const id = String(pendienteId || '').trim();
  const p = leerHoja_(HOJA_PEND).find(x => String(x.pendienteId || '') === id);
  if (!p || String(p.tipo || '') !== QR_TIPO_REC) return { ok: false, error: 'No encontré esa solicitud.' };
  if (!sol_abiertaExtra_(p)) return { ok: false, error: 'Esa solicitud ya está cerrada.' };
  const c = sol_contenido_(p);
  const cid = Number(c.clienteId);
  const ficha = leerHoja_(HOJA_CLI).find(x => Number(x.id) === cid);
  if (!ficha) return { ok: false, error: 'El cliente de esta solicitud ya no está en la cartera.' };
  const folio = String(p.referencia || '');

  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const rutas = plan_rutas_(leerHoja_(HOJA_RUT));
    let ruta = null, agregada = false, yaEstaba = false;
    if (rutaId) {
      ruta = rutas.find(r => r.rutaId === String(rutaId));
      if (!ruta) return { ok: false, error: 'Esa ruta ya no existe. Recarga la pantalla.' };
      if (ruta.fecha !== F) return { ok: false, error: 'Esa ruta es de otro día.' };
    }
    /* si ya está en alguna ruta de ese día, no se duplica */
    const delDia = rutas.find(r => r.fecha === F && r.paradas.some(x => x.clienteId === cid));
    if (delDia) { ruta = delDia; yaEstaba = true; }
    else if (ruta) {
      agregada = plan_agregar_(ruta.rutaId, F, ruta.conductor, ruta.vehiculo, ruta.estadoPlan, [{ clienteId: cid, origen: 'extra:' + folio }], u) > 0;
      if (agregada) marcar_('logistica');
    }
    c.programada = { fecha: F, rutaId: ruta ? ruta.rutaId : '', conductor: ruta ? ruta.conductor : '',
                     vehiculo: ruta ? ruta.vehiculo : '', por: u.nombre, en: hoy, yaEstaba: yaEstaba };
    actualizarFila_(HOJA_PEND, 'pendienteId', id, {
      estado: 'abierto', contenido: JSON.stringify(c), atendidoPor: u.nombre, atendidoEn: hoy,
      /* esto lo lee el cliente en su página del QR */
      notaCierre: 'Va el ' + sol_diaLargo_(F) + '.' });
    marcar_('logistica');
    return { ok: true, fecha: F, diaTexto: sol_diaLargo_(F), ruta: ruta ? { rutaId: ruta.rutaId, conductor: ruta.conductor, vehiculo: ruta.vehiculo } : null,
             agregada: agregada, yaEstaba: yaEstaba };
  } finally { lock.releaseLock(); }
}

function api_solDeshacerExtra(pin, pendienteId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  const J = jur_guard_(u, 'logistica', 'Una recolección extra'); if (J) return J;          // api 3.12
  jur_log_(u, 'logistica', 'Deshizo una recolección extra programada', pendienteId, '', '', HOJA_RUT, null);
  const id = String(pendienteId || '').trim();
  const p = leerHoja_(HOJA_PEND).find(x => String(x.pendienteId || '') === id);
  if (!p || String(p.tipo || '') !== QR_TIPO_REC) return { ok: false, error: 'No encontré esa solicitud.' };
  if (!sol_abiertaExtra_(p)) return { ok: false, error: 'Esa solicitud ya está cerrada.' };
  const c = sol_contenido_(p);
  const prog = c.programada || null;
  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    let quitada = false;
    if (prog && prog.rutaId && !prog.yaEstaba) {
      const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
      const vals = h.getDataRange().getValues(), cab = vals[0].map(String);
      const cR = cab.indexOf('rutaId'), cC = cab.indexOf('clienteId'), cO = cab.indexOf('origenParada');
      for (let i = vals.length - 1; i >= 1; i--) {
        if (String(vals[i][cR]) === String(prog.rutaId) && Number(vals[i][cC]) === Number(c.clienteId) &&
            cO >= 0 && String(vals[i][cO]) === 'extra:' + String(p.referencia || '')) { h.deleteRow(i + 1); quitada = true; }
      }
    }
    delete c.programada;
    actualizarFila_(HOJA_PEND, 'pendienteId', id, { estado: 'nuevo', contenido: JSON.stringify(c), notaCierre: '' });
    marcar_('logistica');
    return { ok: true, quitada: quitada };
  } finally { lock.releaseLock(); }
}

function api_solProgramarInspeccion(pin, inspeccionId, fecha, inspector) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!puedeInspeccionar_(u)) return { ok: false, error: 'Las inspecciones son de supervisión.' };
  const F = String(fecha || '');
  if (F && !/^\d{4}-\d{2}-\d{2}$/.test(F)) return { ok: false, error: 'Fecha no válida.' };
  if (F && F < hoyPanama_()) return { ok: false, error: 'Ese día ya pasó.' };
  const id = String(inspeccionId || '').trim();
  const r = leerHoja_(HOJA_INSP).find(x => String(x.inspeccionId || '') === id);
  if (!r) return { ok: false, error: 'No encontré esa inspección.' };
  if (INSP_ABIERTAS.indexOf(String(r.estado || '').toUpperCase()) < 0) return { ok: false, error: 'Esa inspección ya se hizo.' };
  const ok = actualizarFila_(HOJA_INSP, 'inspeccionId', id, {
    fechaVisita: F, inspectorAsignado: F ? (String(inspector || '').trim() || u.nombre) : '' });
  if (!ok) return { ok: false, error: 'No se pudo guardar.' };
  marcar_('logistica');
  return { ok: true, fecha: F, diaTexto: F ? sol_diaLargo_(F) : '', inspector: F ? (String(inspector || '').trim() || u.nombre) : '' };
}

function api_solNoProcede(pin, pendienteId, motivo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  const m = String(motivo || '').trim();
  if (m.length < 6) return { ok: false, error: 'Escribe el motivo: el cliente lo va a leer.' };
  const id = String(pendienteId || '').trim();
  const p = leerHoja_(HOJA_PEND).find(x => String(x.pendienteId || '') === id);
  if (!p || String(p.tipo || '') !== QR_TIPO_REC) return { ok: false, error: 'No encontré esa solicitud.' };
  if (!sol_abiertaExtra_(p)) return { ok: false, error: 'Esa solicitud ya está cerrada.' };
  const c = sol_contenido_(p);
  if (c.programada) return { ok: false, error: 'Está programada. Primero quítala del día.' };
  return api_cerrarPendiente(pin, id, 'descartado', m);
}

function sol_extrasAbiertas_() {
  return tab_try_(() => leerHoja_(HOJA_PEND).filter(sol_abiertaExtra_).map(p => {
    const c = sol_contenido_(p);
    return { pendienteId: String(p.pendienteId), folio: String(p.referencia || ''), clienteId: Number(c.clienteId),
             cuando: String(c.cuando || ''), cantidad: String(c.cantidad || ''), prioridad: String(p.prioridad || 'media'),
             pedida: fechaISO_(p.fecha), programada: c.programada && c.programada.fecha ? c.programada.fecha : '' };
  }).filter(x => x.clienteId), []);
}

function sol_porFolio_(folio) {
  const f = String(folio || '').trim(); if (!f) return null;
  return leerHoja_(HOJA_PEND).find(p => String(p.tipo || '') === QR_TIPO_REC && String(p.referencia || '') === f && sol_abiertaExtra_(p)) || null;
}

function sol_extraPuesta_(folio, F, ruta, u) {
  try {
    const p = sol_porFolio_(folio); if (!p) return;
    const c = sol_contenido_(p);
    if (c.programada && c.programada.fecha === F && c.programada.rutaId === ruta.rutaId) return;
    c.programada = { fecha: F, rutaId: ruta.rutaId, conductor: ruta.conductor || '', vehiculo: ruta.vehiculo || '',
                     por: u ? u.nombre : '', en: hoyPanama_(), yaEstaba: false };
    actualizarFila_(HOJA_PEND, 'pendienteId', String(p.pendienteId), {
      estado: 'abierto', contenido: JSON.stringify(c), notaCierre: 'Va el ' + sol_diaLargo_(F) + '.' });
  } catch (e) { /* el plan se guarda igual */ }
}

function sol_extraQuitada_(folio) {
  try {
    const p = sol_porFolio_(folio); if (!p) return;
    const c = sol_contenido_(p); if (!c.programada) return;
    delete c.programada;
    actualizarFila_(HOJA_PEND, 'pendienteId', String(p.pendienteId), { estado: 'nuevo', contenido: JSON.stringify(c), notaCierre: '' });
  } catch (e) {}
}

function sol_alGuardarRuta_(rutaId, F, cond, veh, paradas, viejas, u) {
  const ahora = {};
  (paradas || []).forEach(p => { const o = String(p.origen || ''); if (o.indexOf('extra:') === 0) ahora[o.slice(6)] = 1; });
  Object.keys(ahora).forEach(f => sol_extraPuesta_(f, F, { rutaId: rutaId, conductor: cond, vehiculo: veh }, u));
  (viejas || []).forEach(r => { const o = String(r.origenParada || ''); if (o.indexOf('extra:') === 0 && !ahora[o.slice(6)]) sol_extraQuitada_(o.slice(6)); });
}


/* ══════════ Tablero.gs (copiado tal cual) ══════════ */
function tab_try_(fn, def) { try { return fn(); } catch (e) { return def; } }

function tab_n_(v) { const x = Number(v); return isFinite(x) ? x : 0; }

function tab_r_(v, d) { const k = Math.pow(10, d || 0); return Math.round(tab_n_(v) * k) / k; }

function tab_miles_(v, d) {
  const n = tab_r_(v, d || 0);
  return n.toLocaleString('en-US', { minimumFractionDigits: d || 0, maximumFractionDigits: d || 0 });
}

function tab_dinero_(v) {
  const n = tab_n_(v);
  if (Math.abs(n) >= 10000) return 'B/. ' + tab_r_(n / 1000, 1).toLocaleString('en-US') + 'k';
  return 'B/. ' + tab_miles_(n, 2);
}

function tab_dias_(a, b) { return Math.round((new Date(b + 'T12:00:00Z') - new Date(a + 'T12:00:00Z')) / 86400000); }

function tab_lunes_(hoy) { const d = new Date(hoy + 'T12:00:00Z'); const w = (d.getUTCDay() + 6) % 7; d.setUTCDate(d.getUTCDate() - w); return d.toISOString().slice(0, 10); }

function tab_masDias_(iso, n) { const d = new Date(iso + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); }

function tab_recibosSinEnviar_(hoy) {
  const piden = {};
  leerHoja_(HOJA_CLI).forEach(c => {
    const rd = String(c.reciboDigital || '').toLowerCase();
    if (rd === 'whatsapp' || rd === 'correo' || rd === 'ambos')
      piden[String(c.nombre || '').trim().toUpperCase()] = true;
  });
  const desde = tab_masDias_(hoy, -7), lista = [];
  leerHoja_(HOJA_REC).forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']);
    if (!f || f < desde || f > hoy) return;
    if (!piden[String(r.Cliente || '').trim().toUpperCase()]) return;
    if (String(r.enviado || '').trim()) return;
    lista.push(String(r.Cliente || '').trim());
  });
  return lista;
}

function tab_cartera_(hoy) {
  const libro = cob_libro_();
  let porCobrar = 0, vencido = 0, vencidas = 0, masVieja = '';
  libro.facturas.forEach(f => {
    const pagado = (f.pagos || []).reduce((s, p) => s + tab_n_(p.monto), 0);
    const saldo = tab_n_(f.neto || f.total) - pagado;
    if (saldo <= 0.009) return;
    porCobrar += saldo;
    if (f.vencimiento && f.vencimiento < hoy) {
      vencido += saldo; vencidas++;
      if (!masVieja || f.vencimiento < masVieja) masVieja = f.vencimiento;
    }
  });
  const mes = hoy.slice(0, 8);
  const cobradoMes = libro.pagos.filter(p => String(p.fecha || '').slice(0, 8) === mes)
                                .reduce((s, p) => s + tab_n_(p.monto), 0);
  return { porCobrar: tab_r_(porCobrar, 2), vencido: tab_r_(vencido, 2), vencidas: vencidas,
           diasViejo: masVieja ? tab_dias_(masVieja, hoy) : 0, cobradoMes: tab_r_(cobradoMes, 2) };
}

function tab_pendientesHoja_(modulos, hoy) {
  const nivel = { alta:'r', media:'a', baja:'g' };
  return leerHoja_(HOJA_PEND).filter(p => {
    const e = String(p.estado || 'nuevo').trim().toLowerCase();
    if (ESTADOS_CERRADOS.indexOf(e) >= 0) return false;
    const rec = fechaISO_(p.recordarEn);
    if (e === 'pospuesto' && rec && rec > hoy) return false;
    return modulos.indexOf(String(p.modulo || '').trim().toLowerCase()) >= 0;
  }).map(p => ({
    nivel: nivel[String(p.prioridad || 'media')] || 'a',
    titulo: String(p.titulo || ''), texto: String(p.descripcion || ''),
    asist: String(p.modulo || '').trim().toLowerCase(), fecha: fechaISO_(p.fecha)
  }));
}

function api_tablero(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok:false, error:'PIN no válido', requiereLogin:true };
  const base = api_lobby(pin);
  if (!base.ok) return base;

  const hoy = hoyPanama_(), rol = u.rol;
  /* api 3.7: el módulo principal de esta persona y lo que también sigue */
  const PR = tab_try_(() => prefsUsuario_(u), { principal: rol === 'admin' || rol === 'gerente' ? 'inicio' : 'campo', elegido: false, sigue: [] });
  const abre = {};
  base.modulos.forEach(m => { if (m.permitido && m.estado !== 'construccion' && !m.cerrado) abre[m.id] = true; });   // api 3.14: los apagados no se consultan
  const plata = !!abre.cobros;
  const items = [], kpis = [];
  const it = (nivel, ir, titulo, texto) => items.push({ nivel: nivel, ir: ir, titulo: titulo, texto: texto || '' });

  /* ── Logística: lo mismo que ve el Inicio de logística ── */
  let ini = null;
  if (abre.campo && (esSupervisor_(u) || rol === 'gerente' || PR.principal === 'campo' || PR.sigue.indexOf('campo') >= 0))
    ini = tab_try_(() => api_inicioLogistica(pin, 'semana'), null);
  if (ini && ini.ok) {
    const nv = { r:'r', a:'a', m:'g', b:'g' };
    const incCfg = tab_try_(() => inc_cfg_(), { avisarGerencia: true });
    (ini.atencion || []).forEach(a => {
      /* api 3.8: a gerencia solo le llegan las incidencias graves, y solo si Logística lo deja encendido */
      if (rol === 'gerente' && (a.tipo === 'incidencia' || a.tipo === 'norec' || a.tipo === 'ubicacion') && (!incCfg.avisarGerencia || a.nivel !== 'r')) return;
      it(nv[a.nivel] || 'a', 'campo', String(a.titulo || ''), String(a.texto || ''));
    });
  }
  let sinEnviar = [];
  if (abre.campo && rol !== 'operador') sinEnviar = tab_try_(() => tab_recibosSinEnviar_(hoy), []);
  if (sinEnviar.length) {
    const nombres = sinEnviar.filter((x, i, a) => a.indexOf(x) === i);
    it('a', 'campo', sinEnviar.length + (sinEnviar.length === 1 ? ' recibo pide PDF y no se ha enviado' : ' recibos piden PDF y no se han enviado'),
       nombres.slice(0, 3).join(', ') + (nombres.length > 3 ? ' y ' + (nombres.length - 3) + ' más' : ''));
  }

  /* ── Planta ── */
  const pla = abre.planta ? tab_try_(() => dir_planta_(tab_lunes_(hoy), hoy, hoy), null) : null;
  const yaPlanta = !!(ini && ini.ok && (ini.atencion || []).some(a => a.tipo === 'planta'));
  if (pla && pla._kgSinActa > 0.05 && !yaPlanta)
    it(pla._diasViejo > 3 ? 'a' : 'g', 'planta', tab_miles_(pla._kgSinActa) + ' kg sin acta de entrega',
       'El lote más viejo lleva ' + pla._diasViejo + ' día(s) esperando.');

  /* ── Cartera ── */
  const car = plata ? tab_try_(() => tab_cartera_(hoy), null) : null;
  if (car && car.vencidas)
    it(car.diasViejo > 30 ? 'r' : 'a', 'cobros', car.vencidas + (car.vencidas === 1 ? ' factura vencida' : ' facturas vencidas'),
       tab_dinero_(car.vencido) + ' vencido · la más antigua: ' + car.diasViejo + ' días');

  /* ── Mercadeo ── */
  const mer = (abre.alta || abre.inicio) && (rol === 'mercadeo' || rol === 'admin' || rol === 'gerente' || PR.principal === 'alta')
    ? tab_try_(() => dir_mercadeo_(hoy.slice(0, 8) + '01', hoy, hoy), null) : null;
  const sol = abre.alta ? tab_try_(() => leerHoja_(HOJA_SOL), []) : [];
  const devueltas = sol.filter(s => String(s.estado || '').toUpperCase() === 'DEVUELTA' &&
                                    fechaISO_(s.procesadaEn) >= tab_masDias_(hoy, -30));
  const altasPend = sol.filter(s => String(s.estado || '').toUpperCase() === 'PENDIENTE');
  if (rol === 'mercadeo' && devueltas.length)
    it('r', 'alta', devueltas.length + (devueltas.length === 1 ? ' alta devuelta por logística' : ' altas devueltas por logística'),
       devueltas.slice(0, 2).map(s => String(s.empresa || '') + (s.motivo ? ' · ' + String(s.motivo) : '')).join(' · '));
  if (altasPend.length && (rol === 'mercadeo' || esSupervisor_(u)))
    it('g', rol === 'mercadeo' ? 'alta' : 'campo', altasPend.length + (altasPend.length === 1 ? ' cliente nuevo por aprobar' : ' clientes nuevos por aprobar'),
       'Solicitudes de alta que esperan a logística');
  /* api 3.8: la mala gestión que reportan los conductores, para Mercadeo */
  if (rol === 'mercadeo' || PR.principal === 'alta') {
    const mg = tab_try_(() => inc_paraMercadeo_(), []);
    if (mg.length) it('a', 'alta', mg.length + (mg.length === 1 ? ' cliente con mala gestión de desechos' : ' clientes con mala gestión de desechos'),
      mg.slice(0, 3).map(x => x.cliente + ' (' + mto_f_(x.fecha) + ')').join(', ') + ' · lo reportó el conductor');
  }
  /* api 3.9: documentos de clientes que se borran pronto de la bandeja temporal */
  if (rol === 'mercadeo' || PR.principal === 'alta') {
    const tv = tab_try_(() => arc_temporalAviso_(), []);
    if (tv.length) it(tv.some(o => o.quedan <= 2) ? 'r' : 'a', 'alta', tv.length + (tv.length === 1 ? ' cliente tiene documentos que se borran pronto' : ' clientes tienen documentos que se borran pronto'),
      tv.slice(0, 3).map(o => (o.empresa || o.cod) + ' (' + (o.quedan ? 'en ' + o.quedan + (o.quedan === 1 ? ' día' : ' días') : 'hoy') + ')').join(', ') + ' · imprime el expediente antes');
  }
  if (mer && mer._porVencer && mer._porVencer.length && rol === 'mercadeo')
    it(mer._porVencer[0].dias < 0 ? 'r' : 'a', 'alta', mer._porVencer.length + ' contrato(s) vencen en 30 días o menos',
       mer._porVencer.slice(0, 3).map(c => c.nombre).join(', '));

  /* ── Solicitudes de pago que esperan aprobación ──
     api 3.4: solo si la aprobación está encendida en Configuración. Si se
     aprueba en otro proceso, a gerencia le llega en su lugar el aviso por
     monto: lo que está por pagar y pasa del monto de aviso. */
  const RSP = tab_try_(() => spReglas_(), { aprobacion: true, aviso: 0 });
  if (abre.finanzas && (rol === 'admin' || rol === 'gerente') && !RSP.aprobacion && RSP.aviso > 0) {
    const av = tab_try_(() => leerHoja_(HOJA_SP), []).filter(s => spPorPagar_(s.estado, RSP) && tab_n_(s.total) >= RSP.aviso);
    if (av.length)
      it('g', 'finanzas', av.length + (av.length === 1 ? ' solicitud por pagar pasa de ' : ' solicitudes por pagar pasan de ') + tab_dinero_(RSP.aviso),
         av.slice(0, 2).map(s => String(s.proveedor || '') + ' · ' + tab_dinero_(tab_n_(s.total))).join(' · '));
  }
  if (abre.finanzas && (rol === 'admin' || rol === 'gerente') && RSP.aprobacion) {
    const sp = tab_try_(() => leerHoja_(HOJA_SP), []).filter(s => String(s.estado || '').toUpperCase() === 'SOLICITADA');
    if (sp.length) {
      const total = sp.reduce((s, x) => s + tab_n_(x.total), 0);
      it(sp.some(s => String(s.urgencia || '').toUpperCase() === 'URGE') ? 'a' : 'g', 'finanzas',
         sp.length + (sp.length === 1 ? ' solicitud de pago esperando' : ' solicitudes de pago esperando'),
         (plata || rol === 'admin' || rol === 'gerente') ? 'Por ' + tab_dinero_(total) : '');
    }
  }

  /* ── api 3.1 · Recolecciones extra que pidieron los clientes desde el QR ──
     Entran a Pendientes (bandeja de logística); aquí se avisan en el lobby
     a quien las coordina, sin traer el resto de la bandeja. */
  if (abre.campo && (esSupervisor_(u) || rol === 'gerente' || rol === 'admin')) {
    const qr = tab_try_(() => leerHoja_(HOJA_PEND).filter(p => String(p.tipo || '') === 'qrRecoleccion' &&
                 ESTADOS_CERRADOS.indexOf(String(p.estado || 'nuevo')) < 0), []);
    if (qr.length)
      it(qr.some(p => String(p.prioridad) === 'alta') ? 'r' : 'a', 'campo',
         qr.length + (qr.length === 1 ? ' recolección extra pedida por un cliente' : ' recolecciones extra pedidas por clientes'),
         qr.slice(0, 3).map(p => String(p.titulo || '').replace(/^Recolección extra · /, '')).join(', ') + ' · desde el QR');
  }

  /* ── Lo que dejaron los asistentes en la hoja de pendientes ── */
  const asistDe = [];
  if (abre.alta && rol === 'mercadeo') asistDe.push('mercadeo');
  if (abre.planta && (rol === 'planta' || rol === 'admin' || rol === 'gerente')) asistDe.push('planta');
  if (abre.cobros && (rol === 'cobros' || rol === 'admin' || rol === 'gerente')) asistDe.push('cobros');
  if (rol === 'gerente' || rol === 'admin') asistDe.push('gerencia');
  const irDe = { mercadeo:'alta', planta:'planta', cobros:'cobros', gerencia:'inicio', solicitudes:'finanzas', logistica:'campo' };
  tab_try_(() => tab_pendientesHoja_(asistDe, hoy), []).slice(0, 12)
    .forEach(p => it(p.nivel, irDe[p.asist] || 'inicio', p.titulo, p.texto));

  /* ── api 3.5 · Suspensiones que Cobros pidió y esperan a Mercadeo ── */
  if (abre.alta && (rol === 'mercadeo' || rol === 'admin')) {
    const ns = tab_try_(() => cobB_contarPendientes_(), 0);
    if (ns) it('r', 'alta', ns + (ns === 1 ? ' suspensión pedida por Cobros' : ' suspensiones pedidas por Cobros'),
               'Esperan tu decisión en la ficha del cliente');
  }
  /* ── api 3.5 · Avisos a gerencia: solo informan (incobrables, suspensiones, reactivaciones) ── */
  if (rol === 'gerente' || rol === 'admin') {
    const av = tab_try_(() => avisosGerencia_(7), []);
    if (av.length)
      it('g', 'inicio', av.length === 1 ? av[0].titulo : av.length + ' avisos de Cobros y Mercadeo esta semana',
         av.length === 1 ? av[0].detalle : av.slice(0, 2).map(a => a.titulo).join(' · '));
  }

  /* ── Los cuatro números, según el rol ── */
  const T = ini && ini.ok ? ini.totales : null;
  const I = ini && ini.ok ? ini.indicadores : null;
  const trendKg = (I && I.anterior && I.anterior.kg)
    ? Math.round((I.actual.kg - I.anterior.kg) / I.anterior.kg * 100) : null;
  const kpiParadas = T ? { v: T.hechas + '/' + T.total, e: 'paradas hoy' } : null;
  const kpiKg = I ? { v: tab_miles_(I.actual.kg) + ' kg', e: 'esta semana',
                      d: trendKg === null ? '' : (trendKg >= 0 ? '▲ ' : '▼ ') + Math.abs(trendKg) + '%', malo: trendKg !== null && trendKg < 0 } : null;
  const kpiAcopio = pla ? { v: tab_miles_(pla._kgSinActa) + ' kg', e: 'sin acta de entrega' } : null;
  const kpiCobrar = car ? { v: tab_dinero_(car.porCobrar), e: 'por cobrar', d: car.vencidas ? car.vencidas + ' vencidas' : '', malo: !!car.vencidas } : null;

  /* api 3.7: los cuatro números son los del módulo principal, no los del rol */
  const KS = PR.principal;
  if (KS === 'inicio') {
    [kpiParadas, kpiKg, kpiAcopio, kpiCobrar].forEach(k => { if (k) kpis.push(k); });
  } else if (KS === 'campo') {
    if (kpiParadas) kpis.push(kpiParadas);
    if (ini && ini.ok) kpis.push({ v: String((ini.vivo || []).filter(r => r.estado === 'en ruta').length), e: 'rutas en curso' });
    if (kpiKg) kpis.push(kpiKg);
