    pron[m].n++; pron[m].valor += p.valor; pron[m].ponderado += p.ponderado;
  });
  const pronostico = Object.keys(pron).sort().map(k => ({ mes: k, n: pron[k].n,
    valor: crm_r_(pron[k].valor, 2), ponderado: crm_r_(pron[k].ponderado, 2) }));
