    if (k === 'sectores' && !valor.length) return { ok:false, error:'Deja al menos un sector.' };
  }
  const v = typeof valor === 'string' ? valor : JSON.stringify(valor);
  const r = crm_cambiar_(HOJA_CRM_AJU, COLS_CRM_AJU, 'clave', k, { valor: "'" + v, cambiadoPor: x.u.nombre, cambiadoEn: crm_ahora_() });
