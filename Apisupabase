function prb_esPrueba_(v) { return String(v || '').toUpperCase() === 'SI'; }

function prb_clave_(s) { return String(s || '').trim().toUpperCase(); }

function prb_alcance_(tipo, id) {
  const out = { tipo: tipo, id: String(id), nombre: '', partes: [] };
  const cuenta = (hoja, pred, n) => { let L = []; try { L = leerHoja_(hoja); } catch (e) { try { L = crm_filas_(hoja); } catch (e2) { L = []; } } const k = L.filter(pred).length; if (k) out.partes.push({ hoja: hoja, n: k, que: n }); return k; };
  if (tipo === 'cliente') {
    const c = leerHoja_(HOJA_CLI).find(x => String(x.id) === String(id)); if (!c) return null;
    const nom = prb_clave_(c.nombre); out.nombre = String(c.nombre || ''); out.prueba = prb_esPrueba_(c.prueba);
    cuenta(HOJA_REC, r => prb_clave_(r.Cliente) === nom, 'recolecciones (recibos)');
    cuenta(HOJA_RUT, r => String(r.clienteId) === String(id), 'paradas en rutas');
    cuenta(HOJA_SOL, r => prb_clave_(r.empresa) === nom, 'solicitudes de alta');
    cuenta(HOJA_CRM_ACT, r => String(r.ref) === String(id) && /^cli/.test(String(r.refTipo || '')), 'actividades de Mercadeo');
    cuenta(HOJA_CRM_TAR, r => String(r.ref) === String(id) && /^cli/.test(String(r.refTipo || '')), 'tareas');
    cuenta(HOJA_CRM_CON, r => String(r.ref) === String(id) && /^cli/.test(String(r.refTipo || '')), 'contactos');
    cuenta(HOJA_REP, r => String(r.clienteId) === String(id) || prb_clave_(r.clienteNombre) === nom, 'reposiciones');
    cuenta(HOJA_PEND, r => { const t = String(r.contenido || ''); return t.indexOf('"clienteId":' + id + ',') >= 0 || t.indexOf('"clienteId":"' + id + '"') >= 0; }, 'pendientes (bandeja)');
  } else {
    const p = leerHoja_(HOJA_PRO).find(x => String(x.codigoPropuesta || '').trim() === String(id).trim()); if (!p) return null;
    out.nombre = String(p.empresa || ''); out.prueba = prb_esPrueba_(p.prueba); out.estado = String(p.estado || '');
    cuenta(HOJA_CRM_ACT, r => String(r.ref) === String(id), 'actividades');
    cuenta(HOJA_CRM_TAR, r => String(r.ref) === String(id), 'tareas');
    cuenta(HOJA_CRM_CON, r => String(r.ref) === String(id), 'contactos');
    cuenta(HOJA_CRM_DOC, r => String(r.ref) === String(id), 'documentos (propuestas y contratos)');
    cuenta(HOJA_SOL, r => String(r.codigoPropuesta || '').trim() === String(id).trim() && String(r.estado || '').toUpperCase() !== 'APROBADA', 'solicitudes de alta sin aprobar');
  }
  return out;
}

function api_cfgDatosPrueba(pin, q) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  const pareceP = s => /\b(prueba|test|demo|ejemplo)\b/i.test(String(s || ''));
  const Q = prb_clave_(q);
  const cli = leerHoja_(HOJA_CLI).filter(c => String(c.id || '').trim() && String(c.nombre || '').trim());
  const pro = leerHoja_(HOJA_PRO).filter(p => String(p.codigoPropuesta || '').trim());
  const hit = s => Q && prb_clave_(s).indexOf(Q) >= 0;
  const clientes = cli.filter(c => prb_esPrueba_(c.prueba) || pareceP(c.nombre) || hit(c.nombre) || (Q && String(c.id) === String(q).trim()))
    .map(c => ({ tipo: 'cliente', id: String(c.id), nombre: String(c.nombre), prueba: prb_esPrueba_(c.prueba), sugerido: !prb_esPrueba_(c.prueba) && pareceP(c.nombre), estado: String(c.estado || '') })).slice(0, 60);
  const oportunidades = pro.filter(p => prb_esPrueba_(p.prueba) || pareceP(p.empresa) || hit(p.empresa) || hit(p.codigoPropuesta))
    .map(p => ({ tipo: 'oportunidad', id: String(p.codigoPropuesta), nombre: String(p.empresa || ''), prueba: prb_esPrueba_(p.prueba), sugerido: !prb_esPrueba_(p.prueba) && pareceP(p.empresa), estado: String(p.estado || '') })).slice(0, 60);
  return { ok: true, clientes: clientes, oportunidades: oportunidades };
}

