/* ── reparto: el neto de cada ticket entre las paradas de su viaje ── */
function dso_reparto_(h) {
  const kg = (h.paradas || []).map(() => 0), deViaje = (h.paradas || []).map(() => -1);
  (h.viajes || []).forEach((v, n) => {
    const idx = (v.paradas || []).filter(i => h.paradas[i] && h.paradas[i].atendida);
    const neto = dso_n_(v.neto);
    if (!idx.length) return;
    idx.forEach(i => { deViaje[i] = n; });   /* api 3.26: la descarga en planta (peso después) también cuenta como entregada */
    if (!(neto > 0)) return;
    const tot = idx.reduce((a, i) => a + dso_n_(h.paradas[i].bolsas), 0);
    idx.forEach(i => { deViaje[i] = n; kg[i] += tot > 0 ? neto * dso_n_(h.paradas[i].bolsas) / tot : neto / idx.length; });
  });
  return { kg: kg.map(x => Math.round(x * 10) / 10), viaje: deViaje };
}
function dso_kgBolsa_(puntoId, hojas) {
  let b = 0, k = 0;
  (hojas || dso_hojas_()).filter(h => h.estado === 'cerrada').slice(-60).forEach(h => {
    const R = dso_reparto_(h);
    h.paradas.forEach((p, i) => { if (p.puntoId === puntoId && dso_n_(p.bolsas) > 0 && R.kg[i] > 0) { b += dso_n_(p.bolsas); k += R.kg[i]; } });
  });
  return b > 0 ? Math.round(k / b * 10) / 10 : 0;
}

