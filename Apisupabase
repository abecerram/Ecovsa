function sst_tipo_(tipo, interno) { const T = SST_TIPOS[String(tipo || '')]; return T && (interno || !T.interno) ? T : null; }

/* ── Lista de un tipo de registro ── */
function api_segLista(pin, tipo) {
  const x = sst_usr_(pin); if (x.e) return x.e;
