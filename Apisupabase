function req_vista_(r, SP, entradas, hoy) {
  const q = Object.assign({}, r);
  q.que = r.renglones.map(x => String(x.desc || '') + (Number(x.cant) > 0 && !(Number(x.cant) === 1 && /servicio/i.test(String(x.unidad || ''))) ? ' · ' + x.cant + ' ' + String(x.unidad || '') : '')).join(' + ');
  q.dias = r.fecha ? Math.max(0, Math.round((new Date(hoy + 'T12:00:00') - new Date(r.fecha + 'T12:00:00')) / 86400000)) : 0;
  q.paso = 0; q.fase = 'enviada'; q.texto = 'La tiene Compras · sin tramitar';
  if (r.estado === 'PREGUNTA') { q.fase = 'pregunta'; q.texto = 'Compras pregunta: «' + r.pregunta + '»'; }
  else if (r.estado === 'RESPONDIDA') { q.fase = 'respondida'; q.texto = 'Respondida: «' + r.respuesta + '» · la tiene Compras'; }
  else if (r.estado === 'NO_PROCEDE') { q.fase = 'noprocede'; q.texto = 'No procede: ' + r.motivo; }
  else if (r.estado === 'TRAMITADA' || r.estado === 'RECIBIDA') {
    const s = SP[r.solicitudId] || null; q.paso = 1;
    q.solicitud = s ? { solicitudId: s.solicitudId, proveedor: s.proveedor, total: s.total, estado: s.estado, fechaPago: s.fechaPago, motivoRechazo: s.motivoRechazo } : null;
    const est = s ? s.estado : '';
    const base = r.solicitudId + (s && s.proveedor ? ' · ' + s.proveedor : '') + (s && s.total ? ' · B/. ' + Number(s.total).toFixed(2) : '');
    if (est === 'RECHAZADA' || est === 'ANULADA') { q.fase = 'rechazada'; q.texto = base + ' · ' + (est === 'RECHAZADA' ? 'rechazada' : 'anulada') + (s.motivoRechazo ? ': ' + s.motivoRechazo : ''); }
    else if (est === 'PAGADA') {
      q.paso = 3;
      const recibida = r.estado === 'RECIBIDA' || (!!entradas[r.solicitudId]);
      if (recibida) { q.paso = 4; q.fase = 'recibida'; q.texto = base + ' · pagada' + (s.fechaPago ? ' el ' + mto_f_(s.fechaPago) : '') + ' · recibida'; }
      else { q.fase = 'pagada'; q.texto = base + ' · pagada' + (s.fechaPago ? ' el ' + mto_f_(s.fechaPago) : '') + (/insumo|repuesto/i.test(r.tipo) ? ' · falta contarlo en la bodega' : ' · falta confirmar que se hizo'); }
    }
    else if (est === 'APROBADA') { q.paso = 2; q.fase = 'aprobada'; q.texto = base + ' · aprobada, por pagar'; }
    else { q.fase = 'tramite'; q.texto = base + ' · espera aprobación'; }
  }
  return q;
}

function req_contexto_() {
  const SP = {};
  try { leerHoja_(HOJA_SP).forEach(s => { const id = String(s.solicitudId || '').trim(); if (id) SP[id] = { solicitudId: id, proveedor: String(s.proveedor || ''), total: Number(s.total) || 0,
    estado: String(s.estado || '').toUpperCase(), fechaPago: fechaISO_(s.fechaPago), motivoRechazo: String(s.motivoRechazo || '') }; }); } catch (e) {}
  const entradas = {};
  try { leerHoja_(HOJA_MOV).forEach(m => { const s = String(m.solicitudId || '').trim(); if (s && String(m.tipo || '').toUpperCase() === 'ENTRADA') entradas[s] = true; }); } catch (e) {}
  return { SP: SP, entradas: entradas };
}

function req_preguntas_(modulo) {
  try { return req_filas_().filter(r => r.modulo === modulo && r.estado === 'PREGUNTA').length; } catch (e) { return 0; }
}

function api_reqLista(pin, modulo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const m = String(modulo || '');
  const compras = m === 'compras';
  if (compras ? !req_compras_(u) : !req_pide_(u, m)) return { ok: false, error: compras ? 'Las requisiciones las tramita Compras.' : 'Tu usuario no pide requisiciones por este módulo.' };
  const hoy = hoyPanama_(), cx = req_contexto_(), mes = hoy.slice(0, 7);
  const todas = req_filas_().filter(r => compras || r.modulo === m).map(r => req_vista_(r, cx.SP, cx.entradas, hoy))
    .sort((a, b) => (b.fecha + b.registradoEn).localeCompare(a.fecha + a.registradoEn));
  const abiertas = todas.filter(r => ['noprocede', 'recibida', 'rechazada'].indexOf(r.fase) < 0);
  const k = {
    abiertas: abiertas.length,
    urgentes: abiertas.filter(r => r.urgencia === 'Urgente').length,
    preguntas: todas.filter(r => r.fase === 'pregunta').length,
    porTramitar: todas.filter(r => ['enviada', 'respondida'].indexOf(r.fase) >= 0).length,
    porRecibir: todas.filter(r => r.fase === 'pagada').length,
    tramitadoMes: Math.round(todas.filter(r => r.solicitud && (r.tramitadaEn || '').slice(0, 7) === mes && ['RECHAZADA', 'ANULADA'].indexOf(r.solicitud.estado) < 0)
      .reduce((s, r) => s + (Number(r.solicitud.total) || 0), 0) * 100) / 100,
    tramitadasMes: todas.filter(r => (r.tramitadaEn || '').slice(0, 7) === mes).length,
    noProceden: todas.filter(r => r.fase === 'noprocede').length
  };
  /* para el formulario: los camiones y los equipos */
  let camiones = [], equipos = [];
  try { camiones = vehiculosFlota_().map(v => v.placa); } catch (e) {}
  try { equipos = leerHoja_(HOJA_ACT).filter(a => String(a.clase || '').toLowerCase() !== 'vehiculo' && String(a.nombre || '').trim()).map(a => String(a.nombre).trim()); } catch (e) {}
  (EQUIPOS_PLANTA || []).forEach(e => { if (e !== 'Otro' && equipos.map(x => x.toUpperCase()).indexOf(String(e).toUpperCase()) < 0) equipos.push(e); });
  return { ok: true, hoy: hoy, modulo: m, lista: todas.slice(0, 200), kpis: k, tipos: REQ_TIPOS, urgencias: REQ_URGENCIAS,
           camiones: camiones, equipos: equipos, modulos: REQ_MODULOS, usuario: u.nombre,
           puedeTramitar: req_compras_(u), puedePedir: !compras };
}

function api_reqGuardar(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  d = d || {};
  const m = String(d.modulo || '');
  if (!REQ_MODULOS[m]) return { ok: false, error: 'Falta el módulo que pide.' };
  if (!req_pide_(u, m)) return { ok: false, error: 'Tu usuario no pide requisiciones por ' + REQ_MODULOS[m] + '.' };
  const tipo = REQ_TIPOS.indexOf(String(d.tipo)) >= 0 ? String(d.tipo) : '';
  if (!tipo) return { ok: false, error: 'Elige qué es: insumo, servicio, repuesto u otro.' };
  const ren = (d.renglones || []).map(x => ({ desc: String(x.desc || '').trim().slice(0, 200), cant: Number(x.cant) || 0, unidad: String(x.unidad || '').trim().slice(0, 30) }))
    .filter(x => x.desc);
  if (!ren.length) return { ok: false, error: 'Escribe qué se necesita.' };
  if (!String(d.para || '').trim()) return { ok: false, error: 'Di para qué es (camión, equipo, bodega…).' };
  const urg = REQ_URGENCIAS.indexOf(String(d.urgencia)) >= 0 ? String(d.urgencia) : 'Normal';
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = req_hoja_();
    const hoy = hoyPanama_(), anio = hoy.slice(0, 4);
    const n = req_filas_().filter(r => r.reqId.indexOf('RQ-' + anio + '-') === 0)
      .reduce((mx, r) => Math.max(mx, Number(r.reqId.split('-')[2]) || 0), 0) + 1;
    const id = 'RQ-' + anio + '-' + ('000' + n).slice(-4);
    cobA_agregar_(h, { reqId: id, fecha: hoy, modulo: m, solicitadoPor: u.nombre, tipo: tipo,
      paraTipo: String(d.paraTipo || '').slice(0, 30), para: String(d.para).trim().slice(0, 120), renglones: JSON.stringify(ren),
      porque: String(d.porque || '').trim().slice(0, 600), urgencia: urg, proveedorSugerido: String(d.proveedorSugerido || '').trim().slice(0, 120),
      archivoId: String(d.archivoId || ''), estado: 'ENVIADA', origen: String(d.origen || '').slice(0, 120), registradoEn: req_ahora_() });
    marcar_('mercadeo'); marcar_(m === 'planta' ? 'planta' : 'logistica');
    return { ok: true, reqId: id };
  } finally { lock.releaseLock(); }
}

function api_reqPedirSubida(pin, meta) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!req_pide_(u, 'logistica') && !req_pide_(u, 'planta')) return { ok: false, error: 'Sin permiso.' };
  const e = arc_validar_(meta); if (e) return { ok: false, error: e };
  const r = arc_nuevo_('requisicion', '', '', meta, u.nombre, 'requisiciones');
  return { ok: true, archivoId: r.archivoId, subida: r.subida };
}

function api_reqAdjuntoListo(pin, archivoId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
