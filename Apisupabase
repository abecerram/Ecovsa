function asis_validar_(d, actual) {
  const c = JSON.parse(JSON.stringify(actual));
  const hh = (v, def) => horaValida_(v) ? String(v) : def;
  if (d.hora !== undefined) c.hora = hh(d.hora, c.hora);
  if (d.congelar !== undefined) c.congelar = hh(d.congelar, c.congelar);
  if (d.tope !== undefined) c.tope = hh(d.tope, c.tope);
  if (d.dias !== undefined) { const n = Number(d.dias); if (n >= 1 && n <= 14) c.dias = Math.round(n); }
  if (d.margen !== undefined) { const n = Number(d.margen); if (n >= 0 && n <= 120) c.margen = Math.round(n); }
  if (d.minSitio !== undefined) { const n = Number(d.minSitio); if (n >= 3 && n <= 120) c.minSitio = Math.round(n); }
  if (d.aviso !== undefined) c.aviso = d.aviso === 'resumen' ? 'resumen' : 'tarjeta';
  if (d.noCabe !== undefined) c.noCabe = d.noCabe === 'semanaSig' ? 'semanaSig' : 'globito';
  if (d.feriados !== undefined) c.feriados = d.feriados !== false;
  if (Array.isArray(d.zonasViaje)) c.zonasViaje = d.zonasViaje.map(z => String(z || '').trim().toUpperCase()).filter(z => TAR_ZONAS.indexOf(z) >= 0);
  if (d.semana && typeof d.semana === 'object') Object.keys(c.semana).forEach(k => {
    const s = d.semana[k]; if (!s) return;
    if (ASIS_TIPOS_DIA.indexOf(s.tipo) >= 0) c.semana[k].tipo = s.tipo;
    if (ASIS_MOVER.indexOf(s.mover) >= 0) c.semana[k].mover = s.mover;
  });
  if (d.nunca && typeof d.nunca === 'object') Object.keys(c.nunca).forEach(k => { if (d.nunca[k] !== undefined) c.nunca[k] = d.nunca[k] !== false; });
  if (d.permisos && typeof d.permisos === 'object') Object.keys(c.permisos).forEach(k => { if (!ASIS_PERM_FIJO[k] && ASIS_PERM.indexOf(d.permisos[k]) >= 0) c.permisos[k] = d.permisos[k]; });
  return c;
}

/* Guardar la configuración (y encender o apagar el piloto) */
function api_asisGuardar(pin, d) {
  const x = asis_u_(pin); if (x.e) return x.e;
  d = d || {};
  const antes = asis_cfg_(), c = asis_validar_(d, antes);
  let accion = '';
  if (d.on !== undefined && (d.on === true) !== antes.on) {
    c.on = d.on === true; c.onDesde = crm_ahora_(); c.onPor = x.u.nombre; accion = c.on ? 'encendió' : 'apagó';
  }
  asis_cfgPoner_('asistente', JSON.stringify(c), x.u);
  const cambios = [];
  ['hora', 'congelar', 'dias', 'tope', 'margen', 'minSitio', 'aviso', 'noCabe', 'feriados'].forEach(k => { if (JSON.stringify(antes[k]) !== JSON.stringify(c[k])) cambios.push(k + ': ' + antes[k] + ' → ' + c[k]); });
  if (JSON.stringify(antes.semana) !== JSON.stringify(c.semana)) cambios.push('Mi semana');
  if (JSON.stringify(antes.nunca) !== JSON.stringify(c.nunca)) cambios.push('Lo que nunca mueve');
  if (JSON.stringify(antes.permisos) !== JSON.stringify(c.permisos)) cambios.push('Permisos');
  if (JSON.stringify(antes.zonasViaje) !== JSON.stringify(c.zonasViaje)) cambios.push('Zonas de viaje');
  if (accion || cambios.length) tab_try_(() => cfgHistorial_(x.u, 'Asistente de rutas', accion ? 'Piloto automático ' + (accion === 'encendió' ? 'encendido' : 'apagado') : 'Cambió la configuración', cambios.join(' · ').slice(0, 900)), null);
  let corrida = null;
  if (accion === 'encendió') {
    asis_log_({ tipo: 'on', fecha: hoyPanama_(), texto: 'Piloto automático encendido por ' + x.u.nombre, porque: '' });
    corrida = asis_correr_(c, 'ahora');
  } else if (accion === 'apagó') asis_log_({ tipo: 'off', fecha: hoyPanama_(), texto: 'Piloto automático apagado por ' + x.u.nombre, porque: 'Lo que ya armó se queda como está.' });
  marcar_('logistica');
  return { ok: true, on: c.on, corrida: corrida };
}

/* «Probar mis reglas sin aplicar»: así quedaría la semana; no cambia nada */
function api_asisProbar(pin, d) {
  const x = asis_u_(pin); if (x.e) return x.e;
  const cfg = d && typeof d === 'object' && Object.keys(d).length ? asis_validar_(d, asis_cfg_()) : asis_cfg_();
  const C = asis_contexto_(cfg), PL = asis_plan_(cfg, C);
  return { ok: true, dias: PL.resumen, movs: PL.movs.map(m => ({ desde: ini_fechaTxt_(m.desde), hacia: ini_fechaTxt_(m.hacia), nombres: m.ids.map(id => C.X.nombre[id]).join(', '), antes: asis_h12_(m.antes), despues: asis_h12_(m.despues) })),
           avisos: PL.avisos.map(a => a.texto), tope: cfg.tope, margen: cfg.margen };
}
/* «Aplicar ahora» */
function api_asisAplicar(pin) {
  const x = asis_u_(pin); if (x.e) return x.e;
  const cfg = asis_cfg_();
  if (!cfg.on) return { ok: false, error: 'El piloto automático está apagado. Enciéndelo para que aplique sus reglas.' };
  const r = asis_correr_(cfg, 'ahora');
  return { ok: true, corrida: r };
}

/* Deshacer lo que hizo: lo movido vuelve a su día; una ruta armada se quita. Ese día queda tuyo. */
function api_asisDeshacer(pin, id) {
  const x = asis_u_(pin); if (x.e) return x.e;
  const t = tabla313_(HOJA_ASIS), f = t.filas.find(r => String(r.id) === String(id || ''));
  if (!f) return { ok: false, error: 'No encontré eso en lo que hizo el asistente.' };
  const e = asis_entrada_(f);
  if (e.deshecho) return { ok: false, error: 'Eso ya se deshizo.' };
  if (!e.deshacible) return { ok: false, error: 'Eso ya no se puede deshacer: el día ya pasó o la ruta ya salió.' };
  const rutas = plan_rutas_(leerHoja_(HOJA_RUT));
  let datos = {}; try { datos = JSON.parse(String(f.datos || '{}')) || {}; } catch (er) { datos = {}; }
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
  /* quita de una ruta solo esas paradas, dejando constancia de lo quitado */
  const quitar = (rutaId, fecha, ids) => {
    const vals = h.getDataRange().getValues(), cab = vals[0].map(String), cR = cab.indexOf('rutaId'), cC = cab.indexOf('clienteId'), cO = cab.indexOf('origenParada');
    for (let i = vals.length - 1; i >= 1; i--) if (String(vals[i][cR]) === rutaId && ids.indexOf(Number(vals[i][cC])) >= 0) {
      const o = String(vals[i][cO] || '');
      if (o && o.indexOf('extra:') !== 0) plan_anotarQuitado_(fecha, Number(vals[i][cC]), rutaId, o.split(':')[0], 'deshecho: lo había puesto el asistente', x.u);
      h.deleteRow(i + 1);
    }
  };
  if (e.tipo === 'mov') {
    const ids = String(f.clientes || '').split(',').map(Number).filter(Boolean);
    const dest = rutas.filter(r => r.fecha === e.hacia && r.paradas.some(p => ids.indexOf(p.clienteId) >= 0));
    if (dest.some(r => r.estadoPlan === 'publicada')) return { ok: false, error: 'La ruta del ' + ini_fechaTxt_(e.hacia) + ' ya se publicó. Muévelos a mano desde el planificador.' };
    const orig = rutas.find(r => r.fecha === e.fecha && r.estadoPlan === 'borrador');
    if (!orig && rutas.some(r => r.fecha === e.fecha && r.estadoPlan === 'publicada')) return { ok: false, error: 'La ruta del ' + ini_fechaTxt_(e.fecha) + ' ya se publicó. Muévelos a mano desde el planificador.' };
    dest.forEach(r => quitar(r.rutaId, e.hacia, ids));
    const og = datos.origen || {};
    if (orig) plan_agregar_(orig.rutaId, e.fecha, orig.conductor, orig.vehiculo, 'borrador', ids.map(i => ({ clienteId: i, origen: og[i] || 'asis' })), x.u);
    else ids.forEach(i => alt_ponerEnRuta_(x.u, i, e.fecha, ''));
    asis_marcarManual_([e.fecha, e.hacia], x.u);
  } else if (e.tipo === 'arm') {
    const L = (datos.rutas || []).filter(r => r.fecha > hoyPanama_());
    const fechas = [];
    for (const a of L) {
      const r = rutas.find(z => z.rutaId === a.rutaId);
      if (!r || r.estadoPlan !== 'borrador') continue;
      if (a.nueva) { const b = api_borrarPlan_330_(pin, r.rutaId); if (!b || !b.ok) return b || { ok: false, error: 'No pude quitar la ruta del ' + ini_fechaTxt_(r.fecha) + '.' }; }
      else if ((a.agregados || []).length) quitar(r.rutaId, r.fecha, a.agregados.map(Number));
      fechas.push(r.fecha);
    }
    asis_marcarManual_(fechas, x.u);
  }
  actualizar313_(t, f._fila, { deshechoEn: new Date(), deshechoPor: x.u.nombre });
  asis_log_({ tipo: 'desh', fecha: e.fecha, texto: x.u.nombre + ' deshizo: ' + e.texto, porque: 'Esos días quedan tuyos: el asistente ya no los toca.' });
  marcar_('logistica');
  return { ok: true };
}

