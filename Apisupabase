/* ── Hora de Panamá ──────────────────────────────────────────────────
   Las fechas de la hoja son "hora de Panamá". Aquí se guardan tal cual
   (sin zona) y "ahora" se corre 5 horas, así todas las cuentas del
   código original dan lo mismo que en la hoja. Al salir hacia la
   pantalla se devuelven en hora real, como las devolvía Google. */
const _p2 = n => ('0' + n).slice(-2);
const _DateReal = globalThis.Date;
const DESFASE_PTY = 5 * 3600000;
/* Antes del 22-abr-1908 Panamá usaba su hora local (5h 19m 36s). Google
   la aplica a las horas sueltas de la hoja (que viven en 30-dic-1899). */
const CORTE_1908 = _DateReal.UTC(1908, 3, 22, 0, 19, 36), LMT_EXTRA = 1176000;
class FechaPanama extends _DateReal {
  constructor(...a) {
    if (a.length === 0) super(_DateReal.now() - DESFASE_PTY);
    else super(...a);
  }
  static now() { return _DateReal.now() - DESFASE_PTY; }
  toJSON() {
    const t = this.getTime();
    return isNaN(t) ? null : new _DateReal(t + DESFASE_PTY + (t < CORTE_1908 ? LMT_EXTRA : 0)).toISOString();
  }
  /* Como la muestra Apps Script con la zona de Panamá */
  toString() {
    if (isNaN(this.getTime())) return 'Invalid Date';
    return _DIAS[this.getUTCDay()] + ' ' + _MESES[this.getUTCMonth()] + ' ' + _p2(this.getUTCDate()) + ' ' +
           this.getUTCFullYear() + ' ' + this.toTimeString();
  }
  toDateString() {
    return _DIAS[this.getUTCDay()] + ' ' + _MESES[this.getUTCMonth()] + ' ' + _p2(this.getUTCDate()) + ' ' + this.getUTCFullYear();
  }
  toTimeString() {
    return _p2(this.getUTCHours()) + ':' + _p2(this.getUTCMinutes()) + ':' + _p2(this.getUTCSeconds()) +
           (this.getTime() < CORTE_1908 ? ' GMT-0519 (Eastern Standard Time)' : ' GMT-0500 (Eastern Standard Time)');
  }
}
const _DIAS = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
const _MESES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const Date = FechaPanama;
if (new _DateReal(2026, 0, 1).getTimezoneOffset() !== 0)
  console.warn('[api] OJO: el servidor no está en UTC; las fechas pueden correrse.');

/* ── Utilidades que el código original usaba de Google ── */
const Utilities = {
  formatDate(d, _zona, formato) {
    const f = d instanceof _DateReal ? d : new Date(d);
    return String(formato).replace(/'([^']*)'|yyyy|yy|MM|dd|HH|mm|ss/g, (t, lit) => {
      if (lit !== undefined) return lit;
      switch (t) {
        case 'yyyy': return String(f.getUTCFullYear());
        case 'yy':   return String(f.getUTCFullYear()).slice(-2);
        case 'MM':   return _p2(f.getUTCMonth() + 1);
        case 'dd':   return _p2(f.getUTCDate());
        case 'HH':   return _p2(f.getUTCHours());
        case 'mm':   return _p2(f.getUTCMinutes());
        case 'ss':   return _p2(f.getUTCSeconds());
      }
      return t;
    });
  },
  getUuid: () => randomUUID(),
  sleep() {},
  DigestAlgorithm: { SHA_256: 'sha256', SHA_1: 'sha1', MD5: 'md5' },
  Charset: { UTF_8: 'utf8' },
  computeDigest(alg, valor) {
    const b = createHash(alg).update(String(valor), 'utf8').digest();
    return Array.from(b, x => (x > 127 ? x - 256 : x));   // como Google: bytes con signo
  }
};

/* ══════════ ARCHIVOS · Supabase Storage (api 3.5.1) ══════════
   Tu código sigue siendo síncrono: pide «fírmame una subida» o «borra
   este archivo» y recibe una marca. Las operaciones se hacen DESPUÉS de
   guardar la base, y las marcas se cambian por el resultado en la
   respuesta. Si la base no se guarda, al bucket no se le toca nada.
   La llave la pone Supabase sola dentro de la función: no se pega en
   ningún lado. El bucket «documentos» es privado. */
const ALM_URL = String(Deno.env.get('SUPABASE_URL') || '').replace(/\/$/, '') + '/storage/v1';
const ALM_KEY = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY') || '';
const ALM_BUCKET = Deno.env.get('ECOVSA_BUCKET') || 'documentos';
let _ALM_OPS = [];
function _almOp(tipo, d) { const n = _ALM_OPS.length; _ALM_OPS.push(Object.assign({ tipo: tipo }, d)); return '@@ALM:' + n + '@@'; }
const Almacen = {
  bucket: ALM_BUCKET,
  listo: () => !!(ALM_KEY && Deno.env.get('SUPABASE_URL')),
  firmarSubida: ruta => _almOp('subida', { ruta: String(ruta) }),
  firmarLectura: (ruta, seg, descargar) => _almOp('lectura', { ruta: String(ruta), seg: Number(seg) || 300, descargar: descargar || '' }),
  borrar: ruta => { _almOp('borrar', { ruta: String(ruta) }); },
  subirBase64: (ruta, datos) => { _almOp('subir', { ruta: String(ruta), datos: String(datos) }); },
  /* api 3.7.1: cuánto ocupa el espacio de archivos (lo dice la propia base de Supabase) */
  uso: () => _almOp('uso', {})
};
async function _almUso() {
  try {
    const [r] = await sql`select coalesce(sum((metadata->>'size')::bigint), 0)::bigint as b, count(*)::int as n from storage.objects where bucket_id = ${ALM_BUCKET}`;
    const [t] = await sql`select coalesce(sum((metadata->>'size')::bigint), 0)::bigint as b from storage.objects`;
    return { bytes: Number(r.b) || 0, archivos: Number(r.n) || 0, todo: Number(t.b) || 0 };
  } catch (e) { return null; }   /* sin esquema storage (prueba local): la pantalla usa lo registrado */
}
const _almRuta = r => String(r).split('/').map(encodeURIComponent).join('/');
async function _almFetch(camino, op) {
  const res = await fetch(ALM_URL + camino, Object.assign({}, op, {
    headers: Object.assign({ Authorization: 'Bearer ' + ALM_KEY, apikey: ALM_KEY }, (op && op.headers) || {}) }));
  const t = await res.text(); let j = null; try { j = JSON.parse(t); } catch (e) { j = null; }
  if (!res.ok) throw new Error((j && (j.message || j.error)) || ('el espacio de archivos respondió ' + res.status));
  return j;
}
async function _almUna(o) {
  const b = encodeURIComponent(ALM_BUCKET), r = _almRuta(o.ruta);
  if (o.tipo === 'subida') {
    const j = await _almFetch('/object/upload/sign/' + b + '/' + r, { method: 'POST', headers: { 'x-upsert': 'true' } });
    return ALM_URL + j.url;
  }
  if (o.tipo === 'lectura') {
    const j = await _almFetch('/object/sign/' + b + '/' + r, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ expiresIn: o.seg }) });
    return ALM_URL + j.signedURL + (o.descargar ? '&download=' + encodeURIComponent(o.descargar) : '');
  }
  if (o.tipo === 'borrar') {
    await _almFetch('/object/' + b, { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ prefixes: [o.ruta] }) });
    return true;
  }
  if (o.tipo === 'subir') {
    const m = /^'?data:([^;,]+)[^,]*,(.*)$/s.exec(o.datos);
    if (!m) throw new Error('archivo ilegible');
    const bin = atob(m[2]), u8 = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
    await _almFetch('/object/' + b + '/' + r, { method: 'POST', headers: { 'content-type': m[1], 'x-upsert': 'true' }, body: u8 });
    return true;
  }
  return null;
}
/* Cambia las marcas @@ALM:n@@ por lo que devolvió el bucket. Una
   operación que falla deja null y el aviso en r.almacenError. */
async function resolverAlmacen_(txt, ops) {
  if (txt.indexOf('@@ALM:') < 0 && !ops.length) return txt;
  const res = [], errores = [];
  for (const o of ops) {
    if (o.tipo === 'uso') { res.push(await _almUso()); continue; }
    if (!Almacen.listo()) { res.push(null); errores.push('El espacio de archivos no está configurado.'); continue; }
    try { res.push(await _almUna(o)); }
    catch (e) { res.push(null); errores.push(String((e && e.message) || e)); console.warn('[almacén] ' + o.tipo + ' ' + o.ruta + ': ' + ((e && e.message) || e)); }
  }
  let d; try { d = JSON.parse(txt); } catch (e) { return txt; }
  const cambiar = v => {
    if (typeof v === 'string') { const m = /^@@ALM:(\d+)@@$/.exec(v); return m ? (res[Number(m[1])] === undefined ? null : res[Number(m[1])]) : v; }
    if (Array.isArray(v)) return v.map(cambiar);
    if (v && typeof v === 'object') { const o = {}; Object.keys(v).forEach(k => o[k] = cambiar(v[k])); return o; }
    return v;
  };
  d = cambiar(d);
  if (errores.length && d && d.r && typeof d.r === 'object') {
    const bucket = errores.some(e => /not found|no existe|bucket|related resource/i.test(e));
    /* api 3.6: siempre en español */
    d.r.almacenError = bucket ? 'No encontré el espacio «' + ALM_BUCKET + '» en Supabase Storage: revisa que exista y que el nombre esté escrito igual.'
      : /mime/i.test(errores[0]) ? 'Supabase no acepta ese tipo de archivo: revisa «Allowed MIME types» del espacio ' + ALM_BUCKET + '.'
      : /exceed|too large/i.test(errores[0]) ? 'El archivo pasa el tamaño máximo del espacio ' + ALM_BUCKET + '.'
      : 'El espacio de archivos no respondió bien (' + errores[0] + ').';
  }
  return JSON.stringify(d);
}

/* ══════════ GOOGLE: RUTAS POR CARRETERA Y OPTIMIZAR CON HORARIOS (api 3.6) ══════════
   Igual que el almacén: las funciones del libro son síncronas, así que no
   llaman a Google en el momento. Dejan una marca @@GOO:n@@ con lo que hay
   que pedir, y cuando el pedido ya se guardó se habla con Google y se
   cambia la marca por la respuesta. Si Google falla, la marca queda en
   null y la pantalla recibe r.googleError en español.
   · Rutas (trazo por carretera): Routes API con la clave GOOGLE_MAPS_KEY.
   · Optimizar con horarios: Route Optimization, que no acepta claves: usa la
     cuenta de servicio GOOGLE_RO_CUENTA (el JSON completo) y GOOGLE_PROYECTO.
   Sin esos secretos todo lo demás sigue igual: la pantalla dice que falta
   conectar Google y calcula en línea recta. */
const GOO_KEY = Deno.env.get('GOOGLE_MAPS_KEY') || '';
const GOO_CUENTA_TXT = Deno.env.get('GOOGLE_RO_CUENTA') || '';
let GOO_CUENTA = null; try { GOO_CUENTA = GOO_CUENTA_TXT ? JSON.parse(GOO_CUENTA_TXT) : null; } catch (e) { GOO_CUENTA = null; }
const GOO_PROYECTO = Deno.env.get('GOOGLE_PROYECTO') || (GOO_CUENTA && GOO_CUENTA.project_id) || '';
const GOO_URL_ROUTES = (Deno.env.get('GOOGLE_URL_ROUTES') || 'https://routes.googleapis.com').replace(/\/$/, '');
const GOO_URL_RO = (Deno.env.get('GOOGLE_URL_RO') || 'https://routeoptimization.googleapis.com').replace(/\/$/, '');
let _GOO_OPS = [];
function _gooOp(tipo, d) { const n = _GOO_OPS.length; _GOO_OPS.push({ tipo: tipo, d: d }); return '@@GOO:' + n + '@@'; }
const Google = {
  rutasListo: () => !!GOO_KEY,
  optimizarListo: () => !!(GOO_CUENTA && GOO_CUENTA.private_key && GOO_CUENTA.client_email && GOO_PROYECTO),
  cuentaIlegible: () => !!GOO_CUENTA_TXT && !GOO_CUENTA,
  trazo: d => _gooOp('trazo', d),
  optimizar: d => _gooOp('optimizar', d)
};

/* ── la llave de la cuenta de servicio: un JWT firmado se cambia por un token de 1 hora ── */
let _GOO_TOKEN = null;
function _b64url(b) { let s = typeof b === 'string' ? btoa(unescape(encodeURIComponent(b))) : btoa(String.fromCharCode.apply(null, new Uint8Array(b))); return s.replace(/=+$/, '').replace(/\+/g, '-').replace(/\//g, '_'); }
async function _gooToken() {
  const ahora = Math.floor(Date.now() / 1000);
  if (_GOO_TOKEN && _GOO_TOKEN.vence > ahora + 60) return _GOO_TOKEN.token;
  const c = GOO_CUENTA, aud = c.token_uri || 'https://oauth2.googleapis.com/token';
  const pem = String(c.private_key).replace(/-----[^-]+-----/g, '').replace(/\s+/g, '');
  const der = Uint8Array.from(atob(pem), ch => ch.charCodeAt(0));
  const llave = await crypto.subtle.importKey('pkcs8', der, { name: 'RSASSA-PKCS1-v1_5', hash: 'SHA-256' }, false, ['sign']);
  const cuerpo = _b64url(JSON.stringify({ alg: 'RS256', typ: 'JWT', kid: c.private_key_id || undefined })) + '.' +
    _b64url(JSON.stringify({ iss: c.client_email, scope: 'https://www.googleapis.com/auth/cloud-platform', aud: aud, iat: ahora, exp: ahora + 3600 }));
  const firma = await crypto.subtle.sign('RSASSA-PKCS1-v1_5', llave, new TextEncoder().encode(cuerpo));
  const res = await fetch(aud, { method: 'POST', headers: { 'content-type': 'application/x-www-form-urlencoded' },
    body: 'grant_type=' + encodeURIComponent('urn:ietf:params:oauth:grant-type:jwt-bearer') + '&assertion=' + cuerpo + '.' + _b64url(firma) });
  const j = await res.json().catch(() => ({}));
  if (!res.ok || !j.access_token) throw new Error('GOO_CUENTA:' + (j.error_description || j.error || res.status));
