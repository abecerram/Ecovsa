function nombreComparable_(s) {
  return String(s || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toUpperCase()
    .replace(/[^A-Z0-9]+/g, ' ').replace(/\b(S A|SA|INC|CORP|S DE R L)\b/g, '')
    .replace(/\s+/g, ' ').trim();
}

function horaValida_(t) { return /^([01]\d|2[0-3]):[0-5]\d$/.test(String(t || '')); }

function api_horarioCliente(pin, clienteId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'El horario lo fija logística.' };
  const id = Number(clienteId);
  const c = leerHoja_(HOJA_CLI).find(x => Number(x.id) === id);
  if (!c) return { ok: false, error: 'No encontré ese cliente.' };

  const nombres = [c.nombre, c['razon social'], c['nombre 2']].map(nombreComparable_).filter(Boolean);
  const coincide = n => { const k = nombreComparable_(n); return k && nombres.indexOf(k) >= 0; };
  const sugerencias = [];
  try {
    leerHoja_(HOJA_SOL).forEach(s => {
      if (!String(s.horarioRecoleccion || '').trim()) return;
      if (coincide(s.empresa) || coincide(s.razonSocial))
        sugerencias.push({ de: 'Mercadeo (solicitud de alta)', texto: String(s.horarioRecoleccion).trim() });
    });
  } catch (e) {}
  try {
    leerHoja_(HOJA_PRO).forEach(p => {
      if (!String(p['horario recoleccion'] || '').trim()) return;
      if (coincide(p.empresa) || coincide(p['razon social']) || coincide(p['nombre comercial']))
        sugerencias.push({ de: 'Mercadeo (propuesta)', texto: String(p['horario recoleccion']).trim() });
    });
  } catch (e) {}
  try {
    leerHoja_(HOJA_INSP).forEach(i => {
      if (!coincide(i.empresa)) return;
      const d = horaTxt_(i.ventanaDesde), h = horaTxt_(i.ventanaHasta);
      if (d && h) sugerencias.push({ de: 'Inspección técnica', texto: 'Ventana ' + d + ' a ' + h, desde: d, hasta: h });
      else if (String(i.horarioEstablecimiento || '').trim())
        sugerencias.push({ de: 'Inspección técnica', texto: String(i.horarioEstablecimiento).trim() });
    });
  } catch (e) {}
  const vistas = {};
  return {
    ok: true,
    cliente: { id: id, nombre: String(c.nombre || '') },
    horario: {
      tipo: String(c.horarioTipo || '').toLowerCase(),
      desde: horaTxt_(c.horarioDesde), hasta: horaTxt_(c.horarioHasta),
      nota: String(c.horarioNota || ''), por: String(c.horarioPor || ''),
      en: c.horarioEn ? fechaISO_(c.horarioEn) : ''
    },
    sugerencias: sugerencias.filter(s => { const k = s.de + '|' + s.texto; if (vistas[k]) return false; vistas[k] = 1; return true; })
  };
}

function api_guardarHorarioCliente(pin, clienteId, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'El horario lo fija logística.' };
  d = d || {};
  let tipo = String(d.tipo || '').toLowerCase().trim();
  if (['', 'preferencia', 'estricto'].indexOf(tipo) < 0) return { ok: false, error: 'Tipo de horario no válido.' };
  /* api 3.5.3: borrar las dos horas y guardar es quitar el horario */
  if (tipo && !String(d.desde || '').trim() && !String(d.hasta || '').trim()) tipo = '';
  const desde = tipo ? String(d.desde || '').trim() : '', hasta = tipo ? String(d.hasta || '').trim() : '';
  if (tipo) {
    if (!horaValida_(desde) || !horaValida_(hasta)) return { ok: false, error: 'Escribe la hora de inicio y la de cierre.' };
    if (desde >= hasta) return { ok: false, error: 'La hora de cierre tiene que ser después de la de inicio.' };
  }
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_CLI);
    asegurarColumnas_(h, COLS_HORARIO);
    const vals = h.getDataRange().getValues();
    const cab = vals[0].map(String);
    const cId = cab.indexOf('id');
    for (let i = 1; i < vals.length; i++) {
      if (Number(vals[i][cId]) !== Number(clienteId)) continue;
      const poner = { horarioTipo: tipo, horarioDesde: desde, horarioHasta: hasta,
                      horarioNota: String(d.nota || '').trim().slice(0, 200),
                      horarioPor: u.nombre, horarioEn: new Date() };
      Object.keys(poner).forEach(k => h.getRange(i + 1, cab.indexOf(k) + 1).setValue(poner[k]));
      return { ok: true, horario: { tipo: tipo, desde: desde, hasta: hasta, nota: poner.horarioNota } };
    }
    return { ok: false, error: 'No encontré ese cliente.' };
  } finally { lock.releaseLock(); }
}

function api_cerrarRuta(pin, rutaId, motivo, detalle) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const id = String(rutaId || '').trim();
  if (!id) return { ok: false, error: 'Falta la ruta.' };
  const m = String(motivo || '').trim();
  if (!m) return { ok: false, error: 'Elige el motivo.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
    if (!h) return { ok: false, error: 'No encuentro la hoja de rutas.' };
    asegurarColumnas_(h, COLS_CIERRE_RUTA);
    const vals = h.getDataRange().getValues();
    const cab = vals[0].map(String);
    const cId = cab.indexOf('rutaId'), cCond = cab.indexOf('conductor');
    const filas = [];
    for (let i = 1; i < vals.length; i++) if (String(vals[i][cId]).trim() === id) filas.push(i);
    if (!filas.length) return { ok: false, error: 'No encontré esa ruta.' };
    const conductor = String(vals[filas[0]][cCond] || '').trim().toLowerCase();
    if (!esSupervisor_(u) && conductor !== u.nombre.trim().toLowerCase())
      return { ok: false, error: 'Esa ruta no es tuya.' };
    const ahora = new Date();
    const texto = m + (String(detalle || '').trim() ? ' · ' + String(detalle).trim().slice(0, 200) : '');
    filas.forEach(i => {
      h.getRange(i + 1, cab.indexOf('estadoRuta') + 1).setValue('TERMINADA ANTES');
      h.getRange(i + 1, cab.indexOf('motivoCierre') + 1).setValue(texto);
      h.getRange(i + 1, cab.indexOf('cerradaPor') + 1).setValue(u.nombre);
      h.getRange(i + 1, cab.indexOf('cerradaEn') + 1).setValue(ahora);
    });
    return { ok: true, rutaId: id, motivo: texto, cerradaPor: u.nombre,
             hora: Utilities.formatDate(ahora, 'America/Panama', 'HH:mm') };
  } finally { lock.releaseLock(); }
}


