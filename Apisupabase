function api_crmMoverEtapa(pin, codigos, etapa, extra) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  const e = crm_txt_(etapa), ex = extra || {};
  if (ESTADOS_PRO.indexOf(e) < 0) return { ok:false, error:'Etapa no válida: ' + e };
  if (e === 'Pasado a cartera') return { ok:false, error:'Para pasar a cartera usa «Pasar a cartera»: crea la solicitud de alta para logística.' };
  if (CRM_PERDIDAS.indexOf(e) >= 0 && !crm_txt_(ex.motivo)) return { ok:false, error:'Para marcarla perdida escribe el motivo.' };
  const lista = (Array.isArray(codigos) ? codigos : [codigos]).map(crm_txt_).filter(Boolean);
  if (!lista.length) return { ok:false, error:'No elegiste ninguna oportunidad.' };
  const hoy = hoyPanama_(), hechos = [], errores = [];
  const filas = crm_filas_(HOJA_PRO);
  lista.forEach(cod => {
    const r = filas.find(p => crm_txt_(p.codigoPropuesta) === cod);
    if (!r) { errores.push(cod + ': no existe'); return; }
    const antes = crm_txt_(r.estado) || 'Registrado';
    if (antes === e) return;
    if (antes === 'Pasado a cartera') { errores.push(crm_txt_(r.empresa) + ': ya pasó a cartera'); return; }
    { const v331 = alt_puedeFirmar_(r, e); if (v331) { errores.push(crm_txt_(r.empresa) + ': ' + v331); return; } }   // api 3.31
    const datos = { estado: e, 'fecha etapa': hoy };
    if (CRM_GANADAS.indexOf(e) >= 0 || CRM_PERDIDAS.indexOf(e) >= 0) datos['fecha cierre'] = hoy;
    else datos['fecha cierre'] = '';
    if (CRM_PERDIDAS.indexOf(e) >= 0) datos['motivo perdida'] = crm_txt_(ex.motivo);
    if (e === 'Stand-by') datos.retomar = crm_txt_(ex.retomar);
    if (e === 'Propuesta enviada' && !crm_txt_(r['fecha propuesta'])) datos['fecha propuesta'] = hoy;
    if (BLOQUEADOS_PRO.indexOf(antes) >= 0) datos.__forzar = true;
    const g = api_guardarProspecto(pin, cod, datos);
    if (!g || !g.ok) { errores.push(crm_txt_(r.empresa) + ': ' + ((g && g.error) || 'no se guardó')); return; }
    if (!ex.silencio) crm_registrarActividad_(x.u, { tipo:'nota', ref: cod, refTipo:'op', cuenta: crm_txt_(r.empresa),
      texto: 'Etapa: ' + antes + ' → ' + e + (ex.motivo ? ' · motivo: ' + crm_txt_(ex.motivo) : '') + (ex.nota ? ' · ' + crm_txt_(ex.nota) : '') });
    if (e === 'Stand-by') {
      /* en espera no quedan llamadas vivas: solo la de retomarla */
      crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => t.ref === cod && t.estado === 'pendiente')
        .forEach(t => crm_cambiar_(HOJA_CRM_TAR, COLS_CRM_TAR, 'id', t.id, { estado:'anulada', hechaEn: crm_ahora_(), resultado:'En stand-by' }));
    }
    if (e === 'Stand-by' && crm_txt_(ex.retomar))
      crm_crearTarea_(x.u, { titulo: 'Retomar ' + crm_txt_(r.empresa), tipo:'llamada', fecha: crm_txt_(ex.retomar), ref: cod, refTipo:'op', cuenta: crm_txt_(r.empresa) });
    if (CRM_PERDIDAS.indexOf(e) >= 0 || CRM_GANADAS.indexOf(e) >= 0) {
      /* una oportunidad cerrada no deja tareas colgando */
      crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => t.ref === cod && t.estado === 'pendiente' && alt_tareaDeMercadeo_(t))
        .forEach(t => crm_cambiar_(HOJA_CRM_TAR, COLS_CRM_TAR, 'id', t.id, { estado:'anulada', hechaEn: crm_ahora_(), resultado:'Oportunidad ' + (CRM_PERDIDAS.indexOf(e) >= 0 ? 'perdida' : 'ganada') }));
    }
    crm_sincronizarSeguimiento_(cod);
    if (e === 'Propuesta enviada') alEnviarPropuesta313_(cod, false);   // api 3.13: no pisa una foto que ya exista
    hechos.push(cod);
  });
  if (!hechos.length && errores.length) return { ok:false, error: errores.join(' · ') };
  return { ok:true, movidas: hechos.length, errores: errores };
}

function api_crmReasignar(pin, codigos, asesor) {
