function listaRevision_() {
  const deHoja = leerHoja_(HOJA_LIS)
    .filter(p => String(p.puntoId || '').trim() && String(p.activo || 'SI').toUpperCase() !== 'NO')
    .map(p => ({ puntoId: String(p.puntoId).trim(), momento: String(p.momento || 'diario').toLowerCase(),
                 grupo: String(p.grupo || ''), punto: String(p.punto || ''), ayuda: String(p.ayuda || ''),
                 critico: ['SI','1','TRUE','X'].indexOf(String(p.critico).toUpperCase()) >= 0,
                 orden: Number(p.orden) || 0 }))
    .sort((a, b) => a.orden - b.orden);
  if (deHoja.length) return deHoja;
  return LISTA_REVISION_BASE.map((p, i) => ({ puntoId: p[0], momento: p[1], grupo: p[2], punto: p[3],
                                              ayuda: p[4], critico: !!p[5], orden: i + 1 }));
}

function normVeh_(v) { return String(v || '').trim().toUpperCase().replace(/[\s-]/g, ''); }

function vehiculosFlota_() {
  const act = leerHoja_(HOJA_ACT)
    .filter(a => String(a.clase || '').toLowerCase() === 'vehiculo' &&
                 String(a.estado || 'Activo').toLowerCase() !== 'baja' &&
                 String(a.placa || a.nombre || '').trim())
    .map(a => ({ placa: String(a.placa || a.nombre).trim().toUpperCase(),
                 marca: String(a.marca || '').trim(), activoId: String(a.activoId || '') }));
  if (act.length) return act;
  return VEHICULOS_BASE.map(p => ({ placa: p, marca: '', activoId: '' }));
}

function falla_(f) {
