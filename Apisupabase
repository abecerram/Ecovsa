  if (!o.clienteIds && !o.nombresFactura && !(o.modo === 'consolidada' && rucClave_(o.ruc))) return { ok: false, error: 'Elige sus sedes o escribe el RUC: si no, no se sabe qué facturas son suyas.' };
  const h = cobA_hoja_(HOJA_PAGA, COLS_PAGA);
