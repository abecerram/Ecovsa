    enDia[D] = {}; deD(D).forEach(r => r.paradas.forEach(p => { enDia[D][p.clienteId] = r.rutaId; }));
    const b = deD(D).find(r => r.estadoPlan === 'borrador' && !(C.info[r.rutaId] && String(C.info[r.rutaId].tipo || '') === 'planta'));
    R[D] = { ids: b ? b.paradas.map(p => p.clienteId) : [], origen: {}, fijo: {}, ruta: b || null, nuevos: [], antes: b ? b.paradas.map(p => p.clienteId) : [] };
    if (b) b.paradas.forEach(p => { R[D].origen[p.clienteId] = p.origen; if (esFijo(p.clienteId, D, p.origen)) R[D].fijo[p.clienteId] = true; });
  });
  const anterior = D => { for (let d = ini_dia_(D, -1), i = 0; i < 10 && d >= primero; i++, d = ini_dia_(d, -1)) if (editable(d) && tipoD(d) !== 'viaje') return d; return ''; };
  const siguienteViaje = D => dias.find(d => d >= D && tipoD(d) === 'viaje' && editable(d)) || '';
  const anteriorTrabaja = D => { for (let d = ini_dia_(D, -1), i = 0; i < 10 && d >= primero; i++, d = ini_dia_(d, -1)) if (editable(d)) return d; return ''; };
  const ponerEn = (D, id, origen, fijo, por) => {
    if (!D || !R[D] || !editable(D)) return false;
    if (R[D].ids.indexOf(id) >= 0) return true;
    R[D].ids.push(id); R[D].origen[id] = origen; if (fijo) R[D].fijo[id] = true; R[D].nuevos.push({ id: id, por: por }); return true;
  };
