           camiones: flota.map(v => ({ placa: v.placa, tope: topeCamion_(v.placa, cfgL, ACT) })), zonas: TAR_ZONAS,
           feriados: Object.keys(INC_FERIADOS).filter(f => f >= hoy).slice(0, 6).map(f => ({ fecha: f, fechaTxt: ini_fechaTxt_(f), nombre: INC_FERIADOS[f] })),
           manuales: Object.keys(man).filter(f => f >= hoy).sort().map(f => ({ fecha: f, fechaTxt: ini_fechaTxt_(f), por: man[f] })),
