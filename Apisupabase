function api_guardarListaRevision(pin, puntos) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'La lista la cambia logística.' };
  const l = (puntos || []).filter(p => String(p.punto || '').trim());
  if (!l.filter(p => p.activo !== false).length) return { ok: false, error: 'La lista no puede quedar vacía.' };
  const usados = {};
  let sig = 1;
  l.forEach(p => { const m = String(p.puntoId || '').match(/^[a-z](\d+)$/); if (m) sig = Math.max(sig, Number(m[1]) + 1); });
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = hojaPlanta_(HOJA_LIS, COLS_LIS);
    const vals = h.getDataRange().getValues();
    for (let i = vals.length - 1; i >= 1; i--) h.deleteRow(i + 1);
    l.forEach((p, i) => {
      const mom = ['diario', 'semanal', 'cierre'].indexOf(String(p.momento)) >= 0 ? String(p.momento) : 'diario';
      let id = String(p.puntoId || '').trim();
      if (!id || usados[id]) id = 'p' + ('0' + (sig++)).slice(-2);
      usados[id] = 1;
      h.appendRow(filaPorNombre_(h, { puntoId: id, momento: mom, grupo: String(p.grupo || '').slice(0, 60), punto: String(p.punto).trim().slice(0, 120),
        ayuda: String(p.ayuda || '').slice(0, 160), critico: p.critico ? 'SI' : '', orden: i + 1, activo: p.activo === false ? 'NO' : 'SI' }));
    });
    marcar_('logistica');
    return { ok: true, puntos: l.length };
  } finally { lock.releaseLock(); }
}

function api_fichaCamion(pin, placa) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['supervisor', 'admin', 'gerente'].indexOf(u.rol) < 0) return { ok: false, error: 'Solo logística.' };
  const hoy = hoyPanama_(), nv = normVeh_(placa);
  const mesIni = hoy.slice(0, 7) + '-01';
  const mesAntIni = (() => { const d = new Date(Date.UTC(Number(hoy.slice(0, 4)), Number(hoy.slice(5, 7)) - 2, 1)); return d.toISOString().slice(0, 10); })();
  const cargas = flo_cargas_(leerHoja_(HOJA_COM)).filter(c => normVeh_(c.vehiculo) === nv);
  const delMes = cargas.filter(c => c.fecha >= mesIni);
  const semanas = [];
  for (let i = 7; i >= 0; i--) {
    const fin = ini_dia_(hoy, -i * 7), ini = ini_dia_(fin, -6);
    semanas.push({ desde: ini, hasta: fin, kmL: flo_kmL_(cargas, ini, fin) });
  }
  const litros = delMes.reduce((s, c) => s + c.litros, 0), gasto = delMes.reduce((s, c) => s + c.monto, 0);
  let act = null; try { const a = api_activos(pin); act = ((a && a.activos) || []).find(x => normVeh_(x.placa || x.nombre) === nv) || null; } catch (e) {}
  const FAL = leerHoja_(HOJA_FAL);
  const fallas = FAL.map(r => Object.assign(falla_(r), { taller: String(r.tallerNombre || ''), tallerFecha: fechaISO_(r.tallerFecha) }))
    .filter(f => f.fallaId && normVeh_(f.vehiculo) === nv).sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
  const lista = {}; flo_lista_().forEach(p => lista[p.puntoId] = p);
  const revs = leerHoja_(HOJA_REV).filter(r => normVeh_(r.vehiculo) === nv).map(r => {
    const det = String(r.detalle || '').split(/\s+/).filter(Boolean).map(x => { const k = x.split(':'); return { puntoId: k[0], estado: k[1], punto: (lista[k[0]] || {}).punto || k[0] }; });
    return { revisionId: String(r.revisionId || ''), fecha: fechaISO_(r.fecha), hora: horaTxt_(r.hora), momento: String(r.momento || ''), semanal: String(r.semanal || '') === 'SI',
             conductor: String(r.conductor || ''), km: Number(r.km) || null, tanque: String(r.tanque || ''), puntos: Number(r.puntos) || 0, bien: Number(r.bien) || 0,
             fallas: Number(r.fallas) || 0, malos: det.filter(x => x.estado === 'm').map(x => x.punto) };
  }).sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora)).slice(0, 20);
  /* la misma falla repetida en varias revisiones */
  const cuenta = {}; revs.forEach(r => r.malos.forEach(m => cuenta[m] = (cuenta[m] || 0) + 1));
  const repetidas = Object.keys(cuenta).filter(k => cuenta[k] >= 3).map(k => ({ punto: k, veces: cuenta[k] }));
  const cfg = cfgLog_(); let ACT = []; try { ACT = leerHoja_(HOJA_ACT); } catch (e) {}
  return { ok: true, hoy: hoy, placa: placa, meta: META_KML,
           combustible: { gasto: ini_r_(gasto, 2), litros: ini_r_(litros, 1), cargas: delMes.length, precio: litros ? ini_r_(gasto / litros, 3) : null,
                          kmL: flo_kmL_(cargas, mesIni, hoy), kmLAnt: flo_kmL_(cargas, mesAntIni, ini_dia_(mesIni, -1)), semanas: semanas, lista: cargas.slice(0, 40) },
           activo: act, fallas: fallas.slice(0, 30), revisiones: revs, repetidas: repetidas, tope: topeCamion_(placa, cfg, ACT) };
}


