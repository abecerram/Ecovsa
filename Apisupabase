  };
}

function inc_filas_() { return cobA_leer_(HOJA_INC).map(inc_obj_).filter(x => x.incId); }

function inc_cambiar_(id, cambios) { return cobA_cambiar_(inc_hoja_(), 'incId', id, cambios); }

function inc_abierta_(x) { return INC_ABIERTOS.indexOf(x.estado) >= 0; }

function inc_puedeGestionar_(u) { return !!u && (esSupervisor_(u) || u.rol === 'gerente'); }

function inc_gravedad_(tipo, d) {
  d = d || {};
  if (tipo === 'lesion' || tipo === 'choque' || tipo === 'seguridad') return 'alta';
  if (tipo === 'derrame') return String(d.controlado || '') === 'no' ? 'alta' : 'media';
  if (tipo === 'norecolectada' || tipo === 'mala') return 'baja';
  return 'media';
}

function inc_nuevoId_(F, fecha) {
  const an = String(fecha || hoyPanama_()).slice(0, 4);
  let mx = 0;
  F.forEach(x => { const m = /^INC-(\d{4})-(\d+)$/.exec(x.incId); if (m && m[1] === an) mx = Math.max(mx, Number(m[2])); });
  return 'INC-' + an + '-' + ('000' + (mx + 1)).slice(-4);
}

function inc_titulo_(x) {
  const t = INC_TIPOS[x.tipo] || 'Incidencia';
  if (x.tipo === 'norecolectada') return t + (x.cliente ? ' · ' + x.cliente : '');
  if (x.tipo === 'mala') return t + (x.cliente ? ' · ' + x.cliente : '');
  return t + (x.vehiculo ? ' · ' + x.vehiculo : '');
}

function inc_resumen_(x) {
  const d = x.datos || {}, p = [];
  if (x.tipo === 'norecolectada') {
    if (d.motivo) p.push(d.motivo);
    p.push(d.accion === 'tarde' ? 'vuelve más tarde hoy' : 'pide otro día');
  } else if (x.tipo === 'derrame') {
    if (d.donde) p.push(String(d.donde).toLowerCase());
    if (d.que) p.push(String(d.que).toLowerCase());
    if (d.cuanto) p.push(String(d.cuanto).toLowerCase());
    p.push(d.controlado === 'no' ? 'NO está controlado' : 'controlado');
  } else if (x.tipo === 'mala') {
    (d.hallazgos || []).slice(0, 2).forEach(h => p.push(String(h).toLowerCase()));
    p.push(d.recogio === 'no' ? 'no lo recogió' : 'lo recogió');
  } else if (x.tipo === 'lesion') {
    if (d.que) p.push(String(d.que).toLowerCase());
    if (d.atendido) p.push(String(d.atendido).toLowerCase());
  } else if (x.tipo === 'choque') {
    if (d.heridos) p.push('heridos: ' + String(d.heridos).toLowerCase());
    if (d.puedeSeguir) p.push(d.puedeSeguir === 'no' ? 'el camión no puede seguir' : 'puede seguir');
  } else if (x.tipo === 'seguridad') {
    if (d.que) p.push(String(d.que).toLowerCase());
  }
  if (x.fotos && x.fotos.length && !x.fotosBorradas) p.push(x.fotos.length + (x.fotos.length === 1 ? ' foto' : ' fotos'));
  return p.join(' · ');
}

function inc_corto_(x) {
  return { incId: x.incId, idLocal: x.idLocal, fecha: x.fecha, hora: x.hora, tipo: x.tipo, tipoNombre: INC_TIPOS[x.tipo] || x.tipo,
