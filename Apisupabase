  cobA_leer_(HOJA_CRM_ARC).filter(a => String(a.ruta || '')).forEach(a => { const t = Number(a.tamano) || 0; b += t; n++; por.crm = (por.crm || 0) + t; });
  return { bytes: b, archivos: n, porAmbito: Object.keys(por).map(k => ({ ambito: k, nombre: ARC_AMBITOS[k] || k, bytes: por[k] })).sort((x, y) => y.bytes - x.bytes) };
