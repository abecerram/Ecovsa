 */

const PROP_EMPRESA_313 = 'EMPRESA_DATOS';
const PROP_EMPRESA_CUENTA_313 = 'EMPRESA_CUENTA';

function empresaGuardada313_() {
  const pr = PropertiesService.getScriptProperties();
  const d = json313_(pr.getProperty(PROP_EMPRESA_313), {}) || {};
  const rl = d.representanteLegal || {}, db = d.datosBancarios || {};
  return {
    folio: String(d.folio || ''),
    representanteLegal: { nombre: String(rl.nombre || ''), nacionalidad: String(rl.nacionalidad || ''),
      documento: String(rl.documento || ''), genero: String(rl.genero || '') },
    datosBancarios: { banco: String(db.banco || ''), titular: String(db.titular || ''), tipo: String(db.tipo || '') },
    correosNotificacion: Array.isArray(d.correosNotificacion) ? d.correosNotificacion.map(String).filter(Boolean) : [],
    cambiadoPor: String(d.cambiadoPor || ''), cambiadoEn: String(d.cambiadoEn || ''),
