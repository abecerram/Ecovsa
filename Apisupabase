function api_certServEmitir(pin, clienteId, tipo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!csv_puedeEmitir_(u)) return { ok: false, error: 'Sin permiso para emitir certificados.' };
  const hoy = hoyPanama_(), clis = leerHoja_(HOJA_CLI);
  const c = clis.find(x => String(x.id).trim() === String(clienteId).trim());
  if (!c) return { ok: false, error: 'No encontré el cliente.' };
  const d = csv_datosCliente_(c), falta = csv_falta_(d, hoy);
  if (falta) return { ok: false, error: falta };
  /* 3.17.2 · si la razón social tiene varias sedes activas es macro: un solo certificado de la cuenta */
  const hermanas = d.razon ? clis.map(csv_datosCliente_).filter(x => x.activo && x.razon && x.razon.toUpperCase() === d.razon.toUpperCase()) : [d];
  const T = hermanas.length > 1 ? 'cuenta' : 'sede';
  if (tipo === 'cuenta' && T !== 'cuenta') return { ok: false, error: 'Esta razón social tiene una sola sede: su certificado lleva su número de cliente.' };
  let sedes = [d];
  if (T === 'cuenta') {
    sedes = clis.map(csv_datosCliente_).filter(x => x.activo && x.razon && x.razon.toUpperCase() === d.razon.toUpperCase());
    if (sedes.length < 2) return { ok: false, error: 'Esta razón social tiene una sola sede: su certificado es el de la sede.' };
    const mal = sedes.map(x => [x, csv_falta_(x, hoy)]).filter(p => p[1]);
    if (mal.length) return { ok: false, error: 'Antes de emitir el de la cuenta, corrige la ficha de ' + mal.map(p => p[0].nombre + ' (' + p[1].replace(/\.$/, '').toLowerCase() + ')').join('; ') + '.' };
  }
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const t = csv_filas_();
    const pref = 'CSV-' + hoy.slice(2, 4) + '-';
    let max = 0; t.filas.forEach(x => { const f = csv_t_(x.folio); if (f.indexOf(pref) === 0) max = Math.max(max, Number(f.slice(pref.length)) || 0); });
    const folio = pref + ('000' + (max + 1)).slice(-4);
    /* el número del certificado: micro = N° de cliente; macro = el de su primer certificado de cuenta (se conserva al renovar) */
    /* en la cuenta, el contrato de la sede que vence de último (el que marca la vigencia del certificado) */
    const conC = (T === 'cuenta' ? sedes.slice() : [d]).filter(x => csv_conContrato_(x.contrato))
      .sort((a, b) => String(b.vence || '').localeCompare(String(a.vence || '')) || String(b.contrato).localeCompare(String(a.contrato)));
    const numero = csv_numeroDe_(conC.length ? conC[0].contrato : d.contrato, d.id);
    /* el vigente anterior del mismo cliente (o cuenta) queda reemplazado */
    t.filas.forEach(x => {
      const o = csv_obj_(x);
      if (o.estado !== 'VIGENTE') return;
      const ids = sedes.map(z => z.id);
      if ((o.tipo === T && T === 'sede' && o.clienteId === d.id) || (o.tipo === 'cuenta' && T === 'cuenta' && o.razonSocial.toUpperCase() === d.razon.toUpperCase())
        || (T === 'cuenta' && o.tipo === 'sede' && ids.indexOf(o.clienteId) >= 0))  /* 3.17.2: los de cada sede del macro quedan dentro del de la cuenta */
        actualizar313_(t, x._fila, { estado: 'REEMPLAZADO', reemplazadoPor: folio });
    });
    const inicio = sedes.map(x => x.inicio).sort()[0], vence = sedes.map(x => x.vence).sort().slice(-1)[0];
    const frec = T === 'cuenta' ? (sedes.every(x => x.frecuencia === sedes[0].frecuencia) ? sedes[0].frecuencia : 'Según cada sede') : d.frecuencia;
    agregar313_(t, { folio: folio, tipo: T, clienteId: d.id, clientes: sedes.map(x => x.id).join(','), razonSocial: d.razon, ruc: "'" + d.ruc, dv: "'" + d.dv,
      establecimiento: T === 'cuenta' ? d.razon : d.nombre, direccion: T === 'cuenta' ? '' : d.direccion,
      sedes: T === 'cuenta' ? JSON.stringify(sedes.map(x => ({ nombre: x.nombre, frecuencia: x.frecuencia, direccion: x.direccion }))) : '',
      frecuencia: frec, contrato: "'" + d.contrato, inicio: "'" + inicio, vence: "'" + vence, servicio: CSV_SERVICIO, emitido: "'" + hoy, emitidoPor: u.nombre, estado: 'VIGENTE', numero: "'" + numero });
    try {
      crm_registrarActividad_(u, { tipo: 'nota', ref: d.id, refTipo: 'cli', cuenta: d.nombre, resultado: 'Certificado de servicio',
        texto: 'Certificado de servicio N.° ' + numero + ' emitido (' + (T === 'cuenta' ? 'de la cuenta, ' + sedes.length + ' sedes' : 'de la sede') + '), vigente hasta ' + fechaEnPalabras_(vence) + '.' });
    } catch (e) {}
    marcar_('mercadeo');
    return { ok: true, folio: folio, numero: numero, tipo: T, url: 'CertificadoServicio.html?f=' + encodeURIComponent(folio) + '&k=' + csv_clave_(folio) };
  } finally { lock.releaseLock(); }
}

/* La página del certificado (enlace con clave; sin PIN) */
