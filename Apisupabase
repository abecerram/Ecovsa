}

function api_reportarIncidencia(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  d = d || {};
  const tipo = String(d.tipo || '');
  if (!INC_TIPOS[tipo]) return { ok: false, error: 'Elige qué pasó.' };
  const datos = (d.datos && typeof d.datos === 'object') ? d.datos : {};
  if (tipo === 'norecolectada') {
    if (!Number(d.clienteId)) return { ok: false, error: 'Falta el cliente de la parada.' };
    if (INC_MOTIVOS_NR.indexOf(String(datos.motivo || '')) < 0) return { ok: false, error: 'Elige qué pasó.' };
    if (['tarde', 'otro'].indexOf(String(datos.accion || '')) < 0) return { ok: false, error: 'Elige qué hacemos con la parada.' };
  }
  if (tipo === 'mala' && !Number(d.clienteId)) return { ok: false, error: 'Elige el cliente.' };
  const relato = String(d.relato || '').trim().replace(/\s+/g, ' ').slice(0, 1200);
  const idLocal = String(d.idLocal || '').slice(0, 40);
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const F = inc_filas_();
    if (idLocal) { const ya = F.find(x => x.idLocal === idLocal); if (ya) return { ok: true, incId: ya.incId, gravedad: ya.gravedad, repetida: true }; }
    let cliente = '';
    const cid = Number(d.clienteId) || 0;
    if (cid) { const c = leerHoja_(HOJA_CLI).find(x => Number(x.id) === cid); cliente = c ? String(c.nombre || '') : ''; }
    const hoy = hoyPanama_();
    const fecha = /^\d{4}-\d{2}-\d{2}$/.test(String(d.fecha || '')) ? String(d.fecha) : hoy;
    const hora = /^\d{1,2}:\d{2}$/.test(String(d.hora || '')) ? String(d.hora) : Utilities.formatDate(new Date(), 'America/Panama', 'HH:mm');
    const incId = inc_nuevoId_(F, fecha), grav = inc_gravedad_(tipo, datos);
    const limpio = JSON.stringify(datos).slice(0, 4000);
    cobA_agregar_(inc_hoja_(), {
      incId: incId, idLocal: idLocal, creadaEn: inc_ahora_(), fecha: fecha, hora: "'" + hora, tipo: tipo, gravedad: grav,
      usuario: u.nombre, vehiculo: String(d.vehiculo || '').slice(0, 20), rutaId: String(d.rutaId || '').slice(0, 40),
      fechaRuta: String(d.fechaRuta || '').slice(0, 10), clienteId: cid || '', cliente: cliente, datos: limpio, relato: relato,
      lat: Number(d.lat) ? Math.round(Number(d.lat) * 1e6) / 1e6 : '', lng: Number(d.lng) ? Math.round(Number(d.lng) * 1e6) / 1e6 : '',
      fotos: '[]', estado: 'ENVIADA', respuestas: '[]'
    });
    marcar_('logistica');
    return { ok: true, incId: incId, gravedad: grav };
  } finally { lock.releaseLock(); }
}

function inc_buscar_(u, ref) {
  const r = String(ref || '');
  const x = inc_filas_().find(z => z.incId === r || (z.idLocal && z.idLocal === r));
  if (!x) return null;
