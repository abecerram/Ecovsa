/* ═══════════════════════════════════════════════════════════════
   api 3.14 · ENCENDER Y APAGAR MÓDULOS (Configuración)
   Un módulo «en mantenimiento» se cierra para todos menos para el
   administrador y los probadores que él elija. La puerta está aquí,
   en el servidor: cuando alguien que no está en la lista llama una
   función de ese módulo, no se guarda nada y la pantalla recibe el
   aviso. Lo que ve el cliente (formulario, propuesta, enlace,
   recibos) no pasa por esta puerta: no lleva PIN de empleado.
   El conductor sigue trabajando aunque Logística esté apagado: su
   recolección del día no se detiene.
   Se guarda en la propiedad MODULOS_MANT. Nada se borra.
   ═══════════════════════════════════════════════════════════════ */
const MANT_PROP = 'MODULOS_MANT';
/* De qué módulo del lobby es cada bloque de funciones. Entrada, Configuración y el QR del cliente nunca se apagan. */
const MANT_BLOQUE_MOD = {
  logistica: ['campo'], mercadeo: ['alta'], crm: ['alta'], planta: ['planta'], cobros: ['cobros'],
  gerencia: ['inicio'], finanzas: ['finanzas', 'solicitud'], administracion: ['admin'], mantenimiento: ['admin'],
  certificados: ['certificados'], calidad: ['calidad'], seguridad: ['seguridad']
};
const MANT_NUNCA = ['entrada', 'configuracion', 'qr'];
/* Calidad nace apagado hasta que el administrador lo encienda */
const MANT_DE_FABRICA = {
  calidad: { estado: 'mant', entran: [], mensaje: 'Calidad todavía está en construcción.', regreso: '', desde: '2026-10-01 00:00', por: 'Sistema' },
  seguridad: { estado: 'mant', entran: [], mensaje: 'Seguridad todavía está en construcción.', regreso: '', desde: '2026-10-14 00:00', por: 'Sistema' }
};
let _MANT_FN = null;

/* función → módulos a los que pertenece (si sale en varios, se cierra solo si todos están apagados) */
function mant_mapa_() {
  if (_MANT_FN) return _MANT_FN;
  const m = {}, nunca = {};
  Object.keys(BLOQUES).forEach(b => (BLOQUES[b] || []).forEach(fn => {
    if (MANT_NUNCA.indexOf(b) >= 0) { nunca[fn] = true; return; }
    (MANT_BLOQUE_MOD[b] || []).forEach(id => { m[fn] = m[fn] || []; if (m[fn].indexOf(id) < 0) m[fn].push(id); });
  }));
  Object.keys(nunca).forEach(fn => { delete m[fn]; });
  _MANT_FN = m;
  return m;
}

function mant_guardado_() {
  let g = {};
  try { g = JSON.parse(PropertiesService.getScriptProperties().getProperty(MANT_PROP) || '{}') || {}; } catch (e) { g = {}; }
  return g;
}

/* Solo los módulos apagados: { id: { estado:'mant', entran, mensaje, regreso, desde, por } } */
function mant_todos_() {
  const g = mant_guardado_(), r = {};
  Object.keys(MANT_DE_FABRICA).forEach(k => { if (!g[k]) r[k] = MANT_DE_FABRICA[k]; });
  Object.keys(g).forEach(k => { if (g[k] && g[k].estado === 'mant') r[k] = g[k]; });
  return r;
}

function mant_titulo_(id) { const m = MODULOS.filter(x => x.id === id)[0]; return m ? m.titulo : id; }

function mant_entra_(u, id, M) {
  if (!u) return false;
  if (u.rol === 'admin') return true;
  if (id === 'campo' && u.rol === 'operador') return true;     // el conductor en ruta no se detiene
  return (M && Array.isArray(M.entran) ? M.entran : []).indexOf(String(u.nombre || '').trim()) >= 0;
}

function mant_info_(id, M) {
  const titulo = mant_titulo_(id);
  const mensaje = String((M && M.mensaje) || '').trim() || (titulo + ' está en mantenimiento.');
  const regreso = String((M && M.regreso) || '').trim();
  return { modulo: id, titulo: titulo, mensaje: mensaje, regreso: regreso,
           aviso: mensaje + (regreso ? ' Vuelve: ' + regreso.replace(/\.$/, '') + '.' : '') };
}

/* La puerta. La llama usuarioPorPin_ cuando reconoce a alguien. */
function mant_puerta_(u) {
  const fn = _REQ_FN; if (!fn) return;
  const mods = mant_mapa_()[fn]; if (!mods || !mods.length) return;
  const M = mant_todos_();
  if (!mods.every(id => M[id] && !mant_entra_(u, id, M[id]))) return;
  const info = mant_info_(mods[0], M[mods[0]]);
  _MANT_BLOQ = info;
  const e = new Error(info.aviso); e.mantenimiento = info;
  throw e;
}

/* Cada pantalla con módulo pregunta cada minuto: ¿sigo abierta? */
function api_mantEstado(pin, modulo) {
  const id = String(modulo || '').trim();
  if (!MODULOS.some(m => m.id === id)) return { ok: true, abierto: true };
  /* Pasa por la entrada normal (cuenta intentos de PIN): así esta consulta no sirve para adivinar un PIN */
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  _PRES_REG = { nombre: u.nombre, rol: u.rol, modulo: id };
  const M = mant_todos_()[id];
  if (!M) return { ok: true, abierto: true };
  const info = mant_info_(id, M);
  const entra = mant_entra_(u, id, M);
  return { ok: true, abierto: false, entra: entra, modulo: id, titulo: info.titulo, mensaje: info.mensaje, regreso: info.regreso,
           aviso: info.aviso, entran: entra ? ['Administrador'].concat(M.entran || []) : [] };
}

/* ── presencia: tabla aparte, fuera del libro (se escribe sin esperar y no choca con los guardados) ── */
let _PRES_TABLA = null;
function pres_tabla_() {
  if (!_PRES_TABLA) _PRES_TABLA = (async () => {
    await sql`create table if not exists public.presencia (nombre text primary key, rol text, modulo text not null, visto timestamptz not null default now())`;
    await sql`alter table public.presencia enable row level security`;
  })().catch(e => { _PRES_TABLA = null; throw e; });
  return _PRES_TABLA;
}
function pres_anotar_(p) {
  pres_tabla_().then(() => sql`insert into public.presencia (nombre, rol, modulo, visto) values (${p.nombre}, ${p.rol || ''}, ${p.modulo}, now())
    on conflict (nombre) do update set rol = excluded.rol, modulo = excluded.modulo, visto = now()`)
    .catch(e => console.warn('[presencia] ' + String((e && e.message) || e)));
}
async function pres_leer_() {
  try {
    await pres_tabla_();
    const f = await sql`select nombre, rol, modulo, extract(epoch from (now() - visto))::int as hace from public.presencia where visto > now() - interval '3 minutes'`;
    return f.map(x => ({ nombre: x.nombre, rol: x.rol, modulo: x.modulo, hace: Number(x.hace) || 0 }));
  } catch (e) { console.warn('[presencia] ' + String((e && e.message) || e)); return null; }
}

/* ── Configuración › Encender y apagar ── */
function api_cfgModulos(pin) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  const M = mant_todos_(), pres = _PRES_LEIDA, yo = a.u.nombre.trim();
  const activos = leerHoja_(HOJA_USR).filter(cfgActivo_).map(f => ({ nombre: String(f.nombre || '').trim(), rol: String(f.rol || '').toLowerCase().trim() }))
    .filter(x => x.nombre);
  const modulos = MODULOS.filter(m => m.zona !== 'oculto').map(m => {
    const x = M[m.id];
    const dentro = (pres || []).filter(p => p.modulo === m.id && p.nombre !== yo)
      .map(p => ({ nombre: p.nombre, rol: TAB_ROTULO[p.rol] || p.rol, hace: p.hace, sigue: !!x && mant_entra_({ nombre: p.nombre, rol: p.rol }, m.id, x) }));
    return { id: m.id, titulo: m.titulo, detalle: m.detalle, icono: m.icono, zona: m.zona,
             apagado: !!x, entran: x ? (x.entran || []) : [], mensaje: x ? (x.mensaje || '') : '', regreso: x ? (x.regreso || '') : '',
             desde: x ? (x.desde || '') : '', por: x ? (x.por || '') : '', dentro: dentro };
  });
  return { ok: true, hoy: hoyPanama_(), modulos: modulos, presencia: pres !== null,
           usuarios: activos.filter(x => x.rol !== 'admin' && x.nombre !== yo).map(x => ({ nombre: x.nombre, rol: TAB_ROTULO[x.rol] || x.rol })) };
}

/* d = { apagar:true|false, entran:[nombres], mensaje, regreso } */
function api_cfgModuloEstado(pin, id, d) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  id = String(id || ''); d = d || {};
  const m = MODULOS.filter(x => x.id === id && x.zona !== 'oculto')[0];
  if (!m) return { ok: false, error: 'No encontré ese módulo.' };
  const g = mant_guardado_(), antes = mant_todos_()[id];
  const ahora = seg_ahoraTxt_();
  if (d.apagar) {
    const validos = leerHoja_(HOJA_USR).filter(cfgActivo_).map(f => String(f.nombre || '').trim());
    const entran = (Array.isArray(d.entran) ? d.entran : []).map(x => String(x || '').trim())
      .filter((x, i, l) => x && validos.indexOf(x) >= 0 && l.indexOf(x) === i).slice(0, 20);
    g[id] = { estado: 'mant', entran: entran, mensaje: String(d.mensaje || '').trim().slice(0, 200),
              regreso: String(d.regreso || '').trim().slice(0, 60),
              desde: antes ? (antes.desde || ahora) : ahora, por: antes ? (antes.por || a.u.nombre) : a.u.nombre };
    PropertiesService.getScriptProperties().setProperty(MANT_PROP, JSON.stringify(g));
    cfgHistorial_(a.u, 'Encender y apagar', (antes ? 'Cambió el mantenimiento de ' : 'Apagó por mantenimiento ') + m.titulo,
      'Entran: administrador' + (entran.length ? ', ' + entran.join(', ') : '') + (g[id].regreso ? ' · vuelve: ' + g[id].regreso : ''));
    return { ok: true, apagado: true };
  }
  if (!antes) return { ok: true, sinCambios: true };
  g[id] = { estado: 'on', desde: ahora, por: a.u.nombre };
  PropertiesService.getScriptProperties().setProperty(MANT_PROP, JSON.stringify(g));
  cfgHistorial_(a.u, 'Encender y apagar', 'Encendió ' + m.titulo, 'Estuvo en mantenimiento desde ' + (antes.desde || '—'));
  return { ok: true, apagado: false };
}

