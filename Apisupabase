/* ── Hojas por encabezados ─────────────────────────────────────── */
/* Abre (o crea) la hoja y se asegura de que tenga todas las columnas.
   No borra ni reordena columnas que ya estén: solo agrega al final. */
function hoja313_(nombre, cols) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let h = ss.getSheetByName(nombre);
  if (!h) h = ss.insertSheet(nombre);
  if (!cols || !cols.length) return h;
  if (h.getLastRow() === 0 || h.getLastColumn() === 0) {
    h.getRange(1, 1, 1, cols.length).setValues([cols]);
    return h;
  }
  const cab = h.getRange(1, 1, 1, h.getLastColumn()).getValues()[0].map(String);
  const faltan = cols.filter(c => cab.indexOf(c) < 0);
  if (faltan.length) h.getRange(1, cab.length + 1, 1, faltan.length).setValues([faltan]);
  return h;
}
/* Lee la hoja como objetos con su número de fila (_fila, 1 = encabezado). */
function tabla313_(nombre, cols) {
  const h = cols ? hoja313_(nombre, cols) : SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nombre);
  if (!h || h.getLastRow() < 1 || h.getLastColumn() < 1) return { h: h, cab: [], filas: [] };
  const datos = h.getRange(1, 1, h.getLastRow(), h.getLastColumn()).getValues();
  const cab = datos.shift().map(String);
  const filas = [];
  datos.forEach((f, i) => {
    if (!f.some(v => v !== '' && v != null)) return;
    const o = { _fila: i + 2 }; cab.forEach((c, j) => { o[c] = f[j]; }); filas.push(o);
  });
  return { h: h, cab: cab, filas: filas };
}
function celda313_(v) {
  if (v == null) return '';
  if (typeof v === 'object' && !(v instanceof Date)) return JSON.stringify(v);
  if (typeof v === 'boolean') return v ? 'SI' : 'NO';
  return v;
}
/* Escribe solo los campos pedidos en una fila; si falta la columna, se agrega. */
function actualizar313_(t, fila, campos) {
  Object.keys(campos).forEach(k => {
    let c = t.cab.indexOf(k);
    if (c < 0) {
      t.h.getRange(1, t.cab.length + 1, 1, 1).setValues([[k]]);
      t.cab.push(k); c = t.cab.length - 1;
    }
    t.h.getRange(fila, c + 1, 1, 1).setValues([[celda313_(campos[k])]]);
  });
}
function agregar313_(t, obj) {
  Object.keys(obj).forEach(k => {
    if (t.cab.indexOf(k) < 0) { t.h.getRange(1, t.cab.length + 1, 1, 1).setValues([[k]]); t.cab.push(k); }
  });
  t.h.appendRow(t.cab.map(c => celda313_(obj[c])));
}
function si313_(v) { return v === true || String(v).toUpperCase() === 'SI' || String(v).toUpperCase() === 'TRUE'; }

