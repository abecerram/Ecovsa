                                     : leerHoja_(HOJA_CLI).find(c => String(c.nombre || '').trim().toUpperCase() === String(s.empresa || '').trim().toUpperCase());
  if (!cli) return { ok: false, error: 'No encontré la ficha del cliente.' };
  const texto = alt_txt_(d.texto, 500); if (!texto) return { ok: false, error: 'Escribe qué te dijo el cliente.' };
