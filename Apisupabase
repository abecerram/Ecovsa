    entregas: rep_textoRecibo_(fila.entregas)
  }, empresa: datosDoc_('recibo') };
  if (limitado) {
    ['contacto', 'correo', 'telefono', 'whatsapp', 'canal', 'gps', 'clienteId', 'reciboDigital'].forEach(k => { r.datos[k] = ''; });
    r.datos.limitado = true;
