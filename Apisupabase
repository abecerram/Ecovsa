/* ══════════ Estadísticas de accidentabilidad (F-SST-04) ══════════
   Se arman solas con los reportes de lesión y choque. Las horas trabajadas las anota el responsable una vez al mes (tipo «horas»).
   Índice de frecuencia = accidentes con baja × 1,000,000 ÷ horas · índice de gravedad = días perdidos × 1,000 ÷ horas. */
function api_segEstadisticas(pin, mes) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  const hoy = hoyPanama_();
  const M = /^\d{4}-\d{2}$/.test(String(mes || '')) ? String(mes) : hoy.slice(0, 7), A = M.slice(0, 4);
  const inc = sst_incidentes_();
  const acc = inc.filter(i => i.t === 'inc' && (i.tipoLog === 'lesion' || i.tipoLog === 'choque'));
  const en = (L, pref) => L.filter(i => String(i.fecha || '').slice(0, pref.length) === pref);
  const conBaja = L => L.filter(i => i.baja === 'si'), sinBaja = L => L.filter(i => i.baja !== 'si');
  const horasLista = sst_lista_('horas');
  const hMes = horasLista.filter(h => h.mes === M).reduce((s, h) => s + (Number(h.horas) || 0), 0);
  const hAnio = horasLista.filter(h => String(h.mes).slice(0, 4) === A && h.mes <= M).reduce((s, h) => s + (Number(h.horas) || 0), 0);
  const calc = (L, horas) => {
    const cb = conBaja(L), dias = cb.reduce((s, i) => s + (Number(i.dias) || 0), 0);
    return { conBaja: cb.length, sinBaja: sinBaja(L).length, dias: dias, horas: horas || 0,
      frecuencia: horas ? Math.round(cb.length * 1000000 / horas * 100) / 100 : null, gravedad: horas ? Math.round(dias * 1000 / horas * 100) / 100 : null };
  };
  const casiM = inc.filter(i => i.t === 'ca' && String(i.fecha || '').slice(0, 7) === M).length, casiA = inc.filter(i => i.t === 'ca' && String(i.fecha || '').slice(0, 4) === A && String(i.fecha).slice(0, 7) <= M).length;
  const personal = sst_personas_(false).filter(p => p.est === 'activo').length;
  const finMes = new Date(Date.UTC(+M.slice(0, 4), +M.slice(5, 7), 0)).toISOString().slice(0, 10);
  /* api 3.33 · el mes a mes del año (hasta el mes elegido) y los reportes del mes, para la hoja del F-SST-04 */
  const meses = [];
  for (let k = 1; k <= Number(M.slice(5, 7)); k++) {
    const mm = A + '-' + ('0' + k).slice(-2);
    const hM = horasLista.filter(h => h.mes === mm).reduce((s, h) => s + (Number(h.horas) || 0), 0);
    meses.push(Object.assign({ mes: mm }, calc(en(acc, mm), hM), { casi: inc.filter(i => i.t === 'ca' && String(i.fecha || '').slice(0, 7) === mm).length }));
  }
  const reportes = inc.filter(i => String(i.fecha || '').slice(0, 7) === M).map(i => {
    const esAcc = i.t === 'inc' && (i.tipoLog === 'lesion' || i.tipoLog === 'choque');
    return { id: i.id, fecha: i.fecha, tipo: i.t === 'ca' ? 'Casi accidente' : (esAcc ? 'Accidente' : 'Incidente') + ' · ' + String(i.a || '').toLowerCase(),
      q: sst_t_(i.q, 160), d: sst_t_(i.d, 60), baja: esAcc ? (i.baja === 'si' ? 'Sí' : i.baja === 'no' ? 'No' : 'Sin clasificar') : '—', dias: esAcc ? (Number(i.dias) || 0) : '—' };
  }).sort((a, b) => String(a.fecha).localeCompare(String(b.fecha)));
  return { ok: true, mes: M, hoy: hoy, corte: finMes, personal: personal, fuente: 'Reportes de incidencia (F-LOG-03)', meses: meses, reportes: reportes,
    mensual: Object.assign(calc(en(acc, M), hMes), { casi: casiM }),
    anual: Object.assign(calc(acc.filter(i => String(i.fecha || '').slice(0, 4) === A && String(i.fecha).slice(0, 7) <= M), hAnio), { casi: casiA }),
    sinClasificar: acc.filter(i => i.baja === '' && String(i.fecha || '').slice(0, 7) === M).length,
    horasDelMes: horasLista.filter(h => h.mes === M).map(h => ({ id: h.id, horas: Number(h.horas) || 0 })), puede: { editar: x.puedeEditar } };
}

/* ══════════ Archivos de Seguridad (ámbito «seguridad») ══════════
   Constancias, certificados, listas firmadas, fotos. El certificado de buena salud (clase «apt») solo lo abre el responsable de SST y el administrador. */
const SST_CLASES = ['apt', 'cverde', 'cblanco', 'tet', 'hepb', 'ind', 'epp', 'firma', 'caprec', 'acta', 'simulacro', 'evidencia', 'cert', 'contratista', 'foto', 'auditoria'];
function sst_archivos_(ref, x) {
  return arc_filas_().filter(a => a.ambito === 'seguridad' && a.ref === String(ref) && a.estado === 'VIGENTE' && a.ruta && (a.doc !== 'apt' || x.p.certificado))
    .map(a => ({ archivoId: a.archivoId, clase: a.doc, nombre: a.nombre, mime: a.mime, tamano: a.tamano, subidoPor: a.subidoPor, subidoEn: a.subidoEn, vence: a.vence }));
}
function sst_puedeArchivo_(x, clase) {
  if (clase === 'apt') return !!x.p.certificado;
  if (clase === 'foto') return true;       // cualquiera que reporte un casi accidente puede sumarle una foto
  return x.puedeEditar;
}
function api_segArchivos(pin, ref) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  const L = sst_archivos_(ref, x);
  return { ok: true, archivos: x.puedeExp ? L : L.filter(a => a.clase === 'foto') };
}
/* meta = { nombre, mime, tamano, vence? } → la firma para subir directo al espacio de archivos */
function api_segArchivoPedir(pin, ref, clase, meta) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  clase = String(clase || '');
  if (SST_CLASES.indexOf(clase) < 0) return { ok: false, error: 'Ese archivo no se reconoce.' };
  if (!sst_puedeArchivo_(x, clase)) return { ok: false, error: clase === 'apt' ? 'El certificado de buena salud solo lo suben el responsable de SST y el administrador (Ley 81).' : 'Sin permiso para subir archivos.' };
  ref = sst_t_(ref, 60);
  if (!ref) return { ok: false, error: 'Falta decir a qué pertenece el archivo.' };
  meta = meta || {};
  const e = arc_validar_(meta); if (e) return { ok: false, error: e };
  const n = arc_filas_().filter(a => a.ambito === 'seguridad' && a.ref === ref && a.estado !== 'BORRADO').length;
  if (n >= 60) return { ok: false, error: 'Esto ya tiene demasiados archivos.' };
  const r = arc_nuevo_('seguridad', ref, clase, { nombre: meta.nombre || 'archivo', mime: meta.mime, tamano: meta.tamano }, x.u.nombre, 'seguridad/' + arc_slug_(ref));
  if (meta.vence && /^\d{4}-\d{2}-\d{2}$/.test(String(meta.vence))) arc_cambiar_(r.archivoId, { vence: String(meta.vence) });
  return { ok: true, archivoId: r.archivoId, subida: r.subida };
}
function api_segArchivoListo(pin, archivoId) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  const a = arc_filas_().find(z => z.archivoId === String(archivoId) && z.ambito === 'seguridad');
  if (!a) return { ok: false, error: 'No encontré el archivo.' };
  if (!sst_puedeArchivo_(x, a.doc)) return { ok: false, error: 'Sin permiso.' };
  if (a.estado === 'SUBIENDO') arc_cambiar_(a.archivoId, { estado: 'VIGENTE', subidoEn: arc_ahora_() });
  return { ok: true, archivoId: a.archivoId, clase: a.doc };
}
function api_segArchivoVer(pin, archivoId, descargar) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  const a = arc_filas_().find(z => z.archivoId === String(archivoId) && z.ambito === 'seguridad');
  if (!a || !a.ruta || a.estado !== 'VIGENTE') return { ok: false, error: 'Ese archivo no está.' };
  if (a.doc === 'apt' && !x.p.certificado) return { ok: false, error: 'El certificado de buena salud solo lo abren el responsable de SST y el administrador (Ley 81).' };
  if (a.doc !== 'foto' && !x.puedeExp) return { ok: false, error: 'Sin permiso.' };
  return { ok: true, url: Almacen.firmarLectura(a.ruta, 300, descargar ? a.nombre : ''), mime: a.mime, nombre: a.nombre };
}

/* ══════════ Lo que se ve en Inicio y en los contadores del menú ══════════ */
function sst_resumen_(x) {
  const hoy = hoyPanama_(), o = {};
  if (x.puedeExp) {
    const act = sst_personas_(false).filter(p => p.est === 'activo');
    o.exp = { activos: act.length, completos: act.filter(p => p.completo).length, incompletos: act.filter(p => !p.completo).length };
  }
  const acc = sst_lista_('accion');
  o.acc = { abiertas: acc.filter(a => a.e !== 'cerr').length, vencidas: acc.filter(a => ['pend', 'curso', undefined, ''].indexOf(a.e) >= 0 && a.f && a.f < hoy).length };
  const inc = sst_incidentes_();
  o.inc = { abiertos: inc.filter(i => i.paso < 4).length, casi: inc.filter(i => i.t === 'ca').length };
  o.contadores = { exp: o.exp ? o.exp.incompletos : 0, acc: o.acc.vencidas, inc: o.inc.abiertos };
  return o;
}


