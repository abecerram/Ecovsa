/* ══════════ Expedientes del personal ══════════
   Una ficha común a peligrosos, sólidos, planta y oficina. Nace en la hoja SegRegistros (tipo persona).
   Las personas del equipo de sólidos (SolidosEquipo) aparecen solas, sin tocar su pantalla: Seguridad las lee y,
   cuando se les anota algo propio (salud, vacunas, carnés), se crea su ficha enlazada.
   Ley 81 de 2019: el certificado de buena salud, el tipo de sangre y las alergias son datos de salud. Los ve y los
   cambia solo el administrador y el responsable de SST; el resto del equipo ve «apto / no apto» y cuándo vence. */
const SST_PUESTOS = ['Conductor', 'Ayudante recolector', 'Personal de planta', 'Oficina'];
const SST_LINEAS = ['Peligrosos', 'Sólidos', 'Planta', 'Administración'];
const SST_REQ = [['apt', 'Certificado de buena salud'], ['hepb', 'Hepatitis B'], ['tet', 'Tétanos'], ['cverde', 'Carné de salud verde (MINSA)'],
  ['cblanco', 'Carné de salud blanco (MINSA)'], ['ind', 'Inducción SST'], ['cap', 'Capacitación del puesto'], ['epp', 'EPP entregado y firmado']];
/* A quién le toca cada plan de capacitación: 1 completo · 2 solo emergencias · 3 versión corta de 2 horas */
const SST_CAP_PUESTOS = {
  'Conductor': { 'PL-SST-01': 1, 'PL-SST-02': 1, 'PL-SST-03': 1, 'PL-SST-04': 1, 'PL-SST-05': 1, 'PL-SST-06': 1 },
  'Ayudante recolector': { 'PL-SST-01': 1, 'PL-SST-02': 1, 'PL-SST-03': 1, 'PL-SST-04': 1, 'PL-SST-05': 1, 'PL-SST-06': 2 },
  'Personal de planta': { 'PL-SST-01': 1, 'PL-SST-02': 1, 'PL-SST-03': 1, 'PL-SST-04': 1, 'PL-SST-05': 1 },
  'Oficina': { 'PL-SST-01': 3 }
};
const SST_AVISO_DIAS = 30;

function sst_fechaTxt_(iso) {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || ''));
  return m ? Number(m[3]) + ' ' + SST_MESES[Number(m[2]) - 1] + ' ' + m[1] : '';
}
function sst_dias_(a, b) {          // días de a a b (ISO)
  const f = s => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(s || '')); return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) : NaN; };
  return Math.round((f(b) - f(a)) / 86400000);
}
function sst_iso_(v) { const s = fechaISO_(v) || sst_t_(v, 10); return /^\d{4}-\d{2}-\d{2}$/.test(s) ? s : ''; }
/* Estado de algo que vence: al día · por vencer (30 días) · vencido */
function sst_vence_(vence, hoy) {
  const d = sst_dias_(hoy, vence);
  if (isNaN(d)) return 'falta';
  return d < 0 ? 'vencido' : d <= SST_AVISO_DIAS ? 'por' : 'ok';
}

/* La ficha de una persona del equipo de sólidos, vista como persona de Seguridad */
function sst_desdeSolidos_(e) {
  const firmado = /firm/i.test(e.protocoloEstado || '');
  return { id: 'S:' + e.personaId, n: e.nombre, p: (DSO_PUESTOS[e.puesto] || e.puesto || 'Ayudante') + ' de sólidos', puestoTipo: /conductor/i.test(e.puesto) ? 'Conductor' : 'Ayudante recolector',
    linea: 'Sólidos', est: 'activo', mina: 'No', usr: !!e.usuario, solidos: true, solidosId: e.personaId, lic: '', licVence: sst_iso_(e.licenciaVence),
    tel: e.telefono || '', na: ['hepb', 'cap'],
    ind: firmado ? { fecha: sst_iso_(e.protocoloFecha), firmada: true, origen: 'protocolo de sólidos' } : null,
    epp: e.eppEntregado ? { fecha: sst_iso_(e.eppEntregado), firmada: true, origen: 'ficha de sólidos' } : null, _virtual: true };
}
function sst_naPorDefecto_(p) {
  if (p.puestoTipo === 'Oficina') return ['hepb', 'cverde', 'cblanco', 'cap', 'epp'];
  if (p.linea === 'Sólidos') return ['hepb', 'cap'];
  return [];
}
/* Calcula, para cada requisito, [estado, texto]. estado: ok · warn · bad · gris */
function sst_req_(p, hoy) {
  const na = Array.isArray(p.na) ? p.na : sst_naPorDefecto_(p), S = p.salud || {}, C = p.carnes || {}, r = {};
  const nA = k => na.indexOf(k) >= 0;
  const vencible = (o, etqOk, etqFalta, etqTramite) => {
    if (o && o.vence) {
      const e = sst_vence_(o.vence, hoy);
      if (e === 'vencido') return ['bad', 'Vencido · ' + sst_fechaTxt_(o.vence)];
      if (e === 'por') return ['warn', 'Vence ' + sst_fechaTxt_(o.vence)];
      return ['ok', etqOk + ' · vence ' + sst_fechaTxt_(o.vence)];
    }
    if (o && o.tramite) return ['warn', etqTramite + (o.cita ? ' · cita ' + sst_fechaTxt_(o.cita) : '')];
    return ['bad', etqFalta];
  };
  /* certificado de buena salud */
  if (nA('apt')) r.apt = ['gris', 'No aplica'];
  else {
    const a = S.apt;
    if (a && a.vence && a.res === 'noapto') r.apt = ['bad', 'No apto · ' + sst_fechaTxt_(a.fecha)];
    else if (a && a.vence) {
      const e = sst_vence_(a.vence, hoy);
      r.apt = e === 'vencido' ? ['bad', 'Vencido · ' + sst_fechaTxt_(a.vence)]
        : e === 'por' ? ['warn', 'Vence ' + sst_fechaTxt_(a.vence)]
        : a.res === 'restr' ? ['warn', 'Apto con restricciones · vence ' + sst_fechaTxt_(a.vence)]
        : ['ok', 'Apto · vence ' + sst_fechaTxt_(a.vence)];
    } else if (a && a.tramite) r.apt = ['warn', 'En trámite' + (a.cita ? ' · cita ' + sst_fechaTxt_(a.cita) : '')];
    else r.apt = ['bad', 'Falta · cita por pedir'];
  }
  /* vacunas */
  if (nA('hepb')) r.hepb = ['gris', 'No aplica'];
  else if (S.hepb && S.hepb.completa) r.hepb = ['ok', 'Completa' + (S.hepb.fecha ? ' · ' + sst_fechaTxt_(S.hepb.fecha) : '')];
  else if (S.hepb && Number(S.hepb.dosis) > 0) r.hepb = ['warn', Number(S.hepb.dosis) + ' de ' + (Number(S.hepb.de) || 3) + ' dosis'];
  else r.hepb = ['bad', 'Sin constancia'];
  if (nA('tet')) r.tet = ['gris', 'No aplica'];
  else if (S.tet && S.tet.fecha) {
    const prox = String(Number(String(S.tet.fecha).slice(0, 4)) + 10);
    r.tet = Number(prox) * 1 > Number(hoy.slice(0, 4)) ? ['ok', 'Al día · ' + prox] : ['bad', 'Refuerzo vencido · ' + prox];
  } else r.tet = ['bad', 'Falta'];
  /* carnés del MINSA */
  r.cverde = nA('cverde') ? ['gris', 'No aplica' + (p.puestoTipo === 'Oficina' ? ' · puesto de oficina' : '')] : vencible(C.cverde, 'Vigente', 'Falta', 'En trámite');
  r.cblanco = nA('cblanco') ? ['gris', 'No aplica' + (p.puestoTipo === 'Oficina' ? ' · puesto de oficina' : '')] : vencible(C.cblanco, 'Vigente', 'Falta', 'En trámite');
  /* inducción */
  if (nA('ind')) r.ind = ['gris', 'No aplica'];
  else if (p.ind && p.ind.fecha) r.ind = p.ind.firmada === false ? ['warn', 'Falta su firma'] : ['ok', (p.ind.origen === 'protocolo de sólidos' ? 'Protocolo firmado' : 'Inducción SST') + ' · ' + sst_fechaTxt_(p.ind.fecha)];
  else r.ind = ['bad', 'Falta'];
  /* capacitación del puesto: los planes que le tocan (menos la inducción) con su repaso al día */
  if (nA('cap')) r.cap = ['gris', 'No aplica'];
  else {
    const toca = Object.keys(SST_CAP_PUESTOS[p.puestoTipo] || {}).filter(c => c !== 'PL-SST-01');
    if (!toca.length) r.cap = ['gris', 'No aplica'];
    else {
      const caps = p.caps || {}, ok = toca.filter(c => caps[c] && sst_dias_(caps[c], hoy) <= 365);
      r.cap = ok.length === toca.length ? ['ok', 'Al día · ' + ok.length + ' de ' + toca.length]
        : ok.length ? ['warn', ok.length + ' de ' + toca.length + ' planes al día'] : ['bad', 'Falta · 0 de ' + toca.length];
    }
  }
  /* EPP */
  if (nA('epp')) r.epp = ['gris', 'No aplica'];
  else if (p.epp && p.epp.fecha) r.epp = p.epp.firmada === false ? ['warn', 'Entregado · falta la firma · ' + sst_fechaTxt_(p.epp.fecha)] : ['ok', 'Entregado y firmado · ' + sst_fechaTxt_(p.epp.fecha)];
  else r.epp = ['bad', 'Sin constancia de entrega'];
  return r;
}
function sst_completo_(r) { return SST_REQ.every(q => r[q[0]][0] === 'ok' || r[q[0]][0] === 'gris'); }

/* Todas las personas (las de SegRegistros y las del equipo de sólidos que aún no tienen ficha propia) */
function sst_personasBase_() {
  const regs = sst_filas_('persona').map(sst_item_);
  let sol = [];
  try { sol = dso_equipo_().filter(e => e.activo); } catch (e) { sol = []; }
  const enlazados = {}; regs.forEach(p => { if (p.solidosId) enlazados[p.solidosId] = p; });
  /* quien tiene ficha enlazada toma de sólidos lo que no tenga anotado aquí */
  regs.forEach(p => {
    const e = p.solidosId ? sol.find(z => z.personaId === p.solidosId) : null;
    if (!e) return;
    const v = sst_desdeSolidos_(e);
    if (!p.ind && v.ind) p.ind = v.ind;
    if (!p.epp && v.epp) p.epp = v.epp;
    if (!p.licVence && v.licVence) p.licVence = v.licVence;
    p.solidos = true;
  });
  return regs.concat(sol.filter(e => !enlazados[e.personaId]).map(sst_desdeSolidos_));
}
/* La persona lista para mostrar: con sus requisitos calculados y, solo si puede, sus datos de salud */
function sst_personaVista_(p, hoy, cert) {
  const r = sst_req_(p, hoy), S = p.salud || {};
  const o = { id: p.id, n: p.n, p: p.p || p.puestoTipo || '', puestoTipo: p.puestoTipo || '', est: p.est || 'activo', linea: p.linea || '', mina: p.mina || 'Por definir',
