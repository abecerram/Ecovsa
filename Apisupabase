    totalFacturas: cobA_r2_(l.totalFacturas), totalPagos: cobA_r2_(l.totalPagos), estado: String(l.estado || ''),
    anuladoPor: String(l.anuladoPor || ''), motivo: String(l.motivo || '')
  })).reverse();
  const conc = cobA_conciliar_(L);
  const inc = cobA_incobrables_(L);
  /* api 3.5: quién paga tarde, y cuánto se paga a tiempo en el último año */
  const PUN = cobB_puntualidad_(L), aTiempo = { pagadas: 0, tarde: 0 };
  cuentas.forEach(c => { const p = PUN[c.clave]; c.pagaTarde = !!(p && p.pagaTarde); c.puntualidad = p || null; if (p) { aTiempo.pagadas += p.pagadas; aTiempo.tarde += p.tarde; } });
  aTiempo.pct = aTiempo.pagadas ? Math.round((aTiempo.pagadas - aTiempo.tarde) / aTiempo.pagadas * 100) : null;
  const t = { saldo: 0, vencido: 0, facturasVencidas: 0, cuentasDeben: 0, mas90: 0, porVencer: 0 };
  cuentas.forEach(c => { if (c.saldo > 0.009) { t.cuentasDeben++; t.saldo += c.saldo; t.vencido += c.vencido; t.porVencer += c.porVencer; t.facturasVencidas += c.vencidas; } });
  L.facturas.forEach(f => { if (f.mora > 90) t.mas90 += f.saldo; });
  ['saldo', 'vencido', 'mas90', 'porVencer'].forEach(k => t[k] = cobA_r2_(t[k]));
  return {
    ok: true, usuario: u, hoy: L.hoy, permiso: esCobros_(u) ? 'trabaja' : 've', esAdmin: u.rol === 'admin',
    cfg: L.C, escalera: esc, resultados: COBA_RESULTADOS,
    totales: t, cuentas: cuentas, facturas: L.facturas, pagos: L.pagos.slice().sort((a, b) => a.fecha < b.fecha ? 1 : a.fecha > b.fecha ? -1 : 0),
    gestiones: L.gestiones.slice(-500).reverse(), planes: L.planes, agenda: agenda, metricas: cobA_metricas_(L, agenda),
    suspensiones: cobB_suspensiones_(L).slice(-60).reverse(), aTiempo: aTiempo,
    conciliar: conc, incobrables: inc, lotes: lotes, metodos: METODOS_PAG,
    promosQueTerminan: promosQueTerminan_('cobros'),   // api 3.13
    fichas: L.F.lista.map(f => ({ id: f.id, nombre: f.nombre, razon: f.razon, ruc: f.ruc, estado: f.estado })),   // api 3.13.1: para elegir el cliente
    empresa: { comercial: EMPRESA.comercial, razonSocial: EMPRESA.razonSocial, ruc: EMPRESA.ruc, dv: EMPRESA.dv, telefono: EMPRESA.telefono, correo: EMPRESA.correo, direccion: EMPRESA.direccion },
    cartera: {
      diasEnCobrar: cob_diasEnCobrar_(libro, L.hoy, 90), curva: cob_curva_(libro, L.hoy, 6),
      concentracion: cob_concentracion_(libro, L.hoy, 5), envejecimiento: cob_envejecimiento_(libro, L.hoy, 60)
    }
  };
