/* api 3.33 · el cliente puede tener dos números (telefono y whatsapp) y Logística elige a cuál van los avisos (avisoA).
   Si el elegido está vacío o mal escrito, se usa el otro. Sin elección: el de WhatsApp si sirve, si no el teléfono (como antes). */
function avi_num_(v) {
  const w = String(v || ''), m = w.match(/wa\.me\/(\d+)/);
  let n = m ? m[1] : w.replace(/\D/g, '');
  if (!n) return '';
  if (n.length === 8) n = '507' + n;
  return n.length > 13 || n.length < 8 ? '' : n;
}
function avi_tel_(c) {
  c = c || {};
  const t = avi_num_(c.telefono), w = avi_num_(c.whatsapp);
  return String(c.avisoA || '').toLowerCase() === 'telefono' ? (t || w) : (w || t);
}

function api_avisosDia(pin, fecha) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  const F = String(fecha || '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(F)) return { ok: false, error: 'Falta la fecha.' };
  const ids = {};
  leerHoja_(HOJA_RUT).forEach(r => { if (fechaISO_(r.fecha) === F && Number(r.clienteId)) ids[Number(r.clienteId)] = 1; });
  const tels = {};
  leerHoja_(HOJA_CLI).forEach(c => { const id = Number(c.id); if (ids[id]) tels[id] = avi_tel_(c); });
  const avisos = {};
  let filas = []; try { filas = leerHoja_(HOJA_AVI); } catch (e) { filas = []; }
  filas.forEach(a => {
    if (fechaISO_(a.fecha) !== F) return;
    const id = Number(a.clienteId); if (!id) return;
    avisos[id] = { estado: String(a.estado || ''), nota: String(a.nota || ''), rutaId: String(a.rutaId || ''),
                   avisadoEn: a.avisadoEn ? fechaISO_(a.avisadoEn) + ' ' + horaTxt_(a.avisadoEn) : '',
                   avisadoPor: String(a.avisadoPor || ''),
                   actualizadoEn: a.actualizadoEn ? fechaISO_(a.actualizadoEn) + ' ' + horaTxt_(a.actualizadoEn) : '',
                   actualizadoPor: String(a.actualizadoPor || '') };
  });
  const cfg = cfgLog_();
  return { ok: true, fecha: F, avisos: avisos, tels: tels,
           texto: String(cfg.avisoTexto || '') || AVI_TEXTO_BASE, textoBase: AVI_TEXTO_BASE,
           ventana: Number(cfg.avisoVentana) || 60 };
}

function api_guardarAviso(pin, fecha, clienteId, rutaId, estado, nota) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  const F = String(fecha || ''), id = Number(clienteId), est = String(estado || '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(F) || !id) return { ok: false, error: 'Faltan datos del aviso.' };
  if (AVI_ESTADOS.indexOf(est) < 0) return { ok: false, error: 'Estado de aviso no válido.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = hojaPlanta_(HOJA_AVI, COLS_AVI);
    const vals = h.getDataRange().getValues(), cab = vals[0].map(String);
    const cF = cab.indexOf('fecha'), cC = cab.indexOf('clienteId');
    let fila = -1, antes = {};
    for (let i = 1; i < vals.length; i++) {
      if (fechaISO_(vals[i][cF]) === F && Number(vals[i][cC]) === id) { fila = i + 1; cab.forEach((c, j) => antes[c] = vals[i][j]); break; }
    }
    const ahora = new Date();
    const obj = { fecha: F, clienteId: id, rutaId: String(rutaId || antes.rutaId || ''), estado: est,
                  nota: nota !== undefined && nota !== null ? String(nota).slice(0, 200) : String(antes.nota || ''),
                  avisadoEn: est === 'avisado' ? ahora : (antes.avisadoEn || ''),
                  avisadoPor: est === 'avisado' ? u.nombre : String(antes.avisadoPor || ''),
                  actualizadoEn: ahora, actualizadoPor: u.nombre };
    if (!est) { obj.avisadoEn = ''; obj.avisadoPor = ''; obj.nota = ''; }
    const row = filaPorNombre_(h, obj);
    if (fila > 0) h.getRange(fila, 1, 1, row.length).setValues([row]);
    else h.appendRow(row);
    marcar_('logistica');
    return { ok: true, aviso: { estado: est, nota: obj.nota, avisadoPor: obj.avisadoPor,
             avisadoEn: obj.avisadoEn ? fechaISO_(obj.avisadoEn) + ' ' + horaTxt_(obj.avisadoEn) : '' } };
  } finally { lock.releaseLock(); }
}


/* ══════════ Cierre.gs (copiado tal cual) ══════════ */
function api_cierreRutas(pin, desde, hasta, conductor) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'El cierre de rutas es de supervisión.' };
  const hoy = hoyPanama_();
  const okF = v => /^\d{4}-\d{2}-\d{2}$/.test(String(v || ''));
  let D = okF(desde) ? String(desde) : ini_dia_(hoy, -((ini_dow_(hoy) + 6) % 7));
  let H = okF(hasta) ? String(hasta) : hoy;
  if (D > H) { const t = D; D = H; H = t; }
  if (H > hoy) H = hoy;
  const largo = ini_diasEntre_(D, H) + 1;
  const pD = ini_dia_(D, -largo), pH = ini_dia_(D, -1);
  const cond = String(conductor || '').trim().toLowerCase();
  const n = v => Number(v) || 0;

  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC), JOR = leerHoja_(HOJA_JOR);
  const P = cli_plan_(CLI, REC, hoy);
  const cliPorId = {}; CLI.forEach(c => cliPorId[Number(c.id)] = c);
  const rutas = plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.estadoPlan === 'publicada' && r.fecha >= pD && r.fecha <= H);
  const RINF = rinf_leer_(), cfgCR = cfgLog_();   // api 3.34: el recorrido real guardado y los km por carretera del plan

  /* recolecciones por cliente y fecha; y el promedio de tiempo en sitio de cada cliente */
  const recDe = {};           // id|fecha → rec
  const minCli = {};          // id → [min]
  Object.keys(P.idx.visitas).forEach(id => P.idx.visitas[id].forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']);
    recDe[id + '|' + f] = r;
    const m = minutosEntre_(horaTxt_(r['hora inicio']), horaTxt_(r['hora final']));
    if (m >= 2 && m <= 180) (minCli[id] = minCli[id] || []).push(m);
  }));
  const promCli = id => { const l = minCli[id] || []; return l.length ? Math.round(l.reduce((a, b) => a + b, 0) / l.length) : null; };
  const minPlanDe = id => { const c = cliPorId[id] || {}; return n(c.minutosParada) || promCli(id) || MIN_SITIO_BASE; };
  const kgDe = r => n(r['total Kg']) || (n(r['Kg Recolectados']) + n(r['kg anatomopatologico']) + n(r['kg punzo cortantes']));

  const armar = r => {
    const j = JOR.filter(x => fechaISO_(x.fecha) === r.fecha && ini_nom_(x.conductor) === ini_nom_(r.conductor))[0] || null;
    let kg = 0, hechas = 0, estr = 0, estrOk = 0;
    const paradas = r.paradas.map((p, i) => {
      const c = cliPorId[p.clienteId] || {}, rec = recDe[p.clienteId + '|' + r.fecha];
      const hTipo = String(c.horarioTipo || '').toLowerCase(), hD = horaTxt_(c.horarioDesde), hH = horaTxt_(c.horarioHasta);
      const o = { n: i + 1, clienteId: p.clienteId, cliente: String(c.nombre || ('Cliente ' + p.clienteId)), origen: p.origen, horaPlan: p.horaPlan,
                  hTipo: hTipo, hDesde: hD, hHasta: hH, hecha: !!rec, prom: promCli(p.clienteId), minPlan: minPlanDe(p.clienteId) };
      if (rec) {
        o.hi = horaTxt_(rec['hora inicio']); o.hf = horaTxt_(rec['hora final']);
        o.min = minutosEntre_(o.hi, o.hf); o.kg = ini_r_(kgDe(rec), 1); o.recibo = String(rec['recibo numero'] || '');
        o.lat = numeroSeguro_(rec.latRegistro); o.lng = numeroSeguro_(rec.lngRegistro);
        if (!o.lat) { o.lat = numeroSeguro_(c.lat); o.lng = numeroSeguro_(c.lng); o.latCliente = true; }
        kg += o.kg; hechas++;
        if (hTipo && hD && hH && o.hi) {
          o.fuera = o.hi < hD || o.hi > hH;
          if (hTipo === 'estricto') { estr++; if (!o.fuera) estrOk++; }
          if (o.fuera) o.tarde = ini_min_(o.hi) - ini_min_(o.hi > hH ? hH : hD);
        }
        o.larga = o.prom && o.min && o.min > o.prom + 10 && o.min > o.prom * 1.4;
      }
      return o;
    });
    const km = j ? (n(j.kmRecorridos) || (n(j.kmFinal) > n(j.kmInicio) && n(j.kmInicio) ? n(j.kmFinal) - n(j.kmInicio) : 0)) : 0;
    const salida = j ? horaTxt_(j.horaInicio) : '', llegada = j ? horaTxt_(j.horaFinal) : '';
    const reales = paradas.filter(p => p.hi).sort((a, b) => a.hi.localeCompare(b.hi));
    const ultimaPlan = paradas.filter(p => p.horaPlan).slice(-1)[0];
    const regresoPlan = ultimaPlan ? ini_hhmm_(ini_min_(ultimaPlan.horaPlan) + ultimaPlan.minPlan + 20) : '';
    /* observaciones automáticas */
    const obs = [];
    if (r.horaSalida && salida && ini_min_(salida) - ini_min_(r.horaSalida) > 10)
      obs.push({ t: 'a', titulo: 'Salió ' + (ini_min_(salida) - ini_min_(r.horaSalida)) + ' min tarde', texto: 'Plan ' + r.horaSalida + ', salió ' + salida + '.' });
    paradas.filter(p => p.fuera && p.hTipo === 'estricto').forEach(p => {
      const k = reales.indexOf(p), ant = k > 0 ? reales[k - 1] : null;
      obs.push({ t: 'r', titulo: p.cliente + ': ' + p.tarde + ' min ' + (p.hi > p.hHasta ? 'tarde' : 'antes'),
                 texto: 'Solo recibe de ' + p.hDesde + ' a ' + p.hHasta + ' y llegó ' + p.hi + '.' + (ant && ant.larga ? ' Venía de ' + ant.cliente + ', que tardó más de la cuenta.' : (p.horaPlan && p.horaPlan <= p.hHasta ? ' Estaba planeada para las ' + p.horaPlan + '.' : '')) });
    });
    paradas.filter(p => p.larga).forEach(p => obs.push({ t: 'a', titulo: p.cliente + ': ' + p.min + ' min en sitio', texto: 'Su promedio es ' + p.prom + ' min: ' + (p.min - p.prom) + ' más de lo normal.', clienteId: p.clienteId }));
    for (let k = 1; k < reales.length; k++) {
      const g = ini_min_(reales[k].hi) - ini_min_(reales[k - 1].hf || reales[k - 1].hi);
      if (g >= 60) obs.push({ t: 'b', titulo: (reales[k - 1].hf || reales[k - 1].hi) + ' · ' + Math.floor(g / 60) + ' h ' + ('0' + (g % 60)).slice(-2) + ' sin parada', texto: 'Entre ' + reales[k - 1].cliente + ' y ' + reales[k].cliente + '. ¿Almuerzo o trayecto largo?' });
    }
    const sinHacer = paradas.filter(p => !p.hecha).length;
    let estado = 'completa';
    if (r.estadoRuta === 'TERMINADA ANTES') estado = 'terminada';
    else if (sinHacer && r.fecha < hoy) estado = 'pendientes';
    else if (sinHacer) estado = r.fecha === hoy ? 'encurso' : 'pendientes';
    return { rutaId: r.rutaId, fecha: r.fecha, conductor: r.conductor, vehiculo: (j && j.vehiculo) ? String(j.vehiculo) : r.vehiculo,
             estado: estado, motivo: r.motivoCierre, cerradaEn: horaTxt_(r.cerradaEn),
             real: (x => { const q = rinf_recorrido_(x); return q ? { km: q.km, min: q.min, guardado: true } : null; })(RINF[r.rutaId]),   // api 3.34 (los legs se piden aparte: pesan)
             kmPlan: Number((RINF[r.rutaId] || {}).trazoKm) || null,   // api 3.34
             salida: salida, llegada: llegada, salidaPlan: r.horaSalida, regresoPlan: regresoPlan, km: km, kg: ini_r_(kg, 1),
             total: paradas.length, hechas: hechas, estrictos: estr, estrictosOk: estrOk,
             fueraHorario: paradas.filter(p => p.fuera).length, paradas: paradas, obs: obs,
             revisionSalida: j ? String(j.revisionSalida || '') : '', revisionCierre: j ? String(j.revisionCierre || '') : '' };
  };

  const deCond = r => !cond || r.conductor.trim().toLowerCase() === cond;
  const lista = rutas.filter(r => r.fecha >= D && deCond(r)).map(armar).sort((a, b) => (a.fecha + a.conductor).localeCompare(b.fecha + b.conductor));
  const prev = rutas.filter(r => r.fecha <= pH && deCond(r)).map(armar);

  const suma = (l, f) => l.reduce((s, x) => s + (Number(f(x)) || 0), 0);
  const prom = l => l.length ? l.reduce((a, b) => a + b, 0) / l.length : null;
  const jornadas = lista.filter(r => r.salida);
  const durs = jornadas.filter(r => r.llegada).map(r => ini_min_(r.llegada) - ini_min_(r.salida)).filter(m => m > 0);
  const numeros = {
    total: suma(lista, r => r.total), hechas: suma(lista, r => r.hechas),
    kg: ini_r_(suma(lista, r => r.kg), 1), kgAnterior: ini_r_(suma(prev, r => r.kg), 1),
    rutas: lista.length, terminadas: lista.filter(r => r.estado === 'terminada').length,
    km: suma(lista, r => r.km), jornadas: jornadas.length,
    jornadaProm: durs.length ? Math.round(prom(durs)) : null,
    salidaProm: jornadas.length ? ini_hhmm_(prom(jornadas.map(r => ini_min_(r.salida)))) : '',
    estrictos: suma(lista, r => r.estrictos), estrictosOk: suma(lista, r => r.estrictosOk),
    fueraHorario: suma(lista, r => r.fueraHorario)
  };

  /* análisis de tiempos */
  const todasP = [];
  lista.forEach(r => r.paradas.forEach(p => { if (p.hecha) todasP.push({ r: r, p: p }); }));
  const sitios = todasP.map(x => x.p.min).filter(m => m >= 2 && m <= 180);
  const trayectos = [], primeras = [], desdeSalida = [];
  lista.forEach(r => {
    const re = r.paradas.filter(p => p.hi).sort((a, b) => a.hi.localeCompare(b.hi));
    if (re.length) { primeras.push(ini_min_(re[0].hi)); if (r.salida) { const d = ini_min_(re[0].hi) - ini_min_(r.salida); if (d >= 0 && d < 240) desdeSalida.push(d); } }
    for (let k = 1; k < re.length; k++) { const g = ini_min_(re[k].hi) - ini_min_(re[k - 1].hf || re[k - 1].hi); if (g >= 0 && g < 120) trayectos.push(g); }
  });
  const planSal = lista.filter(r => r.salidaPlan).map(r => ini_min_(r.salidaPlan));
  const planReg = lista.filter(r => r.regresoPlan).map(r => ini_min_(r.regresoPlan));
  const regresos = jornadas.filter(r => r.llegada).map(r => ini_min_(r.llegada));
  const minPlanUsado = prom(todasP.map(x => x.p.minPlan));
  const porCli = {};
  todasP.forEach(x => { const k = x.p.clienteId; const o = porCli[k] = porCli[k] || { clienteId: k, cliente: x.p.cliente, mins: [], fuera: 0 }; if (x.p.min >= 2 && x.p.min <= 180) o.mins.push(x.p.min); if (x.p.fuera) o.fuera++; });
  const clientesT = Object.keys(porCli).map(k => {
    const o = porCli[k], c = cliPorId[o.clienteId] || {};
    return { clienteId: o.clienteId, cliente: o.cliente, promPeriodo: o.mins.length ? Math.round(prom(o.mins)) : null, visitasPeriodo: o.mins.length,
             promHist: promCli(o.clienteId), visitasHist: (minCli[o.clienteId] || []).length,
             enPlan: minPlanDe(o.clienteId), editado: !!n(c.minutosParada), fuera: o.fuera };
  }).sort((a, b) => (b.promPeriodo || 0) - (a.promPeriodo || 0));
  const porCond = {};
  lista.forEach(r => {
    const o = porCond[r.conductor] = porCond[r.conductor] || { conductor: r.conductor, salidas: [], sitio: [], tray: [], paradas: 0, dias: 0 };
    if (r.salida) o.salidas.push(ini_min_(r.salida));
    r.paradas.forEach(p => { if (p.min >= 2 && p.min <= 180) o.sitio.push(p.min); });
    const re = r.paradas.filter(p => p.hi).sort((a, b) => a.hi.localeCompare(b.hi));
    for (let k = 1; k < re.length; k++) { const g = ini_min_(re[k].hi) - ini_min_(re[k - 1].hf || re[k - 1].hi); if (g >= 0 && g < 120) o.tray.push(g); }
    o.paradas += r.hechas; o.dias++;
  });
  const conductores = Object.keys(porCond).map(k => { const o = porCond[k];
    return { conductor: o.conductor, salida: o.salidas.length ? ini_hhmm_(prom(o.salidas)) : '', sitio: o.sitio.length ? Math.round(prom(o.sitio)) : null,
             trayecto: o.tray.length ? Math.round(prom(o.tray)) : null, paradasDia: o.dias ? ini_r_(o.paradas / o.dias, 1) : 0 }; });
  const tiempos = {
    salida: planSal.length || jornadas.length ? { real: jornadas.length ? ini_hhmm_(prom(jornadas.map(r => ini_min_(r.salida)))) : '', plan: planSal.length ? ini_hhmm_(prom(planSal)) : '' } : null,
    primera: primeras.length ? { real: ini_hhmm_(prom(primeras)), desdeSalida: desdeSalida.length ? Math.round(prom(desdeSalida)) : null } : null,
    sitio: sitios.length ? { real: Math.round(prom(sitios)), plan: minPlanUsado ? Math.round(minPlanUsado) : null } : null,
    trayecto: trayectos.length ? Math.round(prom(trayectos)) : null,
    regreso: regresos.length ? { real: ini_hhmm_(prom(regresos)), plan: planReg.length ? ini_hhmm_(prom(planReg)) : '' } : null
  };
  const llama = [];
  if (tiempos.regreso && tiempos.regreso.plan) {
    const d = ini_min_(tiempos.regreso.real) - ini_min_(tiempos.regreso.plan);
    const ds = tiempos.salida && tiempos.salida.plan ? ini_min_(tiempos.salida.real) - ini_min_(tiempos.salida.plan) : null;
    if (d > 10) llama.push({ t: 'a', titulo: 'Las rutas regresan ' + d + ' min tarde en promedio', texto: ds !== null && ds > 5 ? 'La salida ya va ' + ds + ' min tarde: el retraso empieza en la planta.' : 'El retraso se acumula en la calle.' });
  } else if (tiempos.salida && tiempos.salida.plan) {
    const ds = ini_min_(tiempos.salida.real) - ini_min_(tiempos.salida.plan);
    if (ds > 10) llama.push({ t: 'a', titulo: 'Salen ' + ds + ' min tarde en promedio', texto: 'Plan ' + tiempos.salida.plan + ', salida real ' + tiempos.salida.real + '.' });
  }
  if (tiempos.sitio && tiempos.sitio.plan && Math.abs(tiempos.sitio.plan - tiempos.sitio.real) >= 5) {
    const mas = tiempos.sitio.plan > tiempos.sitio.real;
    llama.push({ t: 'b', titulo: 'El planificador ' + (mas ? 'sobreestima' : 'se queda corto'), texto: 'Planea ' + tiempos.sitio.plan + ' min en sitio por parada y el real es ' + tiempos.sitio.real + '.' + (mas ? ' Con el historial caben más paradas por ruta.' : ' Revisa los tiempos por cliente.') });
  }
  const fueras = [];
  lista.forEach(r => r.paradas.filter(p => p.fuera && p.hTipo === 'estricto').forEach(p => fueras.push(p.cliente + ' (' + ini_fechaTxt_(r.fecha) + ')')));
  if (fueras.length) llama.push({ t: 'r', titulo: fueras.length + (fueras.length === 1 ? ' cliente fuera de horario' : ' llegadas fuera de horario'), texto: fueras.slice(0, 4).join(', ') + (fueras.length > 4 ? '…' : '') + '.' });

  let operadores = []; try { operadores = operadoresActivos_(); } catch (e) {}
  return { ok: true, hoy: hoy, desde: D, hasta: H, anterior: { desde: pD, hasta: pH }, conductor: conductor || '',
           numeros: numeros, rutas: lista, tiempos: tiempos, clientes: clientesT.slice(0, 60), conductores: conductores, llama: llama,
           operadores: operadores,
           /* api 3.34: para calcular y guardar el recorrido real por carretera desde la pantalla */
           base: map_llOk_(cfgCR.baseLat, cfgCR.baseLng) ? { lat: Number(cfgCR.baseLat), lng: Number(cfgCR.baseLng), nombre: String(cfgCR.baseNombre || 'Base') } : null,
           google: map_google_(cfgCR) };
}


/* ══════════ Clientes.gs (copiado tal cual) ══════════ */
function cli_activo_(c) {
  const sit = String(c.situacion || '').trim().toLowerCase();
  const est = String(c.estado || '').trim().toUpperCase();
  const frec = String(c.frecuencia || '').trim().toLowerCase();
  if (CLI_FUERA_SIT.indexOf(sit) >= 0) return false;
  if (CLI_FUERA_EST.indexOf(est) >= 0) return false;
  if (frec.indexOf('suspend') >= 0) return false;
  return true;
}

function cli_nombres_(c) {
  const l = [c.nombre, c['nombre 2']].concat(String(c.nombresRecibo || '').split('|'));
  const out = [];
  l.forEach(x => { const k = nombreComparable_(x); if (k && out.indexOf(k) < 0) out.push(k); });
  return out;
}

function cli_indice_(CLI, REC) {
  const dueno = {}, repetido = {};
  CLI.forEach(c => {
    const id = Number(c.id); if (!id) return;
    cli_nombres_(c).forEach(k => {
      if (dueno[k] && dueno[k] !== id) repetido[k] = 1; else dueno[k] = id;
    });
  });
  Object.keys(repetido).forEach(k => delete dueno[k]);
  const visitas = {}, huerfanos = {};
  REC.forEach(r => {
    const f = fechaISO_(r['Fecha de Recoleccion']); if (!f) return;
    const k = nombreComparable_(r.Cliente);
    const id = dueno[k];
    if (id) { (visitas[id] = visitas[id] || []).push(r); return; }
    const nom = String(r.Cliente || '').trim(); if (!nom) return;
    const h = huerfanos[nom] = huerfanos[nom] || { nombre: nom, recibos: 0, ultima: '' };
    h.recibos++; if (f > h.ultima) h.ultima = f;
  });
  return { dueno: dueno, visitas: visitas, huerfanos: huerfanos };
}

function cli_tocaRec_(pl, f) {
  if (!pl || !pl.recurrencia || !f) return false;
  if (pl.recDesde && f < pl.recDesde) return false;
  if (pl.recHasta && f > pl.recHasta) return false;
  if (pl.pausaHasta && f <= pl.pausaHasta) return false;
  const dw = ini_dow_(f);
  if ((pl.recDias || []).indexOf(dw) < 0) return false;
  if (pl.recurrencia === 'mes') {
    const d = Number(f.slice(8, 10));
    const fin = new Date(Date.UTC(Number(f.slice(0, 4)), Number(f.slice(5, 7)), 0)).getUTCDate();
    return pl.recSemana === 5 ? d + 7 > fin : Math.ceil(d / 7) === (pl.recSemana || 1);
  }
  const sem = REC_SEMANAS[pl.recurrencia]; if (!sem) return false;
  if (sem === 1) return true;
  const lunes = x => ini_dia_(x, -((ini_dow_(x) + 6) % 7));
  const w = Math.round(ini_diasEntre_(lunes(pl.recDesde || f), lunes(f)) / 7);
  return w >= 0 && w % sem === 0;
}

function cli_proxRec_(pl, a, n) {
  const out = [];
  if (!pl || !pl.recurrencia || !a) return out;
  let d = a;
  for (let i = 0; i < 800 && out.length < (n || 3); i++, d = ini_dia_(d, 1)) if (cli_tocaRec_(pl, d)) out.push(d);
  return out;
}

function cli_recTxt_(pl) {
  if (!pl || !pl.recurrencia) return '';
  const dias = (pl.recDias || []).map(x => REC_DIAS[x]);
  const lista = dias.length > 1 ? dias.slice(0, -1).join(', ') + ' y ' + dias[dias.length - 1] : (dias[0] || '');
  if (pl.recurrencia === 'mes') return 'la ' + REC_ORD[pl.recSemana || 1] + ' semana del mes, ' + lista;
  return REC_TXT[pl.recurrencia] + ', ' + lista;
}

function cli_diasRec_(v) {
  return String(v === undefined || v === null ? '' : v).split(/[^0-9]+/).map(Number).filter(x => x >= 1 && x <= 6)
    .filter((x, i, a) => a.indexOf(x) === i).sort();
}

function cli_fechaOk_(v) { const f = fechaISO_(v); return /^\d{4}-\d{2}-\d{2}$/.test(f) && !isNaN(new Date(f + 'T12:00:00Z').getTime()) ? f : ''; }

function cli_plan_(CLI, REC, hoy) {
  const idx = cli_indice_(CLI, REC);
  const plan = {};
  CLI.forEach(c => {
    const id = Number(c.id); if (!id) return;
    const vs = (idx.visitas[id] || []).map(r => cli_fechaOk_(r['Fecha de Recoleccion'])).filter(Boolean).sort();
    const ultimaReal = vs.length ? vs[vs.length - 1] : '';
    const ultima = [ultimaReal, cli_fechaOk_(c.ultimaVisita)].filter(Boolean).sort().pop() || '';
    const dias = diasDeFrecuencia_(c.frecuencia);
    const pvCol = cli_fechaOk_(c.proximaVisita);
    const rec = String(c.recurrencia || '').toLowerCase();
    const recDesde = cli_fechaOk_(c.recurrenciaDesde);
    const rp = { recurrencia: REC_SEMANAS.hasOwnProperty(rec) && recDesde ? rec : '', recDias: cli_diasRec_(c.recurrenciaDia),
                 recSemana: Number(c.recurrenciaSemana) || 0, recDesde: recDesde, recHasta: cli_fechaOk_(c.recurrenciaHasta),
                 pausaHasta: cli_fechaOk_(c.recurrenciaPausaHasta), pausaMotivo: String(c.recurrenciaPausaMotivo || ''),
                 conductorPref: String(c.recurrenciaConductor || ''), vehiculoPref: String(c.recurrenciaVehiculo || '') };
    if (!rp.recDias.length) rp.recurrencia = '';
    let proxima = '', origen = '';
    if (rp.recurrencia) {
      /* la primera fecha de la recurrencia que no se ha atendido; si ya pasó, queda vencido */
      const base = ultimaReal && ultimaReal >= recDesde ? ini_dia_(ultimaReal, 1) : recDesde;
      proxima = cli_proxRec_(rp, base, 1)[0] || ''; origen = 'recurrencia';
    } else {
      proxima = pvCol; origen = pvCol ? 'ficha' : '';
      if (ultima && dias) {
        const cand = ini_dia_(ultima, dias);
        if (!proxima || ultima >= proxima) { proxima = cand; origen = 'frecuencia'; }
      }
      if (!proxima && !ultima) {
        const ini = cli_fechaOk_(c['inicio recoleccion']);
        if (ini) { proxima = ini; origen = 'inicio'; }
      }
    }
    const activo = cli_activo_(c);
    const d = proxima ? ini_diasEntre_(hoy, proxima) : null;
    let urg = 'sinfecha';
    if (!activo) urg = 'fuera';
    else if (d === null) urg = 'sinfecha';
    else if (d < -7) urg = 'atrasado';
    else if (d < 0) urg = 'vencido';
    else if (d <= 7) urg = 'semana';
    else urg = 'aldia';
    plan[id] = { activo: activo, ultima: ultima, ultimaReal: ultimaReal, proxima: proxima, origen: origen,
                 dias: dias, diasA: d, urg: urg, visitas: vs.length,
                 recurrencia: rp.recurrencia, recDia: rp.recDias[0] || 0, recDias: rp.recDias, recSemana: rp.recSemana,
                 recDesde: recDesde, recHasta: rp.recHasta, pausaHasta: rp.pausaHasta, pausaMotivo: rp.pausaMotivo,
                 conductorPref: rp.conductorPref, vehiculoPref: rp.vehiculoPref,
                 recTxt: cli_recTxt_(rp), pausada: !!(rp.pausaHasta && rp.pausaHasta >= hoy) };
  });
  return { plan: plan, idx: idx };
}

function api_clientesLogistica(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'La cartera operativa es de logística.' };
  const hoy = hoyPanama_();
  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC), RUT = leerHoja_(HOJA_RUT);
  const P = cli_plan_(CLI, REC, hoy);

  /* rutas de hoy en adelante: quién ya está programado y cuánto cabe */
  const rutas = {};
  RUT.forEach(r => {
    const f = fechaISO_(r.fecha); const id = String(r.rutaId || '');
    if (!f || f < hoy || !id) return;
    const ru = rutas[id] = rutas[id] || { rutaId: id, fecha: f, conductor: String(r.conductor || ''), vehiculo: String(r.vehiculo || ''),
                                         estado: String(r.estadoRuta || '').toUpperCase(), ids: [] };
    const cid = Number(r.clienteId); if (ru.ids.indexOf(cid) < 0) ru.ids.push(cid);
  });
  const hechoEn = {};
  REC.forEach(r => { const f = fechaISO_(r['Fecha de Recoleccion']); if (f >= hoy) hechoEn[f + '|' + nombreComparable_(r.Cliente)] = 1; });
  const regionDe = {};
  CLI.forEach(c => { regionDe[Number(c.id)] = String(c.region || '').trim().toUpperCase(); });
  const CFGL = cfgLog_(); let ACTS = []; try { ACTS = leerHoja_(HOJA_ACT); } catch (e) {}
  const listaRutas = Object.keys(rutas).map(k => rutas[k]).filter(r => r.estado !== 'TERMINADA ANTES').sort((a, b) => a.fecha.localeCompare(b.fecha));
  listaRutas.forEach(r => {
    r.tope = topeCamion_(r.vehiculo, CFGL, ACTS);
    r.caben = Math.max(0, r.tope - r.ids.length);
    const cuenta = {};
    r.ids.forEach(i => { const z = regionDe[i] || ''; if (z) cuenta[z] = (cuenta[z] || 0) + 1; });
    r.zonas = Object.keys(cuenta).sort((a, b) => cuenta[b] - cuenta[a]);
  });
  const enRuta = {};
  listaRutas.forEach(r => r.ids.forEach(i => {
    const nom = CLI.find(c => Number(c.id) === i);
    const hecho = nom && cli_nombres_(nom).some(k => hechoEn[r.fecha + '|' + k]);
    if (!hecho && (!enRuta[i] || r.fecha < enRuta[i].fecha)) enRuta[i] = { fecha: r.fecha, conductor: r.conductor, rutaId: r.rutaId };
  }));

  const sugerir = (id, zona) => {
    if (enRuta[id]) return { tipo: 'ya', fecha: enRuta[id].fecha, texto: ini_fechaTxt_(enRuta[id].fecha) + ' · ya en ruta' };
    const man = ini_dia_(hoy, 1);
    const cand = listaRutas.filter(r => r.fecha >= man && r.caben > 0 && zona && r.zonas.indexOf(zona) >= 0)[0];
    if (cand) return { tipo: 'ruta', fecha: cand.fecha, rutaId: cand.rutaId, texto: ini_fechaTxt_(cand.fecha) + ' · ' + String(cand.conductor).split(' ')[0] + ' · caben ' + cand.caben };
    const cualq = listaRutas.filter(r => r.fecha >= man && r.caben > 0)[0];
    if (cualq) return { tipo: 'otra', fecha: cualq.fecha, rutaId: cualq.rutaId, texto: ini_fechaTxt_(cualq.fecha) + ' · otra zona · caben ' + cualq.caben };
    let d = man; for (let g = 0; g < 10 && (ini_dow_(d) === 0 || ini_dow_(d) === 6); g++) d = ini_dia_(d, 1);
    return { tipo: 'nueva', fecha: d, texto: ini_fechaTxt_(d) + ' · sin ruta todavía' };
  };

  /* lo que no se puede planificar bien */
  const revisar = [];
  const huerf = Object.keys(P.idx.huerfanos).map(k => P.idx.huerfanos[k]);
  const tokens = s => nombreComparable_(s).split(' ').filter(t => t.length > 2 && ['CLINICA','CENTRO','MEDICO','HOSPITAL','DENTAL','PANAMA','LABORATORIO','VETERINARIA','SALUD'].indexOf(t) < 0);
  huerf.forEach(h => {
    const th = tokens(h.nombre); if (!th.length) return;
    let mejor = null, pts = 0;
    CLI.forEach(c => {
      const tc = [].concat.apply([], cli_nombres_(c).map(tokens));
      const p = th.filter(t => tc.indexOf(t) >= 0).length / th.length;
      if (p > pts) { pts = p; mejor = c; }
    });
    if (mejor && pts >= 0.5) h.candidato = { id: Number(mejor.id), nombre: String(mejor.nombre || '') };
  });

  const clientes = CLI.filter(c => Number(c.id)).map(c => {
    const id = Number(c.id), p = P.plan[id];
    const zona = String(c.region || '').trim().toUpperCase();
    const problemas = [];
    if (p.activo && (c.lat === '' || c.lat === null || c.lat === undefined || !Number(c.lat))) problemas.push({ tipo: 'ubicacion', texto: 'Sin ubicación en el mapa' });
    if (p.activo && !p.proxima) problemas.push({ tipo: 'fecha', texto: 'No tiene próxima visita ni forma de calcularla' });
    if (!p.activo && ['ATRASADO','VENCIDO','POR RECOLECTAR'].indexOf(String(c.estado || '').toUpperCase()) >= 0)
      problemas.push({ tipo: 'fuera', texto: 'Fuera de servicio pero su estado dice ' + String(c.estado).toLowerCase() });
    huerf.filter(h => h.candidato && h.candidato.id === id).forEach(h =>
      problemas.push({ tipo: 'nombre', texto: h.recibos + (h.recibos === 1 ? ' recibo' : ' recibos') + ' como «' + h.nombre + '»', nombre: h.nombre, recibos: h.recibos, ultima: h.ultima }));
    const o = {
      id: id, nombre: String(c.nombre || ''), zona: String(c.region || ''), direccion: String(c.direccion || ''),
      frecuencia: String(c.frecuencia || ''), contacto: String(c.contacto || ''), telefono: String(c.telefono || ''),
      whatsapp: String(c.whatsapp || ''), avisoA: String(c.avisoA || ''),             /* api 3.33 */
      ruc: String(c.ruc || ''), kg: Number(c.kg) || 0, estado: String(c.estado || ''),
      activo: p.activo, urg: p.urg, diasA: p.diasA, ultima: p.ultima, proxima: p.proxima, origen: p.origen,
      recurrencia: p.recurrencia, recDia: p.recDia, recTxt: p.recTxt, pausada: p.pausada,
      horario: String(c.horarioTipo || '').toLowerCase(), desde: horaTxt_(c.horarioDesde), hasta: horaTxt_(c.horarioHasta),
      lat: Number(c.lat) || null, lng: Number(c.lng) || null,
      enRuta: enRuta[id] || null, problemas: problemas
    };
    if (p.activo && ['atrasado','vencido','semana','sinfecha'].indexOf(p.urg) >= 0) o.sugerencia = sugerir(id, zona);
    return o;
  });
  const orden = { atrasado: 0, vencido: 1, semana: 2, sinfecha: 3, aldia: 4, fuera: 5 };
  clientes.sort((a, b) => (orden[a.urg] - orden[b.urg]) || ((a.diasA === null ? 999 : a.diasA) - (b.diasA === null ? 999 : b.diasA)) || a.nombre.localeCompare(b.nombre));

  let operadores = [];
  try { operadores = operadoresActivos_(); } catch (e) {}
  let vehiculos = [];
  try { vehiculos = vehiculosFlota_().map(v => v.placa); } catch (e) { vehiculos = VEHICULOS_BASE.slice(); }
  return { ok: true, hoy: hoy, clientes: clientes,
           huerfanos: huerf.sort((a, b) => b.recibos - a.recibos),
           rutas: listaRutas.map(r => ({ rutaId: r.rutaId, fecha: r.fecha, conductor: r.conductor, vehiculo: r.vehiculo,
                                         paradas: r.ids.length, caben: r.caben, zonas: r.zonas.slice(0, 2) })),
           operadores: operadores, vehiculos: vehiculos };
}

function api_fichaCliente(pin, clienteId) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'La ficha operativa es de logística.' };
  const hoy = hoyPanama_();
  const id = Number(clienteId);
  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC);
  const c = CLI.find(x => Number(x.id) === id);
  if (!c) return { ok: false, error: 'No encontré ese cliente.' };
  const P = cli_plan_(CLI, REC, hoy), p = P.plan[id];
  const n = v => Number(v) || 0;
  const hTipo = String(c.horarioTipo || '').toLowerCase(), hDesde = horaTxt_(c.horarioDesde), hHasta = horaTxt_(c.horarioHasta);
  const hace12 = ini_dia_(hoy, -365);

  const visitas = (P.idx.visitas[id] || []).map(r => {
    const hi = horaTxt_(r['hora inicio']), hf = horaTxt_(r['hora final']);
    const kg = n(r['total Kg']) || (n(r['Kg Recolectados']) + n(r['kg anatomopatologico']) + n(r['kg punzo cortantes']));
    const fuera = hTipo === 'estricto' && hi && ((hHasta && hi > hHasta) || (hDesde && hi < hDesde));
    const env = String(r.enviado || '');
    return { fecha: fechaISO_(r['Fecha de Recoleccion']), recibo: String(r['recibo numero'] || ''), kg: ini_r_(kg, 1),
             hi: hi, hf: hf, min: minutosEntre_(hi, hf), conductor: String(r.Responsable || ''), fuera: !!fuera,
             digital: env ? (env.indexOf('whatsapp') >= 0 ? 'whatsapp' : (env.indexOf('correo') >= 0 ? 'correo' : 'sí')) : '',
             nombre: String(r.Cliente || ''),
             /* api 2.7: para la miniatura del recibo en la ficha */
             kgBio: ini_r_(n(r['Kg Recolectados']), 1), cantBio: n(r['cantidad bolsas']),
             kgPunzo: ini_r_(n(r['kg punzo cortantes']), 1), cantPunzo: n(r['cantidad punzo cort']),
             kgAnatomo: ini_r_(n(r['kg anatomopatologico']), 1), cantAnatomo: n(r['cantidad anatomo']),
             firma: !!String(r.firma || '').trim(), firmante: String(r.firmante || ''),
             acta: String(r.acta || ''), vehiculo: String(r.vehiculo || '') };
  }).sort((a, b) => b.fecha.localeCompare(a.fecha));
  const ult = visitas.filter(v => v.fecha >= hace12);
  const conMin = ult.filter(v => v.min > 0 && v.min < 180);
  const porMes = {};
  ult.forEach(v => { const m = v.fecha.slice(0, 7); porMes[m] = (porMes[m] || 0) + v.kg; });
  const meses = [];
  for (let i = 11; i >= 0; i--) {
    const d = new Date(Date.UTC(Number(hoy.slice(0, 4)), Number(hoy.slice(5, 7)) - 1 - i, 1));
    const m = d.toISOString().slice(0, 7); meses.push({ mes: m, kg: ini_r_(porMes[m] || 0, 1) });
  }

  // % cumplidas: paradas programadas en 12 meses que se hicieron
  const noms = cli_nombres_(c);
  const hechas = {};
  visitas.forEach(v => hechas[v.fecha] = 1);
  const prog = {};
  leerHoja_(HOJA_RUT).forEach(r => { const f = fechaISO_(r.fecha); if (Number(r.clienteId) === id && f >= hace12 && f < hoy) prog[f] = 1; });
  const fProg = Object.keys(prog);
  const futuras = [];
  leerHoja_(HOJA_RUT).forEach(r => { const f = fechaISO_(r.fecha); if (Number(r.clienteId) === id && f >= hoy && futuras.every(x => x.fecha !== f)) futuras.push({ fecha: f, conductor: String(r.conductor || '') }); });

  // propuesta de recurrencia según el historial
  const fechas = visitas.map(v => v.fecha).sort();
  let propuesta = null;
  if (fechas.length >= 3) {
    const gaps = [];
    for (let i = 1; i < fechas.length; i++) gaps.push(ini_diasEntre_(fechas[i - 1], fechas[i]));
    const rec = gaps.slice(-8).sort((a, b) => a - b);
    const med = rec[Math.floor(rec.length / 2)];
    const patron = med <= 10 ? 'semanal' : (med <= 21 ? 'quincenal' : (med <= 50 ? 'mensual' : (med <= 120 ? 'trimestral' : '')));
    const cuenta = {};
    fechas.slice(-10).forEach(f => { const d = ini_dow_(f); cuenta[d] = (cuenta[d] || 0) + 1; });
    const dia = Number(Object.keys(cuenta).sort((a, b) => cuenta[b] - cuenta[a])[0]);
    const man = visitas.slice(0, 10).filter(v => v.hi && v.hi < '12:00').length;
    propuesta = { patron: patron, cadaDias: med, dia: dia || 1, manana: man >= Math.ceil(Math.min(10, visitas.length) / 2) };
  }

  // cobros por su RUC
  let cobros = null;
  const ruc = String(c.ruc || '').trim();
  if (ruc) {
    try {
      const porFac = {};
      leerHoja_(HOJA_PAG).forEach(pg => { const f = String(pg.factura || '').trim(); if (f) porFac[f] = (porFac[f] || 0) + n(pg.monto); });
      let saldo = 0, vencido = 0, facturas = 0, ultima = '';
      leerHoja_(HOJA_FAC).forEach(f => {
        if (String(f.ruc || '').trim() !== ruc) return;
        facturas++;
        if (esIncobrable_(f)) return;     // api 3.4: fuera de la cartera
        const num = String(f.factura || '').trim();
        const s = (n(f.total) || n(f.monto)) - (porFac[num] || 0);
        const venc = vencimientoDe_(f);
        if (s > 0.009) { saldo += s; if (venc && venc < hoy) vencido += s; }
        const fe = fechaISO_(f.fecha); if (fe > ultima) ultima = fe;
      });
      cobros = { facturas: facturas, saldo: ini_r_(saldo, 2), vencido: ini_r_(vencido, 2), ultimaFactura: ultima };
    } catch (e) {}
  }

  let rcd = []; try { rcd = rcd_de_(u, id); } catch (e) { rcd = []; }   /* api 3.7: sus recordatorios de este cliente */
  return {
    ok: true, hoy: hoy, recordatorios: rcd,
    cliente: {
      id: id, nombre: String(c.nombre || ''), nombre2: String(c['nombre 2'] || ''), razon: String(c['razon social'] || ''),
      zona: String(c.region || ''), direccion: String(c.direccion || ''), frecuencia: String(c.frecuencia || ''), kg: n(c.kg),
      estado: String(c.estado || ''), situacion: String(c.situacion || ''), activo: p.activo,
      contacto: String(c.contacto || ''), telefono: String(c.telefono || ''), correo: String(c.correo || ''),
      whatsapp: String(c.whatsapp || ''), avisoA: String(c.avisoA || ''),            /* api 3.33 */
      canal: String(c.canal || ''), reciboDigital: String(c.reciboDigital || '').toLowerCase(), ruc: ruc, dv: String(c.dv || ''), contrato: String(c.contrato || ''),
      vencimiento: fechaISO_(c.vencimiento), inicio: fechaISO_(c['inicio recoleccion']),
      lat: Number(c.lat) || null, lng: Number(c.lng) || null,
      horario: { tipo: hTipo, desde: hDesde, hasta: hHasta, nota: String(c.horarioNota || '') },
      notaConductor: String(c.notaConductor || ''),
      nombresRecibo: String(c.nombresRecibo || '').split('|').map(s => s.trim()).filter(Boolean)
    },
    plan: p,
    resumen: {
      visitas12: ult.length, kg12: ini_r_(ult.reduce((s, v) => s + v.kg, 0), 1),
      kgVisita: ult.length ? ini_r_(ult.reduce((s, v) => s + v.kg, 0) / ult.length, 1) : 0,
      minSitio: conMin.length ? Math.round(conMin.reduce((s, v) => s + v.min, 0) / conMin.length) : null,
      digitales: ult.filter(v => v.digital).length,
      fueraHorario: ult.filter(v => v.fuera).length,
      programadas: fProg.length, cumplidas: fProg.filter(f => hechas[f]).length
    },
    meses: meses, visitas: visitas.slice(0, 40), futuras: futuras.sort((a, b) => a.fecha.localeCompare(b.fecha)).slice(0, 6),
    propuesta: propuesta,
    proximasRec: p.recurrencia ? cli_proxRec_(p, hoy, 3) : [],
    cobros: cobros
  };
}

function cli_escribir_(ids, poner) {
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_CLI);
  const faltan = typeof poner === 'function' ? [] : Object.keys(poner).filter(k => COLS_CLI_OPER.indexOf(k) < 0);
  asegurarColumnas_(h, COLS_CLI_OPER.concat(faltan));
  const vals = h.getDataRange().getValues();
  const cab = vals[0].map(String);
  const cId = cab.indexOf('id');
  const quiero = {}; ids.forEach(i => quiero[String(Number(i))] = 1);
  let k = 0;
  for (let i = 1; i < vals.length; i++) {
    if (!quiero[String(Number(vals[i][cId]))]) continue;
    const pp = typeof poner === 'function' ? poner(Object.fromEntries(cab.map((c, j) => [c, vals[i][j]]))) : poner;
    Object.keys(pp).forEach(col => { const j = cab.indexOf(col); if (j >= 0) h.getRange(i + 1, j + 1).setValue(pp[col]); });
    k++;
  }
  return k;
}

function api_guardarOperativoCliente(pin, clienteId, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Lo operativo del cliente lo edita logística.' };
  d = d || {};
  const poner = {};
  ['contacto', 'telefono', 'whatsapp', 'correo', 'direccion', 'canal', 'notaConductor'].forEach(k => {
    if (d[k] !== undefined) poner[k] = String(d[k] || '').trim().slice(0, k === 'notaConductor' ? 300 : 200);
  });
  if (d.avisoA !== undefined) {                                                   /* api 3.33 · a cuál número van los avisos */
    const aa = String(d.avisoA || '').toLowerCase();
    if (['', 'telefono', 'whatsapp'].indexOf(aa) < 0) return { ok: false, error: 'Elige a cuál número van los avisos.' };
    poner.avisoA = aa;
  }
  if (d.reciboDigital !== undefined) {
    const rd = String(d.reciboDigital || '').toLowerCase();
    if (['', 'no', 'whatsapp', 'correo', 'ambos'].indexOf(rd) < 0) return { ok: false, error: 'Opción de recibo digital no válida.' };
    poner.reciboDigital = rd === 'no' ? '' : rd;
  }
  if (d.lat !== undefined || d.lng !== undefined) {
    const la = Number(d.lat), ln = Number(d.lng);
    if (!isFinite(la) || !isFinite(ln) || Math.abs(la) > 90 || Math.abs(ln) > 180 || !la || !ln) return { ok: false, error: 'Ubicación no válida.' };
    poner.lat = Math.round(la * 1e6) / 1e6; poner.lng = Math.round(ln * 1e6) / 1e6;
  }
  if (d.minutosParada !== undefined) {
    const m = String(d.minutosParada).trim() === '' ? '' : Number(d.minutosParada);
    if (m !== '' && !(m >= 3 && m <= 240)) return { ok: false, error: 'El tiempo de parada va de 3 a 240 minutos.' };
    poner.minutosParada = m;
  }
  if (d.proximaVisita !== undefined) {
    const f = String(d.proximaVisita || '').trim();
    if (f && !/^\d{4}-\d{2}-\d{2}$/.test(f)) return { ok: false, error: 'Fecha no válida.' };
    poner.proximaVisita = f;
  }
  if (!Object.keys(poner).length) return { ok: false, error: 'No hay nada que guardar.' };
  poner.operPor = u.nombre; poner.operEn = new Date();
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const k = cli_escribir_([clienteId], poner);
    if (!k) return { ok: false, error: 'No encontré ese cliente.' };
    marcar_('logistica');
    return { ok: true };
  } finally { lock.releaseLock(); }
}

function api_guardarRecurrencia(pin, ids, patron, dia, op) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'La recurrencia la fija logística.' };
  const lista = (Array.isArray(ids) ? ids : [ids]).map(Number).filter(Boolean);
  if (!lista.length) return { ok: false, error: 'Elige al menos un cliente.' };
  op = op || {};
  const hoy = hoyPanama_();
  const fOk = v => { const f = String(v || '').trim(); return /^\d{4}-\d{2}-\d{2}$/.test(f) ? f : ''; };
  if (op.soloPausa) {
    const ph = fOk(op.pausaHasta);
    if (op.pausaHasta && !ph) return { ok: false, error: 'Fecha de pausa no válida.' };
    if (ph && !String(op.pausaMotivo || '').trim()) return { ok: false, error: 'Escribe el motivo de la pausa.' };
    const lock = LockService.getScriptLock(); lock.waitLock(20000);
    try {
      const k = cli_escribir_(lista, { recurrenciaPausaHasta: ph, recurrenciaPausaMotivo: ph ? String(op.pausaMotivo).trim().slice(0, 150) : '',
                                       recurrenciaPor: u.nombre, recurrenciaEn: new Date() });
      marcar_('logistica');
      return { ok: true, clientes: k, pausaHasta: ph };
    } finally { lock.releaseLock(); }
  }
  const pat = String(patron || '').toLowerCase();
  if (pat && !REC_SEMANAS.hasOwnProperty(pat)) return { ok: false, error: 'Patrón no válido.' };
  const dias = cli_diasRec_(Array.isArray(dia) ? dia.join(',') : dia);
  if (pat && !dias.length) return { ok: false, error: 'Elige el día (lunes a sábado).' };
  if (pat && pat !== 'semanal' && dias.length > 1) return { ok: false, error: 'Varios días por semana solo con «cada semana».' };
  const sem = Number(op.semana) || 0;
  if (pat === 'mes' && !(sem >= 1 && sem <= 5)) return { ok: false, error: 'Elige qué semana del mes.' };
  const hasta = fOk(op.hasta);
  let ancla = '';
  if (pat) {
    const desde = fOk(op.desde) || ini_dia_(hoy, 1);
    ancla = desde;
    for (let g = 0; g < 7 && dias.indexOf(ini_dow_(ancla)) < 0; g++) ancla = ini_dia_(ancla, 1);
    if (hasta && hasta < ancla) return { ok: false, error: '«Hasta» es antes de que empiece.' };
  }
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const k = cli_escribir_(lista, {
      recurrencia: pat, recurrenciaDia: pat ? dias.join(',') : '', recurrenciaDesde: ancla,
      recurrenciaSemana: pat === 'mes' ? sem : '', recurrenciaHasta: pat ? hasta : '',
      recurrenciaConductor: pat ? String(op.conductor || '').trim() : '', recurrenciaVehiculo: pat ? String(op.vehiculo || '').trim() : '',
      recurrenciaPausaHasta: '', recurrenciaPausaMotivo: '',
      recurrenciaPor: u.nombre, recurrenciaEn: new Date() });
    marcar_('logistica');
    const pl = { recurrencia: pat, recDias: dias, recSemana: sem, recDesde: ancla, recHasta: hasta };
    return { ok: true, clientes: k, patron: pat, desde: ancla, texto: cli_recTxt_(pl), proximas: pat ? cli_proxRec_(pl, hoy, 4) : [] };
  } finally { lock.releaseLock(); }
}

function api_unirNombreCliente(pin, clienteId, nombre) {
  const u = usuarioPorPin_(pin);
