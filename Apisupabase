function api_merDecidirSuspension(pin, suspId, decision, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!cobB_puedeDecidir_(u)) return { ok: false, error: 'La suspensión la decide Mercadeo.' };
  d = d || {};
  const L = cobA_libro_(); cobA_seguimiento_(L);
  const s = cobB_suspensiones_(L).filter(x => x.id === String(suspId))[0];
  if (!s || !s.abierta) return { ok: false, error: 'Esa solicitud ya no está abierta.' };
  const c = L.cuentas[s.clave] || {};
  const motivo = String(d.motivo || '').trim();
  const h = cobA_hoja_(HOJA_SUSP, COLS_SUSP);
  const dec = String(decision || '').toLowerCase();
  if (dec === 'plazo') {
    const hasta = fechaISO_(d.hasta);
    if (!hasta || hasta <= L.hoy) return { ok: false, error: 'Elige una fecha de plazo posterior a hoy.' };
    cobA_cambiar_(h, 'suspId', s.id, { estado: 'PLAZO', decidio: u.nombre, fechaDecision: L.hoy, motivoDecision: motivo, plazoHasta: hasta });
    cobB_gestionSistema_(c, u, 'PLAZO HASTA ' + fechaPanama_(hasta), motivo || 'Mercadeo dio plazo', 'plazo', hasta);
    marcar_('cobros'); marcar_('mercadeo');
    return { ok: true, estado: 'PLAZO' };
  }
  if (dec === 'seguir') {
    if (!motivo) return { ok: false, error: 'Escribe por qué no se suspende: queda escrito.' };
    cobA_cambiar_(h, 'suspId', s.id, { estado: 'SEGUIR', decidio: u.nombre, fechaDecision: L.hoy, motivoDecision: motivo });
    cobB_gestionSistema_(c, u, 'NO SE SUSPENDE', motivo, 'seguir', cobA_mas_(L.hoy, 3));
    marcar_('cobros'); marcar_('mercadeo');
    return { ok: true, estado: 'SEGUIR' };
  }
  if (dec !== 'suspender') return { ok: false, error: 'Decisión no válida.' };
  if (!motivo) return { ok: false, error: 'Escribe el motivo de la suspensión.' };
  /* la confirmación con PIN: tiene que ser el mismo usuario que decide */
  const u2 = usuarioPorPin_(String(d.pin2 || ''));
  if (!u2 || String(u2.nombre).trim().toLowerCase() !== String(u.nombre).trim().toLowerCase())
    return { ok: false, error: 'El PIN de confirmación no coincide con el tuyo.' };
  const hechos = [], errores = [];
  s.clienteIds.forEach(id => {
    const r = api_cambiarEstadoCliente(pin, id, 'mora', 'Suspensión por falta de pago · ' + motivo);
    if (r && r.ok) hechos.push(id); else if (!(r && /ya está así/.test(r.error || ''))) errores.push((r && r.error) || 'error');
  });
  if (!hechos.length && errores.length) return { ok: false, error: errores[0] };
  let carta = null;
  if (d.carta) carta = cobB_crearCarta_(L, c, 'suspension', u, {});
  cobA_cambiar_(h, 'suspId', s.id, { estado: 'SUSPENDIDA', decidio: u.nombre, fechaDecision: L.hoy, motivoDecision: motivo, cartaId: carta ? carta.cartaId : '' });
  cobB_gestionSistema_(c, u, 'SUSPENDIDO', motivo, 'suspendido', cobA_mas_(L.hoy, 7));
  avisoGerencia_('suspension', 'Se suspendió el servicio a ' + (c.cliente || s.cliente),
    'Decidió ' + u.nombre + ' · ' + cobA_fmt_(c.vencido) + ' vencido · ' + hechos.length + ' punto(s) fuera de ruta · ' + motivo, u, 'mercadeo', s.id);
  marcar_('cobros'); marcar_('mercadeo');
  return { ok: true, estado: 'SUSPENDIDA', puntos: hechos.length, carta: carta };
}

