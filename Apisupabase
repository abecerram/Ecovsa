/* ── Lectura de los textos vigentes ─────────────────────────────── */
function bloquesFabrica313_(doc) { return TEXTOS_FABRICA[doc] || null; }
function bloqueFabrica313_(doc, bloque) { return (TEXTOS_FABRICA[doc] || []).filter(b => b.id === bloque)[0] || null; }

/* {doc|bloque|variante: fila} de lo que Mercadeo cambió */
function textosEditados313_() {
  const m = {};
  tabla313_(HOJA_DOCT_313, COLS_DOCT_313).filas.forEach(f => {
    m[f.doc + '|' + f.bloque + '|' + String(f.variante || '')] = f;
  });
  return m;
}
/* El texto vigente de un bloque y variante: el editado o el de fábrica. */
function textoVigente313_(doc, bloque, variante, ed) {
  ed = ed || textosEditados313_();
  const f = ed[doc + '|' + bloque + '|' + (variante || '')];
  if (f) return String(f.texto || '');
  const b = bloqueFabrica313_(doc, bloque);
  return b && b.textos ? String(b.textos[variante || ''] || '') : '';
}

function api_docTextos(pin, doc) {
  const e = entrar313_(pin, 'lee'); if (e.error) return e.error;
  if (!bloquesFabrica313_(doc)) return { ok: false, error: 'Documento desconocido.' };
  const ed = textosEditados313_();
  const bloques = bloquesFabrica313_(doc).map(b => {
    const o = { id: b.id, titulo: b.titulo, auto: !!b.auto, descripcion: b.descripcion || '', variantes: b.auto ? [] : b.variantes, textos: {} };
    if (!b.auto) b.variantes.forEach(v => {
      const f = ed[doc + '|' + b.id + '|' + v.id];
      o.textos[v.id] = { texto: f ? String(f.texto || '') : b.textos[v.id], original: b.textos[v.id], editado: !!f,
        editadoPor: f ? String(f.editadoPor || '') : '', editadoEn: f ? String(f.editadoEn || '') : '' };
    });
    return o;
  });
  const num = numeracionDatos313_();
  return { ok: true, doc: doc, bloques: bloques,
    variables: VARIABLES_DOC_313.map(v => ({ clave: v[0], ayuda: v[1] })),
    numeracion: doc === 'contrato' ? num.ct : num.pro, puedeEditar: puedeEscribirMer313_(e.u) };
}

/* Variables escritas que no existen (una tilde o una letra de más). */
function variablesDesconocidas313_(texto) {
  const claves = VARIABLES_DOC_313.map(v => v[0]), malas = [];
  String(texto || '').replace(/\{\??([^{}]*)\}/g, (m, k) => { if (claves.indexOf(k.trim()) < 0 && malas.indexOf(m) < 0) malas.push(m); return m; });
  return malas;
}
function resumen313_(t) { const s = String(t || '').replace(/\s+/g, ' ').trim(); return s.length > 90 ? s.slice(0, 87) + '…' : s; }

function historialDoc313_(u, d) {
  const t = tabla313_(HOJA_DOCH_313, COLS_DOCH_313);
  const aviso = !esAdmin_(u);
  agregar313_(t, { id: id313_('TX'), cuando: ahora313_(), quien: u.nombre, doc: d.doc, bloque: d.bloque || '', variante: d.variante || '',
    accion: d.accion, titulo: d.titulo || '', resumen: d.resumen || '', textoAnterior: d.textoAnterior == null ? '' : d.textoAnterior,
    textoNuevo: d.textoNuevo == null ? '' : d.textoNuevo, avisoAdmin: aviso ? 'SI' : 'NO' });
  if (aviso) avisoAdmin313_(u, d.avisoTitulo || ('Cambio en ' + d.doc), d.avisoDetalle || (u.nombre + ': ' + (d.titulo || '') + ' · ' + (d.resumen || '')));
}

/* Escribe (o borra, si texto es null) la versión editada de un bloque. */
function escribirTexto313_(u, doc, bloque, variante, texto) {
  const t = tabla313_(HOJA_DOCT_313, COLS_DOCT_313);
  const f = t.filas.filter(x => x.doc === doc && x.bloque === bloque && String(x.variante || '') === (variante || ''))[0];
  if (texto == null) { if (f) t.h.deleteRow(f._fila); return; }
  const campos = { doc: doc, bloque: bloque, variante: variante || '', texto: texto, editadoPor: u.nombre, editadoEn: ahora313_() };
  if (f) actualizar313_(t, f._fila, campos); else agregar313_(t, campos);
}

function validarBloque313_(doc, bloque, variante) {
  const b = bloqueFabrica313_(doc, bloque);
  if (!b) return 'Ese bloque no existe.';
  if (b.auto) return 'Ese bloque lo arma el sistema y no se edita.';
  if (!b.variantes.some(v => v.id === (variante || ''))) return 'Esa variante no existe en el bloque.';
  return '';
}
function bloqueRespuesta313_(doc, bloque) {
  const ed = textosEditados313_(), b = bloqueFabrica313_(doc, bloque), o = { id: b.id, titulo: b.titulo, textos: {} };
  b.variantes.forEach(v => { const f = ed[doc + '|' + b.id + '|' + v.id];
    o.textos[v.id] = { texto: f ? String(f.texto) : b.textos[v.id], original: b.textos[v.id], editado: !!f,
      editadoPor: f ? String(f.editadoPor || '') : '', editadoEn: f ? String(f.editadoEn || '') : '' }; });
  return o;
}

function api_docGuardarTexto(pin, doc, bloque, variante, texto, entiendo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  if (entiendo !== true) return { ok: false, error: 'Marca «Entiendo» para guardar: el cambio sale en todas las propuestas nuevas.' };
  const malo = validarBloque313_(doc, bloque, variante); if (malo) return { ok: false, error: malo };
  const nuevo = String(texto == null ? '' : texto).replace(/\r\n?/g, '\n').replace(/<[^>]*>/g, '').trim();
  if (!nuevo) return { ok: false, error: 'El texto no puede quedar vacío. Usa «Volver al texto original» si quieres el de fábrica.' };
  const des = variablesDesconocidas313_(nuevo);
  if (des.length) return { ok: false, error: 'No conozco ' + des.join(', ') + '. Revisa cómo se escribe la variable.' };
  return candado313_(() => {
    const antes = textoVigente313_(doc, bloque, variante);
    if (antes === nuevo) return { ok: true, sinCambios: true, bloque: bloqueRespuesta313_(doc, bloque) };
    const b = bloqueFabrica313_(doc, bloque), orig = b.textos[variante || ''];
    escribirTexto313_(e.u, doc, bloque, variante, nuevo === orig ? null : nuevo);
    historialDoc313_(e.u, { doc: doc, bloque: bloque, variante: variante, accion: 'editar', titulo: b.titulo + nombreVariante313_(b, variante),
      resumen: resumen313_(nuevo), textoAnterior: antes, textoNuevo: nuevo,
      avisoTitulo: 'Mercadeo cambió un texto de la ' + doc, avisoDetalle: e.u.nombre + ' cambió «' + b.titulo + '»' + nombreVariante313_(b, variante) + '.' });
    return { ok: true, bloque: bloqueRespuesta313_(doc, bloque) };
  });
}
function nombreVariante313_(b, variante) {
  if (!variante || b.variantes.length < 2) return '';
  const v = b.variantes.filter(x => x.id === variante)[0];
  return v ? ' · ' + v.nombre : '';
}

function api_docVolverOriginal(pin, doc, bloque, variante, entiendo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  if (entiendo !== true) return { ok: false, error: 'Marca «Entiendo» para volver al texto original.' };
  const malo = validarBloque313_(doc, bloque, variante); if (malo) return { ok: false, error: malo };
  return candado313_(() => {
    const b = bloqueFabrica313_(doc, bloque), antes = textoVigente313_(doc, bloque, variante), orig = b.textos[variante || ''];
    if (antes === orig) return { ok: true, sinCambios: true, bloque: bloqueRespuesta313_(doc, bloque) };
    escribirTexto313_(e.u, doc, bloque, variante, null);
    historialDoc313_(e.u, { doc: doc, bloque: bloque, variante: variante, accion: 'original', titulo: b.titulo + nombreVariante313_(b, variante),
      resumen: 'Volvió al texto original', textoAnterior: antes, textoNuevo: orig,
      avisoTitulo: 'Mercadeo volvió un texto de la ' + doc + ' al original', avisoDetalle: e.u.nombre + ' · «' + b.titulo + '»' });
    return { ok: true, bloque: bloqueRespuesta313_(doc, bloque) };
  });
}

function api_docRestaurarFabrica(pin, doc, entiendo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  if (!bloquesFabrica313_(doc)) return { ok: false, error: 'Documento desconocido.' };
  if (entiendo !== true) return { ok: false, error: 'Marca «Entiendo» para restaurar todo de fábrica.' };
  return candado313_(() => {
    const t = tabla313_(HOJA_DOCT_313, COLS_DOCT_313);
    const mias = t.filas.filter(f => f.doc === doc).sort((a, b) => b._fila - a._fila);
    if (!mias.length) return { ok: true, sinCambios: true };
    const copia = {}; mias.forEach(f => { copia[f.bloque + '|' + String(f.variante || '')] = String(f.texto || ''); });
    mias.forEach(f => t.h.deleteRow(f._fila));
    historialDoc313_(e.u, { doc: doc, accion: 'fabrica', titulo: 'Todo el documento', resumen: 'Restauró todo de fábrica (' + mias.length + ' bloque' + (mias.length === 1 ? '' : 's') + ')',
      textoAnterior: JSON.stringify(copia), textoNuevo: '',
      avisoTitulo: 'Mercadeo restauró de fábrica los textos de la ' + doc, avisoDetalle: e.u.nombre + ' · ' + mias.length + ' bloque(s)' });
    return { ok: true };
  });
}

function api_docHistorial(pin, filtro) {
  const e = entrar313_(pin, 'lee'); if (e.error) return e.error;
  const f = String(filtro || '');
  const puede = puedeEscribirMer313_(e.u);
  const items = tabla313_(HOJA_DOCH_313, COLS_DOCH_313).filas
    .filter(h => f ? h.doc === f : h.doc !== 'empresa')
    .map(h => ({ id: String(h.id), cuando: String(h.cuando), quien: String(h.quien), doc: String(h.doc), bloque: String(h.bloque || ''),
      variante: String(h.variante || ''), titulo: String(h.titulo || ''), resumen: String(h.resumen || ''),
      textoAnterior: h.accion === 'fabrica' ? '' : String(h.textoAnterior || ''), avisoAdmin: si313_(h.avisoAdmin),
      puedeVolver: puede && (h.accion === 'editar' || h.accion === 'original' || h.accion === 'version') && !!bloqueFabrica313_(h.doc, h.bloque) }))
    .reverse();
  return { ok: true, items: items };
}

/* «Volver a esta versión»: deja el bloque como estaba ANTES de ese cambio. */
function api_docVolverVersion(pin, historialId, entiendo) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  if (entiendo !== true) return { ok: false, error: 'Marca «Entiendo» para volver a esa versión.' };
  const h = tabla313_(HOJA_DOCH_313, COLS_DOCH_313).filas.filter(x => String(x.id) === String(historialId))[0];
  if (!h) return { ok: false, error: 'No encontré ese cambio en el historial.' };
  if (['editar', 'original', 'version'].indexOf(String(h.accion)) < 0 || !bloqueFabrica313_(h.doc, h.bloque))
    return { ok: false, error: 'Ese cambio no se puede volver atrás desde aquí.' };
  const doc = String(h.doc), bloque = String(h.bloque), variante = String(h.variante || ''), destino = String(h.textoAnterior || '');
  return candado313_(() => {
    const b = bloqueFabrica313_(doc, bloque), antes = textoVigente313_(doc, bloque, variante);
    if (antes === destino) return { ok: true, sinCambios: true };
    escribirTexto313_(e.u, doc, bloque, variante, destino === b.textos[variante] ? null : destino);
    historialDoc313_(e.u, { doc: doc, bloque: bloque, variante: variante, accion: 'version', titulo: b.titulo + nombreVariante313_(b, variante),
      resumen: 'Volvió a la versión del ' + String(h.cuando).slice(0, 10), textoAnterior: antes, textoNuevo: destino,
      avisoTitulo: 'Mercadeo volvió un texto de la ' + doc + ' a una versión anterior', avisoDetalle: e.u.nombre + ' · «' + b.titulo + '»' });
    return { ok: true };
  });
}

/* ── Resolver los textos para un cliente ───────────────────────── */

/* Número a letras (igual que Contrato.html). */
function enLetras313_(v) {
  const UNI = ['', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez', 'once', 'doce', 'trece', 'catorce', 'quince',
    'dieciséis', 'diecisiete', 'dieciocho', 'diecinueve', 'veinte', 'veintiuno', 'veintidós', 'veintitrés', 'veinticuatro', 'veinticinco',
    'veintiséis', 'veintisiete', 'veintiocho', 'veintinueve'];
  const DEC = ['', '', '', 'treinta', 'cuarenta', 'cincuenta', 'sesenta', 'setenta', 'ochenta', 'noventa'];
  const CEN = ['', 'ciento', 'doscientos', 'trescientos', 'cuatrocientos', 'quinientos', 'seiscientos', 'setecientos', 'ochocientos', 'novecientos'];
  const m100 = n => n < 30 ? UNI[n] : DEC[Math.floor(n / 10)] + (n % 10 ? ' y ' + UNI[n % 10] : '');
  const m1000 = n => { if (n === 100) return 'cien'; const c = Math.floor(n / 100), r = n % 100; return (c ? CEN[c] : '') + (c && r ? ' ' : '') + (r ? m100(r) : ''); };
  const total = Math.round((Number(v) || 0) * 100);
  const n = Math.floor(total / 100), cent = total % 100;
  let t;
  if (n === 0) t = 'cero';
  else if (n < 1000) t = m1000(n);
  else { const mil = Math.floor(n / 1000), r = n % 1000; t = (mil === 1 ? 'mil' : m1000(mil) + ' mil') + (r ? ' ' + m1000(r) : ''); }
  t = t.charAt(0).toUpperCase() + t.slice(1);
  return t + ' balboas con ' + ('0' + cent).slice(-2) + '/100';
}

