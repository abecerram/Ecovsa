    return { ok: true };
  } finally { lock.releaseLock(); }
}

function api_moverParada_330_(pin, rutaId, clienteId, fechaDestino, rutaDestino) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  const id = Number(clienteId), D = String(fechaDestino || '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(D)) return { ok: false, error: 'Elige el día.' };
  if (D < hoyPanama_()) return { ok: false, error: 'Ese día ya pasó.' };
  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const rutas = plan_rutas_(leerHoja_(HOJA_RUT));
    const orig = rutas.find(r => r.rutaId === String(rutaId || ''));
    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
    let origen = '';
    if (orig) {
      const p = orig.paradas.find(x => x.clienteId === id);
      origen = p ? p.origen : '';
      const vals = h.getDataRange().getValues(), cab = vals[0].map(String), cR = cab.indexOf('rutaId'), cC = cab.indexOf('clienteId');
      for (let i = vals.length - 1; i >= 1; i--) if (String(vals[i][cR]) === orig.rutaId && Number(vals[i][cC]) === id) h.deleteRow(i + 1);
      if (String(origen || '').indexOf('extra:') !== 0) plan_anotarQuitado_(orig.fecha, id, orig.rutaId, (origen || 'movida').split(':')[0], 'movida al ' + D, u);
    }
    const deD = rutas.filter(r => r.fecha === D);
    let dest = deD.find(r => r.rutaId === String(rutaDestino || '')) || deD.find(r => r.estadoPlan === 'borrador') || (deD.length === 1 ? deD[0] : null);
    if (!dest && deD.length > 1) dest = deD[0];
    let nueva = false;
    if (!dest) { dest = { rutaId: 'R' + new Date().getTime(), fecha: D, conductor: orig ? orig.conductor : (operadoresActivos_()[0] || ''), vehiculo: orig ? orig.vehiculo : '', estadoPlan: 'borrador' }; nueva = true; }
    if (!dest.vehiculo) { try { dest.vehiculo = vehiculosFlota_()[0].placa; } catch (e) { dest.vehiculo = VEHICULOS_BASE[0]; } }
    const esExtra = String(origen || '').indexOf('extra:') === 0;
    const n = plan_agregar_(dest.rutaId, D, dest.conductor, dest.vehiculo, dest.estadoPlan, [{ clienteId: id, origen: esExtra ? origen : 'movida:' + (orig ? orig.fecha : '') }], u);
    if (esExtra && typeof sol_extraPuesta_ === 'function') sol_extraPuesta_(origen.slice(6), D, dest, u);
    marcar_('logistica');
    return { ok: true, destino: { fecha: D, rutaId: dest.rutaId, conductor: dest.conductor, estadoPlan: dest.estadoPlan, nueva: nueva }, agregada: n > 0 };
  } finally { lock.releaseLock(); }
}

function api_recurrentes(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística.' };
  const hoy = hoyPanama_();
  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC);
  const P = cli_plan_(CLI, REC, hoy);
  const lista = [], sugerencias = [];
  CLI.forEach(c => {
    const id = Number(c.id), pl = P.plan[id]; if (!pl) return;
    if (pl.recurrencia) {
      lista.push({ id: id, nombre: String(c.nombre || ''), zona: String(c.region || ''), activo: pl.activo, texto: pl.recTxt,
                   patron: pl.recurrencia, dias: pl.recDias, semana: pl.recSemana, desde: pl.recDesde, hasta: pl.recHasta,
                   pausaHasta: pl.pausaHasta, pausaMotivo: pl.pausaMotivo, pausada: pl.pausada,
                   conductor: pl.conductorPref, vehiculo: pl.vehiculoPref, proxima: cli_proxRec_(pl, hoy, 1)[0] || '',
                   horario: String(c.horarioTipo || '') ? horaTxt_(c.horarioDesde) + '–' + horaTxt_(c.horarioHasta) : '' });
      return;
    }
    if (!pl.activo) return;
    /* ¿se recoge siempre el mismo día? (últimas visitas de 6 meses) */
    const fs = (P.idx.visitas[id] || []).map(r => fechaISO_(r['Fecha de Recoleccion'])).filter(f => f >= ini_dia_(hoy, -180)).sort();
    const unicas = fs.filter((f, i) => fs.indexOf(f) === i);
    if (unicas.length < 4) return;
    const cuenta = {}; unicas.slice(-6).forEach(f => { const d = ini_dow_(f); cuenta[d] = (cuenta[d] || 0) + 1; });
    const dia = Number(Object.keys(cuenta).sort((a, b) => cuenta[b] - cuenta[a])[0]);
    const n6 = Math.min(6, unicas.length);
    if (cuenta[dia] / n6 < 0.75 || dia === 0) return;
    const gaps = []; for (let i = 1; i < unicas.length; i++) gaps.push(ini_diasEntre_(unicas[i - 1], unicas[i]));
    const g = gaps.slice(-5).sort((a, b) => a - b)[Math.floor(Math.min(5, gaps.length) / 2)];
    const patron = g <= 10 ? 'semanal' : (g <= 20 ? 'quincenal' : (g <= 40 ? 'mes' : ''));
    if (!patron) return;
    let semana = 0;
    if (patron === 'mes') { const sc = {}; unicas.slice(-4).forEach(f => { const s = Math.ceil(Number(f.slice(8, 10)) / 7); sc[s] = (sc[s] || 0) + 1; }); semana = Number(Object.keys(sc).sort((a, b) => sc[b] - sc[a])[0]) || 1; }
    sugerencias.push({ id: id, nombre: String(c.nombre || ''), zona: String(c.region || ''), patron: patron, dia: dia, semana: semana,
                       texto: cli_recTxt_({ recurrencia: patron, recDias: [dia], recSemana: semana }), visitas: unicas.length, cadaDias: g });
  });
  lista.sort((a, b) => (a.pausada - b.pausada) || a.nombre.localeCompare(b.nombre));
  let operadores = []; try { operadores = operadoresActivos_(); } catch (e) {}
  let vehiculos = []; try { vehiculos = vehiculosFlota_().map(v => v.placa); } catch (e) { vehiculos = VEHICULOS_BASE.slice(); }
  return { ok: true, hoy: hoy, lista: lista, sugerencias: sugerencias, operadores: operadores, vehiculos: vehiculos };
}


