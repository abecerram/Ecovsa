/* Cliente con contrato vigente: tiene número de contrato, no ha vencido y
   no está fuera por retiro o cierre. */
function clienteConContrato313_(id) {
  const c = clientePorId313_(id); if (!c) return false;
  if (!String(c.contrato || '').trim()) return false;
  const v = fechaISO_(c.vencimiento);
  if (v && v < hoy313_()) return false;
  const sit = String(c.situacion || '').toLowerCase();
  if (sit === 'retiro' || sit === 'cierre') return false;
  return true;
}
/* Unido con el 3.12 (revisado 30 sep) · de qué cliente sale la oportunidad.
   «Misma sede» y «agregar otra sede» dejan la oportunidad amarrada a la ficha
   (OP.clienteId en MerOportunidad). La cuenta con sedes (columna cuenta, JSON)
   puede traer clienteId propio o en sus sedes. */
function clientesDeOportunidad313_(p) {
  const ids = [];
  if (String(p.clienteId || '').trim()) ids.push(String(p.clienteId).trim());
  if (String(p['cliente origen'] || '').trim()) ids.push(String(p['cliente origen']).trim());   // misma sede (3.12)
  const cu = cuentaDe313_(p);
  if (cu && typeof cu === 'object') {
    if (cu.clienteId) ids.push(String(cu.clienteId));
    (cu.grupos || []).forEach(g => (g.sedes || []).forEach(s => { if (s.clienteId) ids.push(String(s.clienteId)); }));
  }
  return ids;
}
function esClienteNuevo313_(p) {
  return !clientesDeOportunidad313_(p).some(id => clienteConContrato313_(id));
}

