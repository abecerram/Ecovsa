function api_crmReportes(pin, desde, hasta) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  const hoy = hoyPanama_(), aj = crm_ajustes_();
  const d2 = crm_txt_(hasta) || hoy, d1 = crm_txt_(desde) || crm_masDias_(d2, -89);
  const pros = crm_filas_(HOJA_PRO).map(r => crm_oportunidad_(r, aj, hoy)).filter(p => p.codigoPropuesta);
  const creada = p => p['fecha contacto'] || fechaISO_(p.registradoEn) || '';
  const cierre = p => p['fecha cierre'] || (p.ganada ? (p['fecha contrato'] || p['fecha etapa']) : p.perdida ? p['fecha etapa'] : '') || '';
  const enP = f => f && f >= d1 && f <= d2;
  const cerradas = pros.filter(p => (p.ganada || p.perdida) && enP(cierre(p)));
  const ganadas = cerradas.filter(p => p.ganada), perdidas = cerradas.filter(p => p.perdida);
  const conv = l => { const g = l.filter(p => p.ganada).length, pe = l.filter(p => p.perdida).length; return (g + pe) ? Math.round(g / (g + pe) * 100) : null; };
  const ciclo = l => { const v = l.filter(p => creada(p) && cierre(p)).map(p => crm_dias_(creada(p), cierre(p))).filter(d => d >= 0); return v.length ? Math.round(v.reduce((s, d) => s + d, 0) / v.length) : null; };
  const agrupar = (campo, def) => {
    const g = {};
    pros.filter(p => enP(creada(p)) || enP(cierre(p))).forEach(p => {
      const txt = crm_txt_(typeof campo === 'function' ? campo(p) : p[campo]) || def;
      const k = crm_clave_(txt);   // «katherine Mezua» y «Katherine Mezua» son la misma
      const o = g[k] = g[k] || { clave: txt, nuevas: 0, ganadas: 0, perdidas: 0, abiertas: 0, valorGanado: 0, ciclo: [] };
      if (enP(creada(p))) o.nuevas++;
      if (enP(cierre(p)) && p.ganada) { o.ganadas++; o.valorGanado += p.valor; if (creada(p)) o.ciclo.push(crm_dias_(creada(p), cierre(p))); }
      if (enP(cierre(p)) && p.perdida) o.perdidas++;
      if (p.abierta) o.abiertas++;
    });
    return Object.keys(g).map(k => { const o = g[k];
      return { clave: k, nuevas: o.nuevas, ganadas: o.ganadas, perdidas: o.perdidas, abiertas: o.abiertas,
               valorGanado: crm_r_(o.valorGanado, 2), conversion: (o.ganadas + o.perdidas) ? Math.round(o.ganadas / (o.ganadas + o.perdidas) * 100) : null,
               ciclo: o.ciclo.length ? Math.round(o.ciclo.reduce((s, d) => s + d, 0) / o.ciclo.length) : null }; })
      .sort((a, b) => b.nuevas + b.ganadas - a.nuevas - a.ganadas);
  };
  /* por mes (6 meses hasta d2) */
  /* los meses del periodo pedido (al menos 6, como mucho 24) */
  const meses = [];
  let nMeses = (Number(d2.slice(0, 4)) - Number(d1.slice(0, 4))) * 12 + Number(d2.slice(5, 7)) - Number(d1.slice(5, 7)) + 1;
  nMeses = Math.max(6, Math.min(24, nMeses));
  for (let i = nMeses - 1; i >= 0; i--) { const d = new Date(d2.slice(0, 8) + '15T12:00:00Z'); d.setUTCMonth(d.getUTCMonth() - i); meses.push(d.toISOString().slice(0, 7)); }
  const porMes = meses.map(m => {
    const g = pros.filter(p => p.ganada && cierre(p).slice(0, 7) === m), pe = pros.filter(p => p.perdida && cierre(p).slice(0, 7) === m);
    return { mes: m, nuevas: pros.filter(p => creada(p).slice(0, 7) === m).length, ganadas: g.length, perdidas: pe.length,
             valorGanado: crm_r_(g.reduce((s, p) => s + p.valor, 0), 2), meta: crm_n_(aj.metaMensual),
             conversion: (g.length + pe.length) ? Math.round(g.length / (g.length + pe.length) * 100) : null };
  });
  const abiertas = pros.filter(p => p.abierta);
  const embudo = ESTADOS_PRO.map(e => { const l = pros.filter(p => p.estado === e);
    return { etapa: e, n: l.length, valor: crm_r_(l.reduce((s, p) => s + p.valor, 0), 2), ponderado: crm_r_(l.reduce((s, p) => s + p.ponderado, 0), 2),
             diasPromedio: l.length ? Math.round(l.reduce((s, p) => s + p.diasEtapa, 0) / l.length) : 0, probabilidad: crm_n_(aj.probabilidades[e]) }; });
  const pron = {};
  abiertas.filter(p => p.estado !== 'Stand-by').forEach(p => { const m = p.cierreEsperado ? p.cierreEsperado.slice(0, 7) : 'sin fecha';
    pron[m] = pron[m] || { mes: m, n: 0, valor: 0, ponderado: 0 }; pron[m].n++; pron[m].valor += p.valor; pron[m].ponderado += p.ponderado; });
  const motivos = {};
  perdidas.forEach(p => { const k = crm_txt_(p['motivo perdida']) || 'Sin motivo anotado'; motivos[k] = (motivos[k] || 0) + 1; });
  const acts = crm_filas_(HOJA_CRM_ACT).map(crm_actividad_).filter(a => enP(a.fecha));
  const porTipo = {}; acts.forEach(a => porTipo[a.tipo] = (porTipo[a.tipo] || 0) + 1);
  const porUsuario = {}; acts.forEach(a => porUsuario[a.usuario || '—'] = (porUsuario[a.usuario || '—'] || 0) + 1);
  /* cartera: salud y renovaciones */
  let cartera = null;
  try { const cl = api_crmClientes(pin); if (cl && cl.ok) cartera = { resumen: cl.resumen,
    enRiesgo: cl.clientes.filter(c => c.salud.nivel === 'riesgo').slice(0, 30).map(c => ({ id: c.id, nombre: c.nombre, motivos: c.salud.motivos, accion: c.salud.accion })),
    crecer: cl.clientes.filter(c => c.salud.nivel === 'crecer').slice(0, 30).map(c => ({ id: c.id, nombre: c.nombre, motivos: c.salud.motivos, kgMes: c.kgMes, planKg: c.planKg })),
    renovaciones: cl.renovaciones.slice(0, 30).map(c => ({ id: c.id, nombre: c.nombre, dias: c.diasVence, vencimiento: c.vencimiento, kgMes: c.kgMes, planKg: c.planKg })) }; } catch (e) { cartera = null; }
  let guardados = [];
  try { guardados = aj.reportesGuardados || []; } catch (e) { guardados = []; }
  return { ok:true, usuario: x.u, hoy: hoy, desde: d1, hasta: d2,
           formula: 'Conversión = ganadas ÷ (ganadas + perdidas), cerradas en el periodo. Ganada: Firmado o Pasado a cartera. Perdida: Rechazado.',
           resumen: { nuevas: pros.filter(p => enP(creada(p))).length, ganadas: ganadas.length, perdidas: perdidas.length,
                      conversion: conv(cerradas), ciclo: ciclo(ganadas), valorGanado: crm_r_(ganadas.reduce((s, p) => s + p.valor, 0), 2),
                      abiertas: abiertas.length, valorAbierto: crm_r_(abiertas.reduce((s, p) => s + p.valor, 0), 2),
                      ponderado: crm_r_(abiertas.reduce((s, p) => s + p.ponderado, 0), 2), actividades: acts.length },
           porMes: porMes, embudo: embudo,
           pronostico: Object.keys(pron).sort().map(k => ({ mes: k, n: pron[k].n, valor: crm_r_(pron[k].valor, 2), ponderado: crm_r_(pron[k].ponderado, 2) })),
           porAsesor: agrupar('asesor', 'Sin asesor'), porFuente: agrupar('fuente', 'Sin fuente'),
           porSector: agrupar('sector', 'Sin sector'), porServicio: agrupar(p => p.tipoServicio, 'RECURRENTE'),
           motivosPerdida: Object.keys(motivos).map(k => ({ motivo: k, n: motivos[k] })).sort((a, b) => b.n - a.n),
           perdidas: perdidas.map(p => ({ codigo: p.codigoPropuesta, empresa: p.empresa, motivo: crm_txt_(p['motivo perdida']), valor: p.valor, fecha: cierre(p), asesor: p.asesor, fuente: p.fuente })),
           ganadasLista: ganadas.map(p => ({ codigo: p.codigoPropuesta, empresa: p.empresa, valor: p.valor, fecha: cierre(p), asesor: p.asesor, fuente: p.fuente })),
           actividades: { total: acts.length, porTipo: porTipo, porUsuario: porUsuario },
           cartera: cartera, guardados: guardados };
}

