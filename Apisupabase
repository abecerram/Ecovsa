/* ══════════ EL LIBRO EN MEMORIA ══════════
   Cada pedido trae de la base las hojas que usa y arma con ellas un
   "libro" en memoria que se comporta como la hoja de Google: filas,
   columnas, getRange, appendRow, setValue… Al terminar, se comparan con
   lo que se trajo y solo lo que cambió se guarda. */
let _LIBRO = null;        // hojas cargadas en este pedido
let _EXISTEN = new Map(); // todas las hojas de la base: nombre -> columnas
let _PEPPER = null;
let _VERSION = null;      // versión de los datos cuando se leyeron
let _CLAVE_TAREAS = null;
