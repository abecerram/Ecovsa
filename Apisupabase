  if (d.meta) {
    const tx = cal_t_(d.meta.texto, 80) || R.meta.texto, ms = mesOk(d.meta.mes) ? d.meta.mes : R.meta.mes;
    if (tx !== R.meta.texto) cambios.push('meta: «' + R.meta.texto + '» → «' + tx + '»');
    if (ms !== R.meta.mes) cambios.push('fecha meta: ' + R.meta.mes + ' → ' + ms);
    R.meta = { texto: tx, mes: ms };
  }
  if (Array.isArray(d.etapas)) {
    for (const e of d.etapas) {
      const et = R.etapas.find(z => z.id === String(e.id || '')); if (!et) continue;
      const nom = cal_t_(e.nombre, 60) || et.nombre, de = mesOk(e.desde) ? e.desde : et.desde, ha = mesOk(e.hasta) ? e.hasta : et.hasta;
      if (de > ha) return { ok: false, error: et.nombre + ': el mes de inicio queda después del final.' };
      if (nom !== et.nombre) cambios.push('etapa «' + et.nombre + '» se llama «' + nom + '»');
      if (de !== et.desde || ha !== et.hasta) cambios.push(nom + ': ' + et.desde + '…' + et.hasta + ' → ' + de + '…' + ha);
      const h = e.hecha === undefined ? !!et.hecha : !!e.hecha;
      if (h !== !!et.hecha) { cambios.push(nom + (h ? ': marcada como hecha' : ': vuelve a estar pendiente')); et.hechaEn = h ? cal_ahora_() : ''; et.hechaPor = h ? x.u.nombre : ''; }
      Object.assign(et, { nombre: nom, desde: de, hasta: ha, hecha: h });
    }
  }
  if (!cambios.length) return { ok: true, sinCambios: true };
  PropertiesService.getScriptProperties().setProperty(cal_cfg_().rutaProp, JSON.stringify(R));
  cal_his_(x.u, 'Cambió la ruta', cambios.join(' · '));
  return { ok: true, ruta: R, antes: antes.meta };
}

