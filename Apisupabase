function cta_n_(v) { const x = Number(String(v == null ? '' : v).replace(/,/g, '')); return isFinite(x) ? x : 0; }

function cta_r2_(v) { return Math.round((Number(v) || 0) * 100) / 100; }

function cta_txt_(v, n) { return String(v == null ? '' : v).replace(/^'/, '').replace(/\s+/g, ' ').trim().slice(0, n || 200); }

function cta_id_(p) { return p + Utilities.getUuid().replace(/-/g, '').slice(0, 6).toUpperCase(); }

function tar_() {
  const t = JSON.parse(JSON.stringify(TAR_BASE));
  const r = crm_filas_(HOJA_CRM_AJU).find(x => crm_txt_(x.clave) === 'tarifario');
  if (r) {
    try {
      const g = JSON.parse(String(r.valor).replace(/^'/, ''));
      Object.keys(g).forEach(k => { t[k] = g[k]; });
      t.ejemplo = false; t.cambiadoPor = crm_txt_(r.cambiadoPor); t.cambiadoEn = crm_txt_(r.cambiadoEn);
    } catch (e) {}
  }
  TAR_ZONAS.forEach(z => { if (t.zonas[z] == null) t.zonas[z] = TAR_BASE.zonas[z]; });
  /* api 3.13: el 200 era el valor de antes; la regla nueva es 100 kg. Las sedes ya no cuentan. */
  if (!(cta_n_(t.granDesdeKg) > 0) || cta_n_(t.granDesdeKg) === 200) t.granDesdeKg = 100;
  delete t.granDesdeSedes;
  return t;
}

function tar_historial_() {
  const r = crm_filas_(HOJA_CRM_AJU).find(x => crm_txt_(x.clave) === 'tarifario historial');
  try { return r ? JSON.parse(String(r.valor).replace(/^'/, '')) || [] : []; } catch (e) { return []; }
}

