/* datos = {folio, representanteLegal:{nombre,nacionalidad,documento,genero:'M'|'F'},
   datosBancarios:{banco,titular,tipo,cuenta?}, correosNotificacion:[…]}
   `datosBancarios.cuenta` solo viene si se cambia. */
function api_empresaGuardar(pin, datos) {
  const e = entrar313_(pin, 'admin'); if (e.error) return e.error;
  datos = datos || {};
  const g = empresaGuardada313_();
  const rl = datos.representanteLegal || g.representanteLegal, db = datos.datosBancarios || {};
  const correos = (datos.correosNotificacion != null ? datos.correosNotificacion : g.correosNotificacion);
  const lista = (Array.isArray(correos) ? correos : String(correos).split(/[,;\s]+/)).map(x => String(x).trim()).filter(Boolean);
  const malo = lista.filter(c => !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(c));
  if (malo.length) return { ok: false, error: 'Revisa el correo: ' + malo.join(', ') };
  const gen = String((datos.representanteLegal || {}).genero || '').trim().toUpperCase().slice(0, 1);
  if (datos.representanteLegal && gen && gen !== 'M' && gen !== 'F') return { ok: false, error: 'El género del representante va como M o F.' };
  let cuenta = null;
  if (db.cuenta != null && String(db.cuenta).trim() !== '') {
    cuenta = String(db.cuenta).trim();
    if (!/^[0-9][0-9\- ]{4,30}$/.test(cuenta)) return { ok: false, error: 'El número de cuenta solo lleva números y guiones.' };
  }
  const nuevo = {
    folio: String(datos.folio != null ? datos.folio : g.folio).trim(),
    representanteLegal: { nombre: String(rl.nombre || '').trim(), nacionalidad: String(rl.nacionalidad || '').trim(),
      documento: String(rl.documento || '').trim(), genero: String(rl.genero || '').trim().toUpperCase().slice(0, 1) },
    datosBancarios: { banco: String(db.banco != null ? db.banco : g.datosBancarios.banco).trim(),
      titular: String(db.titular != null ? db.titular : g.datosBancarios.titular).trim(),
      tipo: String(db.tipo != null ? db.tipo : g.datosBancarios.tipo).trim() },
    correosNotificacion: lista, cambiadoPor: e.u.nombre, cambiadoEn: ahora313_()
  };
  return candado313_(() => {
    const pr = PropertiesService.getScriptProperties();
    pr.setProperty(PROP_EMPRESA_313, JSON.stringify(nuevo));
    if (cuenta) pr.setProperty(PROP_EMPRESA_CUENTA_313, cuenta);
    /* al historial va QUÉ cambió, nunca el número de cuenta */
    historialDoc313_(e.u, { doc: 'empresa', accion: 'empresa', titulo: 'Datos de la empresa',
      resumen: 'Guardó los datos de la empresa' + (cuenta ? ' (cambió la cuenta: ' + mascara313_(cuenta) + ')' : '') });
    return { ok: true };
  });
}

