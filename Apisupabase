/* ══════════ Recordar37.gs (copiado tal cual) ══════════ */
function rcd_ahora_() { return Utilities.formatDate(new Date(), tzHoja_(), 'yyyy-MM-dd HH:mm'); }

function rcd_obj_(r) {
  const cid = Number(r.clienteId) || 0;
  return { rcdId: String(r.rcdId || ''), usuario: String(r.usuario || ''), modulo: String(r.modulo || 'campo'),
           clienteId: cid, cliente: String(r.cliente || ''), texto: String(r.texto || ''),
           fecha: fechaISO_(r.fecha), estado: String(r.estado || 'PENDIENTE').toUpperCase(),
           creadoEn: fechaISO_(r.creadoEn) || '', veces: Number(r.vecesPospuesto) || 0,
           tipo: String(r.tipo || (cid ? 'cliente' : '')), ref: String(r.ref || ''), refTxt: String(r.refTxt || '') };
}

function rcd_es_(r, ctx) {
  if (!ctx) return true;
  if (typeof ctx === 'number' || /^\d+$/.test(String(ctx))) return r.clienteId === Number(ctx);
  if (ctx.tipo === 'cliente') return r.clienteId === Number(ctx.ref);
  if (r.tipo !== ctx.tipo) return false;
  if (ctx.tipo === 'ruta') return String(r.ref).split('|')[0] === String(ctx.ref).split('|')[0];
  return String(r.ref).toUpperCase() === String(ctx.ref).toUpperCase();
}

function rcd_de_(u, ctx) {
  if (!u) return [];
  const yo = String(u.nombre || '').trim();
  return cobA_leer_(HOJA_RCD).map(rcd_obj_)
    .filter(r => r.usuario.trim() === yo && r.estado === 'PENDIENTE' && rcd_es_(r, ctx))
    .sort((a, b) => a.fecha < b.fecha ? -1 : a.fecha > b.fecha ? 1 : 0);
}

function rcd_ctxDe_(r) { return r.clienteId ? r.clienteId : (r.tipo ? { tipo: r.tipo, ref: r.ref } : { tipo: '-', ref: r.rcdId }); }

function api_recordatorios(pin, tipo, ref) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (RCD_TIPOS.indexOf(String(tipo)) < 0 || !String(ref || '')) return { ok: false, error: 'Falta de qué es.' };
  return { ok: true, recordatorios: rcd_de_(u, { tipo: String(tipo), ref: String(ref) }) };
}

function api_recordar(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  d = d || {};
  const texto = String(d.texto || '').trim().replace(/\s+/g, ' ').slice(0, 300);
  const fecha = fechaISO_(d.fecha);
  if (texto.length < 3) return { ok: false, error: 'Escribe qué quieres que te recuerde.' };
  if (!fecha || !/^\d{4}-\d{2}-\d{2}$/.test(fecha)) return { ok: false, error: 'Elige el día.' };
  const hoy = hoyPanama_();
  if (fecha < hoy) return { ok: false, error: 'Ese día ya pasó.' };
  if (fecha > ini_dia_(hoy, 400)) return { ok: false, error: 'Elige un día dentro de este año.' };
  let cliente = '', cid = Number(d.clienteId) || 0;
  let tipo = RCD_TIPOS.indexOf(String(d.tipo || '')) >= 0 ? String(d.tipo) : (cid ? 'cliente' : '');
  let ref = String(d.ref || '').trim().slice(0, 80), refTxt = String(d.refTxt || '').trim().slice(0, 120);
  if (cid || tipo === 'cliente') {
    const c = leerHoja_(HOJA_CLI).find(x => Number(x.id) === cid);
    if (!c) return { ok: false, error: 'No encontré ese cliente.' };
    cliente = String(c.nombre || ''); tipo = 'cliente'; ref = String(cid);
  } else if (tipo === 'ruta') {
    if (!/^\d{4}-\d{2}-\d{2}/.test(ref)) return { ok: false, error: 'Falta el día de la ruta.' };
  } else if (tipo === 'camion') {
    if (!ref) return { ok: false, error: 'Falta el camión.' };
    ref = ref.toUpperCase();
  }
  const modulo = ['campo', 'alta', 'planta', 'cobros', 'inicio'].indexOf(String(d.modulo || '')) >= 0 ? String(d.modulo) : 'campo';
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = cobA_hoja_(HOJA_RCD, COLS_RCD);
    const rcdId = 'RC-' + Date.now().toString(36).toUpperCase();
    cobA_agregar_(h, { rcdId: rcdId, usuario: u.nombre, modulo: modulo, clienteId: cid || '', cliente: cliente, texto: texto,
                       fecha: fecha, estado: 'PENDIENTE', creadoEn: rcd_ahora_(), hechoEn: '', vecesPospuesto: 0,
                       tipo: tipo, ref: ref, refTxt: refTxt });
    return { ok: true, rcdId: rcdId, recordatorios: rcd_de_(u, cid || (tipo ? { tipo: tipo, ref: ref } : { tipo: '-', ref: rcdId })) };
  } finally { lock.releaseLock(); }
}

function api_recordatorioAccion(pin, rcdId, accion) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const r = cobA_leer_(HOJA_RCD).map(rcd_obj_).find(x => x.rcdId === String(rcdId || ''));
  if (!r || r.usuario.trim() !== String(u.nombre).trim()) return { ok: false, error: 'No encontré ese recordatorio.' };
  if (r.estado !== 'PENDIENTE') return { ok: true, yaEstaba: true, recordatorios: rcd_de_(u, rcd_ctxDe_(r)) };
  const hoy = hoyPanama_();
  let cambios;
  if (accion === 'hecho') cambios = { estado: 'HECHO', hechoEn: rcd_ahora_() };
  else if (accion === 'borrar') cambios = { estado: 'BORRADO', hechoEn: rcd_ahora_() };
  else if (accion === 'manana') cambios = { fecha: ini_dia_(r.fecha > hoy ? r.fecha : hoy, 1), vecesPospuesto: r.veces + 1 };
  else return { ok: false, error: 'Acción no válida.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    cobA_cambiar_(cobA_hoja_(HOJA_RCD, COLS_RCD), 'rcdId', r.rcdId, cambios);
    return { ok: true, recordatorios: rcd_de_(u, rcd_ctxDe_(r)) };
  } finally { lock.releaseLock(); }
}


/* ══════════ Reponer.gs (copiado tal cual) ══════════ */
function rep_filas_() {
  return crm_filas_(HOJA_REP).filter(r => crm_txt_(r.repId) && String(r.activo || 'SI').toUpperCase() !== 'NO').map(r => ({
    repId: crm_txt_(r.repId), clienteId: crm_txt_(r.clienteId), clienteNombre: crm_txt_(r.clienteNombre), catId: crm_txt_(r.catId),
    nombre: crm_txt_(r.nombre), insumoId: crm_txt_(r.insumoId), cantidad: Math.max(0, Number(r.cantidad) || 0),
    cada: REP_CADA[crm_txt_(r.cada)] ? crm_txt_(r.cada) : 'mes', ref: crm_txt_(r.ref), nota: crm_txt_(r.nota),
    revisado: crm_txt_(r.porRevisar).toUpperCase() !== 'SI', cambiadoPor: crm_txt_(r.cambiadoPor), cambiadoEn: crm_txt_(r.cambiadoEn),
