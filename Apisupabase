    delPlan: s.delPlan === true, dePromo: s.dePromo === true };
  if (s.promoId) o.promoId = cta_txt_(s.promoId, 30);
  return o;
}

function cta_calcular_(c, T, CAT, exento) {   // api 3.23: exento de ITBMS → sin ITBMS
  T = T || tar_();
  const catPor = {}; (CAT || cat_lista_(true)).forEach(x => catPor[x.id] = x);
  const todas = [];
  (c.grupos || []).forEach(g => (g.sedes || []).forEach(s => todas.push(s)));
  const kgTotal = cta_r2_(todas.reduce((a, s) => a + cta_n_(s.kgMes), 0));
  const pk = tar_precioKg_(T, kgTotal);
  let subtotal = 0, visitasTot = 0, refTot = 0;
  const grupos = (c.grupos || []).map(g => {
    let refMes = 0, visitas = 0, kg = 0;
    const sedes = (g.sedes || []).map(s => {
      const plan = tar_plan_(T, cta_n_(s.kgMes), s.anatomo);
      const vis = g.aSolicitud ? (s.visitas == null ? 1 : s.visitas) : (s.visitas == null ? plan.visitas : s.visitas);
      const kgVisita = vis > 0 ? cta_r2_(cta_n_(s.kgMes) / vis) : cta_n_(s.kgMes);
      const via = tar_viaje_(T, s.zona, cta_n_(s.km));
      const bruto = cta_r2_(kgVisita * pk.precio + via.total);
      const min = g.aSolicitud ? cta_n_(T.minimoSolicitud) : cta_n_(T.minimoRuta);
      const porVisita = Math.max(bruto, min);
      const mes = cta_r2_(porVisita * vis);
      refMes += mes; visitas += vis; kg += cta_n_(s.kgMes);
      return Object.assign({}, s, { plan: plan, visitasCalc: vis, kgVisita: kgVisita, viaje: via, refVisita: cta_r2_(porVisita), minimo: porVisita > bruto, refMes: mes });
    });
    refMes = cta_r2_(refMes);
    const n = sedes.length;
    const servicios = (g.servicios || []).map(s => {
      const cat = catPor[s.catId] || {};
      const porSede = s.cantidad === 'solicitud' ? 0 : cta_n_(s.cantidad);
      const cant = s.cada === 'visita' ? cta_r2_(porSede * visitas) : cta_r2_(porSede * n);
      /* api 3.13: lo que no es de cada mes se cobra repartido al mes */
      const meses = s.cada === 'visita' ? 1 : (MESES_CADA_313[s.cada] || 1);
      const total = s.modo === 'cobrado' && s.cantidad !== 'solicitud' ? cta_r2_(cant * cta_n_(s.precio) / meses) : 0;
      return Object.assign({}, s, { nombreCat: cat.nombre || s.nombre, insumoId: s.insumoId || cat.insumoId || '', quien: s.quien || cat.quien || '', tipo: s.tipo || cat.tipo || '', stock: cat.stock, activoCat: cat.activo !== false, cantidadMes: cant, total: total });
    });
    const serv = cta_r2_(servicios.reduce((a, s) => a + s.total, 0));
    /* api 3.13: si el grupo tiene plan, el precio al mes es precio del plan × visitas × sedes */
    const pg313 = planDeGrupo313_(g, n);
    const precio = g.precio == null ? (pg313 ? pg313.precioMes : refMes) : g.precio;
    const dif = refMes > 0 ? Math.round((precio - refMes) / refMes * 1000) / 10 : 0;
    const total = cta_r2_(precio + serv);
    subtotal += total; visitasTot += visitas; refTot += refMes;
    const kgInc = g.kgIncluidos == null ? (pg313 ? pg313.kgIncluidos : Math.round(kg)) : g.kgIncluidos;
    const cg = Object.assign({}, g, { sedes: sedes, servicios: servicios, refMes: refMes, precioFinal: cta_r2_(precio), diferencia: dif, serviciosMes: serv,
      total: total, visitasMes: cta_r2_(visitas), kgMes: cta_r2_(kg), kgIncluidosCalc: kgInc });
    if (pg313) { cg.plan = pg313.plan; cg.kgIncluidos313 = pg313.kgIncluidos; if (pg313.kgAdicional != null) cg.kgAdicional = pg313.kgAdicional; }
    return cg;
  });
  subtotal = cta_r2_(subtotal);
  const itbms = exento ? 0 : cta_r2_(subtotal * cta_n_(T.itbms || 0.07));
  return { exento: !!exento, grupos: grupos, kgTotal: kgTotal, precioKg: pk.precio, tramo: pk, visitasMes: cta_r2_(visitasTot), refTotal: cta_r2_(refTot),
           subtotal: subtotal, itbms: itbms, total: cta_r2_(subtotal + itbms), sedes: todas.length, kgAdicional: T.kgAdicional,
           /* api 3.13: gran generador por volumen (100 kg al mes sumando sedes) o por un plan de 100 kg o más; ya no por sedes */
           sugerirGran: kgTotal >= (cta_n_(T.granDesdeKg) || 100) || grupos.some(g => g.plan && g.plan.gran),
           granGenerador: { sugerido: kgTotal >= (cta_n_(T.granDesdeKg) || 100) || grupos.some(g => g.plan && g.plan.gran),
                            kgMes: kgTotal, umbral: cta_n_(T.granDesdeKg) || 100, porPlan: grupos.some(g => g.plan && g.plan.gran) } };
}

function cta_frecuenciaDe_(vis) {
