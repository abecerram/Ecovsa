function permiso_(u, modulo) {
  if (!u) return 'no';
  if (u.rol === 'admin') return 'trabaja';
  const fila = cfg_().matriz[modulo];
  const v = fila ? fila[u.rol] : 'n';
  return v === 't' || v === 'r' ? 'trabaja' : v === 'v' ? 've' : 'no';
}

