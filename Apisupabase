function api_guardarCamion(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u) && u.rol !== 'gerente') return { ok: false, error: 'Los datos del camión los cambia logística.' };
  d = d || {};
  const placa = String(d.placa || '').trim().toUpperCase().replace(/\s+/g, '-');
  if (!placa) return { ok: false, error: 'Falta la placa.' };
  /* si todavía no hay camiones en Activos, primero se crean los de la flota:
     crear solo uno haría que Flota dejara de ver a los otros */
  mto_asegurarActivos_(pin);
  const ya = mto_activoDe_(placa);
  if (d.nuevo && ya) return { ok: false, error: 'Ya hay un camión con la placa ' + placa + '.' };
  if (!d.nuevo && !ya) return { ok: false, error: 'No encontré el camión ' + placa + '.' };
  const est = String(d.estado || 'Activo');
  const r = api_guardarActivo(pin, { activoId: ya ? String(ya.activoId) : '', clase: 'vehiculo', nombre: ya ? String(ya.nombre || placa) : placa,
    placa: ya ? String(ya.placa || placa) : placa, marca: String(d.marca || '').trim().slice(0, 60), anio: String(d.anio || '').trim().slice(0, 4),
    responsable: String(d.responsable || '').trim().slice(0, 60), estado: ['Activo', 'Baja'].indexOf(est) >= 0 ? est : 'Activo',
    notas: String(d.notas || '').trim().slice(0, 300) });
  if (!r || !r.ok) return r;
  let tope = null;
  if (Number(d.tope) > 0) {
    const t = api_guardarConfigLogistica(pin, { ['tope:' + placa]: Number(d.tope) });
    if (t && t.ok) tope = Number(d.tope);
  }
  let plan = 0;
  if (d.nuevo && d.conPlan) {
    const p = api_guardarPlanFlota(pin, placa, MTO_PLAN_BASE.map(t => ({ tarea: t.tarea, cadaKm: t.cadaKm || '', cadaDias: t.cadaDias || '' })));
    if (p && p.ok) plan = p.guardadas;
  }
  marcar_('logistica');
  return { ok: true, placa: placa, activoId: r.activoId, nuevo: !!d.nuevo, tope: tope, plan: plan };
}


