function cobB_id_(pre) { return pre + Date.now().toString(36).toUpperCase() + Math.floor(Math.random() * 1296).toString(36).toUpperCase(); }

function avisoGerencia_(tipo, titulo, detalle, u, modulo, ref) {
  try {
    const h = cobA_hoja_(HOJA_AVG, COLS_AVG);
