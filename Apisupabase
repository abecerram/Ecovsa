}
async function _gooPost(url, headers, cuerpo) {
  let res;
  try { res = await fetch(url, { method: 'POST', headers: Object.assign({ 'content-type': 'application/json' }, headers), body: JSON.stringify(cuerpo) }); }
  catch (e) { throw new Error('GOO_RED:' + ((e && e.message) || e)); }
  const t = await res.text(); let j = null; try { j = JSON.parse(t); } catch (e) { j = null; }
  if (!res.ok) { const er = (j && j.error) || {}; throw new Error('GOO_' + (er.status || res.status) + ':' + (er.message || t.slice(0, 200))); }
