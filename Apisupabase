function dirB_mesesAtras_(hoy, n) {
  let y = Number(hoy.slice(0, 4)), m = Number(hoy.slice(5, 7)) - n;
  while (m < 1) { m += 12; y--; }
  return y + '-' + ('0' + m).slice(-2);
}

function dirB_dias_(a, b) {
  if (!a || !b) return 0;
  return Math.round((new Date(b + 'T00:00:00') - new Date(a + 'T00:00:00')) / 86400000);
}

function dirB_solicitudesResumen_(R, hoy) {
  const t = { porPagar:0, montoPorPagar:0, porAprobar:0, montoPorAprobar:0, pasanAviso:0,
              urgentes:0, pagadasMes:0, montoPagadoMes:0, viejas:0 };
  const mes = hoy.slice(0, 7);
  leerHoja_(HOJA_SP).forEach(s => {
    if (!String(s.solicitudId || '').trim()) return;
    const e = String(s.estado || '').toUpperCase(), tot = Number(s.total) || 0;
    if (spPorPagar_(e, R)) {
      t.porPagar++; t.montoPorPagar += tot;
      if (dirB_dias_(fechaISO_(s.fechaSolicitud) || fechaISO_(s.fecha), hoy) > DIRB_DIAS_POR_PAGAR) t.viejas++;
    } else if (e === 'SOLICITADA') { t.porAprobar++; t.montoPorAprobar += tot; }
    if ((e === 'SOLICITADA' || e === 'APROBADA') && R.aviso > 0 && tot >= R.aviso) t.pasanAviso++;
    if ((e === 'SOLICITADA' || e === 'APROBADA') && String(s.urgencia || '').toUpperCase() === 'URGE') t.urgentes++;
    if (e === 'PAGADA' && String(fechaISO_(s.fechaPago) || '').slice(0, 7) === mes) { t.pagadasMes++; t.montoPagadoMes += tot; }
  });
  ['montoPorPagar', 'montoPorAprobar', 'montoPagadoMes'].forEach(k => { t[k] = Math.round(t[k] * 100) / 100; });
  return t;
}

function dirB_revisar_(R, hoy) {
  const out = [];
  const lineas = {};
  leerHoja_(HOJA_SPD).forEach(l => {
    const id = String(l.solicitudId || '').trim().toUpperCase();
    if (id) (lineas[id] = lineas[id] || []).push(l);
  });
  const anio = hoy.slice(0, 4);
  const pagadoA = {};

  leerHoja_(HOJA_SP).forEach(s => {
    const id = String(s.solicitudId || '').trim().toUpperCase();
    if (!id) return;
    const e = String(s.estado || '').toUpperCase(), tot = Number(s.total) || 0;
    const f = fechaISO_(s.fechaSolicitud) || fechaISO_(s.fecha);
    const prov = String(s.proveedor || '').trim();
    if (spPorPagar_(e, R)) {
      const d = dirB_dias_(f, hoy);
      if (d > DIRB_DIAS_POR_PAGAR)
        out.push({ tipo:'vieja', id:id, titulo: id + ' lleva ' + d + ' días por pagar',
                   detalle: prov + ' · pedida por ' + String(s.solicitadoPor || '—') + ' el ' + f,
                   monto: tot, dias: d, orden: 1000 + d });
    }
    if (e === 'PAGADA') {
      const fp = fechaISO_(s.fechaPago) || f;
      if (String(fp).slice(0, 4) === anio) {
        const L = lineas[id] || [];
        const sinCuenta = !L.length || L.some(l => !String(l.cuentaCodigo || '').trim());
        const sinProy = !String(s.proyecto || '').trim();
        if (sinCuenta || sinProy)
          out.push({ tipo:'sinDatos', id:id,
            titulo: id + ' se pagó sin ' + (sinCuenta && sinProy ? 'cuenta contable ni proyecto' : sinCuenta ? 'cuenta contable' : 'proyecto'),
            detalle: prov + ' · pagada el ' + fp + ' · no se sabe a qué gasto cargarla',
            monto: tot, orden: 500 });
        const k = normProv_(prov);
        if (k) pagadoA[k] = { nombre: prov, monto: ((pagadoA[k] || {}).monto || 0) + tot, n: ((pagadoA[k] || {}).n || 0) + 1 };
      }
    }
  });

  /* proveedores a los que se les paga y que no tienen cuenta habitual */
  const sinCta = [];
  leerHoja_(HOJA_PROV).forEach(p => {
    const nom = String(p.proveedor || '').trim();
    if (!nom || String(p.activo || 'SI').toUpperCase() === 'NO') return;
    if (String(p.cuentaCodigo || '').trim()) return;
    const pg = pagadoA[normProv_(nom)];
    sinCta.push({ nombre: nom, monto: pg ? pg.monto : 0, n: pg ? pg.n : 0 });
  });
  sinCta.sort((a, b) => b.monto - a.monto);
  if (sinCta.length)
    out.push({ tipo:'provSinCuenta', id:'', titulo: sinCta.length + ' proveedor(es) sin cuenta contable habitual',
      detalle: 'Al pedirles un pago la cuenta no se pega sola. ' +
        sinCta.slice(0, 3).map(x => x.nombre + (x.monto ? ' (B/. ' + x.monto.toFixed(2) + ' este año)' : '')).join(', ') + (sinCta.length > 3 ? '…' : ''),
      monto: 0, orden: 100, lista: sinCta.slice(0, 50) });

  out.sort((a, b) => b.orden - a.orden);
  return out;
}

function api_dirSolicitudes(pin, filtro) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok:false, error:'PIN no válido', requiereLogin:true };
  if (!puedeVer_(u, 'finanzas')) return { ok:false, error:'Finanzas no está en los módulos de tu rol.' };
