  /* api 3.19: Cobros puede abrir el comprobante de pago que subió el cliente en el portal (solo ese tipo de archivo) */
  const puede = a.ambito === 'flota' ? (esSupervisor_(u) || ['admin', 'gerente'].indexOf(u.rol) >= 0)
    : (arc_puedeVerCliente_(u) || (String(a.doc || '') === 'Comprobante de pago (portal)' && esCobros_(u)));
  if (!puede) return { ok: false, error: 'Sin permiso para ver este archivo.' };
