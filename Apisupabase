function sst_personaPoner_(res, datos, x) {
  const ahora = "'" + sst_ahora_();
  if (res.fila) { actualizar313_(res.t, res.fila._fila, { datos: JSON.stringify(datos), cambiadoPor: x.u.nombre, cambiadoEn: ahora }); return; }
