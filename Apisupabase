}

/* Poner al cliente en la ruta de un día: la elegida, el borrador del día o la única que haya; si no hay, una nueva en borrador */
function alt_ponerEnRuta_(u, cid, fecha, rutaId) {
  const rutas = plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.fecha === fecha);
  const ya = rutas.find(r => r.paradas.some(p => p.clienteId === cid));
  if (ya) return Object.assign({}, ya, { nueva: false });
  let dest = rutas.find(r => r.rutaId === String(rutaId || '')) || rutas.find(r => r.estadoPlan === 'borrador') || rutas.find(r => !r.estadoRuta) || null, nueva = false;
  if (!dest) {
    const ult = plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.fecha < fecha).sort((a, b) => b.fecha.localeCompare(a.fecha))[0] || {};
    let veh = ult.vehiculo || ''; if (!veh) { try { veh = vehiculosFlota_()[0].placa; } catch (e) { veh = VEHICULOS_BASE[0]; } }
    dest = { rutaId: 'R' + new Date().getTime(), fecha: fecha, conductor: ult.conductor || (operadoresActivos_()[0] || ''), vehiculo: veh, estadoPlan: 'borrador' };
    nueva = true;
  }
  plan_agregar_(dest.rutaId, fecha, dest.conductor, dest.vehiculo, dest.estadoPlan, [{ clienteId: cid, origen: 'unica' }], u);
  if (nueva) rinf_guardar_(dest.rutaId, { fecha: fecha, conductor: dest.conductor, vehiculo: dest.vehiculo, estadoPlan: 'borrador', tipo: 'recoleccion', por: u.nombre, en: new Date() });
  marcar_('logistica');
  return Object.assign({}, dest, { nueva: nueva });
}

/* Devolver con casillas: Mercadeo ve en rojo lo que tiene que corregir */
