  pon(c.logistica);
  if (['derrame', 'lesion', 'choque', 'seguridad', 'otra'].indexOf(tipo) >= 0) pon(c.gerencia);
  if (tipo === 'mala' || tipo === 'norecolectada') pon(c.mercadeo);
  return l;
}

function api_incConfig(pin) {
