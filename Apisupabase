/* «Altas enviadas»: cada cliente que Mercadeo mandó a Logística y en qué va, hasta su primera recolección */
const ALT_ETAPAS = ['Enviada', 'Revisión de Logística', 'Aprobada', 'En planificación', 'Primera recolección'];
function api_altasEnviadas(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['mercadeo', 'supervisor', 'admin', 'gerente'].indexOf(u.rol) < 0) return { ok: false, error: 'Esta pantalla es de Mercadeo.' };
  const hoy = hoyPanama_(), mes = hoy.slice(0, 7), desde = ini_dia_(hoy, -120);
  const CLI = leerHoja_(HOJA_CLI), REC = leerHoja_(HOJA_REC), P = cli_plan_(CLI, REC, hoy);
  const porId = {}, porNom = {};
  CLI.forEach(c => { const id = Number(c.id); if (!id) return; porId[id] = c; porNom[String(c.nombre || '').trim().toUpperCase()] = c; });
  const rutas = plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.fecha >= hoy);
  const ACT = tab_try_(() => crm_filas_(HOJA_CRM_ACT), []);
  const TAR = tab_try_(() => crm_filas_(HOJA_CRM_TAR).map(crm_tarea_), []);
  const mia = s => u.rol === 'mercadeo' ? String(s.registradoPor || '').trim().toLowerCase() === String(u.nombre).trim().toLowerCase() : true;
  const out = [];
  leerHoja_(HOJA_SOL).forEach(s => {
    if (!crm_txt_(s.solicitudId) || !mia(s) || crm_txt_(s.reenviadaComo)) return;
    const est = String(s.estado || '').toUpperCase(), env = fechaISO_(s.fechaSolicitud), proc = fechaISO_(s.procesadaEn);
    const unica = esVisitaUnica_({ tipoServicio: s.tipoServicio, frecuencia: s.frecuencia });
    const cli = crm_txt_(s.clienteId) ? porId[Number(s.clienteId)] : (est === 'APROBADA' ? porNom[String(s.empresa || '').trim().toUpperCase()] : null);
    const cid = cli ? Number(cli.id) : 0, pl = cid ? P.plan[cid] : null;
    const existente = !!crm_txt_(s.cambiosFicha);
    const a = Object.assign(mapSolicitud_(s), { solicitudId: crm_txt_(s.solicitudId), empresa: crm_txt_(s.empresa), clienteId: cid || '', existente: existente, unica: unica,
      frecuencia: crm_txt_(s.frecuencia).toLowerCase(), fechaPedida: alt_fecha_(s.fechaPedida), enviada: env, enviadaTxt: ini_fechaTxt_(env),
      codigoPropuesta: crm_txt_(s.codigoPropuesta), procesadaPor: crm_txt_(s.procesadaPor), procesadaTxt: proc ? ini_fechaTxt_(proc) : '', procesadaISO: proc || '',
      motivo: crm_txt_(s.motivo), corregir: crm_txt_(s.corregir).split(',').filter(k => ALT_CORREGIR[k]).map(k => ({ k: k, t: ALT_CORREGIR[k] })),
      direccion: crm_txt_(s.direccion), contacto: crm_txt_(s.contacto), celular: crm_txt_(s.celular || s.telefono), zona: crm_txt_(s.zona),
      planCosto: s.planCosto === '' ? '' : Number(s.planCosto) || '', planKg: s.planKg === '' ? '' : Number(s.planKg) || '', tarifaKgAdic: s.tarifaKgAdic === '' ? '' : Number(s.tarifaKgAdic) || '',
      tipoServicio: crm_txt_(s.tipoServicio), kgMax: s.kgMax === '' ? '' : Number(s.kgMax) || '', inicioRecoleccion: alt_fecha_(s.inicioRecoleccion),
      vistaEn: crm_txt_(s.vistaEn) });
    let cf = {}; try { cf = JSON.parse(String(s.cambiosFicha || '{}')) || {}; } catch (e) { cf = {}; }
    a.adicional = !!cf._adicional;
    a.desc = (existente ? 'Cliente que ya existe' : 'Cliente nuevo') + ' · ' + (unica ? (a.adicional ? 'visita adicional' : 'visita única') + (a.fechaPedida ? ' · pedida para el ' + ini_fechaTxt_(a.fechaPedida) : '') : 'recurrente' + (a.frecuencia ? ' ' + a.frecuencia : ''));
    if (est === 'PENDIENTE') {
      Object.assign(a, { g: 'log', estado: 'Con Logística', tono: 'warn', paso: 1, marca: 'a',
        que: unica && a.fechaPedida ? 'Esperando que Logística la revise y la ponga en la ruta del ' + ini_fechaTxt_(a.fechaPedida) + '. Te avisa al aprobarla.' : 'Esperando que Logística la revise. Te avisa al aprobarla.' });
      a.desc += ' · enviada el ' + a.enviadaTxt;
    } else if (est === 'DEVUELTA') {
      Object.assign(a, { g: 'accion', estado: 'Devuelta', tono: 'bad', paso: 1, marca: 'm', dev: true,
        que: 'Te la devolvió ' + (a.procesadaPor || 'Logística') + (a.procesadaTxt ? ' el ' + a.procesadaTxt : '') + '. Está detenida hasta que la corrijas.' });
      a.desc += ' · enviada el ' + a.enviadaTxt;
    } else if (est === 'APROBADA') {
      if (proc && proc < desde && !(pl && !pl.ultimaReal)) return;
      const rf = alt_fecha_(s.rutaFecha), av = alt_fecha_(s.avisadaFecha);
      const enRuta = r => r.paradas.some(p => p.clienteId === cid);
      /* la visita única (o adicional) es la de SU fecha; la recurrente, la primera ruta que la tenga */
      const ruta = !cid ? null : unica
        ? (rutas.find(r => r.rutaId === crm_txt_(s.rutaId) && enRuta(r)) || rutas.filter(r => enRuta(r) && (r.fecha === rf || r.fecha === av || r.fecha === a.fechaPedida))[0] || null)
        : rutas.filter(enRuta).sort((x, y) => x.fecha.localeCompare(y.fecha))[0] || null;
      const dia = unica ? (rf || av || a.fechaPedida || proc) : proc;
      const arranco = pl && pl.ultimaReal && (!dia || pl.ultimaReal >= dia);
      const prox = pl ? pl.proxima : '', avisada = alt_fecha_(s.avisadaFecha);
      a.desc += ' · aprobada el ' + (a.procesadaTxt || '—');
      if (arranco) Object.assign(a, { g: 'marcha', estado: 'Ya arrancó', tono: 'gris', paso: 5, marca: 'h', mesArranque: String(pl.ultimaReal).slice(0, 7) === mes,
        que: 'Primera recolección hecha el ' + ini_fechaTxt_(pl.ultimaReal) + '. Ya es un cliente en marcha.' });
      else if (ruta) Object.assign(a, { g: 'plan', estado: 'En planificación', tono: 'ok', paso: 4, marca: 'a', rutaFecha: ruta.fecha,
        que: (unica ? 'Visita' : 'Primera recolección') + ' el ' + ini_fechaTxt_(ruta.fecha) + (ruta.conductor ? ', en la ruta de ' + ruta.conductor : '') + '.' });
      else if (avisada) Object.assign(a, { g: 'log', estado: 'Fecha avisada', tono: 'info', paso: 3, marca: 'o', fechaAvisada: avisada,
        que: 'Le avisaste a Logística que empieza el ' + ini_fechaTxt_(avisada) + '. La pone en ruta; cuando la planifique sale sola de tu seguimiento.' });
      else if (prox && prox >= hoy) Object.assign(a, { g: 'log', estado: 'Aprobada', tono: 'info', paso: 3, marca: 'a',
        que: 'Prevista para el ' + ini_fechaTxt_(prox) + '. Logística la pone en ruta.' });
      else {
        const ult = ACT.filter(x => crm_txt_(x.refTipo) === 'cli' && crm_txt_(x.ref) === String(cid)).sort((x, y) => (crm_txt_(y.fecha) + crm_txt_(y.hora)).localeCompare(crm_txt_(x.fecha) + crm_txt_(x.hora)))[0];
        const sig = TAR.filter(t => t.estado === 'pendiente' && t.refTipo === 'cli' && t.ref === String(cid)).sort((x, y) => String(x.fecha).localeCompare(String(y.fecha)))[0];
        Object.assign(a, { g: 'accion', estado: 'Por iniciar', tono: 'warn', paso: 3, marca: 'o', porIniciar: true,
          ultimo: ult ? { fecha: ini_fechaTxt_(fechaISO_(ult.fecha)), tipo: crm_txt_(ult.tipo), texto: crm_txt_(ult.texto).slice(0, 160) } : null,
          siguiente: sig ? { fecha: ini_fechaTxt_(sig.fecha), titulo: sig.titulo } : null,
          que: 'Aprobado, pero el cliente aún no da la fecha de su ' + (unica ? 'visita' : 'primera recolección') + '. Te toca darle seguimiento.' });
      }
    } else return;
    if (env && env < desde && a.g !== 'accion' && a.g !== 'log') return;
    out.push(a);
  });
  const orden = { accion: 0, log: 1, plan: 2, marcha: 3 };
  out.sort((x, y) => (orden[x.g] - orden[y.g]) || String(y.enviada).localeCompare(String(x.enviada)));
  const dev = out.filter(a => a.dev && !a.vistaEn).sort((x, y) => String(y.procesadaISO).localeCompare(String(x.procesadaISO)))[0] || null;
  return { ok: true, hoy: hoy, etapas: ALT_ETAPAS, altas: out,
    cuentas: { accion: out.filter(a => a.g === 'accion').length, log: out.filter(a => a.g === 'log').length, plan: out.filter(a => a.g === 'plan').length, marcha: out.filter(a => a.g === 'marcha' && a.mesArranque).length },
    aviso: dev ? { empresa: dev.empresa, por: dev.procesadaPor, cuando: dev.procesadaTxt, corregir: dev.corregir.map(c => c.t), solicitudId: dev.solicitudId } : null };
}

/* «Ya tiene fecha»: Mercadeo le avisa a Logística la fecha de la primera recolección */
function api_altaAvisarFecha(pin, solicitudId, fecha) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['mercadeo', 'supervisor', 'admin'].indexOf(u.rol) < 0) return { ok: false, error: 'Sin permiso.' };
  const hoy = hoyPanama_();
  const F = alt_fecha_(fecha); if (!F) return { ok: false, error: 'Elige la fecha.' };
  if (F < hoy) return { ok: false, error: 'Esa fecha ya pasó.' };
  const s = alt_solicitud_(solicitudId); if (!s) return { ok: false, error: 'No encontré esa alta.' };
  if (String(s.estado || '').toUpperCase() !== 'APROBADA') return { ok: false, error: 'Esa alta todavía no está aprobada.' };
  if (String(s.registradoPor || '').trim().toLowerCase() !== String(u.nombre).trim().toLowerCase() && !esSupervisor_(u)) return { ok: false, error: 'Esa alta la envió otra persona.' };
  const CLI = leerHoja_(HOJA_CLI);
  const cli = crm_txt_(s.clienteId) ? CLI.find(c => crm_txt_(c.id) === crm_txt_(s.clienteId))
                                     : CLI.find(c => String(c.nombre || '').trim().toUpperCase() === String(s.empresa || '').trim().toUpperCase());
  if (!cli) return { ok: false, error: 'No encontré la ficha del cliente.' };
  const id = crm_txt_(cli.id), cid = Number(id), proc = fechaISO_(s.procesadaEn);
  /* solo mientras está «Por iniciar»: sin recolección hecha desde la aprobación y sin ruta puesta */
  const pl = cli_plan_(CLI, leerHoja_(HOJA_REC), hoy).plan[cid] || {};
  const hecha = !!(pl.ultimaReal && pl.ultimaReal >= (proc || hoy));
  if (hecha) return { ok: false, error: 'Ese cliente ya tuvo su recolección: ya no está por iniciar.' };
  const yaEnRuta = plan_rutas_(leerHoja_(HOJA_RUT)).some(r => r.fecha >= hoy && r.paradas.some(p => p.clienteId === cid));
  const unica = esVisitaUnica_({ tipoServicio: s.tipoServicio });
  if (yaEnRuta && !unica) return { ok: false, error: 'Logística ya lo puso en una ruta: ya no está por iniciar.' };
  if (unica && crm_txt_(s.rutaId)) return { ok: false, error: 'Esa visita ya está en la ruta del ' + ini_fechaTxt_(alt_fecha_(s.rutaFecha)) + '.' };
  let cf = {}; try { cf = JSON.parse(String(s.cambiosFicha || '{}')) || {}; } catch (e) { cf = {}; }
  const antes = alt_fecha_(s.avisadaFecha) || fechaISO_(cli.proximaVisita) || '';
  if (!cf._adicional) {
    const campos = { proximaVisita: F };
    if (!alt_fecha_(cli['inicio recoleccion'])) campos['inicio recoleccion'] = F;
    crm_cambiar_(HOJA_CLI, COLS_CLI, 'id', id, campos);
  }
  let ruta = null;
  if (unica) ruta = alt_ponerEnRuta_(u, cid, F, '');
  alt_ponerSol_(solicitudId, { avisadaFecha: F, avisadaPor: u.nombre, clienteId: id, rutaFecha: ruta ? F : '', rutaId: ruta ? ruta.rutaId : '' });
  const que = unica ? (cf._adicional ? 'visita adicional' : 'visita') : 'primera recolección';
  crm_registrarActividad_(u, { tipo: 'nota', ref: id, refTipo: 'cli', cuenta: crm_txt_(cli.nombre),
    texto: 'Ya tiene fecha de ' + que + ': ' + ini_fechaTxt_(F) + (antes && antes !== F ? ' (antes: ' + ini_fechaTxt_(antes) + ')' : '') + '. ' + (ruta ? 'Quedó en la ruta de ese día.' : 'Se le avisó a Logística.') });
  anotarPendiente_({ modulo: 'logistica', asistente: 'Altas', prioridad: 'media', tipo: 'altaFecha', referencia: String(solicitudId), clave: 'altaFecha:' + solicitudId + ':' + F,
    titulo: crm_txt_(cli.nombre) + ' ya tiene fecha: ' + ini_fechaTxt_(F),
    descripcion: ruta ? 'Mercadeo avisó la fecha de su ' + que + ' y quedó en la ruta de ese día' + (ruta.nueva ? ' (ruta nueva en borrador)' : '') + '. Revísala.' : 'Mercadeo avisó la fecha de su ' + que + '. Ponlo en la ruta de ese día.',
    enlace: '?p=plan&f=' + F });
  asis_seguro_(() => asis_alEntrar_());
  marcar_('mercadeo');
  return { ok: true, fecha: F, ruta: ruta ? { rutaId: ruta.rutaId, conductor: ruta.conductor, nueva: ruta.nueva } : null };
}

/* Seguimiento de un «Por iniciar»: anotar la llamada y, si se quiere, el próximo seguimiento */
function api_altaAnotar(pin, solicitudId, d) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  d = d || {};
