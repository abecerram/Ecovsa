}

function api_acopioConductor(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const hoy = hoyPanama_();
  const g = {};
  dl_rec_().filter(r => !String(r.acta || '').trim() && r._f <= hoy).forEach(r => {
    const resp = String(r.Responsable || '').trim(), k = dl_clave_(r._f, resp);
    const x = g[k] = g[k] || { clave: k, fecha: r._f, responsable: resp, kg: 0, bultos: 0, recibos: [], tipos: dl_tipos_(),
                               dias: ini_diasEntre_(r._f, hoy) };
    x.kg += dl_kg_(r); x.bultos += dl_bul_(r); dl_sumTipos_(x.tipos, r);
    x.recibos.push({ recibo: String(r['recibo numero'] || ''), cliente: String(r.Cliente || ''), kg: dl_r_(dl_kg_(r)) });
  });
  const grupos = Object.keys(g).map(k => { const x = g[k]; x.kg = dl_r_(x.kg); dl_redTipos_(x.tipos); x.viejo = x.dias > DL_DIAS_VIEJO; return x; })
    .sort((a, b) => (a.fecha + a.responsable).localeCompare(b.fecha + b.responsable));
  const ACT = dl_actas_().sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
  const receptores = [], destinos = ['Planta de Tratamiento Autorizada'];
  const sinTilde = t => String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
  const vistos = {};
  ACT.slice(0, 40).forEach(a => {
    const k = sinTilde(a.recibe).replace(/s/g, 'z');
    if (a.recibe && !vistos[k] && receptores.length < 4) { vistos[k] = 1; receptores.push(a.recibe); }
    if (a.destino && destinos.indexOf(a.destino) < 0) destinos.push(a.destino);
  });
  /* api 3.6: los destinos de entrega configurados van primero */
  try { destinos_().slice().reverse().forEach(d => { const i = destinos.indexOf(d.nombre); if (i >= 0) destinos.splice(i, 1); destinos.unshift(d.nombre); }); } catch (e) {}
  const mias = ACT.filter(a => u.rol !== 'operador' || a.operador.trim().toLowerCase() === u.nombre.trim().toLowerCase()).slice(0, 5)
    .map(a => ({ actaId: a.actaId, fecha: a.fecha, kg: dl_r_(a.kg), vehiculo: a.vehiculo }));
  return { ok: true, hoy: hoy, usuario: u.nombre, grupos: grupos, receptores: receptores, destinos: destinos, actas: mias, diasViejo: DL_DIAS_VIEJO };
}

function api_generarActaDias(pin, datos) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  datos = datos || {};
  const claves = {}; (datos.grupos || []).forEach(k => { if (k) claves[String(k).toLowerCase()] = 1; });
  if (!Object.keys(claves).length) return { ok: false, error: 'Marca al menos un día.' };
  const recibe = String(datos.recibe || '').trim();
  if (!recibe) return { ok: false, error: 'Falta el nombre de quien recibe en planta.' };

  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const hoy = hoyPanama_();
    const sel = dl_rec_().filter(r => !String(r.acta || '').trim() && r._f <= hoy && claves[dl_clave_(r._f, r.Responsable)]);
    if (!sel.length) return { ok: false, error: 'Esos días ya no tienen nada pendiente. Actualiza la pantalla.' };

    // totales y detalle, con la misma forma que el acta de siempre
    const s = { kgBio: 0, cantBio: 0, kgAnatomo: 0, cantAnatomo: 0, kgPunzo: 0, cantPunzo: 0, recibos: [], desde: '', hasta: '' };
    const porCli = {};
    sel.forEach(r => {
      const kb = dl_n_(r['Kg Recolectados']), ka = dl_n_(r['kg anatomopatologico']), kp = dl_n_(r['kg punzo cortantes']);
      s.kgBio += kb; s.kgAnatomo += ka; s.kgPunzo += kp;
      s.cantBio += dl_n_(r['cantidad bolsas']); s.cantAnatomo += dl_n_(r['cantidad anatomo']); s.cantPunzo += dl_n_(r['cantidad punzo cort']);
      const rec = String(r['recibo numero'] || '').trim(); if (rec) s.recibos.push(rec);
      if (!s.desde || r._f < s.desde) s.desde = r._f; if (!s.hasta || r._f > s.hasta) s.hasta = r._f;
      const c = String(r.Cliente || '(sin cliente)').trim();
      const d = porCli[c] = porCli[c] || { cliente: c, visitas: 0, kg: 0, kgBio: 0, kgAnatomo: 0, kgPunzo: 0, recibos: [] };
      d.visitas++; d.kgBio += kb; d.kgAnatomo += ka; d.kgPunzo += kp; d.kg += kb + ka + kp; if (rec) d.recibos.push(rec);
    });
    const r2 = v => Math.round(v * 100) / 100;
    const kgTotal = r2(s.kgBio + s.kgAnatomo + s.kgPunzo), bultos = s.cantBio + s.cantAnatomo + s.cantPunzo;
    const detalle = Object.keys(porCli).map(k => { const d = porCli[k]; ['kg', 'kgBio', 'kgAnatomo', 'kgPunzo'].forEach(z => d[z] = r2(d[z])); d.recibos.sort(); return d; })
      .sort((a, b) => b.kg - a.kg);

    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let hd = ss.getSheetByName(HOJA_DIS);
    if (!hd) hd = crearHoja_(ss, HOJA_DIS, COLS_DIS);
    asegurarColumnas_(hd, COLS_DIS.concat(DL_COLS_EXTRA));

    const usados = {}; leerHoja_(HOJA_DIS).forEach(r => { usados[String(r.actaId || '').trim()] = 1; });
    let actaId = '';
    const arranque = siguienteNumeroActa_(hoy);
    for (let i = 0; i < 500; i++) { const c = actaId_(hoy, arranque + i); if (!usados[c]) { actaId = c; break; } }
    if (!actaId) return { ok: false, error: 'No se pudo asignar un número de acta libre. Avísale al administrador antes de volver a intentar.' };

    const hora = Utilities.formatDate(new Date(), 'America/Panama', 'HH:mm');
    let firma = String(datos.firma || ''); if (firma.length > 45000) firma = '';
    let detTxt = JSON.stringify(detalle); if (detTxt.length > 45000) detTxt = '';
    const quien = (u.rol === 'operador') ? u.nombre : (String(datos.operador || '').trim() || u.nombre);
    hd.appendRow(filaPorNombre_(hd, {
      actaId: actaId, fecha: hoy, hora: hora, operador: quien, vehiculo: String(datos.vehiculo || ''),
      destino: String(datos.destino || 'Planta de Tratamiento Autorizada'), recibe: recibe,
      desde: s.desde, hasta: s.hasta, recibos: s.recibos.sort().join(', '),
      kgBio: r2(s.kgBio), cantBio: s.cantBio, kgAnatomo: r2(s.kgAnatomo), cantAnatomo: s.cantAnatomo,
      kgPunzo: r2(s.kgPunzo), cantPunzo: s.cantPunzo, kgTotal: kgTotal, bultos: bultos,
      observaciones: String(datos.observaciones || '').slice(0, 500), detalle: detTxt, firma: firma, registradoEn: new Date(),
      llegada: horaValida_(datos.llegada) ? String(datos.llegada) : '', salida: hora, entregadoPor: u.nombre
    }));

    // sellar solo lo marcado
    const hr = ss.getSheetByName(HOJA_REC);
    const vals = hr.getDataRange().getValues(), cab = vals[0].map(String);
    let cActa = cab.indexOf('acta');
    if (cActa < 0) { hr.getRange(1, cab.length + 1).setValue('acta'); cActa = cab.length; }
    const cResp = cab.indexOf('Responsable'), cFecha = cab.indexOf('Fecha de Recoleccion');
    const marcas = [];
    for (let i = 1; i < vals.length; i++) {
      const ya = String(vals[i][cActa] || '').trim(), f = fechaISO_(vals[i][cFecha]);
      const entra = !ya && !!f && f <= hoy && !!claves[dl_clave_(f, vals[i][cResp])];
      marcas.push([entra ? actaId : (vals[i][cActa] || '')]);
    }
    if (marcas.length) hr.getRange(2, cActa + 1, marcas.length, 1).setValues(marcas);
    marcar_('logistica');
    return { ok: true, actaId: actaId, fecha: hoy, hora: hora, kgTotal: kgTotal, bultos: bultos, recibos: s.recibos.length,
             desde: s.desde, hasta: s.hasta, tipos: { bio: r2(s.kgBio), punzo: r2(s.kgPunzo), anato: r2(s.kgAnatomo) } };
  } finally { lock.releaseLock(); }
}


/* ══════════ Enlace.gs (copiado tal cual) ══════════ */
function enl_txt_(v, n) { return String(v == null ? '' : v).replace(/^'/, '').replace(/\s+/g, ' ').trim().slice(0, n || 200); }

function enl_ahora_() { return crm_ahora_(); }

function enl_u_(p) { return { nombre: 'Enlace del cliente', rol: 'mercadeo' }; }

function funciones_() { return cfg_().funciones; }

function enl_propuestaDoc_(cod) {
  return crm_filas_(HOJA_CRM_DOC).map(crm_documento_)
    .filter(d => d.ref === cod && d.tipo === 'propuesta' && ['enviada', 'aceptada', 'firmada', 'vista'].indexOf(d.estado) >= 0)
    .sort((a, b) => String(b.creadoEn).localeCompare(String(a.creadoEn)))[0] || null;
}

function enl_hayPropuesta_(p, doc) {
  /* api 3.11: la de un gran generador vale lo que suma su cuenta */
  if (!(crm_n_(p['costo visita']) > 0) && !(cta_esGran_(p) && crm_n_(p['valor cotizado']) > 0)) return false;
  return !!doc || ENL_ETAPAS_PROPUESTA.indexOf(enl_txt_(p.estado)) >= 0;
}

function enl_vence_(p, doc) {
  if (doc && doc.validoHasta) return doc.validoHasta;
  const f = fechaISO_(p['fecha propuesta']);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(f)) return '';
  return crm_masDias_(f, Number(p['validez propuesta']) || 30);
}

function enl_docsPedidos_(p) {
  if (esVisitaUnica_(p)) return false;
  if (enl_txt_(p['enlace respuesta']) === 'acepto' || enl_txt_(p['enlace docs'])) return true;
  if (enl_txt_(p.estado) === 'Contrato en proceso') return true;
  if (enl_txt_(p['bancarios estado'])) return true;
  const cod = enl_txt_(p.codigoPropuesta);
  return arc_filas_().some(a => a.ambito === 'cliente' && a.ref === cod);
}

function enl_primeraRuta_(p) {
  const id = enl_txt_(p.clienteId); if (!id) return '';
  const hoy = hoyPanama_();
  const f = crm_filas_(HOJA_RUT).filter(r => String(r.clienteId) === id).map(r => fechaISO_(r.fecha)).filter(x => x && x >= hoy).sort()[0];
  return f || '';
}

function enl_asesor_(p) {
  const nom = enl_txt_(p.asesor);
  let tel = '';
  if (nom) {
    const u = leerHoja_(HOJA_USR).find(x => crm_clave_(x.nombre) === crm_clave_(nom));
    if (u) tel = String(u.celular || u.telefono || u.whatsapp || '').replace(/\D/g, '');
  }
  if (tel.length === 8) tel = '507' + tel;
  return { nombre: nom || 'ECOVSA', wa: /^5076\d{7}$/.test(tel) ? tel : '' };
}

function enl_estado_(p, F) {
  F = F || funciones_();
  const cod = enl_txt_(p.codigoPropuesta), est = enl_txt_(p.estado) || 'Registrado';
  const unica = esVisitaUnica_(p), resp = enl_txt_(p['enlace respuesta']);
  const doc = enl_propuestaDoc_(cod), hay = enl_hayPropuesta_(p, doc);
  const vence = hay ? enl_vence_(p, doc) : '';
  const recibido = enl_txt_(p['formulario estado']).toUpperCase() === 'RECIBIDO';
  const o = { paso: '', estadoOp: est, unica: unica, respuesta: resp, respuestaEn: enl_txt_(p['enlace respuesta en']),
              aceptoPor: enl_txt_(p['enlace acepto']), motivo: enl_txt_(p['enlace motivo']), comentario: enl_txt_(p['enlace comentario'], 500),
              pide: enl_txt_(p['enlace pide']), docsPedidos: false, propuestaEnlace: !!F.propuestaEnlace, docsEnlace: !!F.docsEnlace,
              datosRecibidos: recibido ? fechaISO_(p['formulario recibido']) || enl_txt_(p['formulario recibido']).slice(0, 10) : '',
              propuestaEnviada: doc ? String(doc.enviadoEn || doc.creadoEn).slice(0, 10) : (hay ? fechaISO_(p['fecha propuesta']) : ''),
              vence: vence, vencida: !!(vence && vence < hoyPanama_()), docs: null, primeraRecoleccion: '' };

  if (CRM_GANADAS.indexOf(est) >= 0 || (!unica && enl_txt_(p['doc contrato firmado']).toUpperCase() === 'SI' && est !== 'Rechazado')) {
    o.paso = 'bienvenida'; o.primeraRecoleccion = enl_primeraRuta_(p); return o;
  }
  if (est === 'Rechazado') { o.paso = 'noacepto'; return o; }
  const acepto = resp === 'acepto' || est === 'Contrato en proceso';
  if (acepto && unica) { o.paso = 'aceptada'; return o; }
  o.docsPedidos = !!F.docsEnlace && enl_docsPedidos_(p);
  if (o.docsPedidos) {
    const d = arc_docsCliente_(p);
    o.docs = d;
    if (d.completo) o.paso = 'contrato';
    else if (d.docs.every(x => x.estado === 'aceptado' || x.estado === 'por revisar')) o.paso = 'revision';
    else o.paso = 'documentos';
    return o;
  }
  if (acepto) { o.paso = 'contrato'; return o; }
  if (hay && F.propuestaEnlace) { o.paso = o.vencida ? 'vencida' : 'propuesta'; return o; }
  o.paso = recibido || hay ? 'espera' : 'datos';
  return o;
}

function enl_resumenPropuesta_(p) {
  const exento = esExento_(p);   // api 3.16.1
  const costo = crm_n_(p['costo visita']), itbms = exento ? 0 : (crm_n_(p.itbms) > 0 ? crm_n_(p.itbms) : 0.07);
  const unica = esVisitaUnica_(p);
  const guardadas = enl_txt_(p.notasPropuesta, 4000) ? String(p.notasPropuesta) : '';
  return {
    cod: enl_txt_(p.codigoPropuesta), unica: unica,
    frecuencia: unica ? '' : enl_txt_(p.frecuencia), kgPlan: crm_n_(p['kg plan']),
    kgAdic: crm_n_(p['tarifa kg adic']), visitaAdic: crm_n_(p['tarifa visita adic']),
    plazo: unica ? 0 : crm_n_(p['plazo contrato']), costo: costo, itbms: itbms,
    impuesto: Math.round(costo * itbms * 100) / 100, total: Math.round(costo * (1 + itbms) * 100) / 100,
    descripcion: enl_txt_(p.descripcionTrabajo, 300), fechaTentativa: fechaISO_(p.fechaTentativa), exento: exento
  };
}

function enl_paraFormulario_(p, k) {
  if (!p || !arc_llaveOk_(p.codigoPropuesta, k)) return null;
  const F = funciones_();
  const e = enl_estado_(p, F);
  e.empresa = enl_txt_(p.empresa); e.contacto = enl_txt_(p.contacto);
  e.asesor = enl_asesor_(p);
  if (e.paso === 'propuesta' || e.paso === 'vencida') {
    e.propuesta = enl_resumenPropuesta_(p);
    /* api 3.12: servicios y productos de un micro o una visita única */
    if (!cta_esGran_(p)) { const sv = tab_try_(() => srv_paraOp_(p), null); if (sv && sv.lista.length) e.servicios = sv; }
    /* api 3.11: gran generador: sus sedes (para aceptar por sede) y la forma de facturar */
    if (cta_esGran_(p)) {
      e.cuenta = tab_try_(() => cta_paraPropuesta_(p), null);
      if (e.cuenta) Object.assign(e.propuesta, { gran: true, costo: e.cuenta.subtotal, impuesto: e.cuenta.itbms, total: e.cuenta.total, sedes: e.cuenta.sedes });
      e.facturas = PAG_MODOS;
    }
  }
  e.motivos = ENL_MOTIVOS.map(m => [m[0], m[1]]);
  if (e.paso === 'documentos' || e.paso === 'revision') e.bancos = ENL_BANCOS;
  return e;
}

function api_enlacePropuesta(token, k) {
  const p = arc_prospecto_(token);
  if (!p || !arc_llaveOk_(token, k)) return { ok: false, error: 'Este enlace no es válido. Pídale a su asesora el enlace actualizado.' };
  const F = funciones_();
  if (!F.propuestaEnlace) return { ok: false, error: 'Su asesora le envía la propuesta por WhatsApp o correo.' };
  const doc = enl_propuestaDoc_(enl_txt_(p.codigoPropuesta));
  if (!enl_hayPropuesta_(p, doc)) return { ok: false, error: 'Su propuesta todavía se está preparando.' };
  const SI = ['codigoPropuesta', 'empresa', 'contacto', 'cargo', 'asesor', 'frecuencia', 'costo visita', 'itbms', 'kg plan',
    'tarifa kg adic', 'tarifa visita adic', 'validez propuesta', 'plazo contrato', 'fecha propuesta', 'fecha contacto',
    'descripcionTrabajo', 'fechaTentativa', 'cantidadEstimada', 'tipoServicio'];
  const o = {};
  SI.forEach(c => { let v = p[c]; if (/^fecha/.test(c) || c === 'fechaTentativa') v = fechaISO_(v); o[c] = v == null ? '' : String(v).trim(); });
  o.tipoServicio = tipoServicioDe_(p); o.visitaUnica = esVisitaUnica_(p); o.generador = enl_txt_(p.generador);
  const guardadas = String(p.notasPropuesta || '').trim();
  o.notas_lista = (guardadas ? guardadas.split('\n').map(x => x.trim()).filter(Boolean) : notasBase_(o)).filter(x => !esLineaVigencia_(x));
  if (cta_esGran_(p)) { o.gran = true; o['razon social'] = enl_txt_(p['razon social']); o.cuenta = tab_try_(() => cta_paraPropuesta_(p), null); }
  else { const sv = tab_try_(() => srv_paraOp_(p), null); if (sv && sv.lista.length) o.servicios = sv; }   // api 3.12
  /* la vigencia que ve el cliente es la del envío */
  let v = enl_vence_(p, doc);
  /* api 3.13: textos editables, promoción y vigencia recortada al cierre de la oferta */
  const x313 = extrasPropuesta313_(enl_txt_(p.codigoPropuesta));
  if (x313) {
    o.textos = x313.textos; o.notas_lista = x313.notas_lista; o.notas_promo = x313.notas_promo; o.promo = x313.promo; o.venceOferta = x313.venceOferta;
    if (x313.promo && x313.venceOferta && (!v || x313.venceOferta < v)) v = x313.venceOferta;
  }
  /* la primera vez que la abre, Mercadeo lo ve en la actividad */
  const cod = enl_txt_(p.codigoPropuesta), marca = (doc ? doc.id + ' v' + doc.version : 'ficha');
  if (enl_txt_(p['enlace vio']).indexOf(marca) < 0) tab_try_(() => {
    crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, { 'enlace vio': marca + ' · ' + enl_ahora_() });
    crm_registrarActividad_(enl_u_(p), { tipo: 'nota', ref: cod, refTipo: 'op', cuenta: enl_txt_(p.empresa), texto: 'El cliente abrió su propuesta desde su enlace.' });
  }, null);
  return { ok: true, cliente: true, hoy: hoyPanama_(), vence: v, prospecto: o, empresa: datosDoc_('propuesta') };
}

function api_enlaceResponder(token, k, decision, d) {
  const p = arc_prospecto_(token);
  if (!p || !arc_llaveOk_(token, k)) return { ok: false, error: 'Este enlace no es válido. Pídale a su asesora el enlace actualizado.' };
  d = d || {};
  const F = funciones_(), e = enl_estado_(p, F), cod = enl_txt_(p.codigoPropuesta), emp = enl_txt_(p.empresa);
  const u = enl_u_(p), ase = enl_txt_(p.asesor) || u.nombre, hoy = hoyPanama_(), ahora = enl_ahora_();
  const dec = enl_txt_(decision);
  const volver = () => Object.assign({ ok: true }, enl_paraFormulario_(arc_prospecto_(cod), k));

  /* pedir una propuesta actualizada (venció) o una nueva (no aceptó) */
  if (dec === 'actualizada' || dec === 'nueva') {
    if (dec === 'actualizada' && e.paso !== 'vencida') return { ok: false, error: 'Su propuesta sigue vigente.' };
    if (dec === 'nueva' && e.paso !== 'noacepto') return { ok: false, error: 'Su solicitud sigue abierta.' };
    if (e.pide && e.pide.slice(-10) === hoy) return volver();
    crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, { 'enlace pide': (dec === 'actualizada' ? 'actualizada' : 'nueva') + ' · ' + hoy });
    crm_registrarActividad_(u, { tipo: 'nota', ref: cod, refTipo: 'op', cuenta: emp,
      texto: dec === 'actualizada' ? 'El cliente pidió desde su enlace una propuesta actualizada (la anterior venció el ' + e.vence + ').'
                                   : 'El cliente pidió desde su enlace una nueva propuesta.' });
    crm_crearTarea_(u, { titulo: (dec === 'actualizada' ? 'Enviar la propuesta actualizada a ' : 'Llamar: pide una nueva propuesta · ') + emp,
      tipo: 'llamada', fecha: hoy, ref: cod, refTipo: 'op', cuenta: emp, asignado: ase });
    crm_sincronizarSeguimiento_(cod);
    marcar_('mercadeo');
    return volver();
  }

  if (e.paso !== 'propuesta') return { ok: false, error: e.paso === 'vencida' ? 'Esta propuesta venció. Pida una actualizada.' : 'Esta propuesta ya fue respondida.' };

  if (dec === 'acepto') {
    /* api 3.13: si la promoción ya cerró, sale de nuevo sin la promoción */
    if (String(p.promoId || '').trim() && fechaISO_(p.venceOferta) && hoy > fechaISO_(p.venceOferta))
      return { ok: false, error: 'La promoción de esta propuesta cerró el ' + fechaLarga313_(fechaISO_(p.venceOferta)) +
               '. Escríbanos y le enviamos la propuesta actualizada.' };
    const nom = enl_txt_(d.nombre, 90), cargo = enl_txt_(d.cargo, 90);
    if (!nom || !cargo) return { ok: false, error: 'Escriba su nombre y su cargo.' };
    if (!d.acepta) return { ok: false, error: 'Marque la casilla para confirmar que acepta.' };
    /* api 3.11: gran generador: acepta por sedes y elige cómo se le factura */
    let notaGran = '';
    if (cta_esGran_(p)) {
      const c = cta_limpiar_(cta_leer_(p)), todas = [];
      c.grupos.forEach(g => g.sedes.forEach(s => todas.push(s)));
      const elegidas = (Array.isArray(d.sedes) ? d.sedes : todas.map(s => s.id)).map(String).filter(id => todas.some(s => s.id === id));
      if (!elegidas.length) return { ok: false, error: 'Marque al menos una sede.' };
      const fac = PAG_MODOS[enl_txt_(d.facturacion)] ? enl_txt_(d.facturacion) : c.facturacion;
      const cambioFac = fac !== c.facturacion;
      c.aceptadas = elegidas; c.facturacionCliente = fac;
      if (cambioFac) { c.facturacion = fac; cta_pagadoresPara_(c, p); }
      cta_guardar_(cod, c);
      notaGran = ' Aceptó ' + elegidas.length + ' de ' + todas.length + ' sedes' + (elegidas.length < todas.length ? ' (' + todas.filter(s => elegidas.indexOf(s.id) >= 0).map(s => s.nombre).join(', ') + ')' : '') +
                 ' · factura: ' + PAG_MODOS[fac].toLowerCase() + (cambioFac ? ' (cambió la forma: revisar los contactos de cobro)' : '') + '.';
      if (cambioFac) crm_crearTarea_(u, { titulo: 'Completar los contactos de cobro (' + PAG_MODOS[fac].toLowerCase() + ') · ' + emp, tipo: 'tarea', fecha: hoy, ref: cod, refTipo: 'op', cuenta: emp, asignado: ase });
    }
    const cambios = { 'enlace respuesta': 'acepto', 'enlace respuesta en': ahora, 'enlace acepto': nom + ' · ' + cargo, 'enlace motivo': '', 'enlace comentario': '' };
    if (F.docsEnlace && !esVisitaUnica_(p)) cambios['enlace docs'] = ahora;
    crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, cambios);
    const doc = enl_propuestaDoc_(cod);
    if (doc) enl_docHistorial_(doc, 'aceptada', 'La aceptó ' + nom + ' (' + cargo + ') desde el enlace');
    enl_moverEtapa_(p, 'Contrato en proceso', { nota: 'aceptó la propuesta desde su enlace' });
    /* si estaba en stand-by, la tarea de retomarla ya no hace falta */
    crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => t.ref === cod && t.estado === 'pendiente' && /^(Retomar|Enviar la propuesta actualizada)/.test(t.titulo))
      .forEach(t => crm_cambiar_(HOJA_CRM_TAR, COLS_CRM_TAR, 'id', t.id, { estado: 'anulada', hechaEn: crm_ahora_(), resultado: 'El cliente aceptó' }));
    crm_registrarActividad_(u, { tipo: 'nota', ref: cod, refTipo: 'op', cuenta: emp, contacto: nom,
      texto: 'El cliente aceptó la propuesta desde su enlace: ' + nom + ' (' + cargo + ').' + notaGran + (cambios['enlace docs'] ? ' Su enlace ya le pide los documentos.' : '') });
    crm_crearTarea_(u, { titulo: esVisitaUnica_(p) ? 'Coordinar la fecha de la visita · ' + emp : 'Agradecer y preparar el contrato · ' + emp,
      tipo: 'llamada', fecha: hoy, ref: cod, refTipo: 'op', cuenta: emp, asignado: ase });
    crm_sincronizarSeguimiento_(cod);
    marcar_('mercadeo');
    return volver();
  }

  if (dec === 'rechazo' || dec === 'despues') {
    const m = ENL_MOTIVOS.find(x => x[0] === enl_txt_(d.motivo));
    const despues = dec === 'despues' || (m && m[0] === 'despues');
    if (!despues && !m) return { ok: false, error: 'Elija por qué, para poder cerrar la solicitud.' };
    const com = enl_txt_(d.comentario, 500);
    if (despues) {
      /* Stand-by: queda la tarea de retomarla unos días antes de que venza */
      const man = crm_masDias_(hoy, 1);
      let ret = e.vence ? crm_masDias_(e.vence, -4) : crm_masDias_(hoy, 14);
      if (ret < man) ret = man;
      crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, { 'enlace respuesta': 'despues', 'enlace respuesta en': ahora, 'enlace motivo': 'Lo decidirá más adelante', 'enlace comentario': com });
      enl_moverEtapa_(p, 'Stand-by', { retomar: ret, nota: 'lo decidirá más adelante (desde su enlace)' + (com ? ' · «' + com + '»' : '') });
      crm_crearTarea_(u, { titulo: 'Retomar antes de que venza · ' + emp, tipo: 'llamada', fecha: ret, ref: cod, refTipo: 'op', cuenta: emp, asignado: ase,
        notas: e.vence ? 'La propuesta vence el ' + e.vence + '.' : '' });
    } else {
      crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, { 'enlace respuesta': 'rechazo', 'enlace respuesta en': ahora, 'enlace motivo': m[1], 'enlace comentario': com });
      const doc = enl_propuestaDoc_(cod);
      if (doc) enl_docHistorial_(doc, 'rechazada', 'No la aceptó desde el enlace: ' + m[1].toLowerCase());
      enl_moverEtapa_(p, 'Rechazado', { motivo: m[2], nota: 'no aceptó la propuesta desde su enlace · ' + m[1].toLowerCase() + (com ? ' · «' + com + '»' : '') });
      crm_crearTarea_(u, { titulo: 'Llamar para entender ' + (m[0] === 'precio' ? 'el precio' : m[0] === 'proveedor' ? 'lo del otro proveedor' : 'por qué no aceptó') + ' · ' + emp,
        tipo: 'llamada', fecha: crm_masDias_(hoy, 1), ref: cod, refTipo: 'op', cuenta: emp, asignado: ase, notas: com ? 'Comentó: ' + com : '' });
    }
    crm_sincronizarSeguimiento_(cod);
    marcar_('mercadeo');
    return volver();
  }
  return { ok: false, error: 'Respuesta no válida.' };
}

function enl_docHistorial_(doc, estado, que) {
  const ahora = enl_ahora_();
  const hist = doc.historial.concat([{ cuando: ahora, quien: 'Cliente (enlace)', que: que + (estado && estado !== doc.estado ? ' · ' + doc.estado + ' → ' + estado : '') }]);
  crm_cambiar_(HOJA_CRM_DOC, COLS_CRM_DOC, 'id', doc.id, { estado: estado || doc.estado, historial: JSON.stringify(hist.slice(-40)) });
}

function enl_moverEtapa_(p, e, ex) {
  ex = ex || {};
  const cod = enl_txt_(p.codigoPropuesta), antes = enl_txt_(p.estado) || 'Registrado', hoy = hoyPanama_();
  if (antes === e || BLOQUEADOS_PRO.indexOf(antes) >= 0) return false;
  const datos = { estado: e, 'fecha etapa': hoy };
  datos['fecha cierre'] = CRM_GANADAS.indexOf(e) >= 0 || CRM_PERDIDAS.indexOf(e) >= 0 ? hoy : '';
  if (CRM_PERDIDAS.indexOf(e) >= 0) datos['motivo perdida'] = enl_txt_(ex.motivo);
  if (e === 'Stand-by') datos.retomar = enl_txt_(ex.retomar);
  crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod, datos);
  crm_registrarActividad_(enl_u_(p), { tipo: 'nota', ref: cod, refTipo: 'op', cuenta: enl_txt_(p.empresa),
    texto: 'Etapa: ' + antes + ' → ' + e + (ex.motivo ? ' · motivo: ' + ex.motivo : '') + (ex.nota ? ' · ' + ex.nota : '') });
  if (e === 'Stand-by' || CRM_PERDIDAS.indexOf(e) >= 0) {
    crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => t.ref === cod && t.estado === 'pendiente' && (e === 'Stand-by' || alt_tareaDeMercadeo_(t)))
      .forEach(t => crm_cambiar_(HOJA_CRM_TAR, COLS_CRM_TAR, 'id', t.id, { estado: 'anulada', hechaEn: crm_ahora_(), resultado: e === 'Stand-by' ? 'En stand-by' : 'Oportunidad perdida' }));
  }
  return true;
}

function api_enlaceBancarios(token, k, d) {
  const p = arc_prospecto_(token);
  if (!p || !arc_llaveOk_(token, k)) return { ok: false, error: 'Este enlace no es válido.' };
