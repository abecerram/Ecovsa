    /* el distintivo de cada sede queda entregado */
    const tc = tabla313_(HOJA_CLI, COLS_DIST);
    sedes.forEach(c => { const f = tc.filas.find(z => String(z.id).trim() === String(c.id).trim()); if (f) actualizar313_(tc, f._fila, { distintivoEntregado: "'" + hoyPanama_(), distintivoPor: x.u.nombre }); });
    try { crm_registrarActividad_(x.u, { tipo: 'nota', ref: String(sedes[0].id).trim(), refTipo: 'cli', cuenta: String(sedes[0].nombre || ''), contacto: recibe, resultado: 'Entregado', texto: 'Distintivo entregado con firma (' + folio + '). Lo recibió ' + recibe + (cargo ? ', ' + cargo : '') + '.' + (sedes.length > 1 ? ' ' + sedes.length + ' sedes.' : '') }); } catch (e) {}
    ptl_his_(x.u.nombre, 'entregó el distintivo', folio + ' · ' + raz + ' · recibió ' + recibe);
    if (inv && inv.url) {
      /* el QR de la constancia es la invitación (un solo uso, 48 h): se guarda para dibujarlo mientras no se use */
      PropertiesService.getScriptProperties().setProperty('PTL_ENTINV_' + folio, inv.url);
