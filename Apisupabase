/* Cuántas propuestas usaron cada plan o promoción y cuántas se firmaron. */
function usos313_() {
  const u = { plan: {}, promo: {} };
  const firm = ['Firmado', 'Pasado a cartera'];
  tabla313_(HOJA_PRO).filas.forEach(p => {
