function api_flotaVehiculo(pin, vehiculo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const hoy = hoyPanama_();
  const vehiculos = vehiculosFlota_();
  const veh = String(vehiculo || '').trim() || vehiculos[0].placa;
  const nv = normVeh_(veh);

  // último cierre conocido de este camión
  let ultimo = null;
  leerHoja_(HOJA_JOR).forEach(j => {
    if (normVeh_(j.vehiculo) !== nv) return;
    [['kmFinal','cierre'], ['kmInicio','salida']].forEach(k => {
      const km = Number(j[k[0]]) || 0;
      if (km && (!ultimo || km > ultimo.km))
        ultimo = { km: km, fecha: fechaISO_(j.fecha), conductor: String(j.conductor || ''), de: k[1] };
    });
  });

  // combustible de este camión, en orden, con el rendimiento entre cargas
  const cargas = leerHoja_(HOJA_COM)
    .filter(c => normVeh_(c.vehiculo) === nv && fechaISO_(c.fecha))
    .map(c => ({ fecha: fechaISO_(c.fecha), hora: horaTxt_(c.hora), estacion: String(c.estacion || ''),
                 litros: litrosCarga_(c), monto: Number(c.monto) || 0, km: Number(c.kilometraje) || 0 }))
    .sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora));
  let prevKm = 0;
  cargas.forEach(c => {
    c.rendimiento = (prevKm && c.km > prevKm && c.litros > 0) ? Math.round((c.km - prevKm) / c.litros * 10) / 10 : null;
    if (c.km > prevKm) prevKm = c.km;
    if (c.km && (!ultimo || c.km > ultimo.km)) ultimo = { km: c.km, fecha: c.fecha, conductor: '', de: 'combustible' };
  });
  const hace7 = new Date(hoy + 'T00:00:00'); hace7.setDate(hace7.getDate() - 6);
  const desde7 = Utilities.formatDate(hace7, 'America/Panama', 'yyyy-MM-dd');
  const semana = cargas.filter(c => c.fecha >= desde7);
  const conRend = cargas.filter(c => c.rendimiento).slice(-3);

  // ¿ya se hizo la revisión semanal de este camión esta semana (desde el lunes)?
  const d0 = new Date(hoy + 'T00:00:00');
  const lunes = new Date(d0); lunes.setDate(d0.getDate() - ((d0.getDay() + 6) % 7));
  const desdeLunes = Utilities.formatDate(lunes, 'America/Panama', 'yyyy-MM-dd');
  const revs = leerHoja_(HOJA_REV).filter(r => normVeh_(r.vehiculo) === nv);
  const semanalHecha = revs.some(r => String(r.semanal || '') === 'SI' && fechaISO_(r.fecha) >= desdeLunes);
  const revHoy = revs.filter(r => fechaISO_(r.fecha) === hoy && String(r.momento) === 'salida')
    .map(r => ({ revisionId: String(r.revisionId), hora: horaTxt_(r.hora), puntos: Number(r.puntos) || 0,
                 bien: Number(r.bien) || 0, fallas: Number(r.fallas) || 0, conductor: String(r.conductor || '') }));

  // lo que el plan de mantenimiento dice de este camión
  const act = vehiculos.filter(v => normVeh_(v.placa) === nv)[0];
  const plan = [];
  if (act && act.activoId) {
    const km = ultimo ? ultimo.km : 0;
    leerHoja_(HOJA_PLN).filter(p => String(p.activoId || '').trim() === act.activoId).forEach(p => {
      const t = { tarea: String(p.tarea || ''), faltanKm: null, vence: fechaISO_(p.vence), faltanDias: null };
      const cadaKm = Number(p.cadaKm) || 0, ultKm = Number(p.ultimoKm) || 0;
      if (cadaKm && ultKm && km) t.faltanKm = ultKm + cadaKm - km;
      if (!t.vence && Number(p.cadaDias) && p.ultimaFecha) {
        const v = new Date(fechaISO_(p.ultimaFecha) + 'T00:00:00'); v.setDate(v.getDate() + Number(p.cadaDias));
        t.vence = Utilities.formatDate(v, 'America/Panama', 'yyyy-MM-dd');
      }
      if (t.vence) t.faltanDias = Math.round((new Date(t.vence + 'T00:00:00') - d0) / 86400000);
      if (t.faltanKm === null && t.faltanDias === null) return;
      t.urgencia = Math.min(t.faltanKm === null ? 1e9 : t.faltanKm / 50, t.faltanDias === null ? 1e9 : t.faltanDias);
      plan.push(t);
    });
    plan.sort((a, b) => a.urgencia - b.urgencia);
  }

  const abiertas = fallasAbiertas_(veh);
  return { ok: true, hoy: hoy, vehiculo: veh, vehiculos: vehiculos, lista: listaRevision_(),
           semanalToca: !semanalHecha, ultimo: ultimo, revisionHoy: revHoy[revHoy.length - 1] || null,
           fallas: abiertas, bloqueo: abiertas.filter(f => f.bloquea),
           kitDerrame: tab_try_(() => inc_kitPendiente_(veh), null),
           cargas: cargas.slice(-5).reverse(),
           litrosSemana: Math.round(semana.reduce((s, c) => s + c.litros, 0) * 100) / 100,
           gastoSemana: Math.round(semana.reduce((s, c) => s + c.monto, 0) * 100) / 100,
           rendimiento: conRend.length ? Math.round(conRend.reduce((s, c) => s + c.rendimiento, 0) / conRend.length * 10) / 10 : null,
           plan: plan.slice(0, 4), fotos: false };
}

function api_guardarRevision(pin, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido' };
  d = d || {};
  const veh = String(d.vehiculo || '').trim();
  if (!veh) return { ok: false, error: 'Falta el vehículo.' };
  /* salida y cierre son revisiones completas; «ruta» es una falla que
     salió manejando, sin lista */
  const momento = ['cierre','ruta'].indexOf(String(d.momento)) >= 0 ? String(d.momento) : 'salida';
  const items = Array.isArray(d.items) ? d.items : [];
  if (!items.length && momento !== 'ruta') return { ok: false, error: 'La revisión está vacía.' };
  if (momento === 'ruta' && !(d.fallas || []).length) return { ok: false, error: 'Falta la falla.' };

  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const hr = hojaPlanta_(HOJA_REV, COLS_REV);
    const hf = hojaPlanta_(HOJA_FAL, COLS_FAL);
    const id = String(d.revisionId || '').trim() || ('REV' + new Date().getTime().toString(36).toUpperCase());

    // reintento del mismo envío: no se duplica
    if (leerHoja_(HOJA_REV).some(r => String(r.revisionId) === id)) {
      const ab = fallasAbiertas_(veh);
      return { ok: true, revisionId: id, repetida: true, bloqueo: ab.filter(f => f.bloquea), fallas: ab };
    }

    const lista = {};
    listaRevision_().forEach(p => lista[p.puntoId] = p);
    const hoy = hoyPanama_(), hora = Utilities.formatDate(new Date(), 'America/Panama', 'HH:mm');
    const bien = items.filter(x => x.estado === 'b').length;
    const malos = items.filter(x => x.estado === 'm').length;
    const semanal = items.some(x => String(x.puntoId || '').charAt(0) === 's');

    hr.appendRow(filaPorNombre_(hr, {
      revisionId: id, fecha: hoy, hora: hora, momento: momento, semanal: semanal ? 'SI' : '',
      vehiculo: veh, conductor: u.nombre, jornadaId: String(d.jornadaId || ''),
      km: Number(d.km) || '', tanque: String(d.tanque || ''), puntos: items.length, bien: bien, fallas: malos,
      detalle: items.map(x => String(x.puntoId) + ':' + String(x.estado)).join(' '),
      registradoEn: new Date()
    }));

    // lo que dijo de las fallas que ya estaban abiertas
    const vals = hf.getDataRange().getValues();
    const cab = vals[0].map(String);
    const col = n => cab.indexOf(n);
    const filaDe = {};
    for (let i = 1; i < vals.length; i++) filaDe[String(vals[i][col('fallaId')])] = i + 1;
    const nota = (fila, txt) => {
      const prev = String(hf.getRange(fila, col('historial') + 1).getValue() || '');
      hf.getRange(fila, col('historial') + 1).setValue((prev ? prev + ' | ' : '') + hoy + ' ' + txt);
    };
    (d.confirmaciones || []).forEach(c => {
      const fila = filaDe[String(c.fallaId)]; if (!fila) return;
      if (c.sigue) {
        const v = Number(hf.getRange(fila, col('vecesConfirmada') + 1).getValue()) || 1;
        hf.getRange(fila, col('vecesConfirmada') + 1).setValue(v + 1);
        hf.getRange(fila, col('ultimaConfirmacion') + 1).setValue(hoy);
      } else {
        hf.getRange(fila, col('estado') + 1).setValue('por confirmar');
        nota(fila, u.nombre + ': ya está bien');
      }
    });

    // fallas nuevas (si ese punto ya tenía una abierta, cuenta como confirmación)
    const abiertas = fallasAbiertas_(veh);
    let n = 0;
    (d.fallas || []).forEach(f => {
      const p = lista[String(f.puntoId)] || { punto: String(f.punto || 'Otra falla'), critico: false };
      const puntoTxt = String(f.punto || p.punto || 'Otra falla');
      const bloquea = String(f.puedeSalir) === 'no';
      const ya = abiertas.filter(a => a.puntoId && a.puntoId === String(f.puntoId || '') && f.puntoId)[0];
      if (ya && filaDe[ya.fallaId]) {
        const fila = filaDe[ya.fallaId];
        hf.getRange(fila, col('vecesConfirmada') + 1).setValue(ya.veces + 1);
        hf.getRange(fila, col('ultimaConfirmacion') + 1).setValue(hoy);
        if (bloquea && !ya.bloquea) { hf.getRange(fila, col('bloquea') + 1).setValue('SI'); hf.getRange(fila, col('puedeSalir') + 1).setValue('no'); }
        if (ya.estado === 'por confirmar') hf.getRange(fila, col('estado') + 1).setValue('abierta');
        nota(fila, u.nombre + ': sigue' + (f.que ? ' · ' + f.que : ''));
        return;
      }
      n++;
      hf.appendRow(filaPorNombre_(hf, {
        fallaId: id.replace(/^REV/, 'FAL') + '-' + n, fecha: hoy, hora: hora, vehiculo: veh,
        conductor: u.nombre, revisionId: id, puntoId: String(f.puntoId || ''), punto: puntoTxt,
        critico: p.critico ? 'SI' : '', que: String(f.que || ''), donde: String(f.donde || ''),
        puedeSalir: bloquea ? 'no' : 'si', bloquea: bloquea ? 'SI' : '', nota: String(f.nota || ''),
        foto: String(f.foto || ''), estado: 'abierta', vecesConfirmada: 1, ultimaConfirmacion: hoy,
        registradoEn: new Date()
      }));
    });

    marcar_('logistica');
    const ab = fallasAbiertas_(veh);
    return { ok: true, revisionId: id, bloqueo: ab.filter(f => f.bloquea), fallas: ab };
  } finally { lock.releaseLock(); }
}

function bloqueoVehiculo_(vehiculo) {
