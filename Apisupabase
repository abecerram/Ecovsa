  const dias = []; for (let i = 1; i <= Math.max(1, Math.min(14, Number(cfg.dias) || 7)); i++) dias.push(ini_dia_(hoy, i));
  const deD = D => C.rutas.filter(r => r.fecha === D);
  const publicadaD = D => deD(D).some(r => r.estadoPlan === 'publicada');
  const motivoNo = D => D < primero ? 'congelado' : (cfg.nunca.manual && C.manual[D]) ? 'manual' : publicadaD(D) ? 'publicada' : '';
  const tipoD = D => asis_tipo_(cfg, D);
