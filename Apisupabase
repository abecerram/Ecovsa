  return { id: String(r.id || ''), tipo: String(r.tipo || ''), en: fechaISO_(r.en), enTxt: ini_fechaTxt_(fechaISO_(r.en)) + ' · ' + horaTxt_(r.en), hoy: fechaISO_(r.en) === hoy,
           fecha: fechaISO_(r.fecha), hacia: fechaISO_(r.hacia), texto: String(r.texto || ''), porque: String(r.porque || ''), nombres: String(r.nombres || ''),
           deshecho: !!String(r.deshechoEn || ''), deshechoPor: String(r.deshechoPor || ''),
