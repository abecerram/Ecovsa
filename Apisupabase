function inc_ahora_() { return "'" + Utilities.formatDate(new Date(), 'America/Panama', 'yyyy-MM-dd HH:mm'); }

function inc_fh_(v) { return v instanceof Date ? Utilities.formatDate(v, 'America/Panama', 'yyyy-MM-dd HH:mm') : String(v || '').replace(/^'/, ''); }

