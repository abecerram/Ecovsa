function api_cfgBorrarPrueba(pin, tipo, id, confirmo) {
  const a = cfgAdmin_(pin); if (a.error) return a.error;
  tipo = tipo === 'cliente' ? 'cliente' : 'oportunidad';
  const x = prb_alcance_(tipo, id); if (!x) return { ok: false, error: 'No lo encontré.' };
  if (!x.prueba) return { ok: false, error: 'Primero márcalo como prueba.' };
  if (prb_clave_(confirmo) !== prb_clave_(x.nombre)) return { ok: false, error: 'Escribe el nombre exacto para confirmar.' };
  const lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    const copia = [];
    if (tipo === 'cliente') {
      const nom = prb_clave_(x.nombre), cid = String(id);
      jur_borrarFilas_(HOJA_REC, r => prb_clave_(r.Cliente) === nom, copia);
      jur_borrarFilas_(HOJA_RUT, r => String(r.clienteId) === cid, copia);
      jur_borrarFilas_(HOJA_SOL, r => prb_clave_(r.empresa) === nom, copia);
      [HOJA_CRM_ACT, HOJA_CRM_TAR, HOJA_CRM_CON].forEach(hj => jur_borrarFilas_(hj, r => String(r.ref) === cid && /^cli/.test(String(r.refTipo || '')), copia));
      jur_borrarFilas_(HOJA_REP, r => String(r.clienteId) === cid || prb_clave_(r.clienteNombre) === nom, copia);
      jur_borrarFilas_(HOJA_PEND, r => { const t = String(r.contenido || ''); return t.indexOf('"clienteId":' + cid + ',') >= 0 || t.indexOf('"clienteId":"' + cid + '"') >= 0; }, copia);
      jur_borrarFilas_(HOJA_CLI, r => String(r.id) === cid, copia);
    } else {
      const cod = String(id).trim();
      [HOJA_CRM_ACT, HOJA_CRM_TAR, HOJA_CRM_CON, HOJA_CRM_DOC].forEach(hj => jur_borrarFilas_(hj, r => String(r.ref) === cod, copia));
      jur_borrarFilas_(HOJA_SOL, r => String(r.codigoPropuesta || '').trim() === cod && String(r.estado || '').toUpperCase() !== 'APROBADA', copia);
      const fila313 = leerHoja_(HOJA_PRO).find(r => String(r.codigoPropuesta || '').trim() === cod) || null;
      jur_borrarFilas_(HOJA_PRO, r => String(r.codigoPropuesta || '').trim() === cod, copia);
      if (fila313) alBorrarProspecto313_(fila313, a.u);   // api 3.13: sus números quedan libres
    }
    const resumen = x.partes.map(p => p.n + ' ' + p.que).join(', ');
    jur_log_(a.u, 'config', 'Borró datos de prueba', id, (tipo === 'cliente' ? 'Cliente ' : 'Oportunidad ') + x.nombre + (resumen ? ' con ' + resumen : ''), 'Datos de prueba', 'varias', copia);
    cfgHistorial_(a.u, 'Datos de prueba', 'Borró definitivamente ' + (tipo === 'cliente' ? 'el cliente ' : 'la oportunidad ') + x.nombre, resumen || 'sin nada más colgando');
    marcar_('logistica'); marcar_('mercadeo');
    return { ok: true, borradas: copia.length };
  } finally { lock.releaseLock(); }
}


