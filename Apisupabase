  return { ok: true, tipo: tipo, items: sst_lista_(tipo), puede: { editar: x.puedeEditar, crear: T.quien === 'todos' || x.puedeEditar }, hoy: hoyPanama_() };
}

/* ── Crear o cambiar un registro. d.id vacío = nuevo. Los datos que no se mandan se conservan. ── */
function api_segGuardar(pin, tipo, d) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  const T = sst_tipo_(tipo); if (!T) return { ok: false, error: 'Ese registro no existe.' };
  d = d && typeof d === 'object' ? d : {};
  const id = sst_t_(d.id, 40);
  const nuevo = !id;
  if (nuevo ? !(T.quien === 'todos' || x.puedeEditar) : !x.puedeEditar) return { ok: false, error: 'Tu usuario no puede ' + (nuevo ? 'agregar' : 'cambiar') + ' esto en Seguridad.' };
  const limpio = sst_limpiar_(d, 0);
  ['id'].forEach(k => { delete limpio[k]; });
  Object.keys(limpio).forEach(k => { if (k.charAt(0) === '_') delete limpio[k]; });
  if (tipo === 'casi' && nuevo) { limpio.por = x.u.nombre; limpio.fecha = /^\d{4}-\d{2}-\d{2}$/.test(String(limpio.fecha || '')) ? limpio.fecha : hoyPanama_(); }   // quien lo reporta queda anotado; no se escribe a mano
  const t = sst_tab_(), ahora = "'" + sst_ahora_();
  let datos = limpio, fila = null;
  if (!nuevo) {
    fila = t.filas.find(f => sst_t_(f.regId, 40) === id && sst_t_(f.tipo, 20) === tipo && sst_t_(f.estado, 12) !== 'quitado');
    if (!fila) return { ok: false, error: 'No encontré ese registro.' };
    datos = Object.assign(sst_json_(fila.datos, {}), limpio);
  }
  if (tipo === 'accion') {
    const antes = fila ? sst_json_(fila.datos, {}) : {};
    const deInc = Array.isArray(antes.o) && antes.o[0] === 'inc';
    if (deInc && limpio.e !== undefined && limpio.e !== antes.e) return { ok: false, error: 'Esta acción sigue los pasos de su investigación: se avanza desde Incidentes y casi accidentes.' };
    if (['pend', 'curso', 'hecha', 'cerr'].indexOf(String(datos.e || 'pend')) < 0) return { ok: false, error: 'Estado de la acción no válido.' };
    if (datos.e === 'cerr' && !sst_t_(datos.v, 400)) return { ok: false, error: 'Para cerrarla escriba cómo se comprobó que funcionó.' };
  }
  if (tipo === 'iper') {          // lo que falte de la valoración queda igual que antes de los controles; sin controles = lista vacía
    ['p', 'g'].forEach(k => { if (datos[k] === undefined || datos[k] === '') datos[k] = 3; });
    if (datos.rp === undefined || datos.rp === '') datos.rp = datos.p;
    if (datos.rg === undefined || datos.rg === '') datos.rg = datos.g;
    if (!Array.isArray(datos.c)) datos.c = [];
  }
  const falta = T.req.filter(k => datos[k] === undefined || String(datos[k]).trim() === '');
  if (falta.length) return { ok: false, error: 'Falta completar: ' + falta.join(', ') + '.' };
  const malo = (T.num || []).filter(k => datos[k] !== undefined && datos[k] !== '' && !(Number(datos[k]) >= 1 && Number(datos[k]) <= 5 && Math.round(Number(datos[k])) === Number(datos[k])));
  if (malo.length) return { ok: false, error: 'Probabilidad y gravedad van de 1 a 5.' };
  const texto = JSON.stringify(datos);
  if (texto.length > 14000) return { ok: false, error: 'Es demasiado largo; resúmalo.' };
  if (nuevo && !T.req.length && !Object.keys(datos).length) return { ok: false, error: 'No hay nada que guardar.' };
  if (nuevo) {
    const rid = sst_nuevoId_(tipo, T);
    agregar313_(t, { regId: rid, tipo: tipo, ref: sst_t_(datos.ref, 60), datos: texto, estado: 'activo', creadoPor: x.u.nombre, creadoEn: ahora, cambiadoPor: x.u.nombre, cambiadoEn: ahora });
    sst_his_(x.u, 'Agregó ' + T.nombre + ' ' + rid, '');
    return { ok: true, id: rid, item: Object.assign({}, datos, { id: rid }) };
  }
  actualizar313_(t, fila._fila, { datos: texto, ref: sst_t_(datos.ref, 60) || sst_t_(fila.ref, 60), cambiadoPor: x.u.nombre, cambiadoEn: ahora });
  return { ok: true, id: id, item: Object.assign({}, datos, { id: id }) };
}

/* ── Quitar un registro (queda marcado «quitado» con el motivo; no se borra) ── */
function api_segQuitar(pin, tipo, id, motivo) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  const T = sst_tipo_(tipo); if (!T) return { ok: false, error: 'Ese registro no existe.' };
