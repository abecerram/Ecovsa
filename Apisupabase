function api_subirFotoIncidencia(pin, ref, meta) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const x = inc_buscar_(u, ref);
  if (!x) return { ok: false, error: 'Todavía no llega la incidencia: se reintenta sola.', reintentar: true };
  if (!inc_abierta_(x)) return { ok: false, error: 'La incidencia ya está cerrada.' };
  meta = meta || {};
  const mime = String(meta.mime || '').toLowerCase(), tam = Number(meta.tamano) || 0;
  if (['image/jpeg', 'image/png', 'image/webp'].indexOf(mime) < 0) return { ok: false, error: 'Solo fotos.' };
  if (!(tam > 0) || tam > INC_FOTO_MAX_B) return { ok: false, error: 'La foto pesa demasiado.' };
  const vivas = arc_filas_().filter(a => a.ambito === 'incidencia' && a.ref === x.incId && a.estado !== 'BORRADO');
  if (vivas.length >= INC_FOTOS_MAX) return { ok: false, error: 'Ya tiene ' + INC_FOTOS_MAX + ' fotos.' };
  const r = arc_nuevo_('incidencia', x.incId, 'foto', { nombre: meta.nombre || 'foto.jpg', mime: mime, tamano: tam }, u.nombre, 'incidencias/' + arc_slug_(x.incId));
  return { ok: true, incId: x.incId, archivoId: r.archivoId, subida: r.subida };
}

function api_registrarFotoIncidencia(pin, incId, archivoId) {
