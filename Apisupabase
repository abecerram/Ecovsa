/* ══════════ Calidad.gs (api 3.24 · parte 1: Inicio como guía + Documentos) ══════════ */
/**
 * ═══════════════════════════════════════════════════════════════
 *  CALIDAD · PARTE 1 (decisiones de Álvaro, 4 oct 2026 · DISENO_calidad.md)
 *
 *  Inicio = la guía hacia la certificación ISO 9001:
 *   · la meta y la ruta (etapas con fechas) EDITABLES por el responsable
 *     de calidad y el administrador, con historial;
 *   · el % «del camino recorrido» AUTOMÁTICO: 50 % por etapas marcadas como
 *     hechas + 50 % por documentos listos del listado maestro;
 *   · cada etapa dice lo que exige (documentos y tareas) y «Lo que falta»
 *     se arma solo con los documentos que no están listos + las tareas que
 *     no son documentos;
 *   · informe de avance (lo arma la pantalla en Word): foto del día, sin código.
 *
 *  Documentos = el listado maestro F-CAL-03 vivo:
 *   · estado de cada código: vigente · en el sistema · externo · por aprobar ·
 *     en borrador · falta · obsoleto, con contador y filtros;
 *   · se sube el PDF (lo que ve el equipo) y el Word o Excel editable (solo lo
 *     baja quien sube). Versión nueva → la anterior queda OBSOLETA, guardada,
 *     nunca se borra;
 *   · «leído y entendido» por persona y por versión.
 *
 *  Quién ve qué: Calidad › Ajustes (solo el administrador). Por rol y con
 *  excepciones por persona; ahí también se nombra al responsable de calidad.
 *  El administrador y el responsable de calidad ven y hacen todo.
 *
 *  Nada se borra: un documento se marca obsoleto, una tarea se quita (queda
 *  como «quitada»), los archivos viejos se guardan.
 * ═══════════════════════════════════════════════════════════════
 */
const CAL_H = { doc: 'CalidadDocs', ver: 'CalidadVersiones', lec: 'CalidadLecturas', tar: 'CalidadTareas', his: 'CalidadHistorial' };
