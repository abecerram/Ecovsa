}

function arc_vivoCliente_(a) { return a.ambito === 'cliente' && (a.estado === 'POR_REVISAR' || a.estado === 'ACEPTADO') && !!a.ruta; }

function arc_borrarCliente_(a, motivo, quien) {
  Almacen.borrar(a.ruta);
  arc_cambiar_(a.archivoId, { estado: 'BORRADO', motivo: String(motivo).slice(0, 200), tamano: 0, notas: (a.notas ? a.notas + ' · ' : '') + 'Borrado ' + arc_ahora_().replace(/^'/, '') + ' · ' + quien });
  tab_try_(() => crm_cambiar_(HOJA_CRM_ARC, COLS_CRM_ARC, 'ruta', a.ruta, { ruta: '', borrado: arc_ahora_().replace(/^'/, '') + ' · ' + motivo }), null);
}

function arc_purgarClientes_() {
  const vencidos = arc_filas_().filter(a => arc_vivoCliente_(a) && arc_diasDesde_(a.subidoEn) >= ARC_DIAS_CLIENTE);
  if (!vencidos.length) return 0;
  const porCod = {};
  vencidos.forEach(a => { arc_borrarCliente_(a, 'Pasaron ' + ARC_DIAS_CLIENTE + ' días en la bandeja temporal', 'Sistema'); porCod[a.ref] = (porCod[a.ref] || 0) + 1; });
  Object.keys(porCod).forEach(cod => tab_try_(() => crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', cod,
    { 'docs borrados': arc_ahora_().replace(/^'/, '') + ' · Sistema (' + ARC_DIAS_CLIENTE + ' días)' }), null));
  marcar_('mercadeo');
  return vencidos.length;
}

function arc_temporal_(cod, p) {
  const A = arc_filas_().filter(a => arc_vivoCliente_(a) && a.ref === cod);
  const quedan = A.map(a => ARC_DIAS_CLIENTE - arc_diasDesde_(a.subidoEn));
  p = p || arc_prospecto_(cod) || {};
  return { n: A.length, aceptados: A.filter(a => a.estado === 'ACEPTADO').length, porRevisar: A.filter(a => a.estado === 'POR_REVISAR').length,
           quedan: quedan.length ? Math.max(0, Math.min.apply(null, quedan)) : null, dias: ARC_DIAS_CLIENTE,
           expediente: String(p['expediente docs'] || '').replace(/^'/, ''), borrados: String(p['docs borrados'] || '').replace(/^'/, ''),
           pagaDesde: String(p['banco pago'] || '').trim() ? String(p['banco pago']).trim() + ' ····' + String(p['cuenta ult4'] || '').replace(/^'/, '') : '' };
}

function arc_temporalTodos_(P) {
  const porCod = {};
  arc_filas_().filter(arc_vivoCliente_).forEach(a => {
    const q = ARC_DIAS_CLIENTE - arc_diasDesde_(a.subidoEn), o = porCod[a.ref] = porCod[a.ref] || { cod: a.ref, n: 0, aceptados: 0, quedan: 99 };
    o.n++; if (a.estado === 'ACEPTADO') o.aceptados++; o.quedan = Math.max(0, Math.min(o.quedan, q));
  });
  if (!P) { P = {}; crm_filas_(HOJA_PRO).forEach(p => P[String(p.codigoPropuesta || '').trim()] = p); }
  return Object.keys(porCod).map(k => Object.assign(porCod[k], { empresa: String((P[k] || {}).empresa || ''), expediente: String((P[k] || {})['expediente docs'] || '').replace(/^'/, '') }))
    .sort((a, b) => a.quedan - b.quedan);
}

function arc_datosCliente_(p) {
  const o = {}; ARC_DATOS_VERIFICAR.forEach(c => o[c[0]] = String(p[c[0]] || '').replace(/^'/, '').trim());
  o.empresa = String(p.empresa || ''); o.contacto = String(p.contacto || ''); o.telefono = String(p.celular || p.telefono || ''); o.correo = String(p.correo || '');
  o.zona = String(p.zona || ''); o.provincia = String(p.provincia || '');
  o.pagaDesde = String(p['banco pago'] || '').trim() ? String(p['banco pago']).trim() + ' ····' + String(p['cuenta ult4'] || '').replace(/^'/, '') : '';
  return o;
}

function api_docsExpediente(pin, cod) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  tab_try_(() => arc_purgarClientes_(), null);
  const p = arc_prospecto_(cod); if (!p) return { ok: false, error: 'No encontré la oportunidad.' };
  const orden = ARC_DOCS_CLIENTE.map(d => d[0]);
