/* ══════════ MtoLog.gs (copiado tal cual) ══════════ */
function mto_f_(iso) {
  const s = String(iso || ''); if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const d = new Date(s + 'T12:00:00Z');
  return ['dom','lun','mar','mié','jue','vie','sáb'][d.getUTCDay()] + ' ' + d.getUTCDate() + ' ' +
         ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'][d.getUTCMonth()] +
         (s.slice(0, 4) !== hoyPanama_().slice(0, 4) ? ' ' + s.slice(0, 4) : '');
}

function mto_km_(v) { return Math.round(Number(v) || 0).toLocaleString('en-US'); }

function mto_esDoc_(t) { return !t.cadaKm && MTO_DOC_RE.test(String(t.tarea || '')); }

function mto_asegurarActivos_(pin) {
  const hay = leerHoja_(HOJA_ACT).filter(a => String(a.clase || '').toLowerCase() === 'vehiculo');
  if (hay.length) return;
  VEHICULOS_BASE.forEach(p => api_guardarActivo(pin, { clase: 'vehiculo', nombre: p, placa: p, estado: 'Activo' }));
}

function mto_activoDe_(placa) {
  const nv = normVeh_(placa);
  return leerHoja_(HOJA_ACT).find(a => String(a.clase || '').toLowerCase() === 'vehiculo' &&
                                       normVeh_(a.placa || a.nombre) === nv) || null;
}

function api_mantenimientoFlota(pin) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['supervisor', 'admin', 'gerente'].indexOf(u.rol) < 0) return { ok: false, error: 'Solo logística.' };
  const hoy = hoyPanama_(), n = v => Number(v) || 0;

  const flota = api_flotaLogistica(pin);
  if (!flota || !flota.ok) return flota;
  let activos = []; try { const a = api_activos(pin); activos = (a && a.activos) || []; } catch (e) {}
  const JOR = leerHoja_(HOJA_JOR), REV = leerHoja_(HOJA_REV), FAL = leerHoja_(HOJA_FAL);
  const critDeRev = {};
  /* rojo = una falla que no deja salir al camión; ámbar = puede salir con la falla */
  FAL.forEach(f => { if (String(f.bloquea || '') === 'SI') critDeRev[String(f.revisionId || '')] = true; });

  /* lunes de esta semana */
  const dSem = new Date(hoy + 'T12:00:00Z').getUTCDay();
  const lunes = ini_dia_(hoy, -((dSem + 6) % 7));
  const dias = []; for (let i = 13; i >= 0; i--) dias.push(ini_dia_(hoy, -i));

  let salidas14 = 0, conRev14 = 0;
  const sinRevision = [];
  const camiones = flota.camiones.map(c => {
    const nv = normVeh_(c.placa);
    const revs = REV.filter(r => normVeh_(r.vehiculo) === nv).map(r => ({
      id: String(r.revisionId || ''), fecha: fechaISO_(r.fecha), hora: horaTxt_(r.hora), momento: String(r.momento || ''),
      semanal: String(r.semanal || '') === 'SI', puntos: n(r.puntos), bien: n(r.bien), fallas: n(r.fallas), conductor: String(r.conductor || '') }));
    const jors = JOR.filter(j => normVeh_(j.vehiculo) === nv).map(j => ({ fecha: fechaISO_(j.fecha), conductor: String(j.conductor || ''),
      revisionSalida: String(j.revisionSalida || '').trim(), hora: horaTxt_(j.horaInicio) }));
    const franja = dias.map(d => {
      const rs = revs.filter(r => r.fecha === d && r.momento !== 'ruta');
      const js = jors.filter(j => j.fecha === d);
      if (js.length) { salidas14++; if (rs.some(r => r.momento === 'salida') || js.some(j => j.revisionSalida)) conRev14++; }
      if (rs.length) return { fecha: d, e: rs.some(r => critDeRev[r.id]) ? 'r' : (rs.some(r => r.fallas > 0) ? 'am' : 'ok') };
      if (js.length) return { fecha: d, e: 'no' };
      return { fecha: d, e: 'sd' };
    });
    /* salidas sin revisión de los últimos 7 días */
    jors.filter(j => j.fecha >= ini_dia_(hoy, -6) && !j.revisionSalida &&
                     !revs.some(r => r.fecha === j.fecha && r.momento === 'salida'))
      .forEach(j => sinRevision.push({ placa: c.placa, fecha: j.fecha, conductor: j.conductor, hora: j.hora }));
    const hoyS = revs.filter(r => r.fecha === hoy && r.momento === 'salida').sort((a, b) => a.hora.localeCompare(b.hora)).pop() || null;
    const sem = revs.filter(r => r.semanal && r.fecha >= lunes).sort((a, b) => a.fecha.localeCompare(b.fecha)).pop() || null;
    const salioSemana = jors.some(j => j.fecha >= lunes && j.fecha <= hoy);
    const act = activos.find(a => normVeh_(a.placa || a.nombre) === nv) || null;
    const tareas = act ? (act.tareas || []) : [];
    return { placa: c.placa, marca: c.marca, conductor: c.conductor, km: c.odometro, kmFecha: c.odometroFecha, estado: c.estado,
             activoId: act ? act.activoId : '',
             hoy: hoyS ? { hora: hoyS.hora, puntos: hoyS.puntos, bien: hoyS.bien, fallas: hoyS.fallas, conductor: hoyS.conductor, bloquea: !!critDeRev[hoyS.id] } : null,
             salioHoy: jors.some(j => j.fecha === hoy),
             semanal: sem ? { fecha: sem.fecha } : null, semanalPendiente: !sem && salioSemana && dSem !== 1,
             franja: franja,
             servicios: tareas.filter(t => !mto_esDoc_(t)), documentos: tareas.filter(t => mto_esDoc_(t)),
             ultimosServicios: act ? (act.servicios || []).slice(0, 5) : [],
             /* api 3.5.3: lo gastado en el mes en este camión */
             serviciosMes: act ? (act.servicios || []).filter(x => String(x.fecha || '').slice(0, 7) === hoy.slice(0, 7)).reduce((s, x) => s + (Number(x.costo) || 0), 0) : 0,
             nServiciosMes: act ? (act.servicios || []).filter(x => String(x.fecha || '').slice(0, 7) === hoy.slice(0, 7)).length : 0 };
  });

  /* ── lo que requiere acción, por urgencia ── */
  const at = [];
  const push = (nivel, tipo, titulo, texto, extra) => at.push(Object.assign({ nivel: nivel, tipo: tipo, titulo: titulo, texto: texto || '' }, extra || {}));
  flota.fallas.filter(f => f.bloquea).forEach(f => push('r', 'falla', f.vehiculo + ' no puede salir',
    f.punto + (f.nota ? ': «' + f.nota + '»' : '') + ' · ' + (f.conductor || '') + (f.hora ? ' a las ' + f.hora : ''), { fallaId: f.fallaId, placa: f.vehiculo }));
  camiones.forEach(c => c.servicios.filter(t => t.estado === 'VENCIDO').forEach(t => push('r', 'servicio', c.placa + ' · ' + t.tarea.toLowerCase() + ' vencido',
    t.faltanKm !== null && t.faltanKm < 0 ? 'Pasado ' + mto_km_(-t.faltanKm) + ' km · último a los ' + mto_km_(t.ultimoKm) + ' km · va en ' + mto_km_(c.km)
      : (t.faltanDias !== null ? 'Venció hace ' + (-t.faltanDias) + ' días' : ''), { placa: c.placa, planId: t.planId })));
  camiones.forEach(c => c.documentos.forEach(t => {
    if (t.estado === 'VENCIDO') push('r', 'doc', c.placa + ' · ' + t.tarea.toLowerCase() + ' vencido', 'Venció el ' + mto_f_(t.vence), { placa: c.placa, planId: t.planId });
    else if (t.estado === 'sin datos') push('r', 'doc', c.placa + ' · ' + t.tarea.toLowerCase() + ' sin fecha', 'Falta la fecha de vencimiento', { placa: c.placa, planId: t.planId });
  }));
  flota.fallas.filter(f => !f.bloquea).forEach(f => push('am', 'falla', f.vehiculo + ' · ' + f.punto.toLowerCase(),
    (f.que ? f.que + ' · ' : '') + (f.estado === 'en taller' ? 'en taller' + (f.taller ? ' (' + f.taller + ')' : '') : 'puede salir') +
    (f.veces > 1 ? ' · confirmada ' + f.veces + ' veces' : '') + ' · desde el ' + mto_f_(f.fecha), { fallaId: f.fallaId, placa: f.vehiculo }));
  sinRevision.sort((a, b) => b.fecha.localeCompare(a.fecha)).forEach(s => push('am', 'sinrev', s.placa + ' salió sin revisión el ' + mto_f_(s.fecha),
    (s.conductor || 'El conductor') + ' abrió jornada' + (s.hora ? ' a las ' + s.hora : '') + ' sin marcar la revisión de salida', { placa: s.placa, clave: 'sinrev:' + s.placa + ':' + s.fecha }));
  camiones.filter(c => c.semanalPendiente).forEach(c => push('am', 'semanal', c.placa + ' · revisión semanal pendiente',
    'Salió esta semana y todavía no tiene la revisión de los lunes', { placa: c.placa, clave: 'sem:' + c.placa + ':' + lunes }));
  camiones.forEach(c => c.servicios.concat(c.documentos).filter(t => t.estado === 'POR VENCER').forEach(t => push('am', mto_esDoc_(t) ? 'doc' : 'servicio',
    c.placa + ' · ' + t.tarea.toLowerCase(), t.faltanKm !== null && t.faltanKm <= 500 ? 'Faltan ' + mto_km_(t.faltanKm) + ' km' : (t.vence ? 'Vence el ' + mto_f_(t.vence) + ' (' + t.faltanDias + ' días)' : ''),
    { placa: c.placa, planId: t.planId })));
  camiones.filter(c => !c.servicios.length && !c.documentos.length).forEach(c => push('g', 'sinplan', c.placa + ' sin plan de mantenimiento',
    'Crea su plan con la base de ECOVSA (aceite, filtros, llantas, frenos, documentos) y ajústalo', { placa: c.placa }));
  camiones.forEach(c => { const s = c.servicios.filter(t => t.estado === 'sin datos');
    if (s.length) push('g', 'sinpartida', c.placa + ' · ' + s.length + (s.length === 1 ? ' tarea' : ' tareas') + ' sin punto de partida',
      'Anota a qué km o en qué fecha fue el último: ' + s.slice(0, 3).map(t => t.tarea.toLowerCase()).join(', ') + (s.length > 3 ? '…' : ''), { placa: c.placa }); });

  /* ── próximos servicios: los de km y fecha, del más cercano al más lejano ── */
  const proximos = [];
  camiones.forEach(c => c.servicios.filter(t => t.estado !== 'sin datos').forEach(t => {
    const pk = t.cadaKm && t.faltanKm !== null ? (t.cadaKm - t.faltanKm) / t.cadaKm : 0;
    const pd = t.cadaDias && t.faltanDias !== null ? (t.cadaDias - t.faltanDias) / t.cadaDias : 0;
    proximos.push({ placa: c.placa, planId: t.planId, tarea: t.tarea, estado: t.estado, faltanKm: t.faltanKm, faltanDias: t.faltanDias,
                    vence: t.vence, pct: Math.max(0, Math.min(100, Math.round(Math.max(pk, pd) * 100))) });
  }));
  proximos.sort((a, b) => b.pct - a.pct);

  const docsNombres = [];
  camiones.forEach(c => c.documentos.forEach(t => { if (docsNombres.indexOf(t.tarea) < 0) docsNombres.push(t.tarea); }));

  return { ok: true, hoy: hoy, lunes: lunes, dias: dias, camiones: camiones, atencion: at, proximos: proximos.slice(0, 8),
           docs: docsNombres, planBase: MTO_PLAN_BASE,
           kpis: { gastoMes: Math.round(camiones.reduce((s, c) => s + (c.serviciosMes || 0), 0) * 100) / 100,
                   serviciosMes: camiones.reduce((s, c) => s + (c.nServiciosMes || 0), 0),
                   vencidos: at.filter(a => a.nivel === 'r' && (a.tipo === 'servicio' || a.tipo === 'doc')).length,
                   proximos: camiones.reduce((s, c) => s + c.servicios.concat(c.documentos).filter(t => t.estado === 'POR VENCER').length, 0),
                   fallas: flota.fallas.length, bloquean: flota.fallas.filter(f => f.bloquea).length,
                   salidas14: salidas14, conRevision14: conRev14 },
           flota: flota };
}

function api_guardarPlanFlota(pin, placa, tareas) {
