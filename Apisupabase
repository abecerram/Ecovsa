/* ── Forma única de un servicio (oportunidad, cuenta, plan, propuesta) ──
   {itemId, nombre, modo:'incluido'|'cobrado', cantidad, cada:'visita'|'mes'|'bimestre'|'trimestre'|'semestre',
    meses:1|2|3|6, precio (por vez), total (al mes, ya repartido), delPlan, dePromo}
   Lee también lo guardado por el 3.12 (catId, cada 'mes'|'visita') y lo del
   primer borrador del 3.13 (periodo/precioPeriodo). Deja catId = itemId para
   que el código del 3.12 que todavía lea catId siga funcionando.            */
function servicioForma313_(s, visitas, cat) {
  s = s || {};
  const id = String(s.itemId || s.catId || '');
  const c = (cat && cat[id]) || {};
  let cada = String(s.cada || '');
  let precio = s.precio != null && s.precio !== '' ? Number(s.precio) : Number(c.precio) || 0;
  if (s.periodo && MESES_CADA_313[s.periodo]) { cada = s.periodo; if (s.precioPeriodo !== '' && s.precioPeriodo != null) precio = Number(s.precioPeriodo); }
  if (cada !== 'visita' && !MESES_CADA_313[cada]) cada = 'mes';
  const o = { itemId: id, catId: id, nombre: String(s.nombre || c.nombre || ''), modo: s.modo === 'cobrado' ? 'cobrado' : 'incluido',
    cantidad: s.cantidad === 'solicitud' ? 'solicitud' : (Number(s.cantidad) || 1), cada: cada,
    meses: cada === 'visita' ? 1 : MESES_CADA_313[cada], precio: r2_313_(precio), total: 0,
    delPlan: s.delPlan === true, dePromo: s.dePromo === true };
  if (s.promoId) o.promoId = String(s.promoId);
  if (s.tipo || c.tipo) o.tipo = String(s.tipo || c.tipo);
  if (s.insumoId || c.insumoId) o.insumoId = String(s.insumoId || c.insumoId);
  if (s.quien || c.quien) o.quien = String(s.quien || c.quien);
  o.total = servicioMes313_(o, visitas);
  return o;
}
function serviciosForma313_(lista, visitas) {
  const cat = {}; catalogo313_().forEach(c => { cat[c.id] = c; });
  return (Array.isArray(lista) ? lista : []).map(s => servicioForma313_(s, visitas, cat)).filter(s => s.itemId);
}

