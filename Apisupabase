/* api 3.33 · lo que está por revisar, agrupado por cliente (Bandeja de Logística) */
function rep_porRevisar_() {
  const L = rep_filas_().filter(r => !r.revisado); if (!L.length) return [];
  const porId = {}, porNom = {};
  leerHoja_(HOJA_CLI).forEach(c => { porId[String(c.id)] = c; porNom[crm_clave_(c.nombre)] = c; });
  const g = {};
  L.forEach(r => {
    const c = r.clienteId ? porId[r.clienteId] : porNom[crm_clave_(r.clienteNombre)]; if (!c) return;
    const id = Number(c.id);
    const x = g[id] = g[id] || { clienteId: id, cliente: String(c.nombre || ''), zona: String(c.region || ''), cuando: '', items: [] };
    x.items.push({ repId: r.repId, nombre: r.nombre, cantidad: r.cantidad, cada: r.cada, cadaTxt: REP_CADA[r.cada] || '', ref: r.ref, nota: r.nota,
                   cuando: r.cambiadoEn, por: r.cambiadoPor, nuevo: !r.revisadoEn && r.creadoEn === r.cambiadoEn });   // si no, «cambió»
    if (r.cambiadoEn > x.cuando) x.cuando = r.cambiadoEn;
  });
  return Object.keys(g).map(k => g[k]).sort((a, b) => String(b.cuando).localeCompare(String(a.cuando)));
}

/* api 3.33 · Logística marca como revisado lo que llegó de Mercadeo: un renglón (repId) o todo lo del cliente (clienteId) */
function api_reposicionRevisada(pin, repId, clienteId) {
