  const p = prospecto313_(cod); if (!p) return { ok: false, error: 'No encontré esa oportunidad.' };
  if (prospectoBloqueado313_(p)) return { ok: false, error: 'La propuesta ya está firmada: el plan no se cambia.' };
  let pl = null, avisos = [];
  if (planId) {
    const a = aplicablesOportunidad313_(p);
    pl = a.planes.filter(x => x.id === String(planId))[0];
    if (!pl) {
      const x = planPorId313_(planId);
      if (!x) return { ok: false, error: 'Ese plan ya no existe.' };
      if (x.estado !== 'activo') return { ok: false, error: 'Ese plan no está activo.' };
      return { ok: false, error: a.sinSector ? 'Ponle sector a este cliente para ver sus planes especiales.' : 'Ese plan especial es de otro sector.' };
    }
  }
  const T = tarifario313_();
  const r = candado313_(() => {
    const campos = pl ? {
      frecuencia: pl.frecuencia, 'kg plan': pl.kgIncluidos, 'costo visita': pl.precio,
      'tarifa kg adic': pl.kgAdicional != null ? pl.kgAdicional : (Number(T.kgAdicional) || ''),
      planId: pl.id, planSnap: JSON.stringify(planSnapDe313_(pl)) } : { planId: '', planSnap: '' };
    /* la promoción se suma a UN plan: si el plan nuevo no la admite, se quita */
    const prSnap = json313_(p.promoSnap, null);
    if (prSnap && (!pl || !promoSeSuma313_(prSnap, pl))) {
      campos.promoId = ''; campos.promoSnap = ''; campos.venceOferta = '';
      avisos.push('Se quitó la promoción «' + prSnap.nombre + '»: no se suma a ' + (pl ? 'este plan' : 'una propuesta sin plan') + '.');
    }
    actualizarProspecto313_(cod, campos);
    return { ok: true };
  });
  if (!r.ok) return r;
  /* servicios: fuera los del plan anterior (y los repetidos), dentro los del plan nuevo */
  const actuales = serviciosForma313_(serviciosDeProspecto313_(p), visitasDe313_(p.frecuencia));
  let lista;
  if (pl) {
    const nuevos = serviciosDelPlanParaOp313_(pl), ids = nuevos.map(s => s.itemId);
    lista = actuales.filter(s => !s.delPlan && ids.indexOf(String(s.itemId || s.catId)) < 0).concat(nuevos);
  } else {
    lista = actuales.map(s => Object.assign({}, s, { delPlan: false }));
  }
  lista = serviciosForma313_(lista, pl ? pl.visitas : visitasDe313_(p.frecuencia));
  const g = guardarServiciosProspecto313_(pin, cod, lista);
  if (g && g.ok === false) return { ok: false, error: 'El plan quedó puesto, pero no se pudieron guardar sus servicios: ' + (g.error || '') };
  return { ok: true, prospecto: prospectoRespuesta313_(pin, cod), avisos: avisos };
}

/* Vigencia de la propuesta: validez en días desde su fecha, recortada al
   cierre de la oferta si lleva promoción. */
function venceBase313_(p) {
  const f = fechaISO_(p['fecha propuesta']) || fechaISO_(p['fecha contacto']) || hoy313_();
  return sumarDias313_(f, Number(p['validez propuesta']) || 30);
}
function venceEfectiva313_(p) {
  const base = venceBase313_(p), pr = json313_(p.promoSnap, null);
  return pr && pr.hasta && pr.hasta < base ? pr.hasta : base;
}

function api_oportunidadPromo(pin, cod, promoId) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  const p = prospecto313_(cod); if (!p) return { ok: false, error: 'No encontré esa oportunidad.' };
  if (prospectoBloqueado313_(p)) return { ok: false, error: 'La propuesta ya está firmada: la promoción no se cambia.' };
  if (!promoId) {
    candado313_(() => { actualizarProspecto313_(cod, { promoId: '', promoSnap: '', venceOferta: '' }); return { ok: true }; });
    return { ok: true, prospecto: prospectoRespuesta313_(pin, cod), venceOferta: '' };
  }
  if (!esClienteNuevo313_(p)) return { ok: false, error: 'Las promociones son solo para clientes nuevos, sin contrato.' };
  if (!String(p.planId || '').trim()) return { ok: false, error: 'Primero elige el plan: la promoción se suma a un plan.' };
  const ya = String(p.promoId || '').trim();
  if (ya && ya !== String(promoId)) {
    const s = json313_(p.promoSnap, {}) || {};
    return { ok: false, error: 'Esta propuesta ya tiene la promoción «' + (s.nombre || ya) + '». Va una sola por propuesta: quítala primero.' };
  }
  const pr = promoPorId313_(promoId); if (!pr) return { ok: false, error: 'Esa promoción ya no existe.' };
  if (!promoActivaHoy313_(pr)) return { ok: false, error: 'Esa promoción no está activa hoy (' + promoEstadoTexto313_(pr).toLowerCase() + ').' };
  const pl = json313_(p.planSnap, null) || planPorId313_(p.planId);
  if (!pl) return { ok: false, error: 'No encontré el plan de esta propuesta.' };
  if (!(pr.planes === 'todos' || pr.planes.indexOf(pl.id) >= 0)) return { ok: false, error: 'Esa promoción no se suma al plan «' + pl.nombre + '».' };
  const rep = itemsGratis313_(pr).filter(i => itemsDelPlan313_(pl).indexOf(i) >= 0)[0];
  if (rep) return { ok: false, error: 'Esa promoción regala algo que el plan «' + pl.nombre + '» ya trae.' };
  const snap = promoSnapDe313_(pr);
  const vence = venceEfectiva313_(Object.assign({}, p, { promoSnap: snap }));
  candado313_(() => { actualizarProspecto313_(cod, { promoId: pr.id, promoSnap: JSON.stringify(snap), venceOferta: vence }); return { ok: true }; });
  return { ok: true, prospecto: prospectoRespuesta313_(pin, cod), venceOferta: vence, recortada: vence === pr.hasta && vence < venceBase313_(p) };
}

/* ── La promoción en la propuesta impresa (sin tachar nada) ─────── */
function beneficioTexto313_(b) {
  if (b.tipo === 'gratis') return b.cantidad + ' ' + b.nombre + ' sin costo ' + (CADA_TXT_313[b.cada] || 'al mes');
  if (b.tipo === 'kgAdicional') return 'kilo adicional a B/. ' + n2_313_(b.precio) + ' más ITBMS';
  if (b.tipo === 'visitasExtra') return b.cantidad + (Number(b.cantidad) === 1 ? ' visita extra' : ' visitas extra') + ' al mes sin costo';
  if (b.tipo === 'precio') return 'precio por visita de B/. ' + n2_313_(b.precio) + ' más ITBMS';
  return '';
}
function unirY313_(l) { return l.length <= 1 ? (l[0] || '') : l.slice(0, -1).join(', ') + ' y ' + l[l.length - 1]; }
/* Las notas de la promoción (van en «Nota importante»). */
function notasPromocion313_(p) {
  const pr = json313_(p.promoSnap, null); if (!pr) return [];
  const pl = json313_(p.planSnap, null) || {};
  const ben = (pr.beneficios || []).map(beneficioTexto313_).filter(Boolean);
  if (!ben.length) return [];
  const dur = Number(pr.duracionMeses) || 0;
  const cuando = dur ? 'durante los primeros ' + (dur === 1 ? 'mes' : dur + ' meses') + ' de servicio' : 'durante todo el contrato';
  const l = ['Promoción ' + pr.nombre + ': ' + unirY313_(ben) + ', ' + cuando + '.'];
  const despues = [];
  if (dur) {
    if (pr.beneficios.some(b => b.tipo === 'precio')) {
      const pv = Number(p['costo visita']) || Number(pl.precio) || 0;
      if (pv) despues.push('el precio por visita de B/. ' + n2_313_(pv) + ' más ITBMS');
    }
    if (pr.beneficios.some(b => b.tipo === 'kgAdicional')) {
      const ka = Number(p['tarifa kg adic']) || 0;
      if (ka) despues.push('el kilo adicional a B/. ' + n2_313_(ka) + ' más ITBMS');
    }
    if (despues.length) l.push('Al terminar la promoción aplica ' + unirY313_(despues) + '.');
  }
  if (pr.hasta) l.push('Promoción válida hasta el ' + fechaLarga313_(pr.hasta) + ', fecha en que cierra la promoción.');
  return l;
}

/* ── Cuenta con sedes: plan por grupo y gran generador ─────────── */
/* Para api_calcularCuentaGran: si el grupo trae planId, el precio al mes es
   precio del plan × visitas × sedes (salvo que Mercadeo ponga uno a mano). */
function planDeGrupo313_(g, nSedes) {
  if (!g || !g.planId) return null;
  const pl = planPorId313_(g.planId) || json313_(g.planSnap, null);
  if (!pl) return null;
  const n = Number(nSedes) || ((g.sedes || []).length) || 1;
  return { plan: { id: pl.id, nombre: pl.nombre, tipo: pl.tipo, gran: esGranPlan313_(pl) },
    visitas: pl.visitas, precioVisita: pl.precio, precioMes: r2_313_(pl.precio * pl.visitas * n),
    kgIncluidos: (Number(pl.kgIncluidos) || 0) * n, kgAdicional: pl.kgAdicional };
}
/* granGenerador para la oportunidad y la cuenta: por volumen (100 kg al mes
   o más sumando sedes) o por un plan de 100 kg o más. Ya no por sedes. */
function granGeneradorInfo313_(p, cuenta) {
  const umbral = umbralGran313_();
  const cu = cuenta || cuentaDe313_(p);
  let kg = 0, sedes = 1;
  if (cu && cu.grupos) {
    sedes = 0;
    cu.grupos.forEach(g => (g.sedes || []).forEach(s => { sedes++; kg += Number(s.kgMes || s.kg) || 0; }));
    if (!sedes) sedes = 1;
  } else kg = Number(p.kgMesEstimado || p['kg estimado'] || p['kg propuesta'] || 0) || 0;
  const pl = json313_(p.planSnap, null);
  const porPlan = !!(pl && (Number(pl.kgIncluidos) || 0) >= umbral);
  return { granGenerador: { sugerido: kg >= umbral || porPlan, kgMes: r2_313_(kg), umbral: umbral, porPlan: porPlan }, sedes: sedes };
}


/* ══════════ Beneficios.gs (api 3.13) ══════════ */
/**
 * ═══════════════════════════════════════════════════════════════
 *  api 3.13 · BENEFICIOS DE PROMOCIÓN DE CADA CLIENTE
 *
 *  Al firmar / pasar a cartera una propuesta con promoción se registra el
 *  beneficio del cliente (hoja CrmBeneficios):
 *    inicio = inicio de recolección · fin = inicio + duración
 *    (duración 0 = todo el contrato → fin = vencimiento del contrato)
 *    avisoEn = 15 días antes del fin; si cae sábado o domingo, el viernes.
 *
 *  La tarea diaria (una vez al día, al abrir cualquier pantalla):
 *   - Mientras dura: aplica al cliente lo de la promoción que cambia el
 *     cobro (precio por visita, kilo adicional).
 *   - Desde avisoEn: sale en «Promociones que terminan» (Mi día de
 *     Mercadeo y de Cobros).
 *   - Al llegar el fin: estado «terminado», el cliente vuelve a las tarifas
 *     del plan normal y se quita lo gratis de la promoción.
 * ═══════════════════════════════════════════════════════════════
 */

const HOJA_BEN_313 = 'CrmBeneficios';
const COLS_BEN_313 = ['id', 'clienteId', 'cliente', 'codigoPropuesta', 'promoId', 'promoSnap', 'normal', 'inicio', 'fin', 'avisoEn',
  'avisado', 'aplicado', 'estado', 'atendidoMercadeo', 'atendidoCobros', 'posponerMercadeo', 'posponerCobros', 'terminadoEn', 'registradoEn'];
const PROP_BEN_DIA_313 = 'BENEFICIOS_ULTIMO_DIA';
const DIAS_AVISO_BEN_313 = 15;

/* Fechas del beneficio. */
function fechasBeneficio313_(inicio, duracionMeses, plazoMeses) {
  const dur = Number(duracionMeses) || 0;
  const meses = dur || Number(plazoMeses) || 0;       // 0 = todo el contrato
  if (!inicio || !meses) return { inicio: inicio || '', fin: '', avisoEn: '' };
  const fin = sumarMeses313_(inicio, meses);
  return { inicio: inicio, fin: fin, avisoEn: habilAntes313_(sumarDias313_(fin, -DIAS_AVISO_BEN_313)) };
}

/* Se llama al pasar a cartera (y es seguro llamarlo dos veces: una propuesta,
   un beneficio). clienteId puede venir vacío: el alta la aprueba Logística
   después, y la tarea diaria lo encuentra. */
function registrarBeneficio_(p, clienteId) {
  const pr = json313_(p.promoSnap, null);
  if (!pr || !String(p.promoId || pr.id || '').trim()) return null;
  const t = tabla313_(HOJA_BEN_313, COLS_BEN_313);
  const cod = String(p.codigoPropuesta || '').trim();
  const ya = t.filas.filter(b => String(b.codigoPropuesta) === cod)[0];
  if (ya) { if (clienteId && !ya.clienteId) actualizar313_(t, ya._fila, { clienteId: clienteId }); return String(ya.id); }
  const inicio = fechaISO_(p['inicio recoleccion']) || hoy313_();
  const plazo = Number(String(p['plazo contrato'] || '').replace(/\D/g, '')) || 0;
  const f = fechasBeneficio313_(inicio, pr.duracionMeses, plazo);
  const pl = json313_(p.planSnap, null) || {};
  const normal = { costoVisita: Number(p['costo visita']) || Number(pl.precio) || 0,
    tarifaKgAdic: Number(p['tarifa kg adic']) || (pl.kgAdicional != null ? Number(pl.kgAdicional) : 0),
    frecuencia: String(p.frecuencia || pl.frecuencia || ''), plan: pl.nombre || '' };
  const id = id313_('BN');
  agregar313_(t, { id: id, clienteId: clienteId || '', cliente: String(p.empresa || ''), codigoPropuesta: cod, promoId: String(p.promoId || pr.id),
    promoSnap: JSON.stringify(pr), normal: JSON.stringify(normal), inicio: f.inicio, fin: f.fin, avisoEn: f.avisoEn,
    avisado: 'NO', aplicado: 'NO', estado: 'vigente', registradoEn: ahora313_() });
  return id;
}

/* Unido con el 3.12 (revisado 30 sep) · el cliente que nació de la propuesta. El 3.12 escribe
   clienteId en el prospecto al aprobar el alta (o la reactivación de misma
   sede); si no, se busca un cliente cuyo contrato sea el de la propuesta. */
function clienteDeBeneficio313_(b) {
  if (String(b.clienteId || '').trim()) return String(b.clienteId);
  const p = prospecto313_(b.codigoPropuesta);
  if (p && String(p.clienteId || '').trim()) return String(p.clienteId);
  const cr = String(b.codigoPropuesta || '').trim();
  if (cr) { const c = tabla313_(HOJA_CLI).filas.filter(x => String(x.clienteRef || '').trim() === cr)[0]; if (c) return String(c.id); }
  const nc = p ? String(p['n contrato'] || '').trim() : '';
  if (nc) { const c = tabla313_(HOJA_CLI).filas.filter(x => String(x.contrato || '').trim() === nc)[0]; if (c) return String(c.id); }
  return '';
}

/* Cambia las tarifas del cliente en Clientes (plan costo, tarifa kg adic). */
function tarifasCliente313_(clienteId, campos) {
  const t = tabla313_(HOJA_CLI);
  const c = t.filas.filter(x => String(x.id) === String(clienteId))[0];
  if (!c) return false;
  actualizar313_(t, c._fila, campos);
  return true;
}

/* Unido con el 3.12 (revisado 30 sep) · quitar lo gratis de la promoción: las reposiciones que
   se crearon desde la promoción (origen 'promo:<id>', ver CAMBIOS §12) se
   apagan. Columnas de Reposiciones del 3.11 no vistas: clienteId, origen,
   activo. */
function quitarGratis313_(clienteId, promoId) {
  const t = tabla313_(HOJA_REP);
  const cli = clientePorId313_(clienteId), nom = cli ? String(cli.nombre || '').trim().toUpperCase() : '';
  if (!t.h || !t.cab.length) return 0;
  if (t.cab.indexOf('origen') < 0 || t.cab.indexOf('activo') < 0) return 0;
  let n = 0;
  t.filas.forEach(r => {
    const suyo = String(r.clienteId || '') ? String(r.clienteId) === String(clienteId) : (nom && String(r.clienteNombre || '').trim().toUpperCase() === nom);
    if (suyo && String(r.origen) === 'promo:' + promoId && si313_(r.activo === '' ? 'SI' : r.activo)) {
      actualizar313_(t, r._fila, { activo: 'NO' }); n++;
    }
  });
  return n;
}

/* Lo que cambia el cobro mientras dura la promoción. */
function tarifasPromo313_(pr) {
  const c = {};
  (pr.beneficios || []).forEach(b => {
    if (b.tipo === 'precio') c['plan costo'] = Number(b.precio);
    if (b.tipo === 'kgAdicional') c['tarifa kg adic'] = Number(b.precio);
  });
  return c;
}

/* Una vez al día. Se puede llamar en cada pantalla: si ya corrió hoy, sale. */
function tareaDiariaBeneficios_(forzar) {
  const hoy = hoy313_(), pr = PropertiesService.getScriptProperties();
  if (!forzar && pr.getProperty(PROP_BEN_DIA_313) === hoy) return { corrio: false };
  const lock = LockService.getScriptLock();
  try { lock.waitLock(5000); } catch (e) { return { corrio: false }; }
  try {
    if (!forzar && pr.getProperty(PROP_BEN_DIA_313) === hoy) return { corrio: false };
    const t = tabla313_(HOJA_BEN_313, COLS_BEN_313), res = { aplicados: 0, avisados: 0, terminados: 0 };
    t.filas.filter(b => b.estado === 'vigente').forEach(b => {
      const cli = clienteDeBeneficio313_(b);
      const cambios = {};
      if (cli && !b.clienteId) cambios.clienteId = cli;
      const promo = json313_(b.promoSnap, {}) || {};
      const fin = fechaISO_(b.fin), aviso = fechaISO_(b.avisoEn);
      if (fin && hoy >= fin) {
        /* terminó: vuelve al plan normal y se quita lo gratis */
        if (cli) {
          const n = json313_(b.normal, {}) || {};
          const c = {}; if (n.costoVisita) c['plan costo'] = n.costoVisita; if (n.tarifaKgAdic) c['tarifa kg adic'] = n.tarifaKgAdic;
          if (Object.keys(c).length) tarifasCliente313_(cli, c);
          quitarGratis313_(cli, b.promoId);
        }
        Object.assign(cambios, { estado: 'terminado', terminadoEn: hoy });
        res.terminados++;
      } else {
        if (cli && !si313_(b.aplicado)) {
          const c = tarifasPromo313_(promo);
          if (!Object.keys(c).length || tarifasCliente313_(cli, c)) { cambios.aplicado = 'SI'; res.aplicados++; }
        }
        if (aviso && hoy >= aviso && !si313_(b.avisado)) { cambios.avisado = 'SI'; res.avisados++; }
      }
      if (Object.keys(cambios).length) actualizar313_(t, b._fila, cambios);
    });
    pr.setProperty(PROP_BEN_DIA_313, hoy);
    res.corrio = true;
    return res;
  } finally { lock.releaseLock(); }
}

/* Para «Mi día» de Mercadeo (rol mercadeo…) y de Cobros: los beneficios que
   terminan pronto y que ese módulo no ha marcado como atendidos. */
function promosQueTerminan_(rol) {
  const hoy = hoy313_();
  const cobros = String(rol || '') === 'cobros';
  const campo = cobros ? 'atendidoCobros' : 'atendidoMercadeo';
  const posp = cobros ? 'posponerCobros' : 'posponerMercadeo';
  return tabla313_(HOJA_BEN_313, COLS_BEN_313).filas
    .filter(b => b.estado === 'vigente' && fechaISO_(b.avisoEn) && hoy >= fechaISO_(b.avisoEn) && !String(b[campo] || '').trim()
      && !(fechaISO_(b[posp]) && hoy < fechaISO_(b[posp])))
    .map(b => {
      const pr = json313_(b.promoSnap, {}) || {}, n = json313_(b.normal, {}) || {}, fin = fechaISO_(b.fin);
      const partes = [];
      if (n.costoVisita) partes.push('B/. ' + n2_313_(n.costoVisita) + ' por visita');
      if (n.tarifaKgAdic) partes.push('kilo adicional B/. ' + n2_313_(n.tarifaKgAdic));
      return { id: String(b.id), clave: 'beneficio:' + String(b.id), cliente: String(b.cliente || ''), clienteId: String(b.clienteId || clienteDeBeneficio313_(b) || ''),
        codigoPropuesta: String(b.codigoPropuesta || ''), promo: String(pr.nombre || ''), fin: fin,
        dias: Math.max(0, diasEntre313_(hoy, fin)), planNormal: (n.plan ? n.plan + ' · ' : '') + partes.join(' · '),
        cambia: cambiaEnFactura313_(pr, n) };
    })
    .sort((a, b) => a.fin < b.fin ? -1 : 1);
}
/* Qué cambia en la factura del cliente cuando termina el beneficio. */
function cambiaEnFactura313_(pr, n) {
  const l = [];
  (pr.beneficios || []).forEach(b => {
    if (b.tipo === 'precio') l.push('Precio por visita: de B/. ' + n2_313_(b.precio) + ' a B/. ' + n2_313_(n.costoVisita));
    else if (b.tipo === 'kgAdicional') l.push('Kilo adicional: de B/. ' + n2_313_(b.precio) + ' a B/. ' + n2_313_(n.tarifaKgAdic));
    else if (b.tipo === 'gratis') l.push('Deja de ir sin costo: ' + b.cantidad + ' ' + b.nombre + ' ' + (CADA_TXT_313[b.cada] || 'al mes'));
    else if (b.tipo === 'visitasExtra') l.push('Terminan las ' + b.cantidad + (Number(b.cantidad) === 1 ? ' visita extra' : ' visitas extra') + ' sin costo al mes');
  });
  return l;
}
/* Qué módulo de Mi día le toca a un rol. */
function modBeneficio313_(u, modulo) {
  if (modulo === 'cobros' || modulo === 'mercadeo') return modulo;
  return u.rol === 'cobros' ? 'cobros' : 'mercadeo';
}

/* Promociones que terminan: accion 'manana' (no mostrarlo hasta mañana),
   'atendido' (ya se hizo lo que tocaba) o 'enterado' (visto, no hay nada que
   hacer). modulo = 'mercadeo'|'cobros'. Cada módulo lleva su propia marca. */
function api_marcarAvisoPromo(pin, id, accion, modulo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (['manana', 'atendido', 'enterado'].indexOf(String(accion)) < 0) return { ok: false, error: 'Acción desconocida.' };
  const m = modBeneficio313_(u, modulo);
  const puede = m === 'cobros' ? ['cobros', 'supervisor', 'admin', 'mercadeo'].indexOf(u.rol) >= 0 : puedeEscribirMer313_(u);
  if (!puede) return { ok: false, error: 'Sin permiso.' };
  return candado313_(() => {
    const t = tabla313_(HOJA_BEN_313, COLS_BEN_313);
    const b = t.filas.filter(x => String(x.id) === String(id))[0];
    if (!b) return { ok: false, error: 'No encontré ese beneficio.' };
    const c = {};
    if (accion === 'manana') c[m === 'cobros' ? 'posponerCobros' : 'posponerMercadeo'] = sumarDias313_(hoy313_(), 1);
    else c[m === 'cobros' ? 'atendidoCobros' : 'atendidoMercadeo'] = accion + ' · ' + u.nombre + ' · ' + hoy313_();
    actualizar313_(t, b._fila, c);
    return { ok: true, promosQueTerminan: promosQueTerminan_(m) };
  });
}
/* Alias del primer borrador («Ya lo atendí»). */
function api_beneficioAtendido(pin, id, modulo) { return api_marcarAvisoPromo(pin, id, 'atendido', modulo); }

