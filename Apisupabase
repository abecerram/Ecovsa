  const calcD = D => asis_calc_(asis_ordenar_(R[D].ids, X), X, salidaDe(D));
  const pasa = D => { const tp = tipoD(D); const c = calcD(D); return { c: c, hora: (tp === 'normal' || tp === 'colchon') && c.regreso > topeMin, paradas: R[D].ids.length > topeP(D) }; };
