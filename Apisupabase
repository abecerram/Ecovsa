  /* api 3.13: sin representante, folio, cuenta y correos de ECOVSA no hay contrato */
  const fe313 = faltanEmpresa313_();
  if (fe313.length) faltan['Datos de la empresa (Configuración)'] = fe313;
  return faltan;
}

