  })).filter(r => r.cantidad > 0);
}

function rep_cada_(v) {
  v = String(v || '').toLowerCase();
  return v === 'visita' ? 'visita' : 'mes';
}

function rep_agregar_(u, o) {
  const cid = crm_txt_(o.clienteId), cnom = crm_txt_(o.clienteNombre), cat = crm_txt_(o.catId);
  if ((!cid && !cnom) || !cat) return null;
  const cant = Math.max(0, Number(o.cantidad) || 0);
  if (!cant) return null;
  const k = cid ? 'I' + cid : 'N' + crm_clave_(cnom);
  const ya = crm_filas_(HOJA_REP).find(r => crm_txt_(r.catId) === cat && (crm_txt_(r.clienteId) ? 'I' + crm_txt_(r.clienteId) : 'N' + crm_clave_(r.clienteNombre)) === k);
  const datos = { clienteId: cid, clienteNombre: cnom, catId: cat, nombre: crm_txt_(o.nombre).slice(0, 90), insumoId: crm_txt_(o.insumoId),
                  cantidad: cant, cada: rep_cada_(o.cada), ref: crm_txt_(o.ref), activo: 'SI', cambiadoPor: u.nombre, cambiadoEn: crm_ahora_() };
  if (o.nota !== undefined) datos.nota = crm_txt_(o.nota).slice(0, 200);
  if (o.origen !== undefined) datos.origen = crm_txt_(o.origen).slice(0, 40);   // api 3.13: 'promo:<id>' se apaga al terminar el beneficio (3.33: '' lo limpia)
  /* api 3.33 · lo nuevo o cambiado que llega de Mercadeo queda «por revisar» en la Bandeja de Logística (si lo pone Logística, ya va revisado).
     Si vuelve igual (misma cantidad, misma frecuencia y activo), no se vuelve a pedir revisión. */
  const rev = o.revisado ? { porRevisar: '', revisadoPor: u.nombre, revisadoEn: crm_ahora_() } : { porRevisar: 'SI' };   // la última revisión se conserva
  if (ya) {
    const igual = String(ya.activo || 'SI').toUpperCase() !== 'NO' && Number(ya.cantidad) === cant && rep_cada_(ya.cada) === datos.cada &&
                  (datos.nota === undefined || crm_txt_(ya.nota) === datos.nota);       // «cada 3 meses» → «cada 6 meses» va en la nota
    if (!igual || o.revisado) Object.assign(datos, rev);
    crm_cambiar_(HOJA_REP, COLS_REP, 'repId', crm_txt_(ya.repId), datos); return crm_txt_(ya.repId);
  }
  const id = 'REP-' + new Date().getTime().toString(36).toUpperCase() + Math.floor(Math.random() * 90 + 10);
  crm_agregar_(HOJA_REP, COLS_REP, Object.assign({ repId: id, nota: '', creadoPor: u.nombre, creadoEn: crm_ahora_(), revisadoPor: '', revisadoEn: '' }, datos, rev));
  return id;
}

function rep_entregadoMes_(REC, mes) {
  const hecho = {};
  (REC || []).forEach(r => {
    const e = String(r.entregas || '').trim(); if (!e) return;
    if (fechaISO_(r['Fecha de Recoleccion']).slice(0, 7) !== mes) return;
    let l = []; try { l = JSON.parse(e); } catch (x) { return; }
    const nom = crm_clave_(r.Cliente);
    (Array.isArray(l) ? l : []).forEach(it => { const k = nom + '|' + crm_txt_(it.catId || it.repId); hecho[k] = (hecho[k] || 0) + (Number(it.cantidad) || 0); });
  });
  return hecho;
}

function rep_paraClientes_(clientes, REC, fecha) {
  const filas = rep_filas_(); if (!filas.length) return {};
  const idPorNom = {}, nomPorId = {};
