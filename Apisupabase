    tipo: 'suspendido', clave: c.clave, siguientePaso: 'Cobrar para reactivar', fechaSiguiente: cobA_mas_(L.hoy, 7)
  });
  return { ok: true, puntos: hechos.length };
}

function api_cobCargarLote(pin, d) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  d = d || {};
  const L = cobA_libro_();
  const facs = (d.facturas || []), pags = (d.pagos || []), ncs = (d.notas || []);   // api 3.13.1: notas de crédito
  if (!facs.length && !pags.length && !ncs.length) return { ok: false, error: 'No hay nada nuevo para cargar.' };
  const n = cobA_leer_(HOJA_LOTES).length + 1;
  const loteId = 'LT-' + L.hoy.slice(0, 4) + '-' + ('000' + n).slice(-4);
  const hF = cobA_hoja_(HOJA_FAC, COLS_FAC.concat(COLS_FAC_NUEVAS));
  const hP = cobA_hoja_(HOJA_PAG, COLS_PAG.concat(COLS_PAG_NUEVAS));
  const saltadas = [];
  let nf = 0, np = 0, tf = 0, tp = 0;
  const nuevasNum = {};
  facs.forEach(f => {
    const num = String(f.factura || '').trim();
    if (!num || L.facPorNum[num] || nuevasNum[num]) { saltadas.push('factura ' + num + ' ya existe'); return; }
    const total = cobA_r2_(f.monto);
    if (!(total > 0)) { saltadas.push('factura ' + num + ' sin monto'); return; }
    const fecha = fechaISO_(f.fecha) || L.hoy;
    const plazo = Number(f.plazo) || 30;
    nuevasNum[num] = 1;
    cobA_agregar_(hF, { factura: num, fecha: fecha, clienteId: f.clienteId || '', cliente: String(f.cliente || ''), 'razon social': String(f.razon || f.cliente || ''),
      ruc: String(f.ruc || ''), periodo: String(f.periodo || ''), concepto: String(f.concepto || 'Servicio ECOVSA'),
      /* api 3.13.1: si el archivo trae subtotal e ITBMS y cuadran con el total, se guardan separados */
      monto: (Math.abs(cobA_r2_(f.subtotal) + cobA_r2_(f.itbms) - total) < 0.011 && cobA_r2_(f.subtotal) > 0) ? cobA_r2_(f.subtotal) : total,
      itbms: (Math.abs(cobA_r2_(f.subtotal) + cobA_r2_(f.itbms) - total) < 0.011 && cobA_r2_(f.subtotal) > 0) ? cobA_r2_(f.itbms) : 0, total: total,
      plazo: plazo, vencimiento: cobA_mas_(fecha, plazo), estado: '', notas: 'Cargada en el lote ' + loteId, registradoPor: a.u.nombre, registradoEn: new Date(), lote: loteId });
    nf++; tf += total;
  });
  const firmas = {};
  L.pagos.forEach(p => { firmas[p.factura + '|' + p.fecha + '|' + p.monto.toFixed(2)] = 1; });
  pags.forEach((p, i) => {
    const num = String(p.factura || '').trim();
    const fecha = fechaISO_(p.fecha) || L.hoy;
    const monto = cobA_r2_(p.monto);
    if (!(monto > 0)) { saltadas.push('pago sin monto'); return; }
    const firma = num + '|' + fecha + '|' + monto.toFixed(2);
    if (firmas[firma]) { saltadas.push('pago de B/. ' + monto.toFixed(2) + ' a ' + (num || 'sin factura') + ' ya existe'); return; }
    if (num && !L.facPorNum[num] && !nuevasNum[num]) { /* se guarda igual: va a Conciliar pagos */ }
    firmas[firma] = 1;
    cobA_agregar_(hP, { pagoId: 'PG' + new Date().getTime().toString(36).toUpperCase() + '-L' + (i + 1), factura: num, fecha: fecha, monto: monto,
      metodo: String(p.metodo || ''), referencia: String(p.referencia || ''), cliente: String(p.cliente || ''),
      notas: 'Cargado en el lote ' + loteId + (p.nota ? '. ' + p.nota : ''), registradoPor: a.u.nombre, registradoEn: new Date(), lote: loteId });
    np++; tp += monto;
  });
  /* api 3.13.1: notas de crédito → rebajan la factura que corrigen (se guarda el original para poder anular el lote) */
  let nn = 0, tn = 0;
  ncs.forEach(n => {
    const nota = String(n.nota || '').trim(), fac = String(n.factura || '').trim(), monto = cobA_r2_(Math.abs(Number(n.monto) || 0));
    if (!nota || !fac || !(monto > 0)) { saltadas.push('nota de crédito ' + (nota || 'sin número') + ' sin factura o sin monto'); return; }
    const r = cobA_ncAplicar313_(hF, fac, { nota: nota, fecha: fechaISO_(n.fecha) || L.hoy, monto: monto, lote: loteId, por: a.u.nombre });
    if (!r.ok) { saltadas.push('nota de crédito ' + nota + ': ' + r.error); return; }
    nn++; tn += monto;
  });
  if (!nf && !np && !nn) return { ok: false, error: 'Todo lo del lote ya estaba cargado.', saltadas: saltadas };
  cobA_agregar_(cobA_hoja_(HOJA_LOTES, COLS_LOTES), { loteId: loteId, fecha: cobA_ahora_(), quien: a.u.nombre, archivo: String(d.archivo || '').slice(0, 120),
    facturas: nf, pagos: np, totalFacturas: cobA_r2_(tf), totalPagos: cobA_r2_(tp), estado: 'CARGADO', notas: nn, totalNotas: cobA_r2_(tn) });
  marcar_('cobros');
  return { ok: true, loteId: loteId, facturas: nf, pagos: np, totalFacturas: cobA_r2_(tf), totalPagos: cobA_r2_(tp), notas: nn, totalNotas: cobA_r2_(tn), saltadas: saltadas };
}

function api_cobAnularLote(pin, loteId, motivo) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  const J = jur_guard_(a.u, 'cobros', 'Un lote de facturas y pagos'); if (J) return J;          // api 3.12
  const m = String(motivo || '').trim();
  if (!m) return { ok: false, error: 'Escribe por qué se anula.' };
  const L = cobA_libro_();
  const lote = cobA_leer_(HOJA_LOTES).filter(l => String(l.loteId) === String(loteId))[0];
  if (!lote) return { ok: false, error: 'No encontré el lote.' };
  if (String(lote.estado).toUpperCase() === 'ANULADO') return { ok: false, error: 'Ya estaba anulado.' };
  const fechaLote = String(lote.fecha instanceof Date ? Utilities.formatDate(lote.fecha, tzHoja_(), 'yyyy-MM-dd') : lote.fecha).slice(0, 10);
  if (fechaLote !== L.hoy && a.u.rol !== 'admin') return { ok: false, error: 'Un lote de otro día solo lo anula el administrador.' };
  const sus = L.facturas.filter(f => f.lote === loteId).map(f => f.factura);
  const ajenos = L.pagos.filter(p => sus.indexOf(p.factura) >= 0 && p.lote !== loteId && !p.anulado);
  if (ajenos.length) return { ok: false, error: 'Ya hay pagos registrados a facturas de este lote (' + ajenos.map(p => p.factura).join(', ') + '). Corrige una por una.' };
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  /* se quitan las filas del lote, de abajo hacia arriba (con copia en el registro de borrados) */
  const copiaLote = [];
  [[HOJA_PAG, 'lote'], [HOJA_FAC, 'lote']].forEach(par => {
    const h = ss.getSheetByName(par[0]); if (!h) return;
    const vals = h.getDataRange().getValues(), c = vals[0].map(String).indexOf(par[1]);
    if (c < 0) return;
