  /* quién no se mueve: se calcula cada vez por el cliente y el día, no por cómo quedó guardado */
  const esFijo = (id, D, origen) => {
    const pl = P.plan[id] || {}, xc = X.cli[id] || {}, o = String(origen || '');
    const diaF = String(ini_dow_(D) === 0 ? 7 : ini_dow_(D));
    if (/^extra:/.test(o)) return !!cfg.nunca.extras;
    if (o === 'unica' || (xc.unica && pl.proxima === D)) return !!cfg.nunca.unicas;
    if (pl.recurrencia && cli_tocaRec_(pl, D)) return !!cfg.nunca.recurrentes;
    if (String(xc.fijo || '').split(/[^0-9]+/).filter(String).indexOf(diaF) >= 0) return !!cfg.nunca.fijo;
    return false;
  };
