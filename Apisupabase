  if (String(x.estado) !== 'PENDIENTE') return { ok: false, error: 'Esa ya se revisó.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    if (aprobar) {
      const k = cli_escribir_([Number(x.clienteId)], { lat: map_r6_(x.lat), lng: map_r6_(x.lng), operPor: u.nombre, operEn: new Date() });
      if (!k) return { ok: false, error: 'No encontré ese cliente.' };
    }
    cobA_cambiar_(cobA_hoja_(HOJA_UBP, COLS_UBP), 'ubId', ubId, { estado: aprobar ? 'APROBADA' : 'DESCARTADA', revisadoPor: u.nombre, revisadoEn: map_ahora_() });
    marcar_('logistica');
    return { ok: true };
  } finally { lock.releaseLock(); }
}

