/* ── Cálculo (la referencia del tarifario) ─────────────────────── */
/* Frecuencia sugerida por los kilos al mes; con anatomopatológico, nunca
   menos que semanal (si la regla está prendida). */
function frecuenciaSugerida313_(kgMes, anatomo, T) {
  const reglas = (T.planes || []).slice();
  let r = reglas.filter(x => x.hasta == null || kgMes <= Number(x.hasta))[0] || reglas[reglas.length - 1] || { frecuencia: 'MENSUAL', visitas: 1 };
  let frec = String(r.frecuencia || 'MENSUAL').toUpperCase();
  if (anatomo && T.anatomoSemanal && visitasDe313_(frec) < 4) frec = 'SEMANAL';
  return frec;
}
function tramoKg313_(kgMes, T) {
  const kg = T.kg || [];
  for (let i = 0; i < kg.length; i++) {
    if (kg[i].hasta == null || kgMes <= Number(kg[i].hasta))
      return { desde: i ? Number(kg[i - 1].hasta) : 0, hasta: kg[i].hasta == null ? null : Number(kg[i].hasta), precio: Number(kg[i].precio) || 0 };
  }
  const u = kg[kg.length - 1] || { hasta: null, precio: 0 };
  return { desde: 0, hasta: null, precio: Number(u.precio) || 0 };
}
function viajeZona313_(zona, km, T) {
  const base = Number((T.zonas || {})[String(zona || '').toUpperCase()]) || 0;
  const extraKm = Math.max(0, (Number(km) || 0) - (Number(T.recargoDesdeKm) || 0));
  const extra = (Number(km) || 0) > (Number(T.recargoDesdeKm) || 0) ? r2_313_(extraKm * (Number(T.recargoKm) || 0)) : 0;
  return { base: base, extra: extra, total: r2_313_(base + extra) };
}
/* Lo que cuesta al mes un servicio cobrado; lo que no es de cada mes se
   REPARTE (precio / meses). */
function servicioMes313_(s, visitas) {
  if (s.modo !== 'cobrado' || s.cantidad === 'solicitud') return 0;
  const cant = Number(s.cantidad) || 1, precio = Number(s.precio) || 0;
  if (s.cada === 'visita') return r2_313_(precio * cant * (Number(visitas) || 0));
  const meses = MESES_CADA_313[s.cada] || 1;
  return r2_313_(precio * cant / meses);
}
/* La fórmula de referencia: kilos por visita × precio del kg del tramo
   + viaje de la zona (+ recargo por km), con el mínimo por visita. */
function calcularPlan313_(datos, T) {
  T = T || tarifario313_();
  const kgMes = Number(datos.kgMes) || 0;
  const sugerida = frecuenciaSugerida313_(kgMes, !!datos.anatomo, T);
  const frec = String(datos.frecuencia || '').toUpperCase().trim() || sugerida;
  const visitas = visitasDe313_(frec, datos.visitas) || 1;
  const tramo = tramoKg313_(kgMes, T);
  const kgVisita = kgMes / visitas;
  const viaje = viajeZona313_(datos.zona, datos.km, T);
  const calc = kgVisita * tramo.precio + viaje.total;
  const minimo = Number(T.minimoRuta) || 0;
  const referencia = r2_313_(Math.max(minimo, calc));
  const precio = (datos.precio === '' || datos.precio == null) ? null : r2_313_(datos.precio);
  const usar = precio != null ? precio : referencia;
  const diferenciaPct = precio != null && referencia ? Math.round((precio - referencia) / referencia * 100) : 0;
  const recoleccionMes = r2_313_(usar * visitas);
  const servicios = serviciosForma313_(datos.servicios || [], visitas).map(s => Object.assign(s, {
    repartido: s.modo === 'cobrado' && s.cada !== 'visita' && s.meses > 1 }));
  const serviciosMes = r2_313_(servicios.reduce((a, s) => a + s.total, 0));
  return { sugerida: sugerida, frecuencia: frec, visitas: visitas, tramo: tramo, precioKg: tramo.precio, kgVisita: r2_313_(kgVisita),
    viaje: viaje, minimo: minimo, alMinimo: calc < minimo, referencia: referencia, referenciaMes: r2_313_(referencia * visitas),
    precio: usar, diferenciaPct: diferenciaPct, recoleccionMes: recoleccionMes, servicios: servicios, serviciosMes: serviciosMes,
    totalMes: r2_313_(recoleccionMes + serviciosMes), gran: kgMes >= (Number(T.granDesdeKg) || 100) };
}
function api_calcularPlan(pin, datos) {
  const e = entrar313_(pin, 'lee'); if (e.error) return e.error;
  const r = calcularPlan313_(datos || {});
  return Object.assign({ ok: true }, r);
}

