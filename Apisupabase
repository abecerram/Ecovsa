function sst_json_(s, def) { try { return s ? JSON.parse(String(s)) : def; } catch (e) { return def; } }
/* Limpia lo que manda la pantalla: textos recortados, números reales, listas y objetos con tope. Sin funciones ni claves raras. */
function sst_limpiar_(v, prof) {
  prof = prof || 0;
  if (v == null) return '';
  if (typeof v === 'string') return v.replace(/\u0000/g, '').trim().slice(0, 2000);
  if (typeof v === 'number') return isFinite(v) ? v : 0;
  if (typeof v === 'boolean') return v;
  if (Array.isArray(v)) return prof > 4 ? [] : v.slice(0, 200).map(z => sst_limpiar_(z, prof + 1));
