const SST_AJUSTE_333 = 'SST_AJUSTE_333';
const SST_F03_NOMBRE = 'Registro de certificados de buena salud y vacunas';
function sst_ajuste333_() {
  const pr = PropertiesService.getScriptProperties();
  if (pr.getProperty(SST_AJUSTE_333)) return;
  const t = cal_tab_('doc');
  let n = 0;
  t.filas.forEach(f => {
    const c = cal_t_(f.codigo);
    if (!/^F-SST-0[1-6]$/.test(c)) return;
    const cambios = {};
    if (cal_t_(f.estado) === 'falta') cambios.estado = 'por_aprobar';
    if (c === 'F-SST-03' && cal_t_(f.nombre, 160) !== SST_F03_NOMBRE) cambios.nombre = SST_F03_NOMBRE;
    if (!Object.keys(cambios).length) return;
    cambios.cambiadoEn = "'" + cal_ahora_(); cambios.cambiadoPor = 'Sistema (api 3.33)';
    actualizar313_(t, f._fila, cambios);
    n++;
  });
  if (n) sst_his_(null, 'Ajuste de la revisión del 14 oct', n + (n === 1 ? ' formato' : ' formatos') + ' F-SST en «Por aprobar» · el F-SST-03 se llama «' + SST_F03_NOMBRE + '»');
  pr.setProperty(SST_AJUSTE_333, cal_ahora_());
}

