    const v = sst_desdeSolidos_(e);
    return { t: t, fila: null, nueva: true, datos: { n: v.n, p: v.p, puestoTipo: v.puestoTipo, linea: 'Sólidos', est: 'activo', mina: 'No', usr: v.usr, solidosId: sid, na: v.na }, id: '' };
  }
  const f = t.filas.find(z => sst_t_(z.regId, 40) === id && sst_t_(z.tipo, 20) === 'persona' && sst_t_(z.estado, 12) !== 'quitado');
  if (!f) return { e: { ok: false, error: 'No encontré a esa persona.' } };
