function api_crmGuardarDocumento(pin, d) {
  const x = crm_usuario_(pin, true); if (x.error) return x.error;
  d = d || {};
  const ahora = crm_ahora_();
  const evento = crm_txt_(d.evento) || (crm_txt_(d.id) ? 'Cambió' : 'Registrado');
  if (crm_txt_(d.id) && crm_txt_(d.id).indexOf('auto-') !== 0) {
    const prev = crm_filas_(HOJA_CRM_DOC).map(crm_documento_).find(y => y.id === crm_txt_(d.id));
    if (!prev) return { ok:false, error:'No encontré el documento.' };
    const cambios = {};
    ['tipo','nombre','estado','canal','enviadoA','enviadoEn','validoHasta','archivoId','enlace','notas'].forEach(k => { if (d[k] !== undefined) cambios[k] = crm_txt_(d[k]); });
    if (d.nuevaVersion) cambios.version = prev.version + 1;
    if (cambios.estado === 'enviada' && !cambios.enviadoEn) cambios.enviadoEn = ahora;
    const hist = prev.historial.concat([{ cuando: ahora, quien: x.u.nombre, que: evento +
      (cambios.estado && cambios.estado !== prev.estado ? ' · ' + prev.estado + ' → ' + cambios.estado : '') +
      (d.nuevaVersion ? ' · versión ' + (prev.version + 1) : '') + (cambios.enviadoA ? ' · a ' + cambios.enviadoA : '') }]);
    cambios.historial = JSON.stringify(hist.slice(-40));
    const r = crm_cambiar_(HOJA_CRM_DOC, COLS_CRM_DOC, 'id', prev.id, cambios);
    /* api 3.13: al anotar el envío de la propuesta se guarda la foto de sus textos */
    if (cambios.estado === 'enviada' && prev.tipo === 'propuesta' && prev.refTipo === 'op') alEnviarPropuesta313_(prev.ref, !!d.nuevaVersion);
    if (cambios.estado === 'firmada' && prev.refTipo === 'op') {
      const casilla = prev.tipo === 'contrato' ? 'doc contrato firmado' : prev.tipo === 'propuesta' ? 'doc propuesta firmada' : '';
      if (casilla) crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', prev.ref, { [casilla]: 'SI' });
    }
    if (cambios.estado === 'enviada' || evento === 'Enviado')
      crm_registrarActividad_(x.u, { tipo: cambios.canal === 'whatsapp' ? 'whatsapp' : 'correo', ref: prev.ref, refTipo: prev.refTipo, cuenta: prev.cuenta,
        texto: 'Envió ' + prev.nombre + (cambios.enviadoA ? ' a ' + cambios.enviadoA : '') });
    return { ok:true, documento: crm_documento_(r) };
  }
  if (!crm_txt_(d.ref)) return { ok:false, error:'Falta a qué oportunidad o cliente pertenece.' };
  if (!crm_txt_(d.tipo)) return { ok:false, error:'Falta el tipo de documento.' };
  const nuevo = { id: crm_id_('DOC'), tipo: crm_txt_(d.tipo), ref: crm_txt_(d.ref), refTipo: crm_txt_(d.refTipo) || 'op',
                  cuenta: crm_txt_(d.cuenta), nombre: crm_txt_(d.nombre) || crm_txt_(d.tipo), version: crm_n_(d.version) || 1,
                  estado: crm_txt_(d.estado) || 'borrador', canal: crm_txt_(d.canal), enviadoA: crm_txt_(d.enviadoA),
                  enviadoEn: crm_txt_(d.enviadoEn) || (crm_txt_(d.estado) === 'enviada' ? ahora : ''), validoHasta: crm_txt_(d.validoHasta),
                  archivoId: crm_txt_(d.archivoId), enlace: crm_txt_(d.enlace), notas: crm_txt_(d.notas),
                  creadoPor: x.u.nombre, creadoEn: ahora,
                  historial: JSON.stringify([{ cuando: ahora, quien: x.u.nombre, que: evento }]) };
  crm_agregar_(HOJA_CRM_DOC, COLS_CRM_DOC, nuevo);
  if (nuevo.estado === 'enviada' && nuevo.tipo === 'propuesta' && nuevo.refTipo === 'op') alEnviarPropuesta313_(nuevo.ref, false);   // api 3.13
  if (nuevo.estado === 'enviada')
    crm_registrarActividad_(x.u, { tipo: nuevo.canal === 'whatsapp' ? 'whatsapp' : 'correo', ref: nuevo.ref, refTipo: nuevo.refTipo, cuenta: nuevo.cuenta,
      texto: 'Envió ' + nuevo.nombre + (nuevo.enviadoA ? ' a ' + nuevo.enviadoA : '') });
  /* subir el contrato o la propuesta firmada marca la casilla de la ficha */
  if (nuevo.refTipo === 'op' && nuevo.estado === 'firmada') {
    const casilla = nuevo.tipo === 'contrato' ? 'doc contrato firmado' : nuevo.tipo === 'propuesta' ? 'doc propuesta firmada' : '';
    if (casilla) crm_cambiar_(HOJA_PRO, COLS_PRO, 'codigoPropuesta', nuevo.ref, { [casilla]: 'SI' });
  }
  return { ok:true, documento: crm_documento_(nuevo) };
}

function api_crmSubirArchivo(pin, a) {
