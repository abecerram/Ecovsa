}
function sst_item_(f) {
  const d = sst_json_(f.datos, {});
  return Object.assign({}, d, { id: sst_t_(f.regId, 40), _ref: sst_t_(f.ref, 60), _creadoPor: sst_t_(f.creadoPor, 80), _creadoEn: sst_t_(f.creadoEn, 20),
    _cambiadoPor: sst_t_(f.cambiadoPor, 80), _cambiadoEn: sst_t_(f.cambiadoEn, 20) });
