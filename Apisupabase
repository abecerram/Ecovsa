function cobA_armarCuotas_(facturas, tipo, primera, n, abono, cadaDias) {
  const r2 = cobA_r2_;
  const tot = r2(facturas.reduce((s, f) => s + f.saldo, 0));
  const fechaK = k => cadaDias ? cobA_mas_(primera, k * cadaDias) : cobA_masMeses_(primera, k);
  if (tipo === 'viejaMes') return facturas.map((f, i) => ({ fecha: fechaK(i), monto: f.saldo, facturas: [f.factura] }));
  if (tipo === 'abono') {
    const ab = Math.min(r2(abono), tot);
    const resto = r2(tot - ab), m = Math.max(1, Number(n) || 1);
    const base = Math.floor(resto / m * 100) / 100;
    const q = [{ fecha: primera, monto: ab, facturas: [] }];
    for (let i = 0; i < m; i++) q.push({ fecha: fechaK(i + 1), monto: i === m - 1 ? r2(resto - base * (m - 1)) : base, facturas: [] });
    return q;
  }
  const m = Math.max(1, Number(n) || 1);
  const base = Math.floor(tot / m * 100) / 100;
  const q = [];
  for (let i = 0; i < m; i++) q.push({ fecha: fechaK(i), monto: i === m - 1 ? r2(tot - base * (m - 1)) : base, facturas: [] });
  return q;
}

function cobA_masMeses_(iso, n) {
  const d = new Date(String(iso) + 'T12:00:00'), dia = d.getDate();
  d.setDate(1); d.setMonth(d.getMonth() + n);
  const ult = new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate();
  d.setDate(Math.min(dia, ult));
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
}

function api_cobCrearPlan(pin, d) {
  const a = cobA_trabaja_(pin); if (a.error) return a.error;
  d = d || {};
  const L = cobA_libro_();
  const c = L.cuentas[String(d.clave || '')];
  if (!c) return { ok: false, error: 'No encontré la cuenta.' };
  const nums = (d.facturas || []).map(String);
  const fs = L.facturas.filter(f => f.clave === c.clave && nums.indexOf(f.factura) >= 0 && f.saldo > 0.009)
    .sort((x, y) => x.fecha < y.fecha ? -1 : 1);
  if (!fs.length) return { ok: false, error: 'Elige al menos una factura abierta.' };
  const tipo = ['viejaMes', 'iguales', 'abono'].indexOf(d.tipo) >= 0 ? d.tipo : 'iguales';
  const primera = fechaISO_(d.primera);
  if (!primera || primera < L.hoy) return { ok: false, error: 'La primera cuota tiene que ser de hoy en adelante.' };
  if (tipo === 'abono' && !(Number(d.abono) > 0)) return { ok: false, error: 'Escribe el abono inicial.' };
  const vivos = L.planes.filter(p => p.clave === c.clave && ['PROPUESTO', 'ACTIVO', 'ATRASADO'].indexOf(p.estado) >= 0);
  if (vivos.length) return { ok: false, error: 'Esta cuenta ya tiene un plan ' + vivos[0].estado.toLowerCase() + ' (' + vivos[0].planId + '). Anúlalo antes de hacer otro.' };
  const cuotas = cobA_armarCuotas_(fs, tipo, primera, d.cuotas, d.abono, Number(d.cadaDias) || 0);
  const total = cobA_r2_(fs.reduce((s, f) => s + f.saldo, 0));
  const suma = cobA_r2_(cuotas.reduce((s, q) => s + q.monto, 0));
  if (Math.abs(suma - total) > 0.01) return { ok: false, error: 'Las cuotas no suman el total. Revisa el abono.' };
  const n = L.planes.filter(p => p.planId.indexOf('PP-' + L.hoy.slice(0, 4)) === 0).length + 1;
  const planId = 'PP-' + L.hoy.slice(0, 4) + '-' + ('000' + n).slice(-3);
  cobA_agregar_(cobA_hoja_(HOJA_PLANES, COLS_PLANES), {
    planId: planId, clave: c.clave, cliente: c.cliente, ruc: c.ruc || c.rucFactura, tipo: tipo, estado: d.aceptado ? 'ACTIVO' : 'PROPUESTO',
    facturas: fs.map(f => f.factura).join(', '), total: total, cuotas: JSON.stringify(cuotas),
    creadoPor: a.u.nombre, creadoEn: L.hoy, aceptadoEn: d.aceptado ? L.hoy : '', notas: String(d.notas || '').slice(0, 500)
  });
  cobA_agregar_(cobA_hojaGes_(), {
    gestionId: 'GC' + new Date().getTime().toString(36).toUpperCase(), fecha: L.hoy, cliente: c.cliente, 'razon social': c.razon, ruc: c.ruc,
    canal: 'plan', saldoEnEseMomento: c.saldo, facturas: fs.map(f => f.factura).join(', '), mensaje: '',
    seCompromete: 'NO', resultado: 'PLAN ' + (d.aceptado ? 'ACEPTADO' : 'PROPUESTO'), notas: cuotas.length + ' cuotas · B/. ' + total.toFixed(2),
    hechoPor: a.u.nombre, registradoEn: new Date(), tipo: 'plan', siguientePaso: d.aceptado ? 'Cobrar la cuota 1' : 'Confirmar si acepta el plan',
    fechaSiguiente: d.aceptado ? cobA_mas_(cuotas[0].fecha, -7) : cobA_mas_(L.hoy, 3), planId: planId, clave: c.clave
  });
  marcar_('cobros');
  return { ok: true, planId: planId, cuotas: cuotas, total: total };
}

function api_cobEstadoPlan(pin, planId, estado, motivo) {
