function api_crmInicio(pin) {
  const x = crm_usuario_(pin); if (x.error) return x.error;
  tareaDiaria313_();   // api 3.13
  const u = x.u, hoy = hoyPanama_(), aj = crm_ajustes_();
  const esMia = t => u.rol !== 'mercadeo' || !t.asignado || t.asignado === u.nombre;
  const tareas = crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => t.estado === 'pendiente' && esMia(t));
  const hoyT = tareas.filter(t => t.fecha === hoy).sort((a, b) => (a.hora || '99').localeCompare(b.hora || '99'));
  const atrasadas = tareas.filter(t => t.fecha && t.fecha < hoy).sort((a, b) => a.fecha.localeCompare(b.fecha));
  const sinFecha = tareas.filter(t => !t.fecha);
  const semana = tareas.filter(t => t.fecha > hoy && t.fecha <= crm_masDias_(hoy, 7))
                       .sort((a, b) => (a.fecha + a.hora).localeCompare(b.fecha + b.hora));

  const pros = crm_filas_(HOJA_PRO).map(r => crm_oportunidad_(r, aj, hoy));
  const abiertas = pros.filter(p => p.abierta);
  const embudo = ESTADOS_PRO.filter(e => CRM_GANADAS.concat(CRM_PERDIDAS).indexOf(e) < 0).map(e => {
    const l = abiertas.filter(p => p.estado === e);
    return { etapa: e, n: l.length, valor: crm_r_(l.reduce((s, p) => s + p.valor, 0), 2),
             ponderado: crm_r_(l.reduce((s, p) => s + p.ponderado, 0), 2),
             excedidas: l.filter(p => p.excedido).length };
  });

  const mes = hoy.slice(0, 7), mesAnt = crm_masDias_(hoy.slice(0, 8) + '01', -1).slice(0, 7);
  const cierreEn = (p, m) => String(p['fecha cierre'] || p['fecha contrato'] || '').slice(0, 7) === m;
  const kpi = m => {
    const g = pros.filter(p => p.ganada && cierreEn(p, m)), pe = pros.filter(p => p.perdida && cierreEn(p, m));
    return { ganadas: g.length, perdidas: pe.length,
             valorGanado: crm_r_(g.reduce((s, p) => s + p.valor, 0), 2),
             nuevas: pros.filter(p => String(p['fecha contacto'] || fechaISO_(p.registradoEn) || '').slice(0, 7) === m).length,
             conversion: (g.length + pe.length) ? Math.round(g.length / (g.length + pe.length) * 100) : null };
  };

  /* alertas: las novedades de siempre + oportunidades pasadas de su límite */
  let novedades = [];
  try { const nv = api_novedades(pin); if (nv && nv.ok) novedades = nv.novedades || []; } catch (e) { novedades = []; }
  const excedidas = abiertas.filter(p => p.excedido).sort((a, b) => (b.diasEtapa - b.limiteDias) - (a.diasEtapa - a.limiteDias))
    .slice(0, 12).map(p => ({ codigo: p.codigoPropuesta, empresa: p.empresa, etapa: p.estado,
                              dias: p.diasEtapa, limite: p.limiteDias }));
  const idx = crm_indices_();
  const sinTarea = abiertas.filter(p => !(idx.tareas[p.codigoPropuesta] || []).length)
    .map(p => ({ codigo: p.codigoPropuesta, empresa: p.empresa, etapa: p.estado })).slice(0, 12);

  const acts = crm_filas_(HOJA_CRM_ACT).map(crm_actividad_)
    .sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora)).slice(0, 15);
  const hechasHoy = crm_filas_(HOJA_CRM_TAR).map(crm_tarea_).filter(t => t.estado === 'hecha' && String(t.hechaEn).slice(0, 10) === hoy && esMia(t)).length;

  const compras = crm_filas_(HOJA_SP)
    .filter(s => u.rol !== 'mercadeo' || crm_txt_(s.solicitadoPor) === u.nombre)
    .filter(s => ['SOLICITADA','APROBADA'].indexOf(crm_txt_(s.estado).toUpperCase()) >= 0)
    .map(s => ({ solicitudId: crm_txt_(s.solicitudId), numero: crm_txt_(s.numero), proveedor: crm_txt_(s.proveedor),
                 total: crm_r_(s.total, 2), estado: crm_txt_(s.estado).toUpperCase(), urgencia: crm_txt_(s.urgencia),
                 etiqueta: spEtiqueta_(s), notaGerencia: crm_txt_(s.notaGerencia),
                 fecha: fechaISO_(s.fechaSolicitud || s.fecha),
                 dias: fechaISO_(s.fechaSolicitud || s.fecha) ? crm_dias_(fechaISO_(s.fechaSolicitud || s.fecha), hoy) : 0 }))
    .sort((a, b) => b.dias - a.dias);

  return { ok:true, usuario: u, hoy: hoy,
           tareas: { hoy: hoyT, atrasadas: atrasadas, sinFecha: sinFecha, semana: semana, hechasHoy: hechasHoy },
           embudo: embudo,
           totales: { abiertas: abiertas.length, valor: crm_r_(abiertas.reduce((s, p) => s + p.valor, 0), 2),
                      ponderado: crm_r_(abiertas.reduce((s, p) => s + p.ponderado, 0), 2) },
           mes: kpi(mes), mesAnterior: kpi(mesAnt), meta: crm_n_(aj.metaMensual),
           novedades: novedades, excedidas: excedidas, sinTarea: sinTarea,
           actividad: acts, compras: compras,
           promosQueTerminan: promosQueTerminan_('mercadeo') };   // api 3.13
}

