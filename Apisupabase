function flo_cargas_(COM) {
  const n = v => Number(v) || 0;
  const porVeh = {};
  COM.forEach(c => {
    const f = fechaISO_(c.fecha); if (!f) return;
    const v = normVeh_(c.vehiculo);
    (porVeh[v] = porVeh[v] || []).push({ cargaId: String(c.cargaId || ''), fecha: f, hora: horaTxt_(c.hora), vehiculo: String(c.vehiculo || ''),
      conductor: String(c.conductor || ''), estacion: String(c.estacion || '').trim(), litros: ini_r_(litrosCarga_(c), 2),
      monto: ini_r_(n(c.monto), 2), km: n(c.kilometraje) });
  });
  const todas = [];
  Object.keys(porVeh).forEach(v => {
    const l = porVeh[v].sort((a, b) => (a.km - b.km) || (a.fecha + a.hora).localeCompare(b.fecha + b.hora));
    for (let i = 0; i < l.length; i++) {
      const c = l[i], a = i ? l[i - 1] : null;
      c.precio = c.litros ? ini_r_(c.monto / c.litros, 3) : null;
      c.kmL = a && c.km > a.km && c.km - a.km < 3000 && c.litros > 0 ? ini_r_((c.km - a.km) / c.litros, 1) : null;
      c.kmDesde = a && c.km > a.km ? c.km - a.km : null;
      c.alertas = [];
      if (c.kmL !== null && c.kmL < KML_SOSPECHOSO) c.alertas.push('rinde ' + c.kmL + ' km/L');
      if (l.some(x => x !== c && x.fecha === c.fecha)) c.alertas.push('dos cargas el mismo día');
      todas.push(c);
    }
  });
  /* precio fuera de lo normal: contra la mediana del mes */
  const porMes = {};
  todas.forEach(c => { if (c.precio) (porMes[c.fecha.slice(0, 7)] = porMes[c.fecha.slice(0, 7)] || []).push(c.precio); });
  Object.keys(porMes).forEach(m => { const l = porMes[m].sort((a, b) => a - b); porMes[m] = l[Math.floor(l.length / 2)]; });
  todas.forEach(c => { const med = porMes[c.fecha.slice(0, 7)]; if (c.precio && med && Math.abs(c.precio - med) / med > 0.15) c.alertas.push('precio B/. ' + c.precio + '/L (normal ' + ini_r_(med, 2) + ')'); });
  return todas.sort((a, b) => (b.fecha + b.hora).localeCompare(a.fecha + a.hora));
}

function flo_kmL_(cargas, desde, hasta) {
  const l = cargas.filter(c => c.fecha >= desde && c.fecha <= hasta && c.kmL !== null && c.kmDesde);
  const km = l.reduce((s, c) => s + c.kmDesde, 0), lt = l.reduce((s, c) => s + c.litros, 0);
  return lt ? ini_r_(km / lt, 1) : null;
}

