/* La cuenta quedó con UNA sede: vuelve a ficha normal (kilos, frecuencia,
   precio, contacto; gran = false; conserva servicios y plan). La cuenta se
   guarda aparte en `cuentaAnterior` por si hay que mirarla. */
function api_cuentaAFichaNormal(pin, cod) {
  const e = entrar313_(pin, 'escribe'); if (e.error) return e.error;
  const p = prospecto313_(cod); if (!p) return { ok: false, error: 'No encontré esa oportunidad.' };
  if (prospectoBloqueado313_(p)) return { ok: false, error: 'La propuesta ya está firmada: no se cambia.' };
  const cu = cuentaDe313_(p);
  if (!cu || !Array.isArray(cu.grupos)) return { ok: false, error: 'Esta oportunidad no es una cuenta con sedes.' };
  const sedes = []; cu.grupos.forEach(g => (g.sedes || []).forEach(s => sedes.push({ g: g, s: s })));
  if (sedes.length !== 1) return { ok: false, error: 'La cuenta tiene ' + sedes.length + ' sedes: vuelve a ficha normal solo con una.' };
  const g = sedes[0].g, s = sedes[0].s;
  const pl = g.planId ? (planPorId313_(g.planId) || json313_(g.planSnap, null)) : null;
  const kgMes = Number(s.kgMes || s.kg) || 0;
  let visitas = Number(s.visitas) || (pl ? pl.visitas : 0);
  if (!visitas) visitas = calcularPlan313_({ kgMes: kgMes, zona: s.zona, km: s.km, anatomo: !!s.anatomo }).visitas;
  let costo;
  if (g.precio != null && g.precio !== '') costo = r2_313_(Number(g.precio) / visitas);
  else if (pl) costo = pl.precio;
  else costo = calcularPlan313_({ kgMes: kgMes, zona: s.zona, km: s.km, anatomo: !!s.anatomo, visitas: visitas, frecuencia: frecuenciaDeVisitas313_(visitas) }).referencia;
  const ct = s.contacto && typeof s.contacto === 'object' ? s.contacto : { nombre: s.contacto || '', telefono: s.telefono || '', correo: s.correo || '' };
  const campos = { frecuencia: pl ? pl.frecuencia : frecuenciaDeVisitas313_(visitas), 'costo visita': costo,
    'kg plan': g.kgIncluidos != null && g.kgIncluidos !== '' ? Number(g.kgIncluidos) : (pl ? pl.kgIncluidos : kgMes),
    'kg estimado': kgMes, generador: '', 'cuenta json': '', cuentaAnterior: JSON.stringify(cu) };
  if (!String(p.direccion || '').trim() && s.direccion) campos.direccion = s.direccion;
  if (!String(p.zona || '').trim() && s.zona) campos.zona = s.zona;
  if (!String(p.contacto || '').trim() && ct.nombre) campos.contacto = ct.nombre;
  if (!String(p.telefono || '').trim() && ct.telefono) campos.telefono = ct.telefono;
  if (!String(p.correo || '').trim() && ct.correo) campos.correo = ct.correo;
  if (!String(p.clienteId || '').trim() && s.clienteId) campos.clienteId = s.clienteId;
  if (pl) { campos.planId = pl.id; campos.planSnap = JSON.stringify(planSnapDe313_(pl)); }
  candado313_(() => { actualizarProspecto313_(cod, campos); return { ok: true }; });
  const gs = guardarServiciosProspecto313_(pin, cod, serviciosForma313_(g.servicios || [], visitas));
  if (gs && gs.ok === false) return { ok: false, error: 'Volvió a ficha normal, pero no se pudieron pasar sus servicios: ' + (gs.error || '') };
  return { ok: true };
}


