  if (!Object.prototype.hasOwnProperty.call(CRM_AJUSTES_BASE, raiz) && raiz !== 'reportesGuardados')
    return { ok:false, error:'Ajuste desconocido: ' + k };
  /* api 3.13: las listas (fuentes, motivos, sectores) se limpian: sin vacíos ni repetidos */
  if (['fuentes', 'motivosPerdida', 'sectores'].indexOf(k) >= 0 && Array.isArray(valor)) {
    const vistos = {};
