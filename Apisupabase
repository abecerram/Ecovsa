    const revHoy = revs.filter(r => fechaISO_(r.fecha) === hoy && String(r.momento) === 'salida').map(r => ({ hora: horaTxt_(r.hora), bien: n(r.bien), puntos: n(r.puntos), fallas: n(r.fallas), conductor: String(r.conductor || '') })).pop() || null;
    const franja = [];
    for (let i = 6; i >= 0; i--) {
      const d = ini_dia_(hoy, -i), rs = revs.filter(r => fechaISO_(r.fecha) === d && String(r.momento) !== 'ruta');
      franja.push({ fecha: d, estado: !rs.length ? 'no' : (rs.some(r => bloq.some(b => b.revisionId === String(r.revisionId))) ? 'bloq' : (rs.some(r => n(r.fallas) > 0) ? 'falla' : 'ok')) });
    }
    const act = activos.find(a => normVeh_(a.placa || a.nombre) === nv);
    const urg = act ? (act.tareas || []).filter(t => t.estado === 'VENCIDO' || t.estado === 'POR VENCER')
      .sort((a, b) => (a.estado === 'VENCIDO' ? 0 : 1) - (b.estado === 'VENCIDO' ? 0 : 1))[0] : null;
    const rutaHoy = rutasHoy.find(r => normVeh_(r.vehiculo) === nv);
    return { placa: v.placa, marca: v.marca || (act && act.marca) || '', activoId: (act && act.activoId) || '',
             estado: bloq.length ? 'bloqueado' : (fa.length ? 'falla' : 'ok'),
             conductor: rutaHoy ? rutaHoy.conductor : cond, rutaHoy: rutaHoy ? { rutaId: rutaHoy.rutaId, conductor: rutaHoy.conductor, paradas: rutaHoy.paradas.length } : null,
             odometro: odo, odometroFecha: odoF, kmMes: kmMes, kmMesAnt: kmMesAnt,   // api 3.34
             kmLMes: flo_kmL_(cv, mesIni, hoy), kmLAnt: flo_kmL_(cv, mesAntIni, mesAntFin),
             gastoMes: ini_r_(delMes.reduce((s, c) => s + c.monto, 0), 2), litrosMes: ini_r_(delMes.reduce((s, c) => s + c.litros, 0), 1),
             revisionHoy: revHoy, fallas: fa.map(f => ({ fallaId: f.fallaId, punto: f.punto, estado: f.estado, bloquea: f.bloquea, critico: f.critico })),
             plan: urg ? { tarea: urg.tarea, estado: urg.estado, faltanKm: urg.faltanKm, faltanDias: urg.faltanDias, vence: urg.vence } : null,
             franja: franja, tope: topeCamion_(v.placa, cfg, ACT) };
  });

  /* combustible de la flota en el mes */
  const delMes = cargas.filter(c => c.fecha >= mesIni);
  const kmMes = JOR.filter(j => fechaISO_(j.fecha) >= mesIni).reduce((s, j) => s + (n(j.kmRecorridos) || (n(j.kmFinal) > n(j.kmInicio) && n(j.kmInicio) ? n(j.kmFinal) - n(j.kmInicio) : 0)), 0);
  const REC = leerHoja_(HOJA_REC).filter(r => fechaISO_(r['Fecha de Recoleccion']) >= mesIni);
  const kgMes = REC.reduce((s, r) => s + (n(r['total Kg']) || n(r['Kg Recolectados']) + n(r['kg anatomopatologico']) + n(r['kg punzo cortantes'])), 0);
  const gasto = delMes.reduce((s, c) => s + c.monto, 0), litros = delMes.reduce((s, c) => s + c.litros, 0);
  const combustible = {
    mes: mes, gasto: ini_r_(gasto, 2), litros: ini_r_(litros, 1), cargas: delMes.length,
    kmL: flo_kmL_(cargas, mesIni, hoy), kmLAnt: flo_kmL_(cargas, mesAntIni, mesAntFin),
    gastoAnt: ini_r_(cargas.filter(c => c.fecha >= mesAntIni && c.fecha <= ini_dia_(mesAntIni, Number(hoy.slice(8)) - 1)).reduce((s, c) => s + c.monto, 0), 2),
    costoKm: kmMes ? ini_r_(gasto / kmMes, 3) : null, costoParada: REC.length ? ini_r_(gasto / REC.length, 2) : null, costoKg: kgMes ? ini_r_(gasto / kgMes, 3) : null,
    km: kmMes, lista: delMes.slice(0, 60), meta: META_KML
  };

  const peso = f => f.bloquea ? 0 : (f.estado === 'por confirmar' ? 1 : (f.estado === 'en taller' ? 3 : 2));
  let libres = []; try { libres = vehiculosFlota_().map(v => v.placa).filter(p => !rutasHoy.some(r => normVeh_(r.vehiculo) === normVeh_(p)) && !fallas.some(f => f.bloquea && normVeh_(f.vehiculo) === normVeh_(p))); } catch (e) {}
  const FAL = leerHoja_(HOJA_FAL);
  const extra = id => { const r = FAL.find(x => String(x.fallaId) === id) || {}; return { taller: String(r.tallerNombre || ''), tallerFecha: fechaISO_(r.tallerFecha) }; };
  return { ok: true, hoy: hoy, meta: META_KML, camiones: camiones,
           fallas: fallas.sort((a, b) => peso(a) - peso(b) || (b.fecha + b.hora).localeCompare(a.fecha + a.hora)).map(f => {
             const e = extra(f.fallaId), rh = rutasHoy.find(r => normVeh_(r.vehiculo) === normVeh_(f.vehiculo));
             return Object.assign({}, f, e, { dias: ini_diasEntre_(f.fecha, hoy), rutaHoy: rh ? { rutaId: rh.rutaId, conductor: rh.conductor, paradas: rh.paradas.length } : null }); }),
           historial: hist.sort((a, b) => b.fecha.localeCompare(a.fecha)).slice(0, 20),
           combustible: combustible, libres: libres, lista: flo_lista_() };
}

function flo_lista_() {
  const h = leerHoja_(HOJA_LIS).filter(p => String(p.puntoId || '').trim());
