function api_clientesARuta(pin, ids, fecha, rutaId, conductor, vehiculo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística arma rutas.' };
  const lista = (Array.isArray(ids) ? ids : [ids]).map(Number).filter(Boolean);
  const f = String(fecha || '').trim();
  if (!lista.length) return { ok: false, error: 'Elige al menos un cliente.' };
  if (!/^\d{4}-\d{2}-\d{2}$/.test(f)) return { ok: false, error: 'Elige el día.' };
  if (f < hoyPanama_()) return { ok: false, error: 'Ese día ya pasó.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
    const filas = leerHoja_(HOJA_RUT).filter(r => fechaISO_(r.fecha) === f);
    const ids_ = {};
    filas.forEach(r => { const k = String(r.rutaId); (ids_[k] = ids_[k] || []).push(r); });
    let rid = String(rutaId || '').trim();
    if (!rid) {
      const ks = Object.keys(ids_);
      if (ks.length === 1) rid = ks[0];
      else if (ks.length > 1) return { ok: false, error: 'Ese día hay ' + ks.length + ' rutas: elige a cuál.', rutas: ks };
    }
    let cond, veh, orden = 0, nueva = false;
    if (rid && ids_[rid]) {
      cond = String(ids_[rid][0].conductor || ''); veh = String(ids_[rid][0].vehiculo || '');
      ids_[rid].forEach(r => { orden = Math.max(orden, Number(r.orden) || 0); });
    } else {
      cond = String(conductor || '').trim(); veh = String(vehiculo || '').trim();
      if (!cond || !veh) return { ok: false, error: 'Ese día no hay ruta: elige conductor y camión.', sinRuta: true };
      rid = 'R' + new Date().getTime(); nueva = true;
    }
    const ya = {}; (ids_[rid] || []).forEach(r => ya[Number(r.clienteId)] = 1);
    /* api 3.34.1: no se agrega a la ruta un cliente suspendido o de baja */
    const fueraN = rut_fueraNuevos_(lista, Object.keys(ya));
    if (fueraN.length) return { ok: false, error: rut_errorFuera_(fueraN) };
    let n = 0;
    const ahora = new Date();
    lista.forEach(id => {
      if (ya[id]) return;
      orden++;
      h.appendRow(filaPorNombre_(h, { rutaId: rid, fecha: f, conductor: cond, vehiculo: veh, orden: orden,
                                     clienteId: id, creadaPor: u.nombre, creadaEn: ahora }));
      ya[id] = 1; n++;
    });
    marcar_('logistica');
    return { ok: true, rutaId: rid, fecha: f, conductor: cond, vehiculo: veh, agregados: n, repetidos: lista.length - n, nueva: nueva };
  } finally { lock.releaseLock(); }
}


/* ══════════ CobrosA.gs (copiado tal cual) ══════════ */
function cobA_r2_(v) { return Math.round((Number(v) || 0) * 100) / 100; }

function cobA_nom_(s) {
  return String(s || '').toUpperCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/\b(S\.?\s?A\.?|INC\.?|CORP\.?)\s*$/, '').replace(/[^0-9A-Z]/g, '');
}

function cobA_dias_(a, b) { return (a && b) ? Math.round((new Date(b + 'T12:00:00') - new Date(a + 'T12:00:00')) / 86400000) : 0; }

function cobA_mas_(iso, n) {
  const d = new Date(String(iso) + 'T12:00:00'); d.setDate(d.getDate() + Number(n || 0));
  return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
}

function cobA_ahora_() { return Utilities.formatDate(new Date(), tzHoja_(), 'yyyy-MM-dd HH:mm'); }

function cobA_hoja_(nombre, cols) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let h = ss.getSheetByName(nombre);
  if (!h) h = crearHoja_(ss, nombre, cols);
  else asegurarColumnas_(h, cols);
  return h;
}

function cobA_leer_(nombre) {
  try { return SpreadsheetApp.getActiveSpreadsheet().getSheetByName(nombre) ? leerHoja_(nombre) : []; } catch (e) { return []; }
}

function cobA_agregar_(h, obj) {
  const cab = h.getRange(1, 1, 1, h.getLastColumn()).getValues()[0].map(String);
  h.appendRow(cab.map(c => obj[c] !== undefined ? obj[c] : ''));
}

function cobA_cambiar_(h, col, valor, cambios) {
  const vals = h.getDataRange().getValues();
  const cab = vals[0].map(String), c = cab.indexOf(col);
  if (c < 0) return false;
  for (let i = 1; i < vals.length; i++) {
    if (String(vals[i][c]).trim() !== String(valor).trim()) continue;
    Object.keys(cambios).forEach(k => {
      let j = cab.indexOf(k);
      if (j < 0) { j = cab.length; h.getRange(1, j + 1).setValue(k); cab.push(k); }
      h.getRange(i + 1, j + 1).setValue(cambios[k]);
    });
    return i + 1;
  }
  return false;
}

function esIncobrable_(f) { return String((f && f.estado) || '').trim().toUpperCase() === 'INCOBRABLE'; }

function cobA_pagadoFac_(num) {
  if (!_COBA_PAGADO) {
    _COBA_PAGADO = {};
    cobA_leer_(HOJA_PAG).forEach(p => {
      const n = String(p.factura || '').trim();
      if (n) _COBA_PAGADO[n] = (_COBA_PAGADO[n] || 0) + (Number(p.monto) || 0);
    });
  }
  return cobA_r2_(_COBA_PAGADO[String(num || '').trim()] || 0);
}

function cobA_tel_(v) { const s = String(v || '').trim(); return (s.replace(/\D/g, '').length >= 7) ? s : ''; }

function cobA_fichas_() {
  const porRuc = {}, porNom = {}, lista = [];
  leerHoja_(HOJA_CLI).forEach(c => {
    const f = {
      id: Number(c.id) || 0, nombre: String(c.nombre || '').trim(), razon: String(c['razon social'] || '').trim(),
      ruc: String(c.ruc || '').trim(), telefono: cobA_tel_(c.telefono), whatsapp: String(c.whatsapp || '').trim(),
      correo: /@/.test(String(c.correo || '')) ? String(c.correo).trim() : '', contacto: String(c.contacto || '').trim(), tipo: carteraDe_(c),
      situacion: String(c.situacion || '').trim().toLowerCase(), estado: String(c.estado || '').trim()
    };
    if (!f.nombre) return;
    lista.push(f);
    const r = rucClave_(f.ruc);
    if (r) (porRuc[r] = porRuc[r] || []).push(f);
    [f.nombre, f.razon].forEach(n => { const k = cobA_nom_(n); if (k && !porNom[k]) porNom[k] = f; });
  });
  return { porRuc: porRuc, porNom: porNom, lista: lista };
}

function cobA_clave_(ruc, cliente, razon, F, alias) {
  const r = rucClave_(ruc);
  if (r) return (alias && alias['RUC:' + r]) || ('R' + r);   // api 3.13.1: RUC asignado a mano a otro cliente
  for (const n of [cliente, razon]) {
    const k = cobA_nom_(n);
    if (!k) continue;
    const f = F.porNom[k];
    if (f && rucClave_(f.ruc)) return 'R' + rucClave_(f.ruc);
    if (alias && alias[k]) return alias[k];
  }
  const k = cobA_nom_(cliente) || cobA_nom_(razon);
  return k ? 'N' + k : '';
}

function cobA_libro_() {
  if (_COBA) return _COBA;
  const hoy = hoyPanama_();
  const C = cfg_().cobros;
  const F = cobA_fichas_();
  /* api 3.11: los pagadores (quién paga cuando hay varias sedes) */
  _PAGIDX = null;
  const PIDX = tab_try_(() => pag_indice_(F), { lista: [], porId: {}, porCliente: {}, porNombre: {}, porRuc: {}, idPorNom: {} });
  const alias = {};
  const asignaciones = {};   // api 3.13.1
  cobA_leer_(HOJA_ALIAS).forEach(a => {
    if (!a.clave) return;
    const g = String(a.asignacion || '').trim();
    if (g) { const x = asignaciones[g] = asignaciones[g] || { id: g, clave: String(a.clave), por: String(a.aprendidoPor || ''), en: fechaISO_(a.aprendidoEn), rucs: [], nombres: [] };
      if (/^#RUC /.test(String(a.nombre))) x.rucs.push(String(a.nombre).slice(5)); else x.nombres.push(String(a.nombre)); }
    if (/^#RUC /.test(String(a.nombre))) { const r = rucClave_(String(a.nombre).slice(5)); if (r) alias['RUC:' + r] = String(a.clave); return; }
    const k = cobA_nom_(a.nombre); if (k) alias[k] = String(a.clave);
  });

  /* pagos por factura (número exacto) */
  const pagos = cobA_leer_(HOJA_PAG).map(p => ({
    pagoId: String(p.pagoId || ''), factura: String(p.factura || '').trim(), fecha: fechaISO_(p.fecha),
    monto: cobA_r2_(p.monto), metodo: String(p.metodo || ''), referencia: String(p.referencia || ''),
    cliente: String(p.cliente || '').trim(), notas: String(p.notas || ''), registradoPor: String(p.registradoPor || ''),
    lote: String(p.lote || '')
  })).filter(p => p.pagoId || p.fecha || p.factura);
  const porFac = {};
  pagos.forEach(p => { if (p.factura) (porFac[p.factura] = porFac[p.factura] || []).push(p); });

  /* lo que las propias facturas enseñan: una factura con RUC dice a quién
     pertenece ese nombre, y las del mismo nombre sin RUC van a esa cuenta */
  const FAC = cobA_leer_(HOJA_FAC);
  FAC.forEach(f => {
    const r = rucClave_(f.ruc); if (!r) return;
    [f.cliente, f['razon social']].forEach(n => { const k = cobA_nom_(n); if (k && !alias[k] && !F.porNom[k]) alias[k] = alias['RUC:' + r] || ('R' + r); });
  });

  /* facturas */
  const facturas = [], facPorNum = {};
  FAC.forEach(f => {
    const num = String(f.factura || '').trim(); if (!num) return;
    const total = cobA_r2_(f.total) || cobA_r2_(Number(f.monto) + Number(f.itbms));
    const ps = porFac[num] || [];
    const cobrado = cobA_r2_(ps.reduce((s, p) => s + p.monto, 0));
    const inc = esIncobrable_(f);
    /* el neto real (con retención), sin el ajuste de incobrable */
    const p = retencionDe_(f.ruc, f.cliente);
    let neto = total;
    if (p) { const esc = cobA_r2_(f.itbms); const it = esc > 0.009 ? esc : cobA_r2_(total - total / 1.07); neto = cobA_r2_(total - it * p / 100); }
    const saldoReal = cobA_r2_(neto - cobrado);
    const saldo = inc ? 0 : saldoReal;
    const venc = vencimientoDe_(f);
    const mora = (saldo > 0.009 && venc && venc < hoy) ? cobA_dias_(venc, hoy) : 0;
    const pg = pag_deFactura_(PIDX, f);
    const clave = pg ? 'P' + pg.pagadorId : pag_mapClave_(PIDX, cobA_clave_(f.ruc, f.cliente, f['razon social'], F, alias));
    const x = {
      factura: num, fecha: fechaISO_(f.fecha), cliente: String(f.cliente || '').trim(), razon: String(f['razon social'] || '').trim(),
      ruc: String(f.ruc || '').trim(), clave: clave, periodo: String(f.periodo || ''), concepto: String(f.concepto || ''),
