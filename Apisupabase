function api_cobSuspender(pin, clave, motivo) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  if (u.rol !== 'admin') return { ok: false, error: 'La suspensión la aprueba el administrador.' };
  const L = cobA_libro_();
  const c = L.cuentas[String(clave || '')];
  if (!c) return { ok: false, error: 'No encontré la cuenta.' };
  if (!c.clienteIds.length) return { ok: false, error: 'La cuenta no tiene ficha de cliente: no hay a quién sacar de rutas.' };
  const m = String(motivo || '').trim() || ('Falta de pago · B/. ' + c.vencido.toFixed(2) + ' vencido, ' + c.moraMax + ' días');
  const hechos = [], errores = [];
  c.clienteIds.forEach(id => {
    const r = api_cambiarEstadoCliente(pin, id, 'mora', m);
    if (r && r.ok) hechos.push(id); else errores.push((r && r.error) || 'error');
  });
  if (!hechos.length) return { ok: false, error: errores[0] || 'No se pudo.' };
  cobA_agregar_(cobA_hojaGes_(), {
    gestionId: 'GC' + new Date().getTime().toString(36).toUpperCase(), fecha: L.hoy, cliente: c.cliente, 'razon social': c.razon, ruc: c.ruc,
