  const rutasHoy = plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.fecha === hoy && r.estadoPlan === 'publicada');

  const kmJor_ = j => n(j.kmRecorridos) || (n(j.kmFinal) > n(j.kmInicio) && n(j.kmInicio) ? n(j.kmFinal) - n(j.kmInicio) : 0);   // api 3.34
  const camiones = vehiculosFlota_().map(v => {
    const nv = normVeh_(v.placa);
    const cv = cargas.filter(c => normVeh_(c.vehiculo) === nv);
    let odo = 0, odoF = '', cond = '';
    /* api 3.34: kilómetros recorridos por este camión en el mes (de sus jornadas) */
    let kmMes = 0, kmMesAnt = 0;
    JOR.forEach(j => { if (normVeh_(j.vehiculo) !== nv) return; const f = fechaISO_(j.fecha), k = kmJor_(j);
      if (f >= mesIni) kmMes += k; else if (f >= mesAntIni && f <= mesAntFin) kmMesAnt += k; });
    JOR.forEach(j => { if (normVeh_(j.vehiculo) !== nv) return; [n(j.kmFinal), n(j.kmInicio)].forEach(k => { if (k > odo) { odo = k; odoF = fechaISO_(j.fecha); cond = String(j.conductor || ''); } }); });
    cv.forEach(c => { if (c.km > odo) { odo = c.km; odoF = c.fecha; } });
    const delMes = cv.filter(c => c.fecha >= mesIni);
    const fa = fallas.filter(f => normVeh_(f.vehiculo) === nv);
    const bloq = fa.filter(f => f.bloquea);
