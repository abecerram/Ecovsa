function cta_servicio313_(s) {
  const id = cta_txt_(s.itemId || s.catId, 30);
  const cada = ['mes', 'visita', 'solicitud', 'bimestre', 'trimestre', 'semestre'].indexOf(s.cada) >= 0 ? s.cada : 'mes';
