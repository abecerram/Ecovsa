  const cambios = {};
  ['titulo','tipo','ref','refTipo','cuenta','fecha','duracion','asignado','notas','lugar'].forEach(k => { if (t[k] !== undefined) cambios[k] = t[k]; });
  if (t.hora !== undefined) cambios.hora = crm_txt_(t.hora);
