    movs.filter(m => m.hacia === D).forEach(m => cambios.push('recibe ' + m.ids.length + ' del ' + ini_fechaTxt_(m.desde)));
    return { fecha: D, fechaTxt: ini_fechaTxt_(D), tipo: t, feriado: INC_FERIADOS[D] || '', no: no, paradas: c ? R[D].ids.length : deD(D).reduce((s, r) => s + r.paradas.length, 0),
             regreso: c && R[D].ids.length ? asis_h12_(c.regreso) : '', nuevas: c ? R[D].nuevos.length : 0, cambios: cambios.join(' · '), viaje: t === 'viaje' };
  });
  return { primero: primero, dias: dias, R: R, movs: movs, avisos: avisos, resumen: resumen, editable: editable, calcD: calcD, salidaDe: salidaDe, reubicados: reubicados, dejados: dejados };
}

/* Escribe el plan: cada día que cambió queda en su borrador, ordenado y con sus horas */
function asis_escribir_(cfg, C, PL, motivo) {
  const X = C.X, ahora = new Date(), armados = [];
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
  asegurarColumnas_(h, COLS_RUT.concat(COLS_PLAN.filter(c => COLS_RUT.indexOf(c) < 0)));
  PL.dias.forEach(D => {
    const r = PL.R[D]; if (!PL.editable(D)) return;
    const cambio = r.ids.length !== r.antes.length || r.ids.some((id, i) => r.antes.indexOf(id) < 0);
    if (!cambio) return;
    if (cfg.permisos.armar !== 'solo' && !r.ruta) return;
    let ruta = r.ruta;
    if (!ruta) {
      if (!r.ids.length) return;
      const cuenta = {}, cuentaV = {};
      r.ids.forEach(id => { const pl = C.P.plan[id]; if (pl && pl.conductorPref) cuenta[pl.conductorPref] = (cuenta[pl.conductorPref] || 0) + 1; if (pl && pl.vehiculoPref) cuentaV[pl.vehiculoPref] = (cuentaV[pl.vehiculoPref] || 0) + 1; });
      const ult = C.rutas.filter(x => x.fecha < D).sort((a, b) => b.fecha.localeCompare(a.fecha))[0] || {};
      const cond = Object.keys(cuenta).sort((a, b) => cuenta[b] - cuenta[a])[0] || ult.conductor || (operadoresActivos_()[0] || '');
      const veh = Object.keys(cuentaV).sort((a, b) => cuentaV[b] - cuentaV[a])[0] || ult.vehiculo || ((vehiculosFlota_()[0] || {}).placa || '');
      if (!cond || !veh) { asis_log_({ tipo: 'aviso', fecha: D, texto: 'El ' + ini_fechaTxt_(D) + ' tiene ' + r.ids.length + ' paradas y no pude armar su ruta', porque: 'No hay ' + (!cond ? 'conductor' : 'camión') + ' para asignarle.' }); return; }
      ruta = { rutaId: 'R' + ahora.getTime() + D.replace(/-/g, '').slice(4), fecha: D, conductor: cond, vehiculo: veh, horaSalida: '', estadoPlan: 'borrador', creadaPor: ASIS_NOMBRE };
    }
    const orden = asis_ordenar_(r.ids, X), c = asis_calc_(orden, X, PL.salidaDe(D));
    /* lo que se fue de este día y venía cargado solo (recurrente o arrastrado) queda como «quitado solo esta vez» */
    r.antes.filter(id => r.ids.indexOf(id) < 0).forEach(id => { const o = String(r.origen[id] || ''); if (o && o.indexOf('extra:') !== 0) plan_anotarQuitado_(D, id, ruta.rutaId, o.split(':')[0], 'el asistente lo pasó a otro día', ASIS_U); });
    const vals = h.getDataRange().getValues(), cab = vals[0].map(String), cId = cab.indexOf('rutaId');
    const viejas = {}; leerHoja_(HOJA_RUT).filter(x => String(x.rutaId) === ruta.rutaId).forEach(x => viejas[Number(x.clienteId)] = x);
    for (let i = vals.length - 1; i >= 1; i--) if (String(vals[i][cId]) === ruta.rutaId) h.deleteRow(i + 1);
    orden.forEach((id, i) => {
      const v = viejas[id] || {};
      h.appendRow(filaPorNombre_(h, { rutaId: ruta.rutaId, fecha: D, conductor: ruta.conductor, vehiculo: ruta.vehiculo, orden: i + 1, clienteId: id,
        creadaPor: v.creadaPor || ruta.creadaPor || ASIS_NOMBRE, creadaEn: v.creadaEn || ahora, estadoPlan: 'borrador',
        origenParada: String(r.origen[id] || v.origenParada || 'asis').slice(0, 40), horaPlan: c.etas[i], horaSalida: ruta.horaSalida || '', regresoMin: c.regreso,
        modificadaPor: ASIS_NOMBRE, modificadaEn: ahora }));
    });
    const nueva = !r.ruta;
    rinf_guardar_(ruta.rutaId, Object.assign({ fecha: D, conductor: ruta.conductor, vehiculo: ruta.vehiculo, estadoPlan: 'borrador', horaSalida: ruta.horaSalida || '', regresoMin: c.regreso, por: ASIS_NOMBRE, en: ahora }, nueva ? { tipo: 'recoleccion' } : {}));
    armados.push({ fecha: D, rutaId: ruta.rutaId, paradas: orden.length, nuevas: r.nuevos.length, regreso: c.regreso, conductor: ruta.conductor, nueva: nueva, agregados: r.nuevos.map(x => x.id) });
  });
  /* lo que hizo, para el globito y para «Lo que hizo» */
  const N = id => C.X.nombre[id] || ('Cliente ' + id);
  PL.movs.forEach(m => {
    const dd = PL.dias.indexOf(m.hacia) < PL.dias.indexOf(m.desde);
    asis_log_({ tipo: 'mov', fecha: m.desde, hacia: m.hacia, clientes: m.ids, nombres: m.ids.map(N).join(', ').slice(0, 400),
      texto: (dd ? 'Adelantó ' : 'Pasó ') + m.ids.map(N).join(' y ') + ' del ' + ini_fechaTxt_(m.desde) + ' al ' + ini_fechaTxt_(m.hacia),
      porque: 'El ' + ini_fechaTxt_(m.desde) + ' regresaba a las ' + asis_h12_(m.antes) + ' (tope ' + asis_h12t_(cfg.tope) + (Number(cfg.margen) ? ', con ' + cfg.margen + ' min de margen' : '') + '). Ahora regresa a las ' + asis_h12_(m.despues) + '.',
      datos: { antes: m.antes, despues: m.despues, origen: m.ids.reduce((o, id) => { o[id] = String((PL.R[m.desde] && PL.R[m.desde].origen[id]) || ''); return o; }, {}) } });
  });
  if (armados.some(a => a.nuevas)) {
    const L = armados.filter(a => a.nuevas);
    asis_log_({ tipo: 'arm', fecha: L[0].fecha, hacia: L[L.length - 1].fecha, clientes: [], nombres: '',
      texto: 'Armó ' + (L.length === 1 ? 'la ruta del ' + ini_fechaTxt_(L[0].fecha) : 'las rutas del ' + ini_fechaTxt_(L[0].fecha) + ' al ' + ini_fechaTxt_(L[L.length - 1].fecha)) + ' (' + L.reduce((s, a) => s + a.nuevas, 0) + ' paradas nuevas)',
      porque: motivo === 'nuevo' ? 'Entró un cliente o una visita nueva' : motivo === 'ahora' ? 'Lo pediste desde la configuración' : 'Les toca esos días',
      datos: { rutas: L.map(a => ({ fecha: a.fecha, rutaId: a.rutaId, paradas: a.paradas, regreso: asis_h12_(a.regreso), nueva: a.nueva, agregados: a.agregados })) } });
  }
  if (PL.dejados && PL.dejados.length) {
    const ya = tab_try_(() => leerHoja_(HOJA_ASIS), []).some(x => String(x.tipo) === 'aviso' && String(x.porque || '').indexOf('Tus permisos') === 0 && fechaISO_(x.en) === C.hoy);
    if (!ya) asis_log_({ tipo: 'aviso', fecha: PL.dejados[0].fecha, texto: PL.dejados.length + (PL.dejados.length === 1 ? ' cliente nuevo o visita única espera' : ' clientes nuevos o visitas únicas esperan') + ' que lo pongas en ruta: ' + PL.dejados.slice(0, 4).map(x => N(x.id) + ' (' + ini_fechaTxt_(x.fecha) + ')').join(', '),
      porque: 'Tus permisos dicen que los nuevos y las visitas únicas los pones tú.' });
  }
  PL.avisos.forEach(a => {
    if (cfg.noCabe === 'semanaSig') return;
    const ya = tab_try_(() => leerHoja_(HOJA_ASIS), []).some(x => String(x.tipo) === 'aviso' && fechaISO_(x.fecha) === a.fecha && fechaISO_(x.en) === C.hoy && !x.deshechoEn);
    if (!ya) asis_log_({ tipo: 'aviso', fecha: a.fecha, hacia: '', clientes: [], nombres: '', texto: 'El ' + ini_fechaTxt_(a.fecha) + ' no cabe', porque: a.texto });
  });
  return armados;
}

function asis_correr_(cfg, motivo) {
  cfg = cfg || asis_cfg_();
  if (!cfg.on && motivo !== 'probar') return null;
  const C = asis_contexto_(cfg), PL = asis_plan_(cfg, C);
  const armados = asis_escribir_(cfg, C, PL, motivo);
  if (armados.length) marcar_('logistica');
  return { armados: armados, movs: PL.movs.length, avisos: PL.avisos.length };
}

/* A la hora de congelar: la ruta de mañana que armó el asistente se publica al conductor */
function asis_publicar_(cfg) {
  const hoy = hoyPanama_(), man = asis_manualesConRutas_(hoy);
  let D = ini_dia_(hoy, 1); for (let i = 0; i < 7 && ['normal', 'colchon', 'viaje'].indexOf(asis_tipo_(cfg, D)) < 0; i++) D = ini_dia_(D, 1);
  if (cfg.nunca.manual && man[D]) return 0;
  const info = tab_try_(() => rinf_leer_(), {});
  const rutas = plan_rutas_(leerHoja_(HOJA_RUT)).filter(r => r.fecha === D && r.estadoPlan === 'borrador' && r.paradas.length);
  const delAsis = rutas.filter(r => r.creadaPor === ASIS_NOMBRE || (info[r.rutaId] && String(info[r.rutaId].por || '') === ASIS_NOMBRE));
  if (!delAsis.length) return 0;
  if (cfg.permisos.publicar !== 'solo') {
    asis_log_({ tipo: 'aviso', fecha: D, texto: 'La ruta del ' + ini_fechaTxt_(D) + ' está lista para publicar', porque: 'Tus permisos dicen que la publicas tú (desde el planificador).' });
    return 0;
  }
  const h = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(HOJA_RUT);
  const vals = h.getDataRange().getValues(), cab = vals[0].map(String);
  const cR = cab.indexOf('rutaId'), cE = cab.indexOf('estadoPlan'), cP = cab.indexOf('publicadaPor'), cW = cab.indexOf('publicadaEn');
  const ids = {}; delAsis.forEach(r => ids[r.rutaId] = 1);
  const ahora = new Date();
  for (let i = 1; i < vals.length; i++) if (ids[String(vals[i][cR])]) {
    h.getRange(i + 1, cE + 1).setValue('');
    if (cP >= 0) h.getRange(i + 1, cP + 1).setValue(ASIS_NOMBRE);
    if (cW >= 0) h.getRange(i + 1, cW + 1).setValue(ahora);
  }
  delAsis.forEach(r => {
    rinf_guardar_(r.rutaId, { estadoPlan: '', por: ASIS_NOMBRE, en: ahora });
    asis_log_({ tipo: 'pub', fecha: D, rutaId: r.rutaId, texto: 'Publicó a ' + (r.conductor || 'el conductor') + ' la ruta del ' + ini_fechaTxt_(D) + ' (' + r.paradas.length + ' paradas)', porque: 'Hora de congelar la ruta de mañana (' + asis_h12t_(cfg.congelar) + ')' });
  });
  marcar_('logistica');
  return delAsis.length;
}

/* Cada mañana a la hora y a la hora de congelar. Corre con la tarea programada y, por si acaso,
   cada vez que Logística abre su inicio o el planificador. */
function asis_tick_() {
  const cfg = asis_cfg_(); if (!cfg.on) return null;
  const hoy = hoyPanama_(), m = asis_ahoraMin_(), cfgL = cfgLog_();
  let r = null;
  if (m >= (ini_min_(cfg.hora) || 360) && fechaISO_(cfgL['asistente:corrida']) !== hoy) { r = asis_correr_(cfg, 'mañana'); asis_cfgPoner_('asistente:corrida', hoy, ASIS_U); }
  if (m >= (ini_min_(cfg.congelar) || 960) && fechaISO_(cfgL['asistente:publico']) !== hoy) { asis_publicar_(cfg); asis_cfgPoner_('asistente:publico', hoy, ASIS_U); }
  return r;
}
/* Al entrar algo nuevo (un alta aprobada, una fecha avisada): se acomoda en el día que le toca */
function asis_alEntrar_() {
  const cfg = asis_cfg_(); if (!cfg.on || cfg.permisos.nuevos !== 'solo') return null;
  return asis_correr_(cfg, 'nuevo');
}

/* corre sin tragarse una hoja que falta: el pedido se repite con ella. Otro error no tumba la pantalla. */
function asis_seguro_(f) { try { return f(); } catch (e) { if (e instanceof FaltaHoja) throw e; console.warn('[asistente] ' + (e && e.message)); return null; } }
