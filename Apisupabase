/* ── EPP: lo que se puede entregar (inventario, categoría EPP) ── */
function sst_stock_() {
  const stock = {};
  leerHoja_(HOJA_MOV).forEach(m => {
    const k = String(m.insumoId || '').trim(); if (!k) return;
    const c = Number(m.cantidad) || 0, entra = String(m.tipo || '').toUpperCase() === 'ENTRADA';
    stock[k] = (stock[k] || 0) + (entra ? c : -c);
  });
  return stock;
}
function api_segEppItems(pin) {
