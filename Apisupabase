}
/* ── Registrar la entrega de EPP (F-SST-01): queda en el expediente y, si el artículo es del inventario, se descuenta ──
   d = { personaId, fecha, tipo: 'Entrega'|'Reposición', firmada, firmaId, originalId, items: [{ insumoId?, nombre, cant, talla, espec, nor, nr, mot }], negativoConfirmado }
   api 3.33: cada artículo lleva su norma, si es nuevo o reposición y el motivo; la entrega guarda la cédula, el cargo y la línea de ese día
   y el original firmado escaneado (originalId), si se llenó en papel. */
function api_segEppEntregar(pin, d) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  if (!x.puedeEditar) return { ok: false, error: 'Tu usuario no puede registrar entregas de EPP.' };
  d = d && typeof d === 'object' ? d : {};
  const res = sst_personaFila_(d.personaId, x); if (res.e) return res.e;
  const items = (Array.isArray(d.items) ? d.items : []).slice(0, 30).map(i => ({ insumoId: sst_t_(i.insumoId, 20), nombre: sst_t_(i.nombre, 80), cant: Math.max(1, Math.min(999, Number(i.cant) || 1)),
    talla: sst_t_(i.talla, 12), espec: sst_t_(i.espec, 100), nor: sst_t_(i.nor, 60), nr: ['Nuevo', 'Reposición'].indexOf(i.nr) >= 0 ? i.nr : '', mot: sst_t_(i.mot, 40) })).filter(i => i.nombre);
  if (!items.length) return { ok: false, error: 'Marque lo que se entrega.' };
  const fecha = sst_iso_(d.fecha) || hoyPanama_();
  const originalId = sst_t_(d.originalId, 40);
  if (originalId && !arc_filas_().some(a => a.archivoId === originalId && a.ambito === 'seguridad' && a.doc === 'epp' && a.estado === 'VIGENTE')) return { ok: false, error: 'No encontré el original firmado que se subió.' };
  /* el inventario: no se entrega lo que no hay (igual que Administración) */
  const stock = sst_stock_(), insumos = {};
  leerHoja_(HOJA_INS).forEach(i => { insumos[String(i.insumoId || '').trim()] = i; });
  const sinStock = items.filter(i => i.insumoId && insumos[i.insumoId] && i.cant > (stock[i.insumoId] || 0));
  if (sinStock.length && !d.negativoConfirmado) {
    const i = sinStock[0];
    return { ok: false, sinStock: { insumo: i.nombre, hay: Math.round((stock[i.insumoId] || 0) * 100) / 100, piden: i.cant, unidad: String((insumos[i.insumoId] || {}).unidad || '') } };
  }
  items.forEach(i => {
    if (i.insumoId && insumos[i.insumoId]) movimiento_({ tipo: 'SALIDA', insumoId: i.insumoId, cantidad: i.cant, fecha: fecha, destinoTipo: 'persona', destino: res.datos.n,
      entregadoPor: x.u.nombre, observaciones: 'Constancia de entrega de EPP (Seguridad)', registradoPor: x.u.nombre });
  });
  const t = sst_tab_(), rid = sst_nuevoId_('epp', SST_TIPOS.epp), ahora = "'" + sst_ahora_();
  const firmada = !!d.firmada || !!sst_t_(d.firmaId, 40) || !!originalId;
  agregar313_(t, { regId: rid, tipo: 'epp', ref: res.id || ('S:' + res.datos.solidosId), estado: 'activo', creadoPor: x.u.nombre, creadoEn: ahora, cambiadoPor: x.u.nombre, cambiadoEn: ahora,
    datos: JSON.stringify({ persona: '', fecha: fecha, tipo: d.tipo === 'Reposición' ? 'Reposición' : 'Entrega', items: items, firmada: firmada, firmaId: sst_t_(d.firmaId, 40), originalId: originalId,
      entregadoPor: x.u.nombre, nombre: res.datos.n, ced: sst_t_(res.datos.ced, 30), cargo: sst_t_(res.datos.p || res.datos.puestoTipo, 80), linea: sst_t_(res.datos.linea, 30) }) });
  const datos = res.datos;
  datos.epp = { fecha: fecha, firmada: firmada, ref: rid };
  sst_personaPoner_(res, datos, x);
  /* el registro lleva el id de la persona (por si la ficha se acaba de crear) */
  const f = sst_tab_().filas.find(z => sst_t_(z.regId, 40) === rid);
  if (f) { const dd = sst_json_(f.datos, {}); dd.persona = res.id; actualizar313_(sst_tab_(), f._fila, { datos: JSON.stringify(dd), ref: res.id }); }
  sst_his_(x.u, 'Entrega de EPP a ' + datos.n, sst_num_('epp', rid) + ' · ' + items.map(i => i.nombre).join(', '));
  return { ok: true, id: rid, num: sst_num_('epp', rid), personaId: res.id };
}

/* ── Registrar una capacitación (F-SST-02): queda en el expediente de cada asistente que aprobó ──
   d = { plan, tema, fecha, dicta, listaId, asist: [{ id, aprobo }] } */
function api_segCapRegistrar(pin, d) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  if (!x.puedeEditar) return { ok: false, error: 'Tu usuario no puede registrar capacitaciones.' };
  d = d && typeof d === 'object' ? d : {};
  const plan = sst_t_(d.plan, 20), fecha = sst_iso_(d.fecha) || hoyPanama_();
  if (!/^PL-SST-\d\d$/.test(plan) && !sst_t_(d.tema, 100)) return { ok: false, error: 'Elija la capacitación.' };
  const asist = (Array.isArray(d.asist) ? d.asist : []).slice(0, 80).map(a => ({ id: sst_t_(a.id, 40), aprobo: a.aprobo !== false })).filter(a => a.id);
  if (!asist.length) return { ok: false, error: 'Marque quién asistió.' };
  const t = sst_tab_();
  const resultados = [];
  for (const a of asist) {
    const res = sst_personaFila_(a.id, x);
    if (res.e) return res.e;
    resultados.push(res);
  }
  resultados.forEach((res, i) => {
    const datos = res.datos;
    if (asist[i].aprobo) {
      if (plan === 'PL-SST-01') datos.ind = { fecha: fecha, firmada: true, origen: 'inducción' };
      else if (plan) { datos.caps = datos.caps || {}; datos.caps[plan] = fecha; }
    }
    sst_personaPoner_(res, datos, x);
    asist[i].id = res.id;                      // si la ficha era de sólidos, ahora tiene la propia
  });
  const rid = sst_nuevoId_('caprec', SST_TIPOS.caprec), ahora = "'" + sst_ahora_();
  agregar313_(sst_tab_(), { regId: rid, tipo: 'caprec', ref: plan, estado: 'activo', creadoPor: x.u.nombre, creadoEn: ahora, cambiadoPor: x.u.nombre, cambiadoEn: ahora,
    datos: JSON.stringify({ plan: plan, tema: sst_t_(d.tema, 160), tipo: sst_t_(d.tipo, 40), duracion: sst_t_(d.duracion, 40), fecha: fecha, dicta: sst_t_(d.dicta, 80), listaId: sst_t_(d.listaId, 40), asist: asist }) });
  sst_his_(x.u, 'Registró la capacitación ' + (plan || sst_t_(d.tema, 60)), sst_num_('caprec', rid) + ' · ' + asist.length + ' asistentes · ' + asist.filter(a => a.aprobo).length + ' aprobaron');
  return { ok: true, id: rid, num: sst_num_('caprec', rid) };
}


/* ══════════ api 3.33 · Formularios llenos ══════════
   Cada F-SST-01 (entrega de EPP) y cada F-SST-02 (inducción o capacitación) lleno, con su número, para verlo o reimprimirlo
   (por ejemplo en una auditoría). Se guardan los datos, no la hoja: la pantalla vuelve a armar el formato. El original firmado
   y escaneado queda adjunto. Lo mismo se ve en el expediente de cada persona. */
function api_segLlenos(pin, codigo) {
  const x = sst_usr_(pin); if (x.e) return x.e;
  if (!x.puedeExp) return { ok: false, error: 'Tu usuario no ve los formularios llenos: son parte de los expedientes del personal.' };
  const c = String(codigo || '');
  const P = {}; sst_personas_(false).forEach(p => { P[p.id] = p; });
  let items;
  if (c === 'F-SST-01') {
    items = sst_lista_('epp').map(e => { const p = P[e.persona] || {};
      return Object.assign({}, e, { num: sst_num_('epp', e.id), personaNombre: e.nombre || p.n || '', ced: e.ced || p.ced || '', cargo: e.cargo || p.p || '', linea: e.linea || p.linea || '' }); });
  } else if (c === 'F-SST-02') {
    items = sst_lista_('caprec').map(r => Object.assign({}, r, { num: sst_num_('caprec', r.id),
