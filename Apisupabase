function api_decidirFalla(pin, fallaId, accion, nota, extra) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido' };
  const acc = String(accion || '');
  if (['autorizar','taller','resuelta','abierta','anular'].indexOf(acc) < 0) return { ok: false, error: 'Acción no válida.' };
  const lock = LockService.getScriptLock(); lock.waitLock(20000);
  try {
    const hf = hojaPlanta_(HOJA_FAL, COLS_FAL);
    if (acc === 'taller' && extra) asegurarColumnas_(hf, COLS_FAL_TALLER);
    const vals = hf.getDataRange().getValues();
    const cab = vals[0].map(String);
    const col = n => cab.indexOf(n);
    for (let i = 1; i < vals.length; i++) {
      if (String(vals[i][col('fallaId')]) !== String(fallaId)) continue;
      const f = falla_(Object.fromEntries(cab.map((c, k) => [c, vals[i][k]])));
      const hoy = hoyPanama_();
      if (acc === 'anular') {
        if (f.conductor.trim().toLowerCase() !== u.nombre.trim().toLowerCase() || f.fecha !== hoy)
          if (!esSupervisor_(u)) return { ok: false, error: 'Solo puedes anular una falla que reportaste hoy.' };
      } else if (!esSupervisor_(u)) return { ok: false, error: 'Solo logística decide sobre las fallas.' };
      const set = (c, v) => hf.getRange(i + 1, col(c) + 1).setValue(v);
      const txt = { autorizar: 'autorizó la salida', taller: 'la mandó a taller', resuelta: 'la dio por resuelta',
                    abierta: 'la dejó abierta', anular: 'la anuló' }[acc];
      if (acc === 'autorizar') { set('bloquea', ''); set('autorizadaPor', u.nombre); set('autorizadaEn', new Date()); }
      if (acc === 'taller') {
        set('estado', 'en taller');
        if (extra && col('tallerNombre') >= 0) { set('tallerNombre', String(extra.taller || '').slice(0, 80)); set('tallerFecha', /^\d{4}-\d{2}-\d{2}$/.test(String(extra.fecha || '')) ? extra.fecha : ''); }
      }
      if (acc === 'resuelta') { set('estado', 'resuelta'); set('bloquea', ''); set('resueltaPor', u.nombre); set('resueltaEn', new Date()); }
      if (acc === 'abierta') set('estado', 'abierta');
      if (acc === 'anular') { set('estado', 'anulada'); set('bloquea', ''); }
      const prev = String(vals[i][col('historial')] || '');
      const tx = acc === 'taller' && extra && extra.taller ? txt + ' (' + extra.taller + (extra.fecha ? ', promete ' + extra.fecha : '') + ')' : txt;
      set('historial', (prev ? prev + ' | ' : '') + hoy + ' ' + u.nombre + ' ' + tx + (nota ? ': ' + nota : ''));
      marcar_('logistica');
      return { ok: true, fallaId: f.fallaId, accion: acc };
    }
    return { ok: false, error: 'No encontré esa falla.' };
  } finally { lock.releaseLock(); }
}

function api_fallasFlota(pin) {
