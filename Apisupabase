  const id = cobB_id_('CT');
  cobA_agregar_(cobA_hoja_(HOJA_CARTAS, COLS_CARTAS), { cartaId: id, token: token, tipo: tipo, fecha: L.hoy, clave: c.clave, cliente: c.cliente, razon: c.razon || '',
    ruc: datos.ruc, saldo: datos.saldo, fechaLimite: limite, datos: JSON.stringify(datos), creadaPor: u.nombre });
  return { cartaId: id, token: token, tipo: tipo, fechaLimite: limite, titulo: COBB_TIPOS_CARTA[tipo] };
}

function api_cobCrearCarta(pin, clave, tipo, d) {
  const u = usuarioPorPin_(pin);
  if (!u) return { ok: false, error: 'PIN no válido', requiereLogin: true };
  const t = String(tipo || '');
  if (!COBB_TIPOS_CARTA[t]) return { ok: false, error: 'Tipo de carta no válido.' };
